  class: worker_box
  style.stroke: "#10B981"
}

w2: "Executor Worker 2\n• Local In-Memory Dim Hash Table\n• Streams Fact Partition 2\n• Zero network shuffle!" {
  class: worker_box
  style.stroke: "#10B981"
}

w3: "Executor Worker 3\n• Local In-Memory Dim Hash Table\n• Streams Fact Partition 3\n• Zero network shuffle!" {
  class: worker_box
  style.stroke: "#10B981"
}

driver -> w1: "Peer-to-Peer Broadcast"
