# Broadcast Hash Join (BHJ) Architecture
direction: down
classes: {
  driver_box: { style: { fill: "#111827"; stroke-width: 2; border-radius: 10 } }
  worker_box: { style: { fill: "#1E293B"; stroke-width: 2; border-radius: 8 } }
}

driver: "Spark Driver Node\n• Collects Small Dimension (< 10MB autoBroadcastJoinThreshold)\n• Serializes & broadcasts table to all workers via TorrentBroadcast" {
  class: driver_box
  style.stroke: "#3B82F6"
}

