# Window Framing: ROWS vs RANGE
direction: right

rows: "ROWS Framing\n• Physical row offset\n• Monotonic increments\n• Running: 100, 200, 300" {
  style.stroke: "#10B981"
}

range: "RANGE Framing (Default)\n• Logical peer group\n• Jumps across duplicates\n• Running: 100, 300, 300 ⚠️" {
  style.stroke: "#F59E0B"
}
