# The Visual Join Spectrum: Relational Algebra Cardinality
direction: right
classes: {
  join_box: { style: { fill: "#111827"; stroke-width: 2; border-radius: 8 } }
}

inner: "1. INNER JOIN (A ∩ B)\n• Strict intersection\n• Matches where predicate is TRUE\n• Drops unmatched A and B rows\n• Output: <= min(|A|, |B|)" {
  class: join_box
  style.stroke: "#3B82F6"
}

left: "2. LEFT OUTER JOIN\n• Preserves all Left table A rows\n• Matched rows get B attributes\n• Unmatched B padded with NULLs\n• Output: >= |A|" {
  class: join_box
  style.stroke: "#10B981"
}

right: "3. RIGHT OUTER JOIN\n• Preserves all Right table B rows\n• Matched rows get A attributes\n• Unmatched A padded with NULLs\n• Output: >= |B|" {
  class: join_box
  style.stroke: "#F59E0B"
}

full: "4. FULL OUTER JOIN (A ∪ B)\n• Complete union of both relations\n• Preserves all A and all B rows\n• Unmatched sides NULL-padded\n• Output: >= max(|A|, |B|)" {
  class: join_box
  style.stroke: "#8B5CF6"
}

cross: "5. CROSS JOIN (|A| × |B|)\n• Cartesian product of relations\n• No predicate; pairs all tuples\n• High danger: row explosion!\n• Output: = |A| × |B|" {
  class: join_box
  style.stroke: "#EF4444"
}

inner -> left -> right -> full -> cross: "Cardinality & Permissiveness" {
  style.stroke: "#64748B"
}
