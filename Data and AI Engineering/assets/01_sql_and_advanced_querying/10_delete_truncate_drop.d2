# DELETE vs TRUNCATE vs DROP: Storage & Logging Lifecycle
direction: right
classes: {
  op_card: { style: { fill: "#111827"; stroke-width: 2; border-radius: 10 } }
}

delete: "DELETE (DML Operation)\n• Row-by-row WAL logging\n• Leaves dead MVCC tuples for VACUUM\n• Retains high-water mark (HWM)\n• Slow on large tables; row-level locks" {
  class: op_card
  style.stroke: "#EF4444"
}

truncate: "TRUNCATE (DDL Operation)\n• Deallocates physical data pages\n• Minimal WAL logging; resets HWM instantly\n• Cannot trigger row-level DELETE triggers\n• Fast; acquires EXCLUSIVE table lock" {
  class: op_card
  style.stroke: "#3B82F6"
}

drop: "DROP (DDL Destruction)\n• Removes catalog table & schema metadata\n• Unlinks OS disk files immediately\n• Permanently destroys table, indexes & triggers\n• Invalidates dependent views & foreign keys" {
  class: op_card
  style.stroke: "#8B5CF6"
}