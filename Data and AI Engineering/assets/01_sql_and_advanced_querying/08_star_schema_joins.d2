# Multi-Table Joins & Star Schema Dimensional Querying
direction: right
classes: {
  fact_box: { style: { fill: "#1E293B"; stroke-width: 2; border-radius: 10 } }
  dim_box: { style: { fill: "#111827"; stroke-width: 2; border-radius: 8 } }
}

fact: "FACT_SALES (Center Hub)\n• sales_id [PK]\n• date_id [FK]\n• customer_id [FK]\n• product_id [FK]\n• store_id [FK]\n• units, revenue, cost" {
  class: fact_box
  style.stroke: "#3B82F6"
}

date: "DIM_DATE\n• date_id [PK]\n• calendar_date\n• year, quarter, month" {
  class: dim_box
  style.stroke: "#F59E0B"
}

cust: "DIM_CUSTOMER\n• customer_id [PK]\n• customer_name\n• loyalty_tier, region" {
  class: dim_box
  style.stroke: "#10B981"
}

prod: "DIM_PRODUCT\n• product_id [PK]\n• sku, category\n• unit_price, cost" {
  class: dim_box
  style.stroke: "#8B5CF6"
}

store: "DIM_STORE\n• store_id [PK]\n• store_name, city\n• country, format" {
  class: dim_box
  style.stroke: "#EF4444"
}

date -> fact: "date_id [FK]" {
  style.stroke: "#F59E0B"
}
cust -> fact: "customer_id [FK]" {
  style.stroke: "#10B981"
}
prod -> fact: "product_id [FK]" {
  style.stroke: "#8B5CF6"
}
store -> fact: "store_id [FK]" {
  style.stroke: "#EF4444"
}