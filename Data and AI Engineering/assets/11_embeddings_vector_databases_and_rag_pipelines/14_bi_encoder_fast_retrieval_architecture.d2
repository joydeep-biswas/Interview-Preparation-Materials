direction: right
classes: {
  q: { style: { fill: "#1e293b"; stroke: "#38bdf8"; font-color: "#f8fafc" } }
  d: { style: { fill: "#581c87"; stroke: "#c084fc"; font-color: "#e9d5ff" } }
  enc: { style: { fill: "#155e75"; stroke: "#22d3ee"; font-color: "#67e8f9" } }
  score: { style: { fill: "#064e3b"; stroke: "#34d399"; font-color: "#a7f3d0" } }
}

query: "Query: 'How to restart pod?'" { class: q }
doc: "Doc: 'Run kubectl delete pod...'" { class: d }
enc_q: "Encoder Network (Query)" { class: enc }
enc_d: "Encoder Network (Doc)" { class: enc }
dot: "Dot Product u . v\n(<2ms HNSW search)" { class: score }

query -> enc_q: "Tokenize"
doc -> enc_d: "Pre-index"
enc_q -> dot: "u in R^1536"
enc_d -> dot: "v in R^1536"