direction: right
classes: {
  closed: { style: { fill: "#7f1d1d"; stroke: "#f87171"; font-color: "#fecaca" } }
  open: { style: { fill: "#064e3b"; stroke: "#34d399"; font-color: "#a7f3d0" } }
  norm: { style: { fill: "#1e293b"; stroke: "#38bdf8"; font-color: "#f8fafc" } }
}

parametric: "Parametric Generation (Closed Book)" {
  q1: "User Query" { class: norm }
  theta: "Frozen Weights theta\n(Static cutoff)" { class: closed }
  hallucinate: "Plausible Hallucination\n(No verification possible)" { class: closed }

  q1 -> theta: "Direct prompt"
  theta -> hallucinate: "Unverified generation"
}

rag: "Retrieval-Augmented Generation (Open Book)" {
  q2: "User Query" { class: norm }
  retriever: "Retriever eta\n(Non-Parametric Corpus D)" { style: { fill: "#155e75"; stroke: "#22d3ee"; font-color: "#67e8f9" } }
  context: "Top-K Grounded Chunks z" { class: open }
  generator: "Generator theta\n(Grounded with citations)" { class: open }

  q2 -> retriever: "Retrieve chunks"
  retriever -> context: "Ranked docs"
  context -> generator: "Context prompt"
  q2 -> generator: "Query prompt"
}