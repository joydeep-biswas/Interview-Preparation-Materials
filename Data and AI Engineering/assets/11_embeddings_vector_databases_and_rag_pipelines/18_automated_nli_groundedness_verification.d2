direction: right
classes: {
  hyp: { style: { fill: "#1e293b"; stroke: "#38bdf8"; font-color: "#f8fafc" } }
  prem: { style: { fill: "#581c87"; stroke: "#c084fc"; font-color: "#e9d5ff" } }
  nli: { style: { fill: "#451a03"; stroke: "#fbbf24"; font-color: "#fde68a" } }
  pass: { style: { fill: "#064e3b"; stroke: "#34d399"; font-color: "#a7f3d0" } }
  fail: { style: { fill: "#7f1d1d"; stroke: "#f87171"; font-color: "#fecaca" } }
}

claim: "Generated Claim (Hypothesis)" { class: hyp }
source: "Cited Context (Premise)" { class: prem }
nli_model: "NLI Model (DeBERTa)\nEvaluates Premise -> Hypothesis" { class: nli }

verdict_pass: "Verified Grounded Citation\n(P(Entailment) > 0.85)" { class: pass }
verdict_fail: "Flagged Hallucination / Redact\n(P(Contradiction / Neutral))" { class: fail }

claim -> nli_model: "Hypothesis"
source -> nli_model: "Premise"
nli_model -> verdict_pass: "Entailment (Pass)"
nli_model -> verdict_fail: "Contradiction (Fail)"