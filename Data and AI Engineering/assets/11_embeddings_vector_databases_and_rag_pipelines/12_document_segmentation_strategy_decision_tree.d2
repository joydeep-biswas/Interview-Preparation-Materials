direction: right
classes: {
  inp: { style: { fill: "#1e293b"; stroke: "#38bdf8"; font-color: "#f8fafc" } }
  router: { style: { fill: "#451a03"; stroke: "#fbbf24"; font-color: "#fde68a" } }
  strat: { style: { fill: "#155e75"; stroke: "#22d3ee"; font-color: "#67e8f9" } }
}

block: "Input Document Block\n(Exceeds token target)" { class: inp }
check: "Document Structure Check" { class: router }

s_prose: "Recursive Character Splitter\n(Markdown & Technical Prose)" { style: { fill: "#1e293b"; stroke: "#38bdf8"; font-color: "#f8fafc" } }
s_code: "AST-Aware Code Splitter\n(Classes & Functions intact)" { class: strat }
s_sem: "Semantic Similarity Chunking\n(Dense Unstructured Text)" { style: { fill: "#581c87"; stroke: "#c084fc"; font-color: "#e9d5ff" } }
s_fixed: "Fixed-Size Token Window\n(High-Throughput Streaming Logs)" { style: { fill: "#064e3b"; stroke: "#34d399"; font-color: "#a7f3d0" } }

block -> check: "Analyze AST / format"
check -> s_prose: "Prose / Markdown"
check -> s_code: "Code / AST"
check -> s_sem: "Dense Text"
check -> s_fixed: "Streaming Logs"