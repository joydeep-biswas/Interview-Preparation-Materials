direction: right
title: "Delta Lake Deletion Vectors vs Copy-on-Write (COW)"
classes: {
  container: { style: { fill: "#111827"; stroke-width: 2; border-radius: 10 } }
  box: { style: { fill: "#1E293B"; stroke-width: 2; border-radius: 8 } }
  table_box: { style: { fill: "#1E293B"; stroke: "#38bdf8"; stroke-width: 2 } }
  blue_box: { style: { fill: "#1e293b"; stroke: "#38bdf8"; stroke-width: 2; border-radius: 8 } }
  green_box: { style: { fill: "#0f291e"; stroke: "#4ade80"; stroke-width: 2; border-radius: 8 } }
  amber_box: { style: { fill: "#231e12"; stroke: "#fbbf24"; stroke-width: 2; border-radius: 8 } }
  purple_box: { style: { fill: "#1e1b2e"; stroke: "#c084fc"; stroke-width: 2; border-radius: 8 } }
  red_box: { style: { fill: "#2b1111"; stroke: "#f87171"; stroke-width: 2; border-radius: 8 } }
}

cow: "Traditional Copy-on-Write (COW)" {
  class: container
  style.fill: "#1a1116"
  style.stroke: "#ef4444"

  orig: "Original 500MB Parquet\n(1,000,000 Rows)"
  rewrite: "Rewritten 500MB Parquet!\n(999,999 surviving rows)"
  orig -> rewrite: "Delete Row #42\n(Full Rewrite!)"
}

dv: "Modern Deletion Vectors (DV)" {
  class: container
  style.fill: "#0c1d1a"
  style.stroke: "#10b981"

  base: "Base 500MB Parquet\n(100% Untouched!)"
  vector: "Tiny Deletion Vector (.dv)\n(2KB Roaring Bitmap: bit 42 tombstone)"
  reader: "Photon / Spark Reader\n(Applies bitmask on read, skips row 42)"

  base -> reader: "Direct Scan"
  vector -> reader: "Bitmask Filter"
}