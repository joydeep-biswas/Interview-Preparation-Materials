direction: down
title: "Delta Lake Clones: Shallow vs Deep Clone Mechanics"
classes: {
  container: { style: { fill: "#111827"; stroke-width: 2; border-radius: 10 } }
  box: { style: { fill: "#1E293B"; stroke-width: 2; border-radius: 8 } }
  table_box: { style: { fill: "#1E293B"; stroke: "#38bdf8"; stroke-width: 2 } }
  blue_box: { style: { fill: "#1e293b"; stroke: "#38bdf8"; stroke-width: 2; border-radius: 8 } }
  green_box: { style: { fill: "#0f291e"; stroke: "#4ade80"; stroke-width: 2; border-radius: 8 } }
  amber_box: { style: { fill: "#231e12"; stroke: "#fbbf24"; stroke-width: 2; border-radius: 8 } }
  purple_box: { style: { fill: "#1e1b2e"; stroke: "#c084fc"; stroke-width: 2; border-radius: 8 } }
  red_box: { style: { fill: "#2b1111"; stroke: "#f87171"; stroke-width: 2; border-radius: 8 } }
}

source: "Primary Production Table: lakehouse.fact_orders" {
  class: container
  style.fill: "#0f172a"
  style.stroke: "#38bdf8"
  description: "10 TB Active Parquet Data | _delta_log/ Version 50"
}

shallow: "Shallow Clone (Zero-Copy Metadata)" {
  class: container
  style.fill: "#062e3d"
  style.stroke: "#06b6d4"

  target: "dev_sandbox.orders_dev_test"
  data: "Data Copied: 0 BYTES (Pointers to source)"
  speed: "Time: 2-5 Seconds"
  use: "Dev/Test, ML feature validation"
  risk: "Tied to source Parquet files (Vulnerable to source VACUUM)"
}

deep: "Deep Clone (Fully Isolated Replica)" {
  class: container
  style.fill: "#062e22"
  style.stroke: "#10b981"

  target: "dr_lakehouse.fact_orders (Secondary Region)"
  data: "Data Copied: Full 10 TB (Incremental sync after run 1)"
  speed: "Time: Hours (Proportional to size)"
  use: "Multi-region DR, Compliance archival"
  isolation: "100% Decoupled from source table"
}

source -> shallow: "SHALLOW CLONE\n(Zero-copy metadata fork)"
source -> deep: "DEEP CLONE\n(Physical data replication)"