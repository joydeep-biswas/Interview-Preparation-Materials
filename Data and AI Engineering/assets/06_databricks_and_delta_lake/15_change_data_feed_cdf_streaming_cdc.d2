direction: right
title: "Delta Lake Change Data Feed (CDF) Architecture"
classes: {
  container: { style: { fill: "#111827"; stroke-width: 2; border-radius: 10 } }
  box: { style: { fill: "#1E293B"; stroke-width: 2; border-radius: 8 } }
  table_box: { style: { fill: "#1E293B"; stroke: "#38bdf8"; stroke-width: 2 } }
  blue_box: { style: { fill: "#1e293b"; stroke: "#38bdf8"; stroke-width: 2; border-radius: 8 } }
  green_box: { style: { fill: "#0f291e"; stroke: "#4ade80"; stroke-width: 2; border-radius: 8 } }
  amber_box: { style: { fill: "#231e12"; stroke: "#fbbf24"; stroke-width: 2; border-radius: 8 } }
  purple_box: { style: { fill: "#1e1b2e"; stroke: "#c084fc"; stroke-width: 2; border-radius: 8 } }
  red_box: { style: { fill: "#2b1111"; stroke: "#f87171"; stroke-width: 2; border-radius: 8 } }
}

mutations: "Table Mutations" {
  class: container
  style.fill: "#111827"
  style.stroke: "#38bdf8"

  ins: "INSERT (New Order)"
  upd: "UPDATE (PENDING -> SHIPPED)"
  del: "DELETE (Cancelled Order)"
}

storage: "Delta Storage Engine" {
  class: container
  style.fill: "#0f172a"
  style.stroke: "#10b981"

  log: "_delta_log/ (JSON commits)"
  data: "Committed Parquet Data"
  cdc: "_change_data/ (Dedicated CDC files)"
}

cdf: "CDF Change Stream" {
  class: container
  style.fill: "#1e1e38"
  style.stroke: "#c084fc"

  rec_ins: "_change_type = 'insert'"
  rec_pre: "_change_type = 'update_preimage'"
  rec_post: "_change_type = 'update_postimage'"
  rec_del: "_change_type = 'delete'"
}

consumers: "Downstream Consumers" {
  class: container
  style.fill: "#0b1329"
  style.stroke: "#3b82f6"

  gold: "Gold Business Mart\n(Incremental rollup aggregation)"
  audit: "Compliance & Audit Log\n(Immutable record history)"
  kafka: "Apache Kafka / Event Hubs\n(Real-time microservice events)"
}

mutations.ins -> storage.data: "Write data"
mutations.upd -> storage.cdc: "Generate CDC"
mutations.del -> storage.cdc: "Generate CDC"

storage.log -> cdf: "table_changes() API"
storage.data -> cdf
storage.cdc -> cdf

cdf -> consumers.gold: "Stream deltas"
cdf -> consumers.audit: "Stream history"
cdf -> consumers.kafka: "Publish events"