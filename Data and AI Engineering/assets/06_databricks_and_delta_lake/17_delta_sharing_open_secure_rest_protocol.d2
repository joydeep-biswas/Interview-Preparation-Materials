direction: right
title: "Delta Sharing Open & Secure Protocol Architecture"
classes: {
  container: { style: { fill: "#111827"; stroke-width: 2; border-radius: 10 } }
  box: { style: { fill: "#1E293B"; stroke-width: 2; border-radius: 8 } }
  table_box: { style: { fill: "#1E293B"; stroke: "#38bdf8"; stroke-width: 2 } }
  blue_box: { style: { fill: "#1e293b"; stroke: "#38bdf8"; stroke-width: 2; border-radius: 8 } }
  green_box: { style: { fill: "#0f291e"; stroke: "#4ade80"; stroke-width: 2; border-radius: 8 } }
  amber_box: { style: { fill: "#231e12"; stroke: "#fbbf24"; stroke-width: 2; border-radius: 8 } }
  purple_box: { style: { fill: "#1e1b2e"; stroke: "#c084fc"; stroke-width: 2; border-radius: 8 } }
  red_box: { style: { fill: "#2b1111"; stroke: "#f87171"; stroke-width: 2; border-radius: 8 } }
}

provider: "Data Provider (Unity Catalog)" {
  class: container
  style.fill: "#0b1329"
  style.stroke: "#3b82f6"

  uc: "Unity Catalog Metastore\n(Share ACLs, table grants)"
  storage: "Cloud Object Storage (S3/ADLS/GCS)\n(Underlying Parquet Data Files)"
}

protocol: "Delta Sharing REST Protocol" {
  class: container
  style.fill: "#0f172a"
  style.stroke: "#10b981"

  auth: "1. Client Auth & REST Query\n(Bearer token verification)"
  check: "2. Permission & Snapshot Evaluation"
  urls: "3. Issue Pre-Signed Cloud URLs\n(Short-lived AWS S3 / Azure SAS URLs)"
}

consumers: "Heterogeneous Recipient Clients" {
  class: container
  style.fill: "#18182f"
  style.stroke: "#c084fc"

  pandas: "Python Pandas / Polars"
  bi: "PowerBI / Tableau / Excel"
  spark: "External Spark Cluster (AWS/GCP)"
  duckdb: "DuckDB / Rust / Go Apps"
}

provider.uc -> protocol.auth: "Configure Grants"
protocol.auth -> protocol.check
protocol.check -> protocol.urls
protocol.urls -> consumers.pandas: "Pre-signed URLs"
protocol.urls -> consumers.bi
protocol.urls -> consumers.spark
protocol.urls -> consumers.duckdb

provider.storage -> consumers.spark: "Direct Parallel Parquet Download (Zero Proxy!)"