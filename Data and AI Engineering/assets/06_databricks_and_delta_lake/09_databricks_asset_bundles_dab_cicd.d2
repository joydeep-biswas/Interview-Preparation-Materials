direction: right
title: "Databricks Asset Bundles (DAB) CI/CD Architecture"
classes: {
  container: { style: { fill: "#111827"; stroke-width: 2; border-radius: 10 } }
  box: { style: { fill: "#1E293B"; stroke-width: 2; border-radius: 8 } }
  table_box: { style: { fill: "#1E293B"; stroke: "#38bdf8"; stroke-width: 2 } }
  blue_box: { style: { fill: "#1e293b"; stroke: "#38bdf8"; stroke-width: 2; border-radius: 8 } }
  green_box: { style: { fill: "#0f291e"; stroke: "#4ade80"; stroke-width: 2; border-radius: 8 } }
  amber_box: { style: { fill: "#231e12"; stroke: "#fbbf24"; stroke-width: 2; border-radius: 8 } }
  purple_box: { style: { fill: "#1e1b2e"; stroke: "#c084fc"; stroke-width: 2; border-radius: 8 } }
  red_box: { style: { fill: "#2b1111"; stroke: "#f87171"; stroke-width: 2; border-radius: 8 } }
}

Dev: "1. Developer Workstation" {
  class: container
  style.stroke: "#38BDF8"
  Config: "databricks.yml (IaC Bundle Definition)"
  Val: "databricks bundle validate"
  DeployDev: "databricks bundle deploy -t dev"
  Config -> Val -> DeployDev
}

Git: "2. Git Pull Request" {
  class: container
  style.stroke: "#FBBF24"
  PR: "Peer Review & Automated Unit Tests"
}

CICD: "3. CI/CD Runner (GitHub Actions / ADO)" {
  class: container
  style.stroke: "#C084FC"
  OIDC: "Authenticates via Cloud OIDC"
  DeployProd: "databricks bundle deploy -t prod"
  OIDC -> DeployProd
}

Prod: "4. Governed Prod Workspace" {
  class: container
  style.stroke: "#34D399"
  SP: "Owned by Service Principal"
  Workflows: "Production Workflows & DLT DAGs"
  SP -> Workflows
}

Dev.DeployDev -> Git.PR: "Git Push & Open PR" { style.stroke: "#FBBF24" }
Git.PR -> CICD.OIDC: "Merge to main branch" { style.stroke: "#C084FC" }
CICD.DeployProd -> Prod.SP: "Deploys assets" { style.stroke: "#34D399" }