direction: right
title: "Delta Lake Time Travel & Checkpoint Reconstruction"
classes: {
  container: { style: { fill: "#111827"; stroke-width: 2; border-radius: 10 } }
  box: { style: { fill: "#1E293B"; stroke-width: 2; border-radius: 8 } }
  table_box: { style: { fill: "#1E293B"; stroke: "#38bdf8"; stroke-width: 2 } }
  blue_box: { style: { fill: "#1e293b"; stroke: "#38bdf8"; stroke-width: 2; border-radius: 8 } }
  green_box: { style: { fill: "#0f291e"; stroke: "#4ade80"; stroke-width: 2; border-radius: 8 } }
  amber_box: { style: { fill: "#231e12"; stroke: "#fbbf24"; stroke-width: 2; border-radius: 8 } }
  purple_box: { style: { fill: "#1e1b2e"; stroke: "#c084fc"; stroke-width: 2; border-radius: 8 } }
  red_box: { style: { fill: "#2b1111"; stroke: "#f87171"; stroke-width: 2; border-radius: 8 } }
}

Timeline: "Historical Delta Log Timeline" {
  class: container
  style.stroke: "#38BDF8"
  Commits09: "0.json .. 9.json (Early commits)"
  Check10: "10.checkpoint.parquet (Consolidated Snapshot v10)"
  Commits1112: "11.json -> 12.json (Recent changes)"
  Head12: "Head Snapshot (Version 12)"

  Commits09 -> Check10 -> Commits1112 -> Head12
}

TimeTravel: "Time Travel Production Capabilities" {
  class: container
  style.stroke: "#C084FC"
  QueryVer: "VERSION AS OF 10 (Replays Checkpoint 10 directly)"
  QueryTime: "TIMESTAMP AS OF '2023-10-25' (Resolves historical timestamp)"
  Restore: "RESTORE TABLE TO VERSION AS OF 10 (Instant Zero-Copy Disaster Recovery)"
}

Timeline.Check10 -> TimeTravel.QueryVer: "Direct resolution" { style.stroke: "#34D399" }