direction: right
title: "Databricks Workflows Multi-Task DAG"
classes: {
  container: { style: { fill: "#111827"; stroke-width: 2; border-radius: 10 } }
  box: { style: { fill: "#1E293B"; stroke-width: 2; border-radius: 8 } }
  table_box: { style: { fill: "#1E293B"; stroke: "#38bdf8"; stroke-width: 2 } }
  blue_box: { style: { fill: "#1e293b"; stroke: "#38bdf8"; stroke-width: 2; border-radius: 8 } }
  green_box: { style: { fill: "#0f291e"; stroke: "#4ade80"; stroke-width: 2; border-radius: 8 } }
  amber_box: { style: { fill: "#231e12"; stroke: "#fbbf24"; stroke-width: 2; border-radius: 8 } }
  purple_box: { style: { fill: "#1e1b2e"; stroke: "#c084fc"; stroke-width: 2; border-radius: 8 } }
  red_box: { style: { fill: "#2b1111"; stroke: "#f87171"; stroke-width: 2; border-radius: 8 } }
}

Task1: "Task 1: Ingest Bronze (Notebook)" {
  class: container
  style.stroke: "#38BDF8"
}

Task2: "Task 2: Cleanse Silver (Python Script)" {
  class: container
  style.stroke: "#34D399"
}

Task3: "Task 3: Build Gold Sales (Serverless SQL)" {
  class: container
  style.stroke: "#FBBF24"
}

Task4: "Task 4: ML Feature Pipeline (Python Wheel)" {
  class: container
  style.stroke: "#C084FC"
}

Task5: "Task 5: Success Webhook Alert" {
  class: container
  style.stroke: "#34D399"
}

Task1 -> Task2: "depends_on" { style.stroke: "#38BDF8" }
Task2 -> Task3: "depends_on" { style.stroke: "#34D399" }
Task2 -> Task4: "depends_on" { style.stroke: "#34D399" }
Task3 -> Task5: "depends_on" { style.stroke: "#FBBF24" }
Task4 -> Task5: "depends_on" { style.stroke: "#C084FC" }