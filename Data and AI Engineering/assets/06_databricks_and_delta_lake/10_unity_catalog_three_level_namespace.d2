direction: right
title: "Unity Catalog 3-Level Namespace Architecture"
classes: {
  container: { style: { fill: "#111827"; stroke-width: 2; border-radius: 10 } }
  box: { style: { fill: "#1E293B"; stroke-width: 2; border-radius: 8 } }
  table_box: { style: { fill: "#1E293B"; stroke: "#38bdf8"; stroke-width: 2 } }
  blue_box: { style: { fill: "#1e293b"; stroke: "#38bdf8"; stroke-width: 2; border-radius: 8 } }
  green_box: { style: { fill: "#0f291e"; stroke: "#4ade80"; stroke-width: 2; border-radius: 8 } }
  amber_box: { style: { fill: "#231e12"; stroke: "#fbbf24"; stroke-width: 2; border-radius: 8 } }
  purple_box: { style: { fill: "#1e1b2e"; stroke: "#c084fc"; stroke-width: 2; border-radius: 8 } }
  red_box: { style: { fill: "#2b1111"; stroke: "#f87171"; stroke-width: 2; border-radius: 8 } }
}

Metastore: "Unity Catalog Metastore (Central Root)" {
  class: container
  style.stroke: "#38BDF8"
}

Catalogs: "Catalogs (1st Level)" {
  class: container
  style.stroke: "#8B5CF6"
  Dev: "dev_catalog (Sandbox)"
  Prod: "prod_catalog (Governed Production)"
}

Schemas: "Schemas / Databases (2nd Level)" {
  class: container
  style.stroke: "#FBBF24"
  Sales: "sales_schema"
  HR: "hr_schema"
}

Assets: "Securable Assets (3rd Level)" {
  class: container
  style.stroke: "#34D399"
  Table: "fact_orders (Managed Table)"
  Volume: "raw_landing (/Volumes/ Non-tabular files)"
  View: "vw_vip_customers (Column-Masked View)"
}

Metastore -> Catalogs.Dev
Metastore -> Catalogs.Prod
Catalogs.Prod -> Schemas.Sales
Catalogs.Prod -> Schemas.HR
Schemas.Sales -> Assets.Table
Schemas.Sales -> Assets.Volume
Schemas.Sales -> Assets.View