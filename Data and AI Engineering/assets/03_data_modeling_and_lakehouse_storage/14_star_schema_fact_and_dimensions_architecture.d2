direction: right
title: "Kimball Star Schema: Central Fact & Conformed Dimensions"
classes: {
  container: { style: { fill: "#111827"; stroke-width: 2; border-radius: 10 } }
  box: { style: { fill: "#1E293B"; stroke-width: 2; border-radius: 8 } }
  table_box: { style: { fill: "#1E293B"; stroke: "#38bdf8"; stroke-width: 2 } }
  blue_box: { style: { fill: "#1e293b"; stroke: "#38bdf8"; stroke-width: 2; border-radius: 8 } }
  green_box: { style: { fill: "#0f291e"; stroke: "#4ade80"; stroke-width: 2; border-radius: 8 } }
  amber_box: { style: { fill: "#231e12"; stroke: "#fbbf24"; stroke-width: 2; border-radius: 8 } }
  purple_box: { style: { fill: "#1e1b2e"; stroke: "#c084fc"; stroke-width: 2; border-radius: 8 } }
  red_box: { style: { fill: "#2b1111"; stroke: "#f87171"; stroke-width: 2; border-radius: 8 } }
}

fact_sales: "FACT_SALES" {
  class: table_box
  shape: sql_table
  sales_fact_id: "bigint [pk]"
  date_sk: "int [fk]"
  customer_sk: "int [fk]"
  product_sk: "int [fk]"
  store_sk: "int [fk]"
  promo_sk: "int [fk]"
  quantity_sold: "int"
  net_amount: "decimal"
}

dim_customer: "DIM_CUSTOMER" {
  class: table_box
  shape: sql_table
  customer_sk: "int [pk]"
  customer_name: "varchar"
}

dim_date: "DIM_DATE" {
  class: table_box
  shape: sql_table
  date_sk: "int [pk]"
  full_date: "date"
}

dim_product: "DIM_PRODUCT" {
  class: table_box
  shape: sql_table
  product_sk: "int [pk]"
  product_name: "varchar"
}

dim_store: "DIM_STORE" {
  class: table_box
  shape: sql_table
  store_sk: "int [pk]"
  store_name: "varchar"
}

dim_promotion: "DIM_PROMOTION" {
  class: table_box
  shape: sql_table
  promo_sk: "int [pk]"
  promo_name: "varchar"
}

dim_customer -> fact_sales: "filters (customer_sk)"
dim_date -> fact_sales: "filters (date_sk)"
dim_product -> fact_sales: "filters (product_sk)"
dim_store -> fact_sales: "filters (store_sk)"
dim_promotion -> fact_sales: "filters (promo_sk)"