direction: right
title: "Snowflake Schema: Normalized Dimension Hierarchies"
classes: {
  container: { style: { fill: "#111827"; stroke-width: 2; border-radius: 10 } }
  box: { style: { fill: "#1E293B"; stroke-width: 2; border-radius: 8 } }
  table_box: { style: { fill: "#1E293B"; stroke: "#38bdf8"; stroke-width: 2 } }
  blue_box: { style: { fill: "#1e293b"; stroke: "#38bdf8"; stroke-width: 2; border-radius: 8 } }
  green_box: { style: { fill: "#0f291e"; stroke: "#4ade80"; stroke-width: 2; border-radius: 8 } }
  amber_box: { style: { fill: "#231e12"; stroke: "#fbbf24"; stroke-width: 2; border-radius: 8 } }
  purple_box: { style: { fill: "#1e1b2e"; stroke: "#c084fc"; stroke-width: 2; border-radius: 8 } }
  red_box: { style: { fill: "#2b1111"; stroke: "#f87171"; stroke-width: 2; border-radius: 8 } }
}

fact_sales: "FACT_SALES" {
  class: table_box
  shape: sql_table
  sales_fact_id: "bigint [pk]"
  product_sk: "int [fk]"
  store_sk: "int [fk]"
}

dim_product: "DIM_PRODUCT" {
  class: table_box
  shape: sql_table
  product_sk: "int [pk]"
  subcategory_id: "int [fk]"
}

dim_subcategory: "DIM_SUBCATEGORY" {
  class: table_box
  shape: sql_table
  subcategory_id: "int [pk]"
  category_id: "int [fk]"
}

dim_category: "DIM_CATEGORY" {
  class: table_box
  shape: sql_table
  category_id: "int [pk]"
  category_name: "varchar"
}

dim_store: "DIM_STORE" {
  class: table_box
  shape: sql_table
  store_sk: "int [pk]"
  city_id: "int [fk]"
}

dim_city: "DIM_CITY" {
  class: table_box
  shape: sql_table
  city_id: "int [pk]"
  region_id: "int [fk]"
}

dim_region: "DIM_REGION" {
  class: table_box
  shape: sql_table
  region_id: "int [pk]"
  region_name: "varchar"
}

fact_sales -> dim_product: "FK: product_sk"
dim_product -> dim_subcategory: "FK: subcategory_id"
dim_subcategory -> dim_category: "FK: category_id"

fact_sales -> dim_store: "FK: store_sk"
dim_store -> dim_city: "FK: city_id"
dim_city -> dim_region: "FK: region_id"