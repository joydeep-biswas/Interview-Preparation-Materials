direction: right
title: "Accumulating Snapshot Fact Table: Order Milestone Pipeline"
classes: {
  container: { style: { fill: "#111827"; stroke-width: 2; border-radius: 10 } }
  box: { style: { fill: "#1E293B"; stroke-width: 2; border-radius: 8 } }
  table_box: { style: { fill: "#1E293B"; stroke: "#38bdf8"; stroke-width: 2 } }
  blue_box: { style: { fill: "#1e293b"; stroke: "#38bdf8"; stroke-width: 2; border-radius: 8 } }
  green_box: { style: { fill: "#0f291e"; stroke: "#4ade80"; stroke-width: 2; border-radius: 8 } }
  amber_box: { style: { fill: "#231e12"; stroke: "#fbbf24"; stroke-width: 2; border-radius: 8 } }
  purple_box: { style: { fill: "#1e1b2e"; stroke: "#c084fc"; stroke-width: 2; border-radius: 8 } }
  red_box: { style: { fill: "#2b1111"; stroke: "#f87171"; stroke-width: 2; border-radius: 8 } }
}

m1: "1. ORDER_PLACED" {
  class: container
  date: "order_date_sk: 20261025"
  status: "PLACED"
}

m2: "2. ORDER_ALLOCATED" {
  class: container
  date: "allocated_date_sk: 20261025"
  status: "ALLOCATED"
}

m3: "3. WAREHOUSE_PICKED" {
  class: container
  date: "picked_date_sk: 20261026"
  status: "PICKED"
}

m4: "4. DISPATCHED" {
  class: container
  date: "shipped_date_sk: 20261026"
  status: "SHIPPED"
}

m5: "5. DELIVERED" {
  class: container
  date: "delivery_date_sk: 20261028"
  status: "DELIVERED"
}

m1 -> m2: "Allocation lag"
m2 -> m3: "Picking lag"
m3 -> m4: "Transit lag"
m4 -> m5: "Final delivery lag"