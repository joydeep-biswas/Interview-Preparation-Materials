direction: right
title: "Kimball 4-Step Dimensional Design Process"
classes: {
  container: { style: { fill: "#111827"; stroke-width: 2; border-radius: 10 } }
  box: { style: { fill: "#1E293B"; stroke-width: 2; border-radius: 8 } }
  table_box: { style: { fill: "#1E293B"; stroke: "#38bdf8"; stroke-width: 2 } }
  blue_box: { style: { fill: "#1e293b"; stroke: "#38bdf8"; stroke-width: 2; border-radius: 8 } }
  green_box: { style: { fill: "#0f291e"; stroke: "#4ade80"; stroke-width: 2; border-radius: 8 } }
  amber_box: { style: { fill: "#231e12"; stroke: "#fbbf24"; stroke-width: 2; border-radius: 8 } }
  purple_box: { style: { fill: "#1e1b2e"; stroke: "#c084fc"; stroke-width: 2; border-radius: 8 } }
  red_box: { style: { fill: "#2b1111"; stroke: "#f87171"; stroke-width: 2; border-radius: 8 } }
}

s1: "Step 1: Select Business Process" {
  class: container
  activity: "Retail Sales, Claims Processing, ATM Withdrawals"
  objective: "Target enterprise activity"
}

s2: "Step 2: Declare the Grain" {
  class: container
  rule: "Always model at lowest atomic grain possible"
  example: "One individual line-item barcode scan"
  style.stroke: "#ef4444"
}

s3: "Step 3: Identify Dimensions" {
  class: container
  context: "Who, What, Where, When, Why, How"
  tables: "Date, Customer, Store, Promotion, Product"
}

s4: "Step 4: Identify Numeric Facts" {
  class: container
  metrics: "Quantity Sold, Extended Price, Discount, Tax"
  types: "Additive, Semi-Additive, Non-Additive"
}

s1 -> s2: "Define activity"
s2 -> s3: "Lock atomic grain"
s3 -> s4: "Surround with facts"