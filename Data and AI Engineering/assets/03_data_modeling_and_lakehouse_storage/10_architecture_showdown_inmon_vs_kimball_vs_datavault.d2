direction: down
title: "Enterprise Architecture Showdown: Inmon vs. Kimball vs. Data Vault 2.0"
classes: {
  container: { style: { fill: "#111827"; stroke-width: 2; border-radius: 10 } }
  box: { style: { fill: "#1E293B"; stroke-width: 2; border-radius: 8 } }
  table_box: { style: { fill: "#1E293B"; stroke: "#38bdf8"; stroke-width: 2 } }
  blue_box: { style: { fill: "#1e293b"; stroke: "#38bdf8"; stroke-width: 2; border-radius: 8 } }
  green_box: { style: { fill: "#0f291e"; stroke: "#4ade80"; stroke-width: 2; border-radius: 8 } }
  amber_box: { style: { fill: "#231e12"; stroke: "#fbbf24"; stroke-width: 2; border-radius: 8 } }
  purple_box: { style: { fill: "#1e1b2e"; stroke: "#c084fc"; stroke-width: 2; border-radius: 8 } }
  red_box: { style: { fill: "#2b1111"; stroke: "#f87171"; stroke-width: 2; border-radius: 8 } }
}

inmon: "1. Inmon (Corporate Information Factory)" {
  class: container
  src: "Operational Sources"
  edw: "Enterprise Data Warehouse (Strict 3NF)"
  marts: "Departmental Data Marts"
  src -> edw: "Heavy ETL"
  edw -> marts: "Downstream extract"
}

kimball: "2. Kimball (Dimensional Lifecycle)" {
  class: container
  src: "Operational Sources"
  bus: "Conformed Bus Matrix"
  stars: "Enterprise Star Schemas"
  src -> bus: "Conformed Dimensions"
  bus -> stars: "Atomic Fact Tables"
}

datavault: "3. Data Vault 2.0 (Agile Audit Core)" {
  class: container
  src: "Hash-Based Ingestion"
  raw_vault: "Raw Data Vault (Hubs, Links, Satellites)"
  biz_vault: "Business Vault & Information Marts"
  src -> raw_vault: "Insert-only load"
  raw_vault -> biz_vault: "PIT & Bridge Views"
}