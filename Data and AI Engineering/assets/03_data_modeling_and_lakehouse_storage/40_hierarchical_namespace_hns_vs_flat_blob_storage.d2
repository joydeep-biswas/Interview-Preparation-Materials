direction: right
title: "Hierarchical Namespace (HNS) vs. Flat Blob Storage"
classes: {
  container: { style: { fill: "#111827"; stroke-width: 2; border-radius: 10 } }
  box: { style: { fill: "#1E293B"; stroke-width: 2; border-radius: 8 } }
  table_box: { style: { fill: "#1E293B"; stroke: "#38bdf8"; stroke-width: 2 } }
  blue_box: { style: { fill: "#1e293b"; stroke: "#38bdf8"; stroke-width: 2; border-radius: 8 } }
  green_box: { style: { fill: "#0f291e"; stroke: "#4ade80"; stroke-width: 2; border-radius: 8 } }
  amber_box: { style: { fill: "#231e12"; stroke: "#fbbf24"; stroke-width: 2; border-radius: 8 } }
  purple_box: { style: { fill: "#1e1b2e"; stroke: "#c084fc"; stroke-width: 2; border-radius: 8 } }
  red_box: { style: { fill: "#2b1111"; stroke: "#f87171"; stroke-width: 2; border-radius: 8 } }
}

flat: "Flat Blob Storage (No HNS)" {
  class: container
  structure: "Directory is a virtual prefix: 'stage/orders/file1.parquet'"
  rename: "Rename '/stage/' to '/prod/': COPY all 100,000 files, then DELETE 100,000 originals"
  complexity: "O(N) Complexity: Takes 1 Hour!"
  structure -> rename -> complexity
}

hns: "ADLS Gen2 with Hierarchical Namespace (HNS)" {
  class: container
  structure: "Directory is a real metadata inode object"
  rename: "Rename '/stage/' to '/prod/': Atomic Metadata Pointer Update"
  complexity: "O(1) Complexity: Takes 15 Milliseconds!"
  structure -> rename -> complexity
}