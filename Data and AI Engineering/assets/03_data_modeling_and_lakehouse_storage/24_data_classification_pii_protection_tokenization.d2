direction: right
title: "Data Classification, PII Protection & Tokenization"
classes: {
  container: { style: { fill: "#111827"; stroke-width: 2; border-radius: 10 } }
  box: { style: { fill: "#1E293B"; stroke-width: 2; border-radius: 8 } }
  table_box: { style: { fill: "#1E293B"; stroke: "#38bdf8"; stroke-width: 2 } }
  blue_box: { style: { fill: "#1e293b"; stroke: "#38bdf8"; stroke-width: 2; border-radius: 8 } }
  green_box: { style: { fill: "#0f291e"; stroke: "#4ade80"; stroke-width: 2; border-radius: 8 } }
  amber_box: { style: { fill: "#231e12"; stroke: "#fbbf24"; stroke-width: 2; border-radius: 8 } }
  purple_box: { style: { fill: "#1e1b2e"; stroke: "#c084fc"; stroke-width: 2; border-radius: 8 } }
  red_box: { style: { fill: "#2b1111"; stroke: "#f87171"; stroke-width: 2; border-radius: 8 } }
}

raw: "Raw Input" {
  class: container
  ssn: "123-45-6789"
  email: "alice@corp.com"
  style.stroke: "#ef4444"
}

engine: "Cryptographic Tokenization & Masking Engine" {
  class: container
  hsm: "Hardware Security Module (KMS Salt)"
}

masked: "Masked View (For Analysts)" {
  class: container
  ssn: "***-**-6789"
  email: "a****@corp.com"
  style.stroke: "#10b981"
}

token: "Tokenized Join Key (For ETL Joins)" {
  class: container
  hash: "SHA256(email + secret_salt)"
  style.stroke: "#8b5cf6"
}

raw -> engine: "Secure ingest"
engine -> masked: "Dynamic Masking for Analysts"
engine -> token: "Deterministic Salted Hash for Joins"