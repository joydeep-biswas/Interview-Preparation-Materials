# Pandas vs Polars: Memory & Architectural Showdown
direction: right
classes: {
  engine_box: { style: { fill: "#111827"; stroke-width: 2; border-radius: 10 } }
}

pandas: "Pandas (Python / NumPy Foundation)\n• Memory Model: Array of PyObject* pointers in heap\n• Execution: Eager evaluation (immediate computation)\n• Parallelism: Single-threaded; GIL bounded\n• Copy Semantics: Defensive copies on write; 5x-10x RAM explosion\n• Vectorization: NumPy SIMD limited by pointer dereferences" {
  class: engine_box
  style.stroke: "#F59E0B"
}

polars: "Polars (Rust / Apache Arrow Native)\n• Memory Model: Contiguous off-heap columnar Arrow buffers\n• Execution: Lazy query engine (predicate & projection pushdown)\n• Parallelism: Multi-threaded multithread engine (Rayon work-stealing)\n• Copy Semantics: Zero-copy slicing & string view buffers\n• Vectorization: True CPU hardware AVX-512 SIMD execution" {
  class: engine_box
  style.stroke: "#10B981"
}

pandas -> polars: "10x-30x Faster & 5x Less Memory"