direction: right
title: "End-to-End Delivery Semantics: At-Most-Once, At-Least-Once, Exactly-Once"
classes: {
  container: { style: { fill: "#111827"; stroke-width: 2; border-radius: 10 } }
  box: { style: { fill: "#1E293B"; stroke-width: 2; border-radius: 8 } }
  table_box: { style: { fill: "#1E293B"; stroke: "#38bdf8"; stroke-width: 2 } }
  blue_box: { style: { fill: "#1e293b"; stroke: "#38bdf8"; stroke-width: 2; border-radius: 8 } }
  green_box: { style: { fill: "#0f291e"; stroke: "#4ade80"; stroke-width: 2; border-radius: 8 } }
  amber_box: { style: { fill: "#231e12"; stroke: "#fbbf24"; stroke-width: 2; border-radius: 8 } }
  purple_box: { style: { fill: "#1e1b2e"; stroke: "#c084fc"; stroke-width: 2; border-radius: 8 } }
  red_box: { style: { fill: "#2b1111"; stroke: "#f87171"; stroke-width: 2; border-radius: 8 } }
}

atmost: "At-Most-Once (Data Loss Possible)" {
  class: container
  style.fill: "#1a1116"
  style.stroke: "#ef4444"

  commit_first: "1. Commit Offset FIRST"
  crash1: "2. Crash during DB write!"
  loss: "3. Recovered worker skips messages (DATA LOST!)"

  commit_first -> crash1 -> loss
}

atleast: "At-Least-Once (Duplicates Possible)" {
  class: container
  style.fill: "#1a1c12"
  style.stroke: "#f59e0b"

  write_first: "1. Write to Sink FIRST"
  crash2: "2. Crash before offset commit!"
  dup: "3. Recovered worker replays (DUPLICATES!)"

  write_first -> crash2 -> dup
}

exactly: "Exactly-Once (EOS Gold Standard)" {
  class: container
  style.fill: "#0c1d1a"
  style.stroke: "#10b981"

  idem: "1. Idempotent Producer (PID + Seq)"
  tx: "2. Kafka Transactional Commits (2PC)"
  sink: "3. Idempotent Sink (Delta Lake MERGE)"

  idem -> tx -> sink
}