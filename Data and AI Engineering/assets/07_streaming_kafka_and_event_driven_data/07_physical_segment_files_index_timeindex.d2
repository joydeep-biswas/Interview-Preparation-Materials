direction: down
title: "Kafka Physical Storage Architecture: Partition Directory & Segment Files"
classes: {
  container: { style: { fill: "#111827"; stroke-width: 2; border-radius: 10 } }
  box: { style: { fill: "#1E293B"; stroke-width: 2; border-radius: 8 } }
  table_box: { style: { fill: "#1E293B"; stroke: "#38bdf8"; stroke-width: 2 } }
  blue_box: { style: { fill: "#1e293b"; stroke: "#38bdf8"; stroke-width: 2; border-radius: 8 } }
  green_box: { style: { fill: "#0f291e"; stroke: "#4ade80"; stroke-width: 2; border-radius: 8 } }
  amber_box: { style: { fill: "#231e12"; stroke: "#fbbf24"; stroke-width: 2; border-radius: 8 } }
  purple_box: { style: { fill: "#1e1b2e"; stroke: "#c084fc"; stroke-width: 2; border-radius: 8 } }
  red_box: { style: { fill: "#2b1111"; stroke: "#f87171"; stroke-width: 2; border-radius: 8 } }
}

part_dir: "Partition Directory: /var/lib/kafka/data/commerce.orders-0/" {
  class: container
  style.fill: "#0b1329"
  style.stroke: "#3b82f6"

  seg0: "Closed Segment Triad (Base Offset 0)" {
    class: box
    style.stroke: "#f59e0b"
    log: "00000000000000000000.log (Binary records)"
    idx: "00000000000000000000.index (Sparse mmap offset -> byte)"
    tidx: "00000000000000000000.timeindex (Timestamp -> offset)"
  }

  active: "Active Writable Segment (Base Offset 10485760)" {
    class: box
    style.stroke: "#38bdf8"
    active_log: "00000000000104857600.log"
  }

  epoch: "leader-epoch-checkpoint (Replication lineage)" {
    class: box
    style.stroke: "#10b981"
  }
}

lookup: "Lookup Path: 1. Find segment -> 2. Binary search .index -> 3. Zero-copy scan" {
  style.fill: "#064e3b"
  style.stroke: "#10b981"
}

part_dir -> lookup