direction: down
title: "Producer ACKs & Replication Durability Matrix"
classes: {
  container: { style: { fill: "#111827"; stroke-width: 2; border-radius: 10 } }
  box: { style: { fill: "#1E293B"; stroke-width: 2; border-radius: 8 } }
  table_box: { style: { fill: "#1E293B"; stroke: "#38bdf8"; stroke-width: 2 } }
  blue_box: { style: { fill: "#1e293b"; stroke: "#38bdf8"; stroke-width: 2; border-radius: 8 } }
  green_box: { style: { fill: "#0f291e"; stroke: "#4ade80"; stroke-width: 2; border-radius: 8 } }
  amber_box: { style: { fill: "#231e12"; stroke: "#fbbf24"; stroke-width: 2; border-radius: 8 } }
  purple_box: { style: { fill: "#1e1b2e"; stroke: "#c084fc"; stroke-width: 2; border-radius: 8 } }
  red_box: { style: { fill: "#2b1111"; stroke: "#f87171"; stroke-width: 2; border-radius: 8 } }
}

case0: "Case 1: acks=0 (Fire & Forget)" {
  class: container
  style.fill: "#1a1116"
  style.stroke: "#ef4444"

  p0: "Producer (0ms wait)"
  l0: "Leader (Does NOT wait for write)"
  risk0: "Extreme data loss risk on broker crash"

  p0 -> l0: "send()"
}

case1: "Case 2: acks=1 (Leader Local Write)" {
  class: container
  style.fill: "#1a1c12"
  style.stroke: "#f59e0b"

  p1: "Producer (Waits for Leader)"
  l1: "Leader (Appends to local PageCache)"
  risk1: "Data lost if Leader dies before ISR fetch"

  p1 -> l1: "send()"
  l1 -> p1: "ACK"
}

caseall: "Case 3: acks=all with min.insync.replicas=2" {
  class: container
  style.fill: "#0c1d1a"
  style.stroke: "#10b981"

  pall: "Producer (Waits for Quorum)"
  lall: "Leader + ISR Followers"
  safe: "ZERO DATA LOSS GUARANTEE"

  pall -> lall: "send()"
  lall -> pall: "Quorum ACK"
}