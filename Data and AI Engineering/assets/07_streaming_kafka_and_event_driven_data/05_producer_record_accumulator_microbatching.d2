direction: right
title: "Kafka Producer Architecture: RecordAccumulator & Micro-Batching"
classes: {
  container: { style: { fill: "#111827"; stroke-width: 2; border-radius: 10 } }
  box: { style: { fill: "#1E293B"; stroke-width: 2; border-radius: 8 } }
  table_box: { style: { fill: "#1E293B"; stroke: "#38bdf8"; stroke-width: 2 } }
  blue_box: { style: { fill: "#1e293b"; stroke: "#38bdf8"; stroke-width: 2; border-radius: 8 } }
  green_box: { style: { fill: "#0f291e"; stroke: "#4ade80"; stroke-width: 2; border-radius: 8 } }
  amber_box: { style: { fill: "#231e12"; stroke: "#fbbf24"; stroke-width: 2; border-radius: 8 } }
  purple_box: { style: { fill: "#1e1b2e"; stroke: "#c084fc"; stroke-width: 2; border-radius: 8 } }
  red_box: { style: { fill: "#2b1111"; stroke: "#f87171"; stroke-width: 2; border-radius: 8 } }
}

app: "Application Thread" {
  class: container
  style.fill: "#0b1329"
  style.stroke: "#3b82f6"

  send: "producer.send(record)"
  hash: "Murmur2(key) Partitioner"
  async: "Returns Future immediately\n(Non-blocking)"
}

acc: "RecordAccumulator (RAM Buffer Pool)" {
  class: container
  style.fill: "#16122b"
  style.stroke: "#8b5cf6"

  b0: "Batch P0 (Accumulating 8KB)"
  b1: "Batch P1 (16KB Full -> READY TO FLUSH)"
  b2: "Batch P2 (linger.ms expired -> FLUSH)"
}

sender: "Background Sender Thread" {
  class: container
  style.fill: "#0c1d1a"
  style.stroke: "#10b981"

  drain: "Batch Drainer (Groups by Broker)"
  nio: "Java NIO SocketChannel"
}

broker: "Kafka Broker Leader" {
  class: container
  style.fill: "#0b1329"
  style.stroke: "#38bdf8"

  socket: "TCP Port 9092 Socket"
  pagecache: "OS Page Cache Append"
}

app.send -> app.hash -> acc
acc.b1 -> sender.drain: "Flush Batch"
acc.b2 -> sender.drain: "Flush Batch"
sender.drain -> sender.nio -> broker.socket -> broker.pagecache