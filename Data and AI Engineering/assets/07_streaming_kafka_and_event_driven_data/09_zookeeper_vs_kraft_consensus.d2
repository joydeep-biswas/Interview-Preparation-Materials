direction: right
title: "Kafka Metadata Architecture: Legacy ZooKeeper vs. Modern KRaft"
classes: {
  container: { style: { fill: "#111827"; stroke-width: 2; border-radius: 10 } }
  box: { style: { fill: "#1E293B"; stroke-width: 2; border-radius: 8 } }
  table_box: { style: { fill: "#1E293B"; stroke: "#38bdf8"; stroke-width: 2 } }
  blue_box: { style: { fill: "#1e293b"; stroke: "#38bdf8"; stroke-width: 2; border-radius: 8 } }
  green_box: { style: { fill: "#0f291e"; stroke: "#4ade80"; stroke-width: 2; border-radius: 8 } }
  amber_box: { style: { fill: "#231e12"; stroke: "#fbbf24"; stroke-width: 2; border-radius: 8 } }
  purple_box: { style: { fill: "#1e1b2e"; stroke: "#c084fc"; stroke-width: 2; border-radius: 8 } }
  red_box: { style: { fill: "#2b1111"; stroke: "#f87171"; stroke-width: 2; border-radius: 8 } }
}

zk: "Legacy ZooKeeper Architecture" {
  class: container
  style.fill: "#1a1116"
  style.stroke: "#ef4444"

  ensemble: "External ZooKeeper Ensemble (3-5 nodes)\n(ZAB consensus, watch trees)"
  ctrl_zk: "Active Controller Broker\n(Full tree reload on failover)"
  brokers_zk: "Data Brokers (Broker 1, 2, 3)"

  ensemble -> ctrl_zk: "Watch updates"
  ctrl_zk -> brokers_zk: "Heavy RPCs"
}

kraft: "Modern KRaft Architecture (KIP-500)" {
  class: container
  style.fill: "#0c1d1a"
  style.stroke: "#10b981"

  quorum: "KRaft Controller Quorum\n(Raft Leader & Followers)"
  metalist: "@metadata Replicated Topic\n(Immutable event log)"
  brokers_k: "Data Brokers (Broker 1, 2, 3)\n(Local in-memory metadata replica)"

  quorum -> metalist: "Commit metadata"
  metalist -> brokers_k: "Event streaming"
}