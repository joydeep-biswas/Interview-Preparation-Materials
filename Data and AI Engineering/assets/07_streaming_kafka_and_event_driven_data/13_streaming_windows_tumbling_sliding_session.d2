direction: down
title: "Streaming Windowing Strategies: Tumbling, Sliding, and Session Windows"
classes: {
  container: { style: { fill: "#111827"; stroke-width: 2; border-radius: 10 } }
  box: { style: { fill: "#1E293B"; stroke-width: 2; border-radius: 8 } }
  table_box: { style: { fill: "#1E293B"; stroke: "#38bdf8"; stroke-width: 2 } }
  blue_box: { style: { fill: "#1e293b"; stroke: "#38bdf8"; stroke-width: 2; border-radius: 8 } }
  green_box: { style: { fill: "#0f291e"; stroke: "#4ade80"; stroke-width: 2; border-radius: 8 } }
  amber_box: { style: { fill: "#231e12"; stroke: "#fbbf24"; stroke-width: 2; border-radius: 8 } }
  purple_box: { style: { fill: "#1e1b2e"; stroke: "#c084fc"; stroke-width: 2; border-radius: 8 } }
  red_box: { style: { fill: "#2b1111"; stroke: "#f87171"; stroke-width: 2; border-radius: 8 } }
}

tumble: "1. Tumbling Window (Fixed-Size; Non-Overlapping: 10m)" {
  class: container
  style.fill: "#0b1329"
  style.stroke: "#3b82f6"

  w1: "10:00 - 10:10 (3 events)"
  w2: "10:10 - 10:20 (2 events)"
  w3: "10:20 - 10:30 (4 events)"
  w1 -> w2 -> w3: "Zero Overlap"
}

slide: "2. Sliding Window (10m Window, 5m Slide Step)" {
  class: container
  style.fill: "#0c1d1a"
  style.stroke: "#10b981"

  s1: "10:00 - 10:10"
  s2: "10:05 - 10:15 (5m overlap with s1 & s3)"
  s3: "10:10 - 10:20"
  s1 -> s2 -> s3: "Moving Averages"
}

sess: "3. Session Window (Dynamic Inactivity Gap: 15m)" {
  class: container
  style.fill: "#1a1c12"
  style.stroke: "#f59e0b"

  act1: "Session 1: Active clicks (<15m gap)"
  gap: "15-Min Idle Gap (Closes Session 1)" {
    class: box
    style.stroke: "#ef4444"
  }
  act2: "Session 2: New Session at 10:45"

  act1 -> gap -> act2
}