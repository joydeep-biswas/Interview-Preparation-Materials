direction: down
title: "Kafka Log Compaction & Tombstone Deletion Mechanics"
classes: {
  container: { style: { fill: "#111827"; stroke-width: 2; border-radius: 10 } }
  box: { style: { fill: "#1E293B"; stroke-width: 2; border-radius: 8 } }
  table_box: { style: { fill: "#1E293B"; stroke: "#38bdf8"; stroke-width: 2 } }
  blue_box: { style: { fill: "#1e293b"; stroke: "#38bdf8"; stroke-width: 2; border-radius: 8 } }
  green_box: { style: { fill: "#0f291e"; stroke: "#4ade80"; stroke-width: 2; border-radius: 8 } }
  amber_box: { style: { fill: "#231e12"; stroke: "#fbbf24"; stroke-width: 2; border-radius: 8 } }
  purple_box: { style: { fill: "#1e1b2e"; stroke: "#c084fc"; stroke-width: 2; border-radius: 8 } }
  red_box: { style: { fill: "#2b1111"; stroke: "#f87171"; stroke-width: 2; border-radius: 8 } }
}

dirty: "1. Uncompacted Log Segment (Before Cleaner)" {
  class: container
  style.fill: "#1a1116"
  style.stroke: "#ef4444"

  o0: "Off 0: K1='Alice' (Old)"
  o1: "Off 1: K2='Bob' (Old)"
  o2: "Off 2: K1='Alice Smith' (LATEST)"
  o3: "Off 3: K3='David' (Active)"
  o4: "Off 4: K2=NULL (Tombstone)"
}

cleaner: "Log Cleaner Process (SkimpyOffsetMap)" {
  class: container
  style.fill: "#1e293b"
  style.stroke: "#38bdf8"
}

clean: "2. Compacted Log Segment (After Cleaner)" {
  class: container
  style.fill: "#0c1d1a"
  style.stroke: "#10b981"

  c2: "Off 2: K1='Alice Smith' (Retained latest)"
  c3: "Off 3: K3='David' (Retained active)"
  c4: "Off 4: K2=NULL (Tombstone held for delete.retention.ms)"
}

dirty -> cleaner: "Scan & deduplicate"
cleaner -> clean: "Write compacted segment"