direction: down
title: "Kafka Consumer Groups & Partition Assignment Dynamics"
classes: {
  container: { style: { fill: "#111827"; stroke-width: 2; border-radius: 10 } }
  box: { style: { fill: "#1E293B"; stroke-width: 2; border-radius: 8 } }
  table_box: { style: { fill: "#1E293B"; stroke: "#38bdf8"; stroke-width: 2 } }
  blue_box: { style: { fill: "#1e293b"; stroke: "#38bdf8"; stroke-width: 2; border-radius: 8 } }
  green_box: { style: { fill: "#0f291e"; stroke: "#4ade80"; stroke-width: 2; border-radius: 8 } }
  amber_box: { style: { fill: "#231e12"; stroke: "#fbbf24"; stroke-width: 2; border-radius: 8 } }
  purple_box: { style: { fill: "#1e1b2e"; stroke: "#c084fc"; stroke-width: 2; border-radius: 8 } }
  red_box: { style: { fill: "#2b1111"; stroke: "#f87171"; stroke-width: 2; border-radius: 8 } }
}

topic: "Topic: commerce.orders (4 Partitions)" {
  class: container
  style.fill: "#0b1329"
  style.stroke: "#3b82f6"

  p0: "Partition 0"
  p1: "Partition 1"
  p2: "Partition 2"
  p3: "Partition 3"
}

group: "Consumer Group: order-processing-group" {
  class: container
  style.fill: "#16122b"
  style.stroke: "#8b5cf6"

  c1: "Consumer 1 (Assigned P0)"
  c2: "Consumer 2 (Assigned P1)"
  c3: "Consumer 3 (Assigned P2)"
  c4: "Consumer 4 (Assigned P3)"
  c5: "Consumer 5 (STARVED / IDLE - 0 Partitions)" {
    class: box
    style.stroke: "#ef4444"
  }
}

topic.p0 -> group.c1
topic.p1 -> group.c2
topic.p2 -> group.c3
topic.p3 -> group.c4