direction: right
classes: {
  route: { style: { fill: "#1e293b"; stroke: "#38bdf8"; font-color: "#f8fafc" } }
  auth: { style: { fill: "#581c87"; stroke: "#c084fc"; font-color: "#e9d5ff" } }
  db: { style: { fill: "#064e3b"; stroke: "#34d399"; font-color: "#a7f3d0" } }
  perm: { style: { fill: "#451a03"; stroke: "#fbbf24"; font-color: "#fde68a" } }
  cfg: { style: { fill: "#1e293b"; stroke: "#64748b"; font-color: "#94a3b8" } }
}

route: "GET /orders/{id}" { class: route }
auth_dep: "get_current_active_user\n(Validates JWT)" { class: auth }
db_dep: "get_async_db_session\n(Connection Pool)" { class: db }
perm_dep: "verify_tenant_access\n(Checks Tenant ID)" { class: perm }
cfg_dep: "get_app_settings\n(Singleton Config)" { class: cfg }

route -> auth_dep
route -> db_dep
auth_dep -> cfg_dep
auth_dep -> perm_dep
perm_dep -> db_dep: "Reuses cached session!"