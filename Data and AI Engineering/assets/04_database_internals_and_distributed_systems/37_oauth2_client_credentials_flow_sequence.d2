direction: right
title: "OAuth 2.0 Client Credentials Grant for M2M Pipelines"
classes: {
  container: { style: { fill: "#111827"; stroke-width: 2; border-radius: 10 } }
  box: { style: { fill: "#1E293B"; stroke-width: 2; border-radius: 8 } }
  table_box: { style: { fill: "#1E293B"; stroke: "#38bdf8"; stroke-width: 2 } }
  blue_box: { style: { fill: "#1e293b"; stroke: "#38bdf8"; stroke-width: 2; border-radius: 8 } }
  green_box: { style: { fill: "#0f291e"; stroke: "#4ade80"; stroke-width: 2; border-radius: 8 } }
  amber_box: { style: { fill: "#231e12"; stroke: "#fbbf24"; stroke-width: 2; border-radius: 8 } }
  purple_box: { style: { fill: "#1e1b2e"; stroke: "#c084fc"; stroke-width: 2; border-radius: 8 } }
  red_box: { style: { fill: "#2b1111"; stroke: "#f87171"; stroke-width: 2; border-radius: 8 } }
}

pipeline: "Data Ingestion Worker" {
  class: container
  creds: "client_id, client_secret stored in KMS"
}

auth: "OAuth 2.0 Auth Server (Okta / Azure AD)" {
  class: container
  token: "Generates signed JWT Access Token (expires in 3600s)"
}

saas: "Protected SaaS API (Salesforce / Stripe)" {
  class: container
  validator: "Verifies JWT RSA signature locally via public key"
}

pipeline -> auth: "1. POST /oauth/v2/token (client_credentials)"
auth -> pipeline: "2. 200 OK {access_token: 'eyJ...'; expires_in: 3600}"
pipeline -> saas: "3. Loop GET /v1/customers (Header: Bearer <token>)"
saas -> pipeline: "4. Return customer records"