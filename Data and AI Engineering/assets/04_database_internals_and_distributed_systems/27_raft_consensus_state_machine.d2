direction: right
title: "Raft Distributed Consensus State Machine"
classes: {
  container: { style: { fill: "#111827"; stroke-width: 2; border-radius: 10 } }
  box: { style: { fill: "#1E293B"; stroke-width: 2; border-radius: 8 } }
  table_box: { style: { fill: "#1E293B"; stroke: "#38bdf8"; stroke-width: 2 } }
  blue_box: { style: { fill: "#1e293b"; stroke: "#38bdf8"; stroke-width: 2; border-radius: 8 } }
  green_box: { style: { fill: "#0f291e"; stroke: "#4ade80"; stroke-width: 2; border-radius: 8 } }
  amber_box: { style: { fill: "#231e12"; stroke: "#fbbf24"; stroke-width: 2; border-radius: 8 } }
  purple_box: { style: { fill: "#1e1b2e"; stroke: "#c084fc"; stroke-width: 2; border-radius: 8 } }
  red_box: { style: { fill: "#2b1111"; stroke: "#f87171"; stroke-width: 2; border-radius: 8 } }
}

follower: Follower {
  class: container
  status: "Passive node responding to RPCs"
  style.stroke: "#3b82f6"
}

candidate: Candidate {
  class: container
  status: "Campaigning for election in Term T"
  style.stroke: "#f59e0b"
}

leader: Leader {
  class: container
  status: "Active coordinator managing replicated log"
  style.stroke: "#10b981"
}

follower -> candidate: "Election timeout fires (150-300ms)"
candidate -> leader: "Receives majority votes (> N/2)"
candidate -> follower: "Discovers higher term or valid leader"
candidate -> candidate: "Split vote: Increment term & retry"
leader -> follower: "Discovers higher term -> Steps down"