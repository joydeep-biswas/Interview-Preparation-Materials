direction: right
title: "Write-Ahead Logging (WAL) & ACID Durability Sequence"
classes: {
  container: { style: { fill: "#111827"; stroke-width: 2; border-radius: 10 } }
  box: { style: { fill: "#1E293B"; stroke-width: 2; border-radius: 8 } }
  table_box: { style: { fill: "#1E293B"; stroke: "#38bdf8"; stroke-width: 2 } }
  blue_box: { style: { fill: "#1e293b"; stroke: "#38bdf8"; stroke-width: 2; border-radius: 8 } }
  green_box: { style: { fill: "#0f291e"; stroke: "#4ade80"; stroke-width: 2; border-radius: 8 } }
  amber_box: { style: { fill: "#231e12"; stroke: "#fbbf24"; stroke-width: 2; border-radius: 8 } }
  purple_box: { style: { fill: "#1e1b2e"; stroke: "#c084fc"; stroke-width: 2; border-radius: 8 } }
  red_box: { style: { fill: "#2b1111"; stroke: "#f87171"; stroke-width: 2; border-radius: 8 } }
}

client: "Client Application"
bp: "Buffer Pool (RAM)" {
  class: container
  dirty: "Page modified in RAM (PageLSN = 5024)"
}
wal_buf: "WAL Ring Buffer (RAM)" {
  class: container
  record: "Redo record appended with LSN 5024"
}
wal_disk: "WAL Disk Files (NVMe)" {
  class: container
  durable: "Synchronous fsync() guarantees durability"
}
table_disk: "Data Files (Table Heap Disk)"

client -> bp: "1. UPDATE accounts SET balance = balance - 100"
bp -> wal_buf: "2. Write Redo Record (LSN: 5024)"
client -> bp: "3. COMMIT Transaction"
bp -> wal_buf: "Flush WAL Buffer"
wal_buf -> wal_disk: "4. fsync() to Disk"
wal_disk -> client: "5. COMMIT Acknowledged (Durability Guaranteed)"
bp -> table_disk: "Async Lazy Checkpointer Flush" {
  style.stroke-dash: 4
}