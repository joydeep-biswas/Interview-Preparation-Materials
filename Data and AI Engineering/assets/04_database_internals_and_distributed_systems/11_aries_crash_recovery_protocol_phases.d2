direction: right
title: "The Three Phases of ARIES Crash Recovery"
classes: {
  container: { style: { fill: "#111827"; stroke-width: 2; border-radius: 10 } }
  box: { style: { fill: "#1E293B"; stroke-width: 2; border-radius: 8 } }
  table_box: { style: { fill: "#1E293B"; stroke: "#38bdf8"; stroke-width: 2 } }
  blue_box: { style: { fill: "#1e293b"; stroke: "#38bdf8"; stroke-width: 2; border-radius: 8 } }
  green_box: { style: { fill: "#0f291e"; stroke: "#4ade80"; stroke-width: 2; border-radius: 8 } }
  amber_box: { style: { fill: "#231e12"; stroke: "#fbbf24"; stroke-width: 2; border-radius: 8 } }
  purple_box: { style: { fill: "#1e1b2e"; stroke: "#c084fc"; stroke-width: 2; border-radius: 8 } }
  red_box: { style: { fill: "#2b1111"; stroke: "#f87171"; stroke-width: 2; border-radius: 8 } }
}

p1: "Phase 1: Analysis" {
  class: container
  action: "Scan WAL forward from latest checkpoint"
  reconstruct: "Reconstruct Dirty Page Table (DPT) & Transaction Table"
  identify: "Identify all active 'loser' transactions"
}

p2: "Phase 2: Redo ('Repeat History')" {
  class: container
  action: "Scan forward from smallest RecLSN in DPT"
  replay: "Replay all changes (committed & uncommitted)"
  state: "Restores exact millisecond state of crash"
}

p3: "Phase 3: Undo" {
  class: container
  action: "Scan WAL backward from end of log"
  rollback: "Roll back changes made by loser transactions"
  clrs: "Write Compensation Log Records (CLRs) for idempotency"
}

p1 -> p2: "State reconstructed"
p2 -> p3: "History repeated"