direction: right
title: "Mutual TLS (mTLS) for Zero Trust Pipeline Ingress"
classes: {
  container: { style: { fill: "#111827"; stroke-width: 2; border-radius: 10 } }
  box: { style: { fill: "#1E293B"; stroke-width: 2; border-radius: 8 } }
  table_box: { style: { fill: "#1E293B"; stroke: "#38bdf8"; stroke-width: 2 } }
  blue_box: { style: { fill: "#1e293b"; stroke: "#38bdf8"; stroke-width: 2; border-radius: 8 } }
  green_box: { style: { fill: "#0f291e"; stroke: "#4ade80"; stroke-width: 2; border-radius: 8 } }
  amber_box: { style: { fill: "#231e12"; stroke: "#fbbf24"; stroke-width: 2; border-radius: 8 } }
  purple_box: { style: { fill: "#1e1b2e"; stroke: "#c084fc"; stroke-width: 2; border-radius: 8 } }
  red_box: { style: { fill: "#2b1111"; stroke: "#f87171"; stroke-width: 2; border-radius: 8 } }
}

client: "Data Pipeline Worker"
ca: "Corporate Root CA (Trust Anchor)"
server: "Enterprise Ingress Gateway (Envoy)"

client -> server: "1. ClientHello (TLS 1.3 Ciphers)"
server -> client: "2. ServerHello + Server X.509 Certificate"
client -> ca: "3. Verify Server Certificate against CA"
server -> client: "4. CertificateRequest (Demands Client Identity)"
client -> server: "5. Client X.509 Certificate + Digital Signature"
server -> ca: "6. Verify Client Certificate against CA"
client <-> server: "Mutual Cryptographic Trust Established (AES-GCM Tunnel)"