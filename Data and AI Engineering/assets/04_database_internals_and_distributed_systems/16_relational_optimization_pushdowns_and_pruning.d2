direction: right
title: "Relational Optimization Primitives: Pushdowns & Partition Pruning"
classes: {
  container: { style: { fill: "#111827"; stroke-width: 2; border-radius: 10 } }
  box: { style: { fill: "#1E293B"; stroke-width: 2; border-radius: 8 } }
  table_box: { style: { fill: "#1E293B"; stroke: "#38bdf8"; stroke-width: 2 } }
  blue_box: { style: { fill: "#1e293b"; stroke: "#38bdf8"; stroke-width: 2; border-radius: 8 } }
  green_box: { style: { fill: "#0f291e"; stroke: "#4ade80"; stroke-width: 2; border-radius: 8 } }
  amber_box: { style: { fill: "#231e12"; stroke: "#fbbf24"; stroke-width: 2; border-radius: 8 } }
  purple_box: { style: { fill: "#1e1b2e"; stroke: "#c084fc"; stroke-width: 2; border-radius: 8 } }
  red_box: { style: { fill: "#2b1111"; stroke: "#f87171"; stroke-width: 2; border-radius: 8 } }
}

unoptimized: "1. Unoptimized Relational Algebra Tree" {
  class: container
  proj: "Project (name, SUM(amount))"
  filter: "Filter (date >= 2026-01-01 AND country = 'US')"
  join: "Join (customer_id = id)"
  scan_orders: "Scan (orders: all columns, all partitions)"
  scan_cust: "Scan (customers: all columns)"
  proj -> filter -> join
  join -> scan_orders
  join -> scan_cust
}

optimized: "2. CBO Optimized Plan (Pushed Down to Physical Storage)" {
  class: container
  o_proj: "Project (name, SUM(amount))"
  o_join: "Hash Join (customer_id = id)"
  o_scan_orders: "Scan orders (Partition Pruning + Projection + Predicate)"
  o_scan_cust: "Scan customers (WHERE country = 'US' + Index Scan)"
  o_proj -> o_join
  o_join -> o_scan_orders
  o_join -> o_scan_cust
}

unoptimized -> optimized: "CBO Transformation"