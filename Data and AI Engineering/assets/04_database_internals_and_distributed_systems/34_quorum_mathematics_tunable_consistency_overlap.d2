direction: right
title: "Quorum Mathematics & Tunable Consistency (W + R > N)"
classes: {
  container: { style: { fill: "#111827"; stroke-width: 2; border-radius: 10 } }
  box: { style: { fill: "#1E293B"; stroke-width: 2; border-radius: 8 } }
  table_box: { style: { fill: "#1E293B"; stroke: "#38bdf8"; stroke-width: 2 } }
  blue_box: { style: { fill: "#1e293b"; stroke: "#38bdf8"; stroke-width: 2; border-radius: 8 } }
  green_box: { style: { fill: "#0f291e"; stroke: "#4ade80"; stroke-width: 2; border-radius: 8 } }
  amber_box: { style: { fill: "#231e12"; stroke: "#fbbf24"; stroke-width: 2; border-radius: 8 } }
  purple_box: { style: { fill: "#1e1b2e"; stroke: "#c084fc"; stroke-width: 2; border-radius: 8 } }
  red_box: { style: { fill: "#2b1111"; stroke: "#f87171"; stroke-width: 2; border-radius: 8 } }
}

write_req: "Client Write (W = 2)"
read_req: "Client Read (R = 2)"

replicas: "3 Replicas (N = 3)" {
  class: container
  n1: "Node 1 (Write Ack: v2)" {
    class: box
    style.stroke: "#10b981"
  }
  n2: "Node 2 (Guaranteed Overlap Node: v2)" {
    class: box
    style.stroke: "#f59e0b"
  }
  n3: "Node 3 (Lagging Stale: v1)" {
    class: box
    style.stroke: "#ef4444"
  }
}

client_resolution: "Strong Consistency Resolution" {
  class: container
  result: "Client inspects v2 and v1 -> Selects v2 (Latest Timestamp)"
  repair: "Read Repair updates Node 3 to v2"
}

write_req -> replicas.n1: "Write Ack"
write_req -> replicas.n2: "Write Ack"
read_req -> replicas.n2: "Read Probe"
read_req -> replicas.n3: "Read Probe"
replicas.n2 -> client_resolution: "Guaranteed Overlap"