direction: down
title: "CAP Theorem: Architectural Trade-Offs (CP vs. AP)"
classes: {
  container: { style: { fill: "#111827"; stroke-width: 2; border-radius: 10 } }
  box: { style: { fill: "#1E293B"; stroke-width: 2; border-radius: 8 } }
  table_box: { style: { fill: "#1E293B"; stroke: "#38bdf8"; stroke-width: 2 } }
  blue_box: { style: { fill: "#1e293b"; stroke: "#38bdf8"; stroke-width: 2; border-radius: 8 } }
  green_box: { style: { fill: "#0f291e"; stroke: "#4ade80"; stroke-width: 2; border-radius: 8 } }
  amber_box: { style: { fill: "#231e12"; stroke: "#fbbf24"; stroke-width: 2; border-radius: 8 } }
  purple_box: { style: { fill: "#1e1b2e"; stroke: "#c084fc"; stroke-width: 2; border-radius: 8 } }
  red_box: { style: { fill: "#2b1111"; stroke: "#f87171"; stroke-width: 2; border-radius: 8 } }
}

p: "Partition Tolerance (P)" {
  class: container
  note: "MANDATORY: Physical networks WILL experience latency and partitions"
  style.stroke: "#8b5cf6"
}

cp: "CP Systems (Consistency > Availability)" {
  class: container
  examples: "Google Spanner, HBase, Bigtable, ZooKeeper, etcd"
  behavior: "Blocks writes or returns HTTP 503 on minority split; guarantees zero stale reads"
  style.stroke: "#3b82f6"
}

ap: "AP Systems (Availability > Consistency)" {
  class: container
  examples: "Apache Cassandra, Amazon DynamoDB, CouchDB"
  behavior: "Accepts reads and writes on both sides; returns eventual data; reconciles conflicts later"
  style.stroke: "#10b981"
}

p -> cp: "Trade Availability for Correctness"
p -> ap: "Trade Consistency for 100% Uptime"