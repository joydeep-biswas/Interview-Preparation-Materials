direction: right
classes: {
  fp: { style: { fill: "#7f1d1d"; stroke: "#f87171"; font-color: "#fecaca" } }
  batch: { style: { fill: "#451a03"; stroke: "#fbbf24"; font-color: "#fde68a" } }
  moe: { style: { fill: "#581c87"; stroke: "#c084fc"; font-color: "#e9d5ff" } }
}

c1: "1. Floating-Point Non-Associativity\n(A+B)+C != A+(B+C)\nAtomic warp sum order varies" { class: fp }
c2: "2. Continuous Batching Dynamic Tiling\nKernel reduction trees change per tick" { class: batch }
c3: "3. MoE Token Dropping\nExpert buffer overflow alters output" { class: moe }

jitter: "Logit Jitter (+-1e-6) -> Flips Argmax Decision Boundaries!" { style: { fill: "#7f1d1d"; stroke: "#f87171"; font-color: "#fecaca" } }

c1 -> jitter
c2 -> jitter
c3 -> jitter