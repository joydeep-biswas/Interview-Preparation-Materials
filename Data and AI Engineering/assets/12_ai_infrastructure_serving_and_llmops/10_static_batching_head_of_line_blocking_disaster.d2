direction: down
classes: {
  req: { style: { fill: "#7f1d1d"; stroke: "#f87171"; font-color: "#fecaca" } }
  slow: { style: { fill: "#451a03"; stroke: "#fbbf24"; font-color: "#fde68a" } }
}

batch: "Static Request Batch (Padded Tensor)" {
  r1: "Req 1: 'What is 2+2?' (5 tokens)\n[Blocked 14.9s by padding]" { class: req }
  r2: "Req 2: 'Write novel' (500 tokens)\n[Takes 15.0 seconds]" { class: slow }
  r3: "Req 3: 'Hello' (2 tokens)\n[Blocked 14.95s by padding]" { class: req }
}

disaster: "Head-of-Line Blocking:\nRequests 1 & 3 finished in 0.1s but cannot return until Req 2 completes!" { style: { fill: "#7f1d1d"; stroke: "#f87171"; font-color: "#fecaca" } }

batch -> disaster