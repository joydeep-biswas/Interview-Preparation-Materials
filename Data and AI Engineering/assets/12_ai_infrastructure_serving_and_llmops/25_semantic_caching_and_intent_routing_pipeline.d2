direction: right
classes: {
  q: { style: { fill: "#1e293b"; stroke: "#38bdf8"; font-color: "#f8fafc" } }
  cache: { style: { fill: "#064e3b"; stroke: "#34d399"; font-color: "#a7f3d0" } }
  router: { style: { fill: "#155e75"; stroke: "#22d3ee"; font-color: "#67e8f9" } }
  slm: { style: { fill: "#064e3b"; stroke: "#34d399"; font-color: "#a7f3d0" } }
  frontier: { style: { fill: "#581c87"; stroke: "#c084fc"; font-color: "#e9d5ff" } }
}

user_q: "User Query Ingress" { class: q }
cache_check: "Semantic Vector Cache\nCosine Sim > 0.95?" { style: { fill: "#451a03"; stroke: "#fbbf24"; font-color: "#fde68a" } }
cache_hit: "Return Cached Response\n(&lt;20ms latency, \$0.00 cost)" { class: cache }

classifier: "Fast Router Model (DeBERTa)" { class: router }
slm: "Small Model: LLaMA-3-8B (\$0.05/M)\n(Routine FAQ / Summaries)" { class: slm }
frontier: "Frontier Model: Claude 3.5 (\$3/M)\n(Complex Reasoning & Code)" { class: frontier }

user_q -> cache_check
cache_check -> cache_hit: "Sim > 0.95"
cache_check -> classifier: "Miss"
classifier -> slm: "Routine"
classifier -> frontier: "Complex"