direction: right
classes: {
  trad: { style: { fill: "#1e293b"; stroke: "#38bdf8"; font-color: "#f8fafc" } }
  llm: { style: { fill: "#064e3b"; stroke: "#34d399"; font-color: "#a7f3d0" } }
}

traditional: "Traditional MLOps (Model-Centric)" {
  feat: "1. Feature Store (Feast)" { class: trad }
  train: "2. Full Model Retraining" { class: trad }
  export: "3. Export Weights (.onnx)" { class: trad }

  feat -> train -> export
}

modern: "Modern LLMOps (Context-Centric)" {
  base: "1. Foundation Model (Frozen Weights)" { class: llm }
  ctx: "2. Context Engineering & RAG" { style: { fill: "#155e75"; stroke: "#22d3ee"; font-color: "#67e8f9" } }
  gateway: "3. AI Gateway & Distributed Tracing" { style: { fill: "#581c87"; stroke: "#c084fc"; font-color: "#e9d5ff" } }

  base -> ctx -> gateway
}