direction: right
title: "Spark UI Performance Diagnostics Architecture"
classes: {
  container: { style: { fill: "#111827"; stroke-width: 2; border-radius: 10 } }
  box: { style: { fill: "#1E293B"; stroke-width: 2; border-radius: 8 } }
  table_box: { style: { fill: "#1E293B"; stroke: "#38bdf8"; stroke-width: 2 } }
  blue_box: { style: { fill: "#1e293b"; stroke: "#38bdf8"; stroke-width: 2; border-radius: 8 } }
  green_box: { style: { fill: "#0f291e"; stroke: "#4ade80"; stroke-width: 2; border-radius: 8 } }
  amber_box: { style: { fill: "#231e12"; stroke: "#fbbf24"; stroke-width: 2; border-radius: 8 } }
  purple_box: { style: { fill: "#1e1b2e"; stroke: "#c084fc"; stroke-width: 2; border-radius: 8 } }
  red_box: { style: { fill: "#2b1111"; stroke: "#f87171"; stroke-width: 2; border-radius: 8 } }
}

Hub: "Spark UI Diagnostic Hub" {
  class: container
  style.stroke: "#38BDF8"
}

JobsTab: "1. Jobs Tab" {
  class: container
  style.stroke: "#38BDF8"
  Desc: "High-level Action duration, status, and failure timeline"
}

StagesTab: "2. Stages Tab" {
  class: container
  style.stroke: "#34D399"
  Desc: "Min/Median/Max task durations, shuffle bytes, and task skew"
}

ExecutorsTab: "3. Executors Tab" {
  class: container
  style.stroke: "#C084FC"
  Desc: "Task Time vs GC Time ratio, disk spills, and lost nodes"
}

StorageTab: "4. Storage Tab" {
  class: container
  style.stroke: "#FBBF24"
  Desc: "Cached DataFrame fraction in memory vs disk eviction"
}

SQLTab: "5. SQL / DataFrame Tab" {
  class: container
  style.stroke: "#22D3EE"
  Desc: "Catalyst physical plan, WholeStageCodegen, and row counts"
}

Hub -> JobsTab
Hub -> StagesTab
Hub -> ExecutorsTab
Hub -> StorageTab
Hub -> SQLTab