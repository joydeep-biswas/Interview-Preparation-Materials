direction: right
title: "Bucket Join Optimization: Zero Shuffle"
classes: {
  container: { style: { fill: "#111827"; stroke-width: 2; border-radius: 10 } }
  box: { style: { fill: "#1E293B"; stroke-width: 2; border-radius: 8 } }
  table_box: { style: { fill: "#1E293B"; stroke: "#38bdf8"; stroke-width: 2 } }
  blue_box: { style: { fill: "#1e293b"; stroke: "#38bdf8"; stroke-width: 2; border-radius: 8 } }
  green_box: { style: { fill: "#0f291e"; stroke: "#4ade80"; stroke-width: 2; border-radius: 8 } }
  amber_box: { style: { fill: "#231e12"; stroke: "#fbbf24"; stroke-width: 2; border-radius: 8 } }
  purple_box: { style: { fill: "#1e1b2e"; stroke: "#c084fc"; stroke-width: 2; border-radius: 8 } }
  red_box: { style: { fill: "#2b1111"; stroke: "#f87171"; stroke-width: 2; border-radius: 8 } }
}

Storage: "Pre-Bucketed Storage (32 Buckets on customer_id)" {
  class: container
  style.stroke: "#22D3EE"
  FactTable: "fact_orders (Buckets 0..31 sorted)"
  DimTable: "dim_customers (Buckets 0..31 sorted)"
}

JoinExecution: "Co-Located Join Execution (Zero Shuffle)" {
  class: container
  style.stroke: "#34D399"
  Task0: "Task 0: SMJ(Fact Bucket 0, Dim Bucket 0)"
  Task1: "Task 1: SMJ(Fact Bucket 1, Dim Bucket 1)"
  TaskN: "Task 31: SMJ(Fact Bucket 31, Dim Bucket 31)"
}

Storage.FactTable -> JoinExecution.Task0: "Local Bucket Read" { style.stroke: "#34D399" }
Storage.DimTable -> JoinExecution.Task0: "Local Bucket Read" { style.stroke: "#34D399" }
Storage.FactTable -> JoinExecution.Task1: "Local Bucket Read" { style.stroke: "#34D399" }
Storage.DimTable -> JoinExecution.Task1: "Local Bucket Read" { style.stroke: "#34D399" }