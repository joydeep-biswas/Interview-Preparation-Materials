direction: right
classes: {
  exec: { style: { fill: "#1e293b"; stroke: "#38bdf8"; font-color: "#f8fafc" } }
  hook_g: { style: { fill: "#064e3b"; stroke: "#34d399"; font-color: "#a7f3d0" } }
  hook_r: { style: { fill: "#7f1d1d"; stroke: "#f87171"; font-color: "#fecaca" } }
  hook_a: { style: { fill: "#451a03"; stroke: "#fbbf24"; font-color: "#fde68a" } }
  hook_c: { style: { fill: "#155e75"; stroke: "#22d3ee"; font-color: "#67e8f9" } }
}

task: "Task Instance Execution" { class: exec }
state: "Execution Outcome" { style: { fill: "#581c87"; stroke: "#c084fc"; font-color: "#e9d5ff" } }

success_cb: "Execute: on_success_callback" { class: hook_g }
retry_cb: "Execute: on_retry_callback" { class: hook_a }
fail_cb: "Execute: on_failure_callback\n(Slack / PagerDuty)" { class: hook_r }
sla_cb: "Execute: sla_miss_callback" { class: hook_c }

task -> state
state -> success_cb: "Succeeds"
state -> retry_cb: "Fails (Retries Left)"
state -> fail_cb: "Fails (Retries Exhausted)"
state -> sla_cb: "Exceeds SLA Window"