direction: right
title: "Micro-Batching Mechanics & Execution Internals"
classes: {
  container: { style: { fill: "#111827"; stroke-width: 2; border-radius: 10 } }
  box: { style: { fill: "#1E293B"; stroke-width: 2; border-radius: 8 } }
  table_box: { style: { fill: "#1E293B"; stroke: "#38bdf8"; stroke-width: 2 } }
  blue_box: { style: { fill: "#1e293b"; stroke: "#38bdf8"; stroke-width: 2; border-radius: 8 } }
  green_box: { style: { fill: "#0f291e"; stroke: "#4ade80"; stroke-width: 2; border-radius: 8 } }
  amber_box: { style: { fill: "#231e12"; stroke: "#fbbf24"; stroke-width: 2; border-radius: 8 } }
  purple_box: { style: { fill: "#1e1b2e"; stroke: "#c084fc"; stroke-width: 2; border-radius: 8 } }
  red_box: { style: { fill: "#2b1111"; stroke: "#f87171"; stroke-width: 2; border-radius: 8 } }
}

kafka: "1. Kafka Event Buffer" {
  class: container
  status: "Offsets advance continuously (Unbounded log)"
}

driver: "2. Driver Coordinator (Trigger: 5s)" {
  class: container
  status: "Polls offsets, writes start offset, creates DAG"
}

workers: "3. Worker Tasks in RAM" {
  class: container
  status: "Processes assigned partitions in parallel"
}

sink: "4. Delta Lakehouse Sink & Commit" {
  class: container
  status: "Appends Parquet, writes commit marker file"
}

kafka -> driver: "Poll latest offsets"
driver -> workers: "Schedule distributed tasks"
workers -> sink: "Flush Parquet & Commit"