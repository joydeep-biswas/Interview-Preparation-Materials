direction: right
classes: {
  task: { style: { fill: "#1e293b"; stroke: "#38bdf8"; font-color: "#f8fafc" } }
}

extract: "Extract Source API\n(PythonOperator)" { class: task }
stage: "Stage to S3\n(S3CreateObjectOperator)" { style: { fill: "#155e75"; stroke: "#22d3ee"; font-color: "#67e8f9" } }
load: "Load to Snowflake\n(SnowflakeSqlApiOperator)" { style: { fill: "#581c87"; stroke: "#c084fc"; font-color: "#e9d5ff" } }
transform: "Transform Marts\n(DbtRunOperator)" { style: { fill: "#451a03"; stroke: "#fbbf24"; font-color: "#fde68a" } }
notify: "Notify Data Team\n(SlackWebhookOperator)" { style: { fill: "#064e3b"; stroke: "#34d399"; font-color: "#a7f3d0" } }

extract -> stage -> load -> transform -> notify