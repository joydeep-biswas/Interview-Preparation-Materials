direction: right
title: "Watermarking Mechanics & Allowed Lateness"
classes: {
  container: { style: { fill: "#111827"; stroke-width: 2; border-radius: 10 } }
  box: { style: { fill: "#1E293B"; stroke-width: 2; border-radius: 8 } }
  table_box: { style: { fill: "#1E293B"; stroke: "#38bdf8"; stroke-width: 2 } }
  blue_box: { style: { fill: "#1e293b"; stroke: "#38bdf8"; stroke-width: 2; border-radius: 8 } }
  green_box: { style: { fill: "#0f291e"; stroke: "#4ade80"; stroke-width: 2; border-radius: 8 } }
  amber_box: { style: { fill: "#231e12"; stroke: "#fbbf24"; stroke-width: 2; border-radius: 8 } }
  purple_box: { style: { fill: "#1e1b2e"; stroke: "#c084fc"; stroke-width: 2; border-radius: 8 } }
  red_box: { style: { fill: "#2b1111"; stroke: "#f87171"; stroke-width: 2; border-radius: 8 } }
}

watermark: "Moving Watermark Window (Allowed Lateness = 20 Mins)" {
  class: container
  max_time: "Max Event Time Seen: 10:40 AM"
  threshold: "Watermark Threshold: 10:20 AM (10:40 - 20 mins)"
  max_time -> threshold
}

records: "Arriving Records Evaluation" {
  class: container
  rec_a: "Record A: Event Time 10:25 AM" {
    class: box
    eval: "10:25 > 10:20 -> ACCEPTED into aggregation window"
    style.stroke: "#10b981"
  }
  rec_b: "Record B: Event Time 10:15 AM" {
    class: box
    eval: "10:15 < 10:20 -> DROPPED or routed to DLQ"
    style.stroke: "#ef4444"
  }
}

watermark.threshold -> records.rec_a: "Evaluates"
watermark.threshold -> records.rec_b: "Evaluates"