direction: right
title: "Historical Backfilling Strategies: Chunked vs. Monolithic"
classes: {
  container: { style: { fill: "#111827"; stroke-width: 2; border-radius: 10 } }
  box: { style: { fill: "#1E293B"; stroke-width: 2; border-radius: 8 } }
  table_box: { style: { fill: "#1E293B"; stroke: "#38bdf8"; stroke-width: 2 } }
  blue_box: { style: { fill: "#1e293b"; stroke: "#38bdf8"; stroke-width: 2; border-radius: 8 } }
  green_box: { style: { fill: "#0f291e"; stroke: "#4ade80"; stroke-width: 2; border-radius: 8 } }
  amber_box: { style: { fill: "#231e12"; stroke: "#fbbf24"; stroke-width: 2; border-radius: 8 } }
  purple_box: { style: { fill: "#1e1b2e"; stroke: "#c084fc"; stroke-width: 2; border-radius: 8 } }
  red_box: { style: { fill: "#2b1111"; stroke: "#f87171"; stroke-width: 2; border-radius: 8 } }
}

naive: "Anti-Pattern: Monolithic Backfill" {
  class: container
  run: "Naive Backfill: Run full 5-year range at once"
  exhaust: "Resource Exhaustion: Cluster OOM & locks production source DB"
  run -> exhaust
  style.stroke: "#ef4444"
}

chunked: "Recommended: Idempotent Chunked Backfill" {
  class: container
  orch: "Partitioned Orchestration: Iterate day-by-day in sequence"
  c1: "Run 2026-01-01"
  c2: "Run 2026-01-02"
  cn: "Run 2026-01-31"
  success: "Safe Execution: Bounded memory, zero lock contention, isolated retries"
  orch -> c1 -> c2 -> cn -> success
  style.stroke: "#10b981"
}