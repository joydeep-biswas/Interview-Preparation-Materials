direction: right
title: "The Three Time Domains in Stream Processing"
classes: {
  container: { style: { fill: "#111827"; stroke-width: 2; border-radius: 10 } }
  box: { style: { fill: "#1E293B"; stroke-width: 2; border-radius: 8 } }
  table_box: { style: { fill: "#1E293B"; stroke: "#38bdf8"; stroke-width: 2 } }
  blue_box: { style: { fill: "#1e293b"; stroke: "#38bdf8"; stroke-width: 2; border-radius: 8 } }
  green_box: { style: { fill: "#0f291e"; stroke: "#4ade80"; stroke-width: 2; border-radius: 8 } }
  amber_box: { style: { fill: "#231e12"; stroke: "#fbbf24"; stroke-width: 2; border-radius: 8 } }
  purple_box: { style: { fill: "#1e1b2e"; stroke: "#c084fc"; stroke-width: 2; border-radius: 8 } }
  red_box: { style: { fill: "#2b1111"; stroke: "#f87171"; stroke-width: 2; border-radius: 8 } }
}

event: "1. EVENT TIME" {
  class: container
  time: "10:14:02 AM on Client Phone / IoT Sensor"
  details: "When real-world action occurred; deterministic"
  style.stroke: "#3b82f6"
}

broker: "2. INGESTION TIME" {
  class: container
  time: "10:45:00 AM on Kafka Broker"
  details: "When message broker received event; includes network lag"
  style.stroke: "#f59e0b"
}

engine: "3. PROCESSING TIME" {
  class: container
  time: "10:45:03 AM on Spark / Flink Worker"
  details: "Local machine clock; non-deterministic across re-runs"
  style.stroke: "#10b981"
}

event -> broker: "Network delay & offline mobile caching"
broker -> engine: "Streaming consumer fetch"