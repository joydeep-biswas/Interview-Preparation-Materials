direction: right
title: "Production API Authentication (OAuth 2.0 Client Credentials)"
classes: {
  container: { style: { fill: "#111827"; stroke-width: 2; border-radius: 10 } }
  box: { style: { fill: "#1E293B"; stroke-width: 2; border-radius: 8 } }
  table_box: { style: { fill: "#1E293B"; stroke: "#38bdf8"; stroke-width: 2 } }
  blue_box: { style: { fill: "#1e293b"; stroke: "#38bdf8"; stroke-width: 2; border-radius: 8 } }
  green_box: { style: { fill: "#0f291e"; stroke: "#4ade80"; stroke-width: 2; border-radius: 8 } }
  amber_box: { style: { fill: "#231e12"; stroke: "#fbbf24"; stroke-width: 2; border-radius: 8 } }
  purple_box: { style: { fill: "#1e1b2e"; stroke: "#c084fc"; stroke-width: 2; border-radius: 8 } }
  red_box: { style: { fill: "#2b1111"; stroke: "#f87171"; stroke-width: 2; border-radius: 8 } }
}

worker: "Ingestion Worker" {
  class: container
  creds: "client_id, client_secret (Stored in KMS)"
}

idp: "Identity Provider (Okta / Azure AD)" {
  class: container
  token: "Generates signed JWT Access Token (expires in 3600s)"
}

api: "SaaS API (Salesforce / Stripe)" {
  class: container
  endpoint: "Protected endpoints (Validates Bearer token)"
}

worker -> idp: "1. POST /oauth/token (client_credentials)"
idp -> worker: "2. Return Access Token JWT (expires_in = 3600s)"
worker -> api: "3. Loop GET /customers (Header: Bearer <token>)"
api -> worker: "4. Return customer records"