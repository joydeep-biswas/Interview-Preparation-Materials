direction: right
classes: {
  slow: { style: { fill: "#7f1d1d"; stroke: "#f87171"; font-color: "#fecaca" } }
  fast: { style: { fill: "#064e3b"; stroke: "#34d399"; font-color: "#a7f3d0" } }
}

flat: "Flat Namespace: O(N) Slow Rename" {
  f_start: "Virtual Path: /staging/\n(10,000 Blobs)" { style: { fill: "#1e293b"; stroke: "#38bdf8"; font-color: "#f8fafc" } }
  f_action: "Copy + Delete Loop\n(10,000 individual operations\nTakes 15-45 minutes!)" { class: slow }

  f_start -> f_action: "Rename Triggered"
}

hns: "Hierarchical Namespace (HNS): O(1) Atomic Rename" {
  h_start: "True Directory Inode: /staging/\n(Single Metadata Object)" { style: { fill: "#155e75"; stroke: "#22d3ee"; font-color: "#67e8f9" } }
  h_action: "Atomic Inode Pointer Update\n(Single metadata change\nTakes &lt;50ms!)" { class: fast }

  h_start -> h_action: "Atomic Pointer Update"
}