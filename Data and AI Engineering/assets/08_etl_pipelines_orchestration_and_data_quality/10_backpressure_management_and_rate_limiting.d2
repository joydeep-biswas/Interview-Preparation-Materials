direction: right
title: "Backpressure Management & Dynamic Rate Limiting"
classes: {
  container: { style: { fill: "#111827"; stroke-width: 2; border-radius: 10 } }
  box: { style: { fill: "#1E293B"; stroke-width: 2; border-radius: 8 } }
  table_box: { style: { fill: "#1E293B"; stroke: "#38bdf8"; stroke-width: 2 } }
  blue_box: { style: { fill: "#1e293b"; stroke: "#38bdf8"; stroke-width: 2; border-radius: 8 } }
  green_box: { style: { fill: "#0f291e"; stroke: "#4ade80"; stroke-width: 2; border-radius: 8 } }
  amber_box: { style: { fill: "#231e12"; stroke: "#fbbf24"; stroke-width: 2; border-radius: 8 } }
  purple_box: { style: { fill: "#1e1b2e"; stroke: "#c084fc"; stroke-width: 2; border-radius: 8 } }
  red_box: { style: { fill: "#2b1111"; stroke: "#f87171"; stroke-width: 2; border-radius: 8 } }
}

no_backpressure: "Without Backpressure (Crash Cycle)" {
  class: container
  k1: "Kafka: 50,000,000 Messages Waiting"
  w1: "Worker Heap: Pulls all 50M messages at once!" {
    class: box
    style.stroke: "#ef4444"
  }
  crash: "Fatal JVM OutOfMemoryError Crash!" {
    class: box
    style.stroke: "#ef4444"
  }
  k1 -> w1 -> crash
}

with_backpressure: "With Backpressure & Rate Limiting" {
  class: container
  k2: "Kafka: 50,000,000 Messages Waiting"
  w2: "Worker Heap: Throttled maxOffsetsPerTrigger=500,000" {
    class: box
    style.stroke: "#10b981"
  }
  stable: "Stable Delta Lake Batch Commit (30s per batch)" {
    class: box
    style.stroke: "#10b981"
  }
  k2 -> w2 -> stable
}