direction: right
title: "Pipeline Fault Tolerance: Self-Healing & Quarantine Gate"
classes: {
  container: { style: { fill: "#111827"; stroke-width: 2; border-radius: 10 } }
  box: { style: { fill: "#1E293B"; stroke-width: 2; border-radius: 8 } }
  table_box: { style: { fill: "#1E293B"; stroke: "#38bdf8"; stroke-width: 2 } }
  blue_box: { style: { fill: "#1e293b"; stroke: "#38bdf8"; stroke-width: 2; border-radius: 8 } }
  green_box: { style: { fill: "#0f291e"; stroke: "#4ade80"; stroke-width: 2; border-radius: 8 } }
  amber_box: { style: { fill: "#231e12"; stroke: "#fbbf24"; stroke-width: 2; border-radius: 8 } }
  purple_box: { style: { fill: "#1e1b2e"; stroke: "#c084fc"; stroke-width: 2; border-radius: 8 } }
  red_box: { style: { fill: "#2b1111"; stroke: "#f87171"; stroke-width: 2; border-radius: 8 } }
}

task: "Task Execution" {
  class: container
  status: "Worker executes transformation"
}

transient: "Transient Error Handler" {
  class: container
  check: "Error classified as Transient (Network timeout / Lock wait)"
  retry: "Exponential Backoff with Full Jitter (Attempts < 5)"
}

circuit: "Circuit Breaker Trip" {
  class: container
  status: "Attempts >= 5: Halt pipeline & trigger PagerDuty alert"
  style.stroke: "#ef4444"
}

dlq: "Fatal Poison Pill Handler (DLQ)" {
  class: container
  status: "Fatal schema corruption: Route record to DLQ; pipeline continues"
  style.stroke: "#10b981"
}

task -> transient: "Transient Failure"
transient -> task: "Retry with Jitter"
transient -> circuit: "Budget Depleted"
task -> dlq: "Fatal Corrupt Data"