direction: right
classes: {
  triage: { style: { fill: "#7f1d1d"; stroke: "#f87171"; font-color: "#fecaca" } }
  lineage: { style: { fill: "#581c87"; stroke: "#c084fc"; font-color: "#e9d5ff" } }
  rca: { style: { fill: "#451a03"; stroke: "#fbbf24"; font-color: "#fde68a" } }
  post: { style: { fill: "#064e3b"; stroke: "#34d399"; font-color: "#a7f3d0" } }
}

s1: "1. Triage & Containment\n(Trip breaker, halt corrupt DAG)" { class: triage }
s2: "2. Lineage Inspection\n(Trace Gold -> Silver -> Bronze)" { class: lineage }
s3: "3. Root Cause Analysis\n(OOM vs Schema Drift vs Auth)" { class: rca }
s4: "4. Backfill & Post-Mortem\n(Idempotent fix & 5-Whys report)" { class: post }

s1 -> s2: "Trace Lineage"
s2 -> s3: "Isolate Cause"
s3 -> s4: "Backfill & Verify"