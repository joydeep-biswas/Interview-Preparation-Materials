direction: right
classes: {
  sli: { style: { fill: "#1e293b"; stroke: "#38bdf8"; font-color: "#f8fafc" } }
  slo: { style: { fill: "#064e3b"; stroke: "#34d399"; font-color: "#a7f3d0" } }
  sla: { style: { fill: "#7f1d1d"; stroke: "#f87171"; font-color: "#fecaca" } }
}

sli: "1. SLI (Service Level Indicator)\nActual Measurement\ne.g. 99.2% loaded <15m" { class: sli }
slo: "2. SLO (Service Level Objective)\nInternal Engineering Target\ne.g. 99.5% compliance" { class: slo }
sla: "3. SLA (Service Level Agreement)\nContractual Commitment\ne.g. Penalty if <98.0%" { class: sla }

sli -> slo: "Measured against"
slo -> sla: "Safety margin buffer"