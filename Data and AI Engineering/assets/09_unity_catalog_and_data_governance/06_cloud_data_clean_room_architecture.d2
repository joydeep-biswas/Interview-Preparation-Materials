direction: right
classes: {
  disney: { style: { fill: "#1e293b"; stroke: "#38bdf8"; font-color: "#f8fafc" } }
  target: { style: { fill: "#581c87"; stroke: "#c084fc"; font-color: "#e9d5ff" } }
  clean: { style: { fill: "#064e3b"; stroke: "#34d399"; font-color: "#a7f3d0" } }
  block: { style: { fill: "#7f1d1d"; stroke: "#f87171"; font-color: "#fecaca" } }
}

disney: "Disney+ (Subscriber Data)" { class: disney }
target: "Target (Retail Purchase Data)" { class: target }

clean_room: "Cloud Data Clean Room" {
  join: "1. Cryptographic Hash Match" { style: { fill: "#155e75"; stroke: "#22d3ee"; font-color: "#67e8f9" } }
  gate: "2. Query Template Gatekeeper" { style: { fill: "#451a03"; stroke: "#fbbf24"; font-color: "#fde68a" } }
  dp: "3. Differential Privacy Engine" { class: target }
  threshold: "4. Threshold Check (>=100 Users)" { style: { fill: "#7f1d1d"; stroke: "#f87171"; font-color: "#fecaca" } }

  join -> gate -> dp -> threshold
}

disney -> clean_room.join: "SHA-256 Hashes"
target -> clean_room.join: "SHA-256 Hashes"

output: "Aggregated Insight (Zero PII)" { class: clean }
blocked: "Blocked! (<100 Rows)" { class: block }

clean_room.threshold -> output: "Passed (>=100)"
clean_room.threshold -> blocked: "Failed (<100)"