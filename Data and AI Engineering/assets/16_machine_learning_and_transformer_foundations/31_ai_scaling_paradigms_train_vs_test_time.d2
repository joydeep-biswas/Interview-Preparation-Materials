classes: {
  train_box: { style: { fill: "#1e293b"; stroke: "#38bdf8"; stroke-width: 2 } }
  test_box: { style: { fill: "#0f291e"; stroke: "#4ade80"; stroke-width: 2; font-color: "#86efac" } }
