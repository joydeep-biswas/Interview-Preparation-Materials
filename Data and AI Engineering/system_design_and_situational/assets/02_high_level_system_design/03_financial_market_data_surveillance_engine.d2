direction: right
classes: {
  container: { style: { fill: "#111827"; stroke-width: 2; border-radius: 10 } }
  box: { style: { fill: "#1E293B"; stroke-width: 2; border-radius: 8 } }
  table_box: { style: { fill: "#1E293B"; stroke: "#38bdf8"; stroke-width: 2 } }
  blue_box: { style: { fill: "#1e293b"; stroke: "#38bdf8"; stroke-width: 2; border-radius: 8 } }
  green_box: { style: { fill: "#0f291e"; stroke: "#4ade80"; stroke-width: 2; border-radius: 8 } }
  amber_box: { style: { fill: "#231e12"; stroke: "#fbbf24"; stroke-width: 2; border-radius: 8 } }
  purple_box: { style: { fill: "#1e1b2e"; stroke: "#c084fc"; stroke-width: 2; border-radius: 8 } }
  red_box: { style: { fill: "#2b1111"; stroke: "#f87171"; stroke-width: 2; border-radius: 8 } }
}

venues: "1. Heterogeneous Venues" {
  class: container
  style.fill: "#111827"
  style.stroke: "#3B82F6"
  style.stroke-width: 2
  lse: "LSE: FIX 4.4 Protocol (UTC)"
  euronext: "Euronext: ITCH / OUCH Binary"
  ptp: "PTP IEEE 1588 Nanosecond Tagging"
}

normalization: "2. Normalization & Spine" {
  class: container
  style.fill: "#111827"
  style.stroke: "#10B981"
  style.stroke-width: 2
  dto: "Canonical Tick DTO Normalizer"
  kafka: "Kafka Topic: market.ticks (Key: Symbol)"
}

flink_cep: "3. Apache Flink CEP Engine" {
  class: container
  style.fill: "#111827"
  style.stroke: "#F59E0B"
  style.stroke-width: 2
  patterns: "Spoofing, Layering & Wash Trade Detectors"
  windows: "500ms Sliding Windows with RocksDB State"
}

compliance: "4. Compliance & Tick Store" {
  class: container
  style.fill: "#111827"
  style.stroke: "#8B5CF6"
  style.stroke-width: 2
  alerts: "Sub-Millisecond Alert Dispatch"
  clickhouse: "ClickHouse Nanosecond Tick Archive"
}

venues -> normalization: "Kernel-Bypass Ingress" {
  style.stroke: "#10B981"
  style.stroke-width: 2
}
normalization -> flink_cep: "Partitioned Stream" {
  style.stroke: "#F59E0B"
  style.stroke-width: 2
}
flink_cep -> compliance: "Real-Time Detection & Persist" {
  style.stroke: "#8B5CF6"
  style.stroke-width: 2
}