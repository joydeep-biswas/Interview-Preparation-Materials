direction: right
classes: {
  container: { style: { fill: "#111827"; stroke-width: 2; border-radius: 10 } }
  box: { style: { fill: "#1E293B"; stroke-width: 2; border-radius: 8 } }
  table_box: { style: { fill: "#1E293B"; stroke: "#38bdf8"; stroke-width: 2 } }
  blue_box: { style: { fill: "#1e293b"; stroke: "#38bdf8"; stroke-width: 2; border-radius: 8 } }
  green_box: { style: { fill: "#0f291e"; stroke: "#4ade80"; stroke-width: 2; border-radius: 8 } }
  amber_box: { style: { fill: "#231e12"; stroke: "#fbbf24"; stroke-width: 2; border-radius: 8 } }
  purple_box: { style: { fill: "#1e1b2e"; stroke: "#c084fc"; stroke-width: 2; border-radius: 8 } }
  red_box: { style: { fill: "#2b1111"; stroke: "#f87171"; stroke-width: 2; border-radius: 8 } }
}

ingestion: "1. Ingestion Gateways" {
  class: container
  style.fill: "#111827"
  style.stroke: "#3B82F6"
  style.stroke-width: 2
  oltp: "PostgreSQL / MySQL CDC"
  events: "10M+ events/sec Clickstream"
  market: "Financial Market Feeds (ITCH / FIX)"
}

event_log: "2. Real-Time Event Log" {
  class: container
  style.fill: "#111827"
  style.stroke: "#10B981"
  style.stroke-width: 2
  kafka: "Apache Kafka / Redpanda Cluster"
  schema: "Confluent Schema Registry"
}

lakehouse: "3. Medallion Lakehouse" {
  class: container
  style.fill: "#111827"
  style.stroke: "#F59E0B"
  style.stroke-width: 2
  bronze: "Bronze: Raw Immutable Log"
  silver: "Silver: Delta / Iceberg ACID Log"
  gold: "Gold: Z-Order Clustered Marts"
}

serving: "4. Serving & AI Tier" {
  class: container
  style.fill: "#111827"
  style.stroke: "#8B5CF6"
  style.stroke-width: 2
  olap: "ClickHouse / StarRocks Sub-Second OLAP"
  trino: "Trino Federated Query Engine"
  ai: "Feature Store & Vector DB Serving"
}

ingestion -> event_log: "Publish Stream" {
  style.stroke: "#10B981"
  style.stroke-width: 2
}
event_log -> lakehouse: "Structured Streaming" {
  style.stroke: "#F59E0B"
  style.stroke-width: 2
}
lakehouse -> serving: "Zero-Copy Parquet / Direct Query" {
  style.stroke: "#8B5CF6"
  style.stroke-width: 2
}