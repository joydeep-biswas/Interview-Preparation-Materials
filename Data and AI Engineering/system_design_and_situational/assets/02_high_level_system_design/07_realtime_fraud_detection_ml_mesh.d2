direction: right
classes: {
  container: { style: { fill: "#111827"; stroke-width: 2; border-radius: 10 } }
  box: { style: { fill: "#1E293B"; stroke-width: 2; border-radius: 8 } }
  table_box: { style: { fill: "#1E293B"; stroke: "#38bdf8"; stroke-width: 2 } }
  blue_box: { style: { fill: "#1e293b"; stroke: "#38bdf8"; stroke-width: 2; border-radius: 8 } }
  green_box: { style: { fill: "#0f291e"; stroke: "#4ade80"; stroke-width: 2; border-radius: 8 } }
  amber_box: { style: { fill: "#231e12"; stroke: "#fbbf24"; stroke-width: 2; border-radius: 8 } }
  purple_box: { style: { fill: "#1e1b2e"; stroke: "#c084fc"; stroke-width: 2; border-radius: 8 } }
  red_box: { style: { fill: "#2b1111"; stroke: "#f87171"; stroke-width: 2; border-radius: 8 } }
}

scoring: "1. Live Scoring Service" {
  class: container
  style.fill: "#111827"
  style.stroke: "#3B82F6"
  style.stroke-width: 2
  inference: "ONNX Runtime Fraud Model (<25ms)"
  telemetry: "Streaming Telemetry Logger to Kafka"
}

online_store: "2. Online Feature Store" {
  class: container
  style.fill: "#111827"
  style.stroke: "#10B981"
  style.stroke-width: 2
  redis: "Redis Low-Latency In-Memory Cluster"
  flink: "Flink Real-Time Window Features"
}

offline_store: "3. Offline Lakehouse Store" {
  class: container
  style.fill: "#111827"
  style.stroke: "#F59E0B"
  style.stroke-width: 2
  delta: "Delta Lake Point-in-Time Correct Dataset"
  ground_truth: "True Fraud Chargeback Labels"
}

drift_loop: "4. Drift & Retraining" {
  class: container
  style.fill: "#111827"
  style.stroke: "#8B5CF6"
  style.stroke-width: 2
  monitoring: "KS-Test & PSI Distribution Shift"
  retrain: "Airflow Automated Champion/Challenger"
}

scoring -> online_store: "Fetch Features (<2ms)" {
  style.stroke: "#10B981"
  style.stroke-width: 2
}
online_store -> offline_store: "Daily Snapshot Sink" {
  style.stroke: "#F59E0B"
  style.stroke-width: 2
}
offline_store -> drift_loop: "Generate Training Batches" {
  style.stroke: "#8B5CF6"
  style.stroke-width: 2
}