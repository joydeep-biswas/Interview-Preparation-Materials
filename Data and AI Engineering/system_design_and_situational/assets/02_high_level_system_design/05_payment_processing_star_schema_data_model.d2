direction: right
classes: {
  container: { style: { fill: "#111827"; stroke-width: 2; border-radius: 10 } }
  box: { style: { fill: "#1E293B"; stroke-width: 2; border-radius: 8 } }
  table_box: { style: { fill: "#1E293B"; stroke: "#38bdf8"; stroke-width: 2 } }
  blue_box: { style: { fill: "#1e293b"; stroke: "#38bdf8"; stroke-width: 2; border-radius: 8 } }
  green_box: { style: { fill: "#0f291e"; stroke: "#4ade80"; stroke-width: 2; border-radius: 8 } }
  amber_box: { style: { fill: "#231e12"; stroke: "#fbbf24"; stroke-width: 2; border-radius: 8 } }
  purple_box: { style: { fill: "#1e1b2e"; stroke: "#c084fc"; stroke-width: 2; border-radius: 8 } }
  red_box: { style: { fill: "#2b1111"; stroke: "#f87171"; stroke-width: 2; border-radius: 8 } }
}

DIM_CUSTOMER: "" {
  class: container
  style.fill: "#111827"
  style.stroke: "#3B82F6"
  style.stroke-width: 2
  customer_id: "PK: string"
  customer_name: "string"
  kyc_status: "varchar(16)"
  country_code: "varchar(2)"
}

DIM_MERCHANT: "" {
  class: container
  style.fill: "#111827"
  style.stroke: "#10B981"
  style.stroke-width: 2
  merchant_id: "PK: string"
  merchant_name: "string"
  mcc_code: "varchar(4)"
  risk_tier: "varchar(8)"
}

FACT_PAYMENT_TRANSACTION: "" {
  class: container
  style.fill: "#111827"
  style.stroke: "#F59E0B"
  style.stroke-width: 2
  transaction_id: "PK: string"
  customer_id: "FK: string"
  merchant_id: "FK: string"
  amount_cents: "bigint"
  currency: "varchar(3)"
  status: "varchar(16)"
  fraud_risk_score: "decimal(5,2)"
}

FACT_REFUND: "" {
  class: container
  style.fill: "#111827"
  style.stroke: "#8B5CF6"
  style.stroke-width: 2
  refund_id: "PK: string"
  transaction_id: "FK: string"
  refund_amount_cents: "bigint"
  reason_code: "varchar(32)"
}

FACT_CHARGEBACK: "" {
  class: container
  style.fill: "#111827"
  style.stroke: "#EF4444"
  style.stroke-width: 2
  dispute_id: "PK: string"
  transaction_id: "FK: string"
  disputed_amount_cents: "bigint"
  dispute_status: "varchar(16)"
}

DIM_CUSTOMER -> FACT_PAYMENT_TRANSACTION: "1 : N places" {
  style.stroke: "#3B82F6"
  style.stroke-width: 2
}
DIM_MERCHANT -> FACT_PAYMENT_TRANSACTION: "1 : N accepts" {
  style.stroke: "#10B981"
  style.stroke-width: 2
}
FACT_PAYMENT_TRANSACTION -> FACT_REFUND: "1 : N has refund" {
  style.stroke: "#8B5CF6"
  style.stroke-width: 2
}
FACT_PAYMENT_TRANSACTION -> FACT_CHARGEBACK: "1 : N has dispute" {
  style.stroke: "#EF4444"
  style.stroke-width: 2
}