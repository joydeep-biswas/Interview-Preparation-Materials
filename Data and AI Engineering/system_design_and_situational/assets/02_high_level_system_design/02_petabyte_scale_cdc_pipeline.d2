direction: right
classes: {
  container: { style: { fill: "#111827"; stroke-width: 2; border-radius: 10 } }
  box: { style: { fill: "#1E293B"; stroke-width: 2; border-radius: 8 } }
  table_box: { style: { fill: "#1E293B"; stroke: "#38bdf8"; stroke-width: 2 } }
  blue_box: { style: { fill: "#1e293b"; stroke: "#38bdf8"; stroke-width: 2; border-radius: 8 } }
  green_box: { style: { fill: "#0f291e"; stroke: "#4ade80"; stroke-width: 2; border-radius: 8 } }
  amber_box: { style: { fill: "#231e12"; stroke: "#fbbf24"; stroke-width: 2; border-radius: 8 } }
  purple_box: { style: { fill: "#1e1b2e"; stroke: "#c084fc"; stroke-width: 2; border-radius: 8 } }
  red_box: { style: { fill: "#2b1111"; stroke: "#f87171"; stroke-width: 2; border-radius: 8 } }
}

source: "1. PostgreSQL Primary" {
  class: container
  style.fill: "#111827"
  style.stroke: "#3B82F6"
  style.stroke-width: 2
  wal: "WAL Replication Log (Logical Decoding)"
  debezium: "Debezium Connector on Kafka Connect"
}

kafka: "2. Kafka CDC Spine" {
  class: container
  style.fill: "#111827"
  style.stroke: "#10B981"
  style.stroke-width: 2
  topic: "Topic: orders.cdc (Key: order_id)"
  partitioning: "256 Partitions with Log Compaction"
}

spark: "3. Spark Streaming" {
  class: container
  style.fill: "#111827"
  style.stroke: "#F59E0B"
  style.stroke-width: 2
  engine: "Structured Streaming (30s Micro-batch)"
  dedup: "10-minute Watermark Deduplication"
}

delta: "4. Delta Silver" {
  class: container
  style.fill: "#111827"
  style.stroke: "#8B5CF6"
  style.stroke-width: 2
  merge: "ACID MERGE INTO matching on order_id"
  history: "Time Travel Audit Trail"
}

gold: "5. Gold & BI" {
  class: container
  style.fill: "#111827"
  style.stroke: "#EC4899"
  style.stroke-width: 2
  marts: "Aggregated Revenue & Cohort Marts"
  bi: "BI Dashboards & Reverse ETL"
}

source -> kafka: "Stream WAL Events" {
  style.stroke: "#10B981"
  style.stroke-width: 2
}
kafka -> spark: "Consumer Group Pull" {
  style.stroke: "#F59E0B"
  style.stroke-width: 2
}
spark -> delta: "ACID MERGE INTO" {
  style.stroke: "#8B5CF6"
  style.stroke-width: 2
}
delta -> gold: "Continuous Aggregation" {
  style.stroke: "#EF4444"
  style.stroke-width: 2
}