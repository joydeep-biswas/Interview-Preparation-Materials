direction: right
classes: {
  container: { style: { fill: "#111827"; stroke-width: 2; border-radius: 10 } }
  box: { style: { fill: "#1E293B"; stroke-width: 2; border-radius: 8 } }
  table_box: { style: { fill: "#1E293B"; stroke: "#38bdf8"; stroke-width: 2 } }
  blue_box: { style: { fill: "#1e293b"; stroke: "#38bdf8"; stroke-width: 2; border-radius: 8 } }
  green_box: { style: { fill: "#0f291e"; stroke: "#4ade80"; stroke-width: 2; border-radius: 8 } }
  amber_box: { style: { fill: "#231e12"; stroke: "#fbbf24"; stroke-width: 2; border-radius: 8 } }
  purple_box: { style: { fill: "#1e1b2e"; stroke: "#c084fc"; stroke-width: 2; border-radius: 8 } }
  red_box: { style: { fill: "#2b1111"; stroke: "#f87171"; stroke-width: 2; border-radius: 8 } }
}

sources: "1. Core Banking Ledgers" {
  class: container
  style.fill: "#111827"
  style.stroke: "#3B82F6"
  style.stroke-width: 2
  db2: "IBM DB2 Core Banking CDC"
  payments: "Payment Processing Kafka Stream"
  zero_loss: "Zero-Loss Transactional Spooler"
}

balancing: "2. Double-Entry Validation" {
  class: container
  style.fill: "#111827"
  style.stroke: "#10B981"
  style.stroke-width: 2
  invariant: "Invariant: Sum(Debits) == Sum(Credits)"
  reconciler: "Flink Streaming Balance Validator"
}

delta_storage: "3. Delta Lake Storage" {
  class: container
  style.fill: "#111827"
  style.stroke: "#F59E0B"
  style.stroke-width: 2
  worm: "Immutable WORM Append-Only Log"
  time_travel: "Time Travel As-Of Millisecond Queries"
}

regulatory: "4. Regulatory & Audit" {
  class: container
  style.fill: "#111827"
  style.stroke: "#8B5CF6"
  style.stroke-width: 2
  compliance: "FINRA / SEC & Basel III Reporting"
  attestation: "Cryptographic End-of-Day Attestation"
}

sources -> balancing: "Strict Exactly-Once Push" {
  style.stroke: "#10B981"
  style.stroke-width: 2
}
balancing -> delta_storage: "Verified Journal Entries" {
  style.stroke: "#F59E0B"
  style.stroke-width: 2
}
delta_storage -> regulatory: "Immutable Audit Extract" {
  style.stroke: "#8B5CF6"
  style.stroke-width: 2
}