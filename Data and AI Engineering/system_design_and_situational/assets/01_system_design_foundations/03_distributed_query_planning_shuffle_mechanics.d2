direction: right
classes: {
  container: { style: { fill: "#111827"; stroke-width: 2; border-radius: 10 } }
  box: { style: { fill: "#1E293B"; stroke-width: 2; border-radius: 8 } }
  table_box: { style: { fill: "#1E293B"; stroke: "#38bdf8"; stroke-width: 2 } }
  blue_box: { style: { fill: "#1e293b"; stroke: "#38bdf8"; stroke-width: 2; border-radius: 8 } }
  green_box: { style: { fill: "#0f291e"; stroke: "#4ade80"; stroke-width: 2; border-radius: 8 } }
  amber_box: { style: { fill: "#231e12"; stroke: "#fbbf24"; stroke-width: 2; border-radius: 8 } }
  purple_box: { style: { fill: "#1e1b2e"; stroke: "#c084fc"; stroke-width: 2; border-radius: 8 } }
  red_box: { style: { fill: "#2b1111"; stroke: "#f87171"; stroke-width: 2; border-radius: 8 } }
}

stage1: "Stage 1: Map Stage" {
  class: container
  style.fill: "#111827"
  style.stroke: "#3B82F6"
  style.stroke-width: 2
  map1: "Map Worker 1: Hash Partitioner (Key % R)"
  map2: "Map Worker 2: In-Memory Sort Buffer"
}

shuffle_disk: "Local NVMe Shuffle Boundary" {
  class: container
  style.fill: "#111827"
  style.stroke: "#F59E0B"
  style.stroke-width: 2
  data_file: "shuffle_X_Y_0.data: Consolidated partition blocks"
  index_file: "shuffle_X_Y_0.index: 8-byte byte-offset table"
}

stage2: "Stage 2: Reduce Stage" {
  class: container
  style.fill: "#111827"
  style.stroke: "#10B981"
  style.stroke-width: 2
  red1: "Reducer 1: Netty chunk fetch for Partition 0"
  red2: "Reducer 2: Hash aggregate & spill-to-disk"
}

stage1.map1 -> shuffle_disk: "Spill & Consolidate" {
  style.stroke: "#F59E0B"
  style.stroke-width: 2
}
stage1.map2 -> shuffle_disk: "Spill & Consolidate" {
  style.stroke: "#F59E0B"
  style.stroke-width: 2
}
shuffle_disk -> stage2.red1: "Netty Asynchronous RPC Fetch" {
  style.stroke: "#10B981"
  style.stroke-width: 2
}
shuffle_disk -> stage2.red2: "Netty Asynchronous RPC Fetch" {
  style.stroke: "#10B981"
  style.stroke-width: 2
}