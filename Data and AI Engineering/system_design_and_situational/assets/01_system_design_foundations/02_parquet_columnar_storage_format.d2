direction: right
classes: {
  container: { style: { fill: "#111827"; stroke-width: 2; border-radius: 10 } }
  box: { style: { fill: "#1E293B"; stroke-width: 2; border-radius: 8 } }
  table_box: { style: { fill: "#1E293B"; stroke: "#38bdf8"; stroke-width: 2 } }
  blue_box: { style: { fill: "#1e293b"; stroke: "#38bdf8"; stroke-width: 2; border-radius: 8 } }
  green_box: { style: { fill: "#0f291e"; stroke: "#4ade80"; stroke-width: 2; border-radius: 8 } }
  amber_box: { style: { fill: "#231e12"; stroke: "#fbbf24"; stroke-width: 2; border-radius: 8 } }
  purple_box: { style: { fill: "#1e1b2e"; stroke: "#c084fc"; stroke-width: 2; border-radius: 8 } }
  red_box: { style: { fill: "#2b1111"; stroke: "#f87171"; stroke-width: 2; border-radius: 8 } }
}

file_layout: "Parquet File Structural Hierarchy" {
  class: container
  style.fill: "#111827"
  style.stroke: "#3B82F6"
  style.stroke-width: 2
  header: "Magic Header: PAR1 (4 bytes)"
  row_group_1: "Row Group 1 (128MB - 512MB)\nColumn Chunks A, B, C"
  row_group_2: "Row Group 2 (Subsequent Data Partition)"
  footer: "File Metadata Footer (Thrift)\nMin/Max Stats, Schema, Offsets"
  end_magic: "Footer Length + Magic: PAR1"
}

chunk_deep_dive: "Column Chunk & Data Page Internals" {
  class: container
  style.fill: "#111827"
  style.stroke: "#10B981"
  style.stroke-width: 2
  dict: "Dictionary Page: Bit-packed unique tokens"
  data: "Data Page: Definition levels (NULLs) + Repetition levels"
  page_header: "Page Header: Compressed/Uncompressed sizes + Page stats"
}

scan_opt: "Engine Scan Optimization: Predicate Pushdown" {
  class: container
  style.fill: "#111827"
  style.stroke: "#F59E0B"
  style.stroke-width: 2
  skipping: "Row Group Skipping: Reads footer stats, skips 256MB I/O"
  vectorized: "Vectorized SIMD: Decompresses only requested columns"
}

file_layout.row_group_1 -> chunk_deep_dive: "Examine Chunk" {
  style.stroke: "#10B981"
  style.stroke-width: 2
}
file_layout.footer -> scan_opt: "Evaluates Predicates" {
  style.stroke: "#F59E0B"
  style.stroke-width: 2
}