direction: right
classes: {
  container: { style: { fill: "#111827"; stroke-width: 2; border-radius: 10 } }
  box: { style: { fill: "#1E293B"; stroke-width: 2; border-radius: 8 } }
  table_box: { style: { fill: "#1E293B"; stroke: "#38bdf8"; stroke-width: 2 } }
  blue_box: { style: { fill: "#1e293b"; stroke: "#38bdf8"; stroke-width: 2; border-radius: 8 } }
  green_box: { style: { fill: "#0f291e"; stroke: "#4ade80"; stroke-width: 2; border-radius: 8 } }
  amber_box: { style: { fill: "#231e12"; stroke: "#fbbf24"; stroke-width: 2; border-radius: 8 } }
  purple_box: { style: { fill: "#1e1b2e"; stroke: "#c084fc"; stroke-width: 2; border-radius: 8 } }
  red_box: { style: { fill: "#2b1111"; stroke: "#f87171"; stroke-width: 2; border-radius: 8 } }
}

ingestion: "1. Ingestion Backplane" {
  class: container
  style.fill: "#111827"
  style.stroke: "#3B82F6"
  style.stroke-width: 2
  sources: "Upstream Sources: CDC, Telemetry, Webhooks"
  commit_log: "Distributed Ingress Log (Kafka / Event Hubs)"
}

storage: "2. Disaggregated Lakehouse" {
  class: container
  style.fill: "#111827"
  style.stroke: "#10B981"
  style.stroke-width: 2
  bronze: "Bronze: Raw Immutable Parquet"
  silver: "Silver: Delta / Iceberg ACID Log"
  gold: "Gold: Z-Order Clustered Aggregates"
}

compute: "3. Distributed Compute" {
  class: container
  style.fill: "#111827"
  style.stroke: "#F59E0B"
  style.stroke-width: 2
  spark: "Apache Spark / Databricks Catalyst"
  olap: "ClickHouse / StarRocks Real-Time OLAP"
  trino: "Trino Federated SQL Querying"
}

governance: "4. Catalog & AI Serving" {
  class: container
  style.fill: "#111827"
  style.stroke: "#8B5CF6"
  style.stroke-width: 2
  catalog: "Unity Catalog / Apache Polaris"
  feature_store: "Redis Online & Lakehouse Offline"
  vector_rag: "Milvus / Qdrant Vector Search"
}

ingestion -> storage: "Append Events" {
  style.stroke: "#10B981"
  style.stroke-width: 2
}
storage -> compute: "Zero-Copy Parquet Read" {
  style.stroke: "#F59E0B"
  style.stroke-width: 2
}
compute -> governance: "Catalog Metadata & Lineage" {
  style.stroke: "#8B5CF6"
  style.stroke-width: 2
}