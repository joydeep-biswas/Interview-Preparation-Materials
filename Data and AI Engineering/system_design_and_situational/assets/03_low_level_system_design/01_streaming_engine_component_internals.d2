direction: right

ingestion: "1. Memory Ingestion Tier" {
  style.fill: "#111827"
  style.stroke: "#3B82F6"
  style.stroke-width: 2
  ring_buffer: "Disruptor Ring Buffer (Lock-free CAS barrier)"
  backpressure: "High-watermark Producer Throttling"
}

partitioner: "2. Partition & Spill Manager" {
  style.fill: "#111827"
  style.stroke: "#10B981"
  style.stroke-width: 2
  hash_part: "MurmurHash3 Partition Router"
  spill_manager: "NVMe Spiller & K-Way External Sorter"
}

rocksdb: "3. RocksDB State Store" {
  style.fill: "#111827"
  style.stroke: "#F59E0B"
  style.stroke-width: 2
  lsm_tree: "MemTable, WAL & Leveled SSTables"
  bloom: "Bloom Filters & Block Cache"
}

checkpoint: "4. Checkpoint & Sink" {
  style.fill: "#111827"
  style.stroke: "#8B5CF6"
  style.stroke-width: 2
  chandy_lamport: "Chandy-Lamport Distributed Barrier"
  idempotent_sink: "Two-Phase Commit Idempotent Sink"
}

ingestion -> partitioner: "Drain Ring Buffer" {
  style.stroke: "#10B981"
  style.stroke-width: 2
}
partitioner -> rocksdb: "Keyed State Access" {
  style.stroke: "#F59E0B"
  style.stroke-width: 2
}
rocksdb -> checkpoint: "Barrier Snapshot Commit" {
  style.stroke: "#8B5CF6"
  style.stroke-width: 2
}