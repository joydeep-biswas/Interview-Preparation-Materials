direction: right
classes: {
  container: { style: { fill: "#111827"; stroke-width: 2; border-radius: 10 } }
  box: { style: { fill: "#1E293B"; stroke-width: 2; border-radius: 8 } }
  table_box: { style: { fill: "#1E293B"; stroke: "#38bdf8"; stroke-width: 2 } }
  blue_box: { style: { fill: "#1e293b"; stroke: "#38bdf8"; stroke-width: 2; border-radius: 8 } }
  green_box: { style: { fill: "#0f291e"; stroke: "#4ade80"; stroke-width: 2; border-radius: 8 } }
  amber_box: { style: { fill: "#231e12"; stroke: "#fbbf24"; stroke-width: 2; border-radius: 8 } }
  purple_box: { style: { fill: "#1e1b2e"; stroke: "#c084fc"; stroke-width: 2; border-radius: 8 } }
  red_box: { style: { fill: "#2b1111"; stroke: "#f87171"; stroke-width: 2; border-radius: 8 } }
}

ingestion: "1. Memory Ingestion Tier" {
  class: container
  style.fill: "#111827"
  style.stroke: "#3B82F6"
  style.stroke-width: 2
  ring_buffer: "Disruptor Ring Buffer (Lock-free CAS barrier)"
  backpressure: "High-watermark Producer Throttling"
}

partitioner: "2. Partition & Spill Manager" {
  class: container
  style.fill: "#111827"
  style.stroke: "#10B981"
  style.stroke-width: 2
  hash_part: "MurmurHash3 Partition Router"
  spill_manager: "NVMe Spiller & K-Way External Sorter"
}

rocksdb: "3. RocksDB State Store" {
  class: container
  style.fill: "#111827"
  style.stroke: "#F59E0B"
  style.stroke-width: 2
  lsm_tree: "MemTable, WAL & Leveled SSTables"
  bloom: "Bloom Filters & Block Cache"
}

checkpoint: "4. Checkpoint & Sink" {
  class: container
  style.fill: "#111827"
  style.stroke: "#8B5CF6"
  style.stroke-width: 2
  chandy_lamport: "Chandy-Lamport Distributed Barrier"
  idempotent_sink: "Two-Phase Commit Idempotent Sink"
}

ingestion -> partitioner: "Drain Ring Buffer" {
  style.stroke: "#10B981"
  style.stroke-width: 2
}
partitioner -> rocksdb: "Keyed State Access" {
  style.stroke: "#F59E0B"
  style.stroke-width: 2
}
rocksdb -> checkpoint: "Barrier Snapshot Commit" {
  style.stroke: "#8B5CF6"
  style.stroke-width: 2
}