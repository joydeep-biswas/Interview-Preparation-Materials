direction: right
classes: {
  container: { style: { fill: "#111827"; stroke-width: 2; border-radius: 10 } }
  box: { style: { fill: "#1E293B"; stroke-width: 2; border-radius: 8 } }
  table_box: { style: { fill: "#1E293B"; stroke: "#38bdf8"; stroke-width: 2 } }
  blue_box: { style: { fill: "#1e293b"; stroke: "#38bdf8"; stroke-width: 2; border-radius: 8 } }
  green_box: { style: { fill: "#0f291e"; stroke: "#4ade80"; stroke-width: 2; border-radius: 8 } }
  amber_box: { style: { fill: "#231e12"; stroke: "#fbbf24"; stroke-width: 2; border-radius: 8 } }
  purple_box: { style: { fill: "#1e1b2e"; stroke: "#c084fc"; stroke-width: 2; border-radius: 8 } }
  red_box: { style: { fill: "#2b1111"; stroke: "#f87171"; stroke-width: 2; border-radius: 8 } }
}

ingestion: "1. Azure Ingestion Tier" {
  class: container
  style.fill: "#111827"
  style.stroke: "#3B82F6"
  style.stroke-width: 2
  sources: "Salesforce, SAP, Event Hubs"
  adf: "Azure Data Factory (ADF CDC)"
  adls_bronze: "ADLS Gen2 Bronze (Raw Parquet)"
}

databricks: "2. Azure Databricks" {
  class: container
  style.fill: "#111827"
  style.stroke: "#8B5CF6"
  style.stroke-width: 2
  spark: "Spark Delta Lake Auto Loader"
  adls_silver: "ADLS Gen2 Silver (Curated)"
  unity: "Unity Catalog & Entra ID RBAC"
}

orchestration: "3. Orchestration & Load" {
  class: container
  style.fill: "#111827"
  style.stroke: "#F59E0B"
  style.stroke-width: 2
  airflow: "Airflow Orchestrator DAGs"
  snowpipe: "Snowpipe Event Grid Ingestion"
}

serving: "4. Snowflake DW & BI" {
  class: container
  style.fill: "#111827"
  style.stroke: "#10B981"
  style.stroke-width: 2
  snowflake: "Snowflake Enterprise Data Warehouse"
  powerbi: "PowerBI DirectQuery Dashboards"
}

ingestion -> databricks: "Ingest to Silver" {
  style.stroke: "#8B5CF6"
  style.stroke-width: 2
}
databricks -> orchestration: "Trigger Snowpipe" {
  style.stroke: "#F59E0B"
  style.stroke-width: 2
}
orchestration -> serving: "Continuous Load" {
  style.stroke: "#10B981"
  style.stroke-width: 2
}