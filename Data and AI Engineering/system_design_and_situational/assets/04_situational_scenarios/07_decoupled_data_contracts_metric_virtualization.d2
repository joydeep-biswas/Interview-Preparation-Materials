direction: right
classes: {
  container: { style: { fill: "#111827"; stroke-width: 2; border-radius: 10 } }
  box: { style: { fill: "#1E293B"; stroke-width: 2; border-radius: 8 } }
  table_box: { style: { fill: "#1E293B"; stroke: "#38bdf8"; stroke-width: 2 } }
  blue_box: { style: { fill: "#1e293b"; stroke: "#38bdf8"; stroke-width: 2; border-radius: 8 } }
  green_box: { style: { fill: "#0f291e"; stroke: "#4ade80"; stroke-width: 2; border-radius: 8 } }
  amber_box: { style: { fill: "#231e12"; stroke: "#fbbf24"; stroke-width: 2; border-radius: 8 } }
  purple_box: { style: { fill: "#1e1b2e"; stroke: "#c084fc"; stroke-width: 2; border-radius: 8 } }
  red_box: { style: { fill: "#2b1111"; stroke: "#f87171"; stroke-width: 2; border-radius: 8 } }
}

bronze: "Layer 1: Immutable Audit (Bronze)" {
  class: container
  style.fill: "#111827"
  style.stroke: "#3B82F6"
  style.stroke-width: 2
  raw: "Raw Append-Only Events (Kafka / S3)"
  contract: "Strict Data Contract (No filters applied)"
}

silver: "Layer 2: Standard Entities (Silver)" {
  class: container
  style.fill: "#111827"
  style.stroke: "#8B5CF6"
  style.stroke-width: 2
  entities: "Deduplicated Conformed Entities (SCD 2)"
  geo: "Standardized H3 Hex & UTC Time"
}

gold: "Layer 3: Virtualized Semantics (Gold)" {
  class: container
  style.fill: "#111827"
  style.stroke: "#10B981"
  style.stroke-width: 2
  dbt: "dbt Semantic Models & Dynamic Views"
  bi: "BI Dashboards & Executive ML Sinks"
}

bronze -> silver: "Conform & Deduplicate" {
  style.stroke: "#8B5CF6"
  style.stroke-width: 2
}
silver -> gold: "Semantic Virtualization" {
  style.stroke: "#10B981"
  style.stroke-width: 2
}