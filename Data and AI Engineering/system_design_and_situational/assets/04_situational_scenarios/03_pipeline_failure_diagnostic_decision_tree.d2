direction: down
classes: {
  container: { style: { fill: "#111827"; stroke-width: 2; border-radius: 10 } }
  box: { style: { fill: "#1E293B"; stroke-width: 2; border-radius: 8 } }
  table_box: { style: { fill: "#1E293B"; stroke: "#38bdf8"; stroke-width: 2 } }
  blue_box: { style: { fill: "#1e293b"; stroke: "#38bdf8"; stroke-width: 2; border-radius: 8 } }
  green_box: { style: { fill: "#0f291e"; stroke: "#4ade80"; stroke-width: 2; border-radius: 8 } }
  amber_box: { style: { fill: "#231e12"; stroke: "#fbbf24"; stroke-width: 2; border-radius: 8 } }
  purple_box: { style: { fill: "#1e1b2e"; stroke: "#c084fc"; stroke-width: 2; border-radius: 8 } }
  red_box: { style: { fill: "#2b1111"; stroke: "#f87171"; stroke-width: 2; border-radius: 8 } }
}

root: "Pipeline Failed / Breached SLA" {
  class: container
  style.fill: "#111827"
  style.stroke: "#EF4444"
  style.stroke-width: 2
  check: "Diagnostic Check: Where is failure logged?"
}

infra: "Suspect: Infrastructure Layer" {
  class: container
  style.fill: "#111827"
  style.stroke: "#3B82F6"
  style.stroke-width: 2
  err: "ExecutorLostFailure, OOMKilled Exit 137"
  fix: "Increase memory overhead, on-demand nodes"
}

data: "Suspect: Data & Schema Layer" {
  class: container
  style.fill: "#111827"
  style.stroke: "#10B981"
  style.stroke-width: 2
  err: "CastError, Schema Mismatch, NPE"
  fix: "Quarantine to DLQ, Enforce Data Contracts"
}

skew: "Suspect: Data Skew / Stragglers" {
  class: container
  style.fill: "#111827"
  style.stroke: "#F59E0B"
  style.stroke-width: 2
  err: "Single Task hangs for 45m then OOMs"
  fix: "Enable AQE Skew Join, Salt Hotspot Keys"
}

root -> infra: "Node Evicted / Exit 137" {
  style.stroke: "#3B82F6"
  style.stroke-width: 2
}
root -> data: "Schema Mismatch / Parse Failure" {
  style.stroke: "#10B981"
  style.stroke-width: 2
}
root -> skew: "Straggler Task / Skewed Partition" {
  style.stroke: "#F59E0B"
  style.stroke-width: 2
}