direction: right
classes: {
  container: { style: { fill: "#111827"; stroke-width: 2; border-radius: 10 } }
  box: { style: { fill: "#1E293B"; stroke-width: 2; border-radius: 8 } }
  table_box: { style: { fill: "#1E293B"; stroke: "#38bdf8"; stroke-width: 2 } }
  blue_box: { style: { fill: "#1e293b"; stroke: "#38bdf8"; stroke-width: 2; border-radius: 8 } }
  green_box: { style: { fill: "#0f291e"; stroke: "#4ade80"; stroke-width: 2; border-radius: 8 } }
  amber_box: { style: { fill: "#231e12"; stroke: "#fbbf24"; stroke-width: 2; border-radius: 8 } }
  purple_box: { style: { fill: "#1e1b2e"; stroke: "#c084fc"; stroke-width: 2; border-radius: 8 } }
  red_box: { style: { fill: "#2b1111"; stroke: "#f87171"; stroke-width: 2; border-radius: 8 } }
}

phase1: "Phase 1: Detection & Mitigation" {
  class: container
  style.fill: "#111827"
  style.stroke: "#EF4444"
  style.stroke-width: 2
  alert: "PagerDuty SLA Breach Alert"
  blast: "Blast Radius Assessment"
  contain: "Freeze Writes & Enable Dead-Letter Queue"
}

phase2: "Phase 2: RCA & Remediation" {
  class: container
  style.fill: "#111827"
  style.stroke: "#F59E0B"
  style.stroke-width: 2
  rca: "Spark UI Skew & Memory Heap Dump"
  patch: "Canary Hotfix Deployment"
  backfill: "Delta Lake Idempotent Backfill"
}

phase3: "Phase 3: Governance & Hardening" {
  class: container
  style.fill: "#111827"
  style.stroke: "#10B981"
  style.stroke-width: 2
  post_mortem: "Blameless Post-Mortem & Timeline"
  contracts: "Data Contracts & Schema Guardrails"
  hardening: "Circuit Breakers & Auto-Scaling"
}

phase1 -> phase2: "Containment Established" {
  style.stroke: "#F59E0B"
  style.stroke-width: 2
}
phase2 -> phase3: "Data Correctness Restored" {
  style.stroke: "#10B981"
  style.stroke-width: 2
}