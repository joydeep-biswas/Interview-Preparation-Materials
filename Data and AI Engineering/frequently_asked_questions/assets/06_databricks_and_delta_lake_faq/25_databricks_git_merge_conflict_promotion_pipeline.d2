# Databricks Git Merge Conflicts & Multi-Environment Promotion Pipeline
direction: right
classes: {
  box: { style: { fill: "#111827"; stroke-width: 2; border-radius: 10 } }
  stage: { style: { fill: "#1E293B"; stroke-width: 1.5; border-radius: 8 } }
}

promotion_pipeline: "Databricks Git Conflict Resolution & Dev -> UAT -> Prod Promotion" {
  class: box
  style.stroke: "#3B82F6"

  dev_conflict: "1. Dev Merge Conflict Resolution\n• Two devs edit same notebook / DAB bundle\n• Databricks Repos UI / CLI git pull --rebase\n• Modularize code into .py modules to avoid .ipynb JSON conflicts\n• Local pytest & bundle validate" {
    class: stage
    style.stroke: "#EF4444"
  }

  pr_ci: "2. Pull Request & Automated CI\n• PR to main branch\n• CI Pipeline: Flake8, Black, Pytest\n• databricks bundle validate -t dev\n• Peer code review & branch protection" {
    class: stage
    style.stroke: "#F59E0B"
  }

  uat_deploy: "3. Automated UAT Staging\n• Merge triggers automated CD to UAT\n• databricks bundle deploy -t uat\n• Run integration tests against sample lakehouse\n• Automated data quality validation" {
    class: stage
    style.stroke: "#3B82F6"
  }

  prod_gate: "4. Production Release Gate\n• Manual release approval gate\n• Deploy via Service Principal (SPN)\n• databricks bundle deploy -t prod\n• Automated canary test & Slack notification" {
    class: stage
    style.stroke: "#10B981"
  }

  dev_conflict -> pr_ci -> uat_deploy -> prod_gate
}

