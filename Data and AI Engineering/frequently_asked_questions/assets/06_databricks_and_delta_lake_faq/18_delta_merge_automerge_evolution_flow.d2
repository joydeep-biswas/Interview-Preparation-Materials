direction: right
classes: {
  source_node: { style: { fill: "#111827"; stroke: "#3B82F6"; stroke-width: 2; border-radius: 8 } }
  check_node: { style: { fill: "#1E293B"; stroke: "#F59E0B"; stroke-width: 2; border-radius: 8 } }
  evolve_node: { style: { fill: "#064E3B"; stroke: "#10B981"; stroke-width: 2; border-radius: 8 } }
  error_node: { style: { fill: "#7F1D1D"; stroke: "#EF4444"; stroke-width: 2; border-radius: 8 } }
}

IncomingBatch: "Incoming Upsert Batch\nContains new column: 'tax_exempt'\nDelta MERGE Statement" { class: source_node }
AutoMergeCheck: "Session Config Check\nspark.databricks.delta.schema\n.autoMerge.enabled == true?" { class: check_node }
TypeCheck: "Type Compatibility\nVerify widened scalar type\n(e.g., Short to Int)" { class: check_node }

CommitLog: "Commit to _delta_log\nAppends new column to schema\nNon-matching rows receive NULL" { class: evolve_node }
Rejection: "AnalysisException: Cannot Resolve\nTarget Schema Strictly Enforced\nTransaction Aborted & Rolled Back" { class: error_node }
Quarantine: "Quarantine / DLQ Sink\nIncompatible Type Mutation\nAlerts Oncall Engineer" { class: error_node }

IncomingBatch -> AutoMergeCheck: "Execute MERGE"
AutoMergeCheck -> Rejection: "No: autoMerge is FALSE"
AutoMergeCheck -> TypeCheck: "Yes: autoMerge is TRUE"
TypeCheck -> CommitLog: "Compatible Type"
TypeCheck -> Quarantine: "Incompatible Type"
