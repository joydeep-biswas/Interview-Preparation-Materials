direction: right
classes: {
  box: { style: { fill: "#111827"; stroke-width: 2; rx: 10 } }
}

s1: "Stage 1: Compaction (OPTIMIZE)" {
  class: box
  style.stroke: "#3B82F6"
  small: "Fragmented Small Files (1MB-5MB)" -> comp: "Uniform 1 GB Parquet Files\nBin-packed active files"
}

s2: "Stage 2: Clustering (Z-ORDER)" {
  class: box
  style.stroke: "#10B981"
  unclust: "Compacted Parquet" -> zord: "Clustered Parquet Files\nMin/Max Zone Maps enable 90%+ skipping"
}

s3: "Stage 3: Purging (VACUUM)" {
  class: box
  style.stroke: "#F59E0B"
  tomb: "Tombstoned Parquet Files" -> purge: "Purged Cloud Storage\nVACUUM table RETAIN 168 HOURS"
}

s1.comp -> s2.unclust: "Optimized Layout"
s1.small -> s3.tomb: "Leaves Obsolete History"
