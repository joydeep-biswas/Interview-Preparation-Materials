direction: right
classes: {
  box: { style: { fill: "#111827"; stroke-width: 2; border-radius: 10 } }
}

raw: "Upstream Ingestion Batch\n(customer_zip: STRING '07030', +2 New Columns)" { class: box; style.stroke: "#3B82F6" }
gate: "Schema Gatekeeper\nDelta Table vs Incoming Schema" { class: box; style.stroke: "#8B5CF6" }

auto_merge: "Merge Schema (.option('mergeSchema', 'true'))\nAppends is_verified, loyalty_tier" { class: box; style.stroke: "#10B981" }
type_branch: "Incompatible Type Branch\n(INT -> STRING for customer_zip)" { class: box; style.stroke: "#EF4444" }

quar: "Quarantine Table: silver.raw_schema_quarantine\nIsolate corrupt batch with schema diff metadata" { class: box; style.stroke: "#EF4444" }
mig: "Automated Column Migration Protocol:\nRename zip -> zip_legacy_int\nAdd customer_zip STRING\nBackfill CAST(zip_legacy_int AS STRING)" { class: box; style.stroke: "#10B981" }

target: "Target Delta Table\nZero Downstream Breakdown!" { class: box; style.stroke: "#10B981" }

raw -> gate
gate -> auto_merge: "New Compatible Columns"
gate -> type_branch: "Type Incompatibility"
type_branch -> quar
type_branch -> mig
auto_merge -> target
mig -> target