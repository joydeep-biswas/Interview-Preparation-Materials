direction: right
classes: {
  box: { style: { fill: "#111827"; stroke-width: 2; rx: 10 } }
}

gov: "1. Governance Isolation (Unity Catalog)\nTenant Catalogs with Dedicated Storage Credentials" { class: box; style.stroke: "#10B981" }
comp: "2. Compute Isolation (Cluster Policies)\nRestricted node sizes, max workers, auto-termination" { class: box; style.stroke: "#F59E0B" }
net: "3. Network & Identity Isolation\nSCIM Azure AD sync, VNet injection, Private Link" { class: box; style.stroke: "#8B5CF6" }
cost: "4. FinOps & Cost Attribution\nCustom cluster tags + system.billing.usage attribution" { class: box; style.stroke: "#3B82F6" }

gov -> comp -> net -> cost
