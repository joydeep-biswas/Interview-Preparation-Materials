direction: right
classes: {
  box: { style: { fill: "#111827"; stroke-width: 2; rx: 10 } }
}

init: "Table Version V0: part-00005.parquet\nContains rows: Merchant M100 AND M200" { class: box; style.stroke: "#3B82F6" }

jobs: "Concurrent Pipelines" {
  class: box
  style.stroke: "#8B5CF6"
  ja: "Job A: UPDATE merchant_id = 'M100'"
  jb: "Job B: UPDATE merchant_id = 'M200'"
}

init -> jobs.ja
init -> jobs.jb

commit_a: "Commit V1 Succeeded!\nJob A replaces part-00005 with part-00005-A" { class: box; style.stroke: "#10B981" }
conflict: "OCC Conflict Check:\nWas part-00005 modified by concurrent txn?" { class: box; style.stroke: "#F59E0B" }
crash_b: "⛔ DeltaConcurrentModificationException\nJob B aborts to prevent overwriting M100!" { class: box; style.stroke: "#EF4444" }

jobs.ja -> commit_a: "Finishes First"
jobs.jb -> conflict: "Attempts V2 Commit"
commit_a -> conflict
conflict -> crash_b: "YES: Target File Modified"
