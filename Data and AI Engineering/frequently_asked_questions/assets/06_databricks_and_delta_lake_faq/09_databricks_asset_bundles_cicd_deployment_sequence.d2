direction: right
classes: {
  card: { style: { fill: "#111827"; stroke-width: 2; border-radius: 8 } }
}

dev: "Data Engineer" { class: card; style.stroke: "#3B82F6" }
git: "GitHub / Azure Repos" { class: card; style.stroke: "#F59E0B" }
ci: "CI Actions Runner" { class: card; style.stroke: "#8B5CF6" }
staging: "Databricks Staging" { class: card; style.stroke: "#10B981" }
prod: "Databricks Production" { class: card; style.stroke: "#10B981" }

dev -> git: "Push branch & open PR"
git -> ci: "Trigger lint, mypy, pytest"
ci -> git: "Tests Pass & Approved"
dev -> git: "Merge to main"
git -> ci: "Trigger CD Deployment"
ci -> staging: "bundle deploy -t staging"
ci -> prod: "bundle deploy -t prod"