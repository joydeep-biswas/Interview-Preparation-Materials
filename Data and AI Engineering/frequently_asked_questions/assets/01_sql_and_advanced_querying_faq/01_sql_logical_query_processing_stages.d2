direction: right
classes: {
  pillar: { style: { fill: "#111827"; stroke-width: 2; rx: 10 } }
  stage: { style: { fill: "#1E293B"; stroke-width: 1.5; rx: 8 } }
}

stage1: "Stage 1: Source & Ingestion" {
  class: pillar
  style.stroke: "#3B82F6"
  s1: "1. FROM & JOINs\nCross products, ON predicates & virtual tables" { class: stage; style.stroke: "#3B82F6" }
  s2: "2. WHERE\nFilter rows prior to grouping (prune scan volume)" { class: stage; style.stroke: "#3B82F6" }
  s1 -> s2
}

stage2: "Stage 2: Grouping & Aggregation" {
  class: pillar
  style.stroke: "#F59E0B"
  s3: "3. GROUP BY\nBucket rows into discrete aggregate groups" { class: stage; style.stroke: "#F59E0B" }
  s4: "4. HAVING\nFilter aggregated metrics (post-grouping prune)" { class: stage; style.stroke: "#F59E0B" }
  s3 -> s4
}

stage3: "Stage 3: Projection & Sets" {
  class: pillar
  style.stroke: "#10B981"
  s5: "5. SELECT\nEvaluate expressions, scalar math & aliases" { class: stage; style.stroke: "#10B981" }
  s6: "6. DISTINCT\nHash/sort deduplication across projected columns" { class: stage; style.stroke: "#10B981" }
  s7: "7. UNION / INTERSECT\nCombine rowsets from distinct subqueries" { class: stage; style.stroke: "#10B981" }
  s5 -> s6 -> s7
}

stage4: "Stage 4: Ordering & Limiting" {
  class: pillar
  style.stroke: "#8B5CF6"
  s8: "8. ORDER BY\nSort final unified result set (aliases visible)" { class: stage; style.stroke: "#8B5CF6" }
  s9: "9. LIMIT / OFFSET\nRestrict output cardinality for client" { class: stage; style.stroke: "#EF4444" }
  s8 -> s9
}

stage1.s2 -> stage2.s3: "Filtered Stream"
stage2.s4 -> stage3.s5: "Aggregated Groups"
stage3.s7 -> stage4.s8: "Projected Rows"
