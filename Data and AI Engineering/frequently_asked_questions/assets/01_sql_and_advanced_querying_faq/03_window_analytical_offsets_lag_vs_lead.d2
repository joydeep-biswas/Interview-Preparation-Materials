direction: right
classes: {
  box: { style: { fill: "#111827"; stroke-width: 2; border-radius: 10 } }
}

r1: "Row N-1 (Previous Month)\nSales: \$80,000" { class: box; style.stroke: "#3B82F6" }
r2: "Row N (Current Month)\nSales: \$95,000" { class: box; style.stroke: "#10B981" }
r3: "Row N+1 (Next Month)\nSales: \$110,000" { class: box; style.stroke: "#F59E0B" }

r1 -> r2: "LAG(sales, 1) -> \$80,000"
r2 -> r3: "LEAD(sales, 1) -> \$110,000"