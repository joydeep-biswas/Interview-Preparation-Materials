direction: right
classes: {
  box: { style: { fill: "#111827"; stroke-width: 2; border-radius: 10 } }
}

full_outer: "Step 1: FULL OUTER JOIN Evaluation" {
  unmatched_l: "Unmatched Left: (A - B)\nLeft row + NULL right columns" { class: box; style.stroke: "#3B82F6" }
  matched: "Matched Center: (A ∩ B)\nLeft row + Right row matched" { class: box; style.stroke: "#64748B" }
  unmatched_r: "Unmatched Right: (B - A)\nNULL left + Right row columns" { class: box; style.stroke: "#3B82F6" }
}

filter_gate: "Exclusion Filter Gate\nWHERE a.id IS NULL OR b.id IS NULL" {
  class: box
  style.stroke: "#F59E0B"
}

emitted: "Step 2: Emitted Symmetric Difference (A △ B)\nRetains exclusive outer rows from both tables" {
  class: box
  style.stroke: "#10B981"
}

discard: "Pruned Stream (Intersection)\nMatched rows discarded by NULL predicate" {
  class: box
  style.stroke: "#EF4444"
}

full_outer.unmatched_l -> filter_gate: { style.stroke: "#3B82F6" }
full_outer.matched -> filter_gate: { style.stroke: "#64748B" }
full_outer.unmatched_r -> filter_gate: { style.stroke: "#3B82F6" }

filter_gate -> emitted: "Passes (Has NULL)" { style.stroke: "#10B981" }
filter_gate -> discard: "Fails (Both Present)" { style.stroke: "#EF4444" }
