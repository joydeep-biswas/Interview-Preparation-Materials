direction: right
classes: {
  box: { style: { fill: "#111827"; stroke-width: 2; border-radius: 10 } }
}

problem: "Problem: Sparse Dates (Missing Oct 2, 3, 4)\nROWS BETWEEN 6 PRECEDING takes prior 6 physical records\nCovers 12 calendar days instead of 7 -> INCORRECT!" {
  style.stroke: "#EF4444"
}

spine: "dim_date Calendar Spine\nGenerates continuous sequence Oct 1..Oct 7" {
  class: box
  style.stroke: "#3B82F6"
}

coalesce: "LEFT JOIN & COALESCE(sales, 0)\nFills sparse gaps with \$0.00" {
  class: box
  style.stroke: "#F59E0B"
}

exact_win: "ROWS BETWEEN 6 PRECEDING AND CURRENT ROW\nGuarantees exact 7-calendar-day rolling sum" {
  class: box
  style.stroke: "#10B981"
}

problem -> spine: "Resolve via Spine"
spine -> coalesce -> exact_win