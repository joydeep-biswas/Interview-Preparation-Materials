direction: right
classes: {
  box: { style: { fill: "#111827"; stroke-width: 2; border-radius: 10 } }
}

case1: "Case 1: Standard Cartesian Product (A x B)" {
  a1: "Table A: 10 Rows\ne.g., Regions" { class: box; style.stroke: "#3B82F6" }
  b1: "Table B: 20 Rows\ne.g., Products" { class: box; style.stroke: "#3B82F6" }
  out1: "Cartesian Join Result\n10 x 20 = 200 Rows Emitted" { class: box; style.stroke: "#10B981" }
  a1 -> out1: { style.stroke: "#10B981" }
  b1 -> out1: { style.stroke: "#10B981" }
}

case2: "Case 2: Empty Set Annihilation (0 x B)" {
  a2: "Table A: Empty Set (0 Rows)\nFilter pruned all rows" { class: box; style.stroke: "#EF4444" }
  b2: "Table B: 20 Rows\nPopulated dimension" { class: box; style.stroke: "#3B82F6" }
  out2: "Cartesian Join Result\n0 x 20 = 0 Rows (Empty Output)" { class: box; style.stroke: "#EF4444" }
  a2 -> out2: { style.stroke: "#EF4444" }
  b2 -> out2: { style.stroke: "#EF4444" }
}
