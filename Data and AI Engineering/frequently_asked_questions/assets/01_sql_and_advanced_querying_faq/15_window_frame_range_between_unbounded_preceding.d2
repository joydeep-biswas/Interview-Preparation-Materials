direction: right
classes: {
  box: { style: { fill: "#111827"; stroke-width: 2; border-radius: 10 } }
}

raw: "Transaction Rows\n(Cust A, Cust A, Cust B)" { class: box; style.stroke: "#3B82F6" }
engine: "Window Partitioning Engine\nPartition: Cust A | Partition: Cust B" { class: box; style.stroke: "#F59E0B" }
eval: "Rank Calculator\nCalculate RANK() inside each partition" { class: box; style.stroke: "#8B5CF6" }
proj: "Projected Output\nRetains original rows + rank column" { class: box; style.stroke: "#10B981" }

raw -> engine -> eval -> proj