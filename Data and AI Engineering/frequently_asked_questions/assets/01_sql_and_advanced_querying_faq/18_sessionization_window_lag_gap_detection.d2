direction: right
classes: {
  box: { style: { fill: "#111827"; stroke-width: 2; border-radius: 10 } }
}

events: "User Clickstream Events\nTimestamp sequence" { class: box; style.stroke: "#3B82F6" }
lag: "LAG(event_time, 1)\nCompute inactivity duration" { class: box; style.stroke: "#8B5CF6" }
flag: "New Session Flag\n1 if gap &gt; 30m or NULL, else 0" { class: box; style.stroke: "#F59E0B" }
session: "Cumulative Session ID\nSUM(is_new_session) OVER (ORDER BY time)\nAssigns stable session IDs" { class: box; style.stroke: "#10B981" }

events -> lag -> flag -> session