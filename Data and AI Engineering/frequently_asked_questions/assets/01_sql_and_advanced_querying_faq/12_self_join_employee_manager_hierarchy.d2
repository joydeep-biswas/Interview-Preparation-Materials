direction: right
classes: {
  box: { style: { fill: "#111827"; stroke-width: 1.5; rx: 10 } }
}

emp: "Employee Table (e)\nID: 1 | Salary: $80,000 | manager_id: 2" { class: box; style.stroke: "#3B82F6" }
mgr: "Manager Table (m)\nID: 2 | Salary: $70,000" { class: box; style.stroke: "#3B82F6" }

join: "Self-Join on e.manager_id = m.id\nEvaluates e.salary &gt; m.salary" { class: box; style.stroke: "#F59E0B" }
flagged: "Employee ID: 1 (FLAGGED!)\nEarns more than their manager ($80k &gt; $70k)" { class: box; style.stroke: "#10B981" }

emp -> join
mgr -> join
join -> flagged: "True (80k &gt; 70k)"
