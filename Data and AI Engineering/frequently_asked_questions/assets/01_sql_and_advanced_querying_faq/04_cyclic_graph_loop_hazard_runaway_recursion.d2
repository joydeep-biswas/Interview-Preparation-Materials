direction: right
classes: {
  box: { style: { fill: "#111827"; stroke-width: 2; border-radius: 10 } }
}

a: "Employee A\n(Reports to Manager B)" { class: box; style.stroke: "#3B82F6" }
b: "Manager B\n(Reports to Director C)" { class: box; style.stroke: "#3B82F6" }
c: "Director C\n(Data Error: Reports to A!)" { class: box; style.stroke: "#EF4444" }

a -> b: "reports_to" { style.stroke: "#3B82F6" }
b -> c: "reports_to" { style.stroke: "#3B82F6" }
c -> a: "CYCLE HAZARD!\nInfinite CTE Recursion" {
  style: {
    stroke: "#EF4444"
    stroke-dash: 4
  }
}
