direction: right
classes: {
  pillar: { style: { fill: "#111827"; stroke-width: 2; border-radius: 10 } }
  stage: { style: { fill: "#1E293B"; stroke-width: 2; border-radius: 8 } }
}

union_all: "UNION ALL: Streaming Append (O(1) Memory)" {
  class: pillar
  style.stroke: "#10B981"
  q1: "Query 1 (10M rows)" { class: stage; style.stroke: "#3B82F6" }
  q2: "Query 2 (10M rows)" { class: stage; style.stroke: "#3B82F6" }
  concat: "Stream Concatenator\nZero hash table / zero deduplication" { class: stage; style.stroke: "#10B981" }
  out_all: "Output: 20M rows\nSub-second execution, O(1) Memory" { class: stage; style.stroke: "#10B981" }

  q1 -> concat: { style.stroke: "#10B981" }
  q2 -> concat: { style.stroke: "#10B981" }
  concat -> out_all: { style.stroke: "#10B981" }
}

union_dist: "UNION DISTINCT: Hash Deduplication (High Memory)" {
  class: pillar
  style.stroke: "#EF4444"
  qa: "Query 1 (10M rows)" { class: stage; style.stroke: "#3B82F6" }
  qb: "Query 2 (10M rows)" { class: stage; style.stroke: "#3B82F6" }
  hash_table: "Wide Hash Table / Shuffle\nBuilds 20M entry hash in RAM" { class: stage; style.stroke: "#EF4444" }
  out_dist: "Output: 18M rows\nHigh CPU, disk I/O & latency" { class: stage; style.stroke: "#EF4444" }

  qa -> hash_table: { style.stroke: "#EF4444" }
  qb -> hash_table: { style.stroke: "#EF4444" }
  hash_table -> out_dist: { style.stroke: "#EF4444" }
}
