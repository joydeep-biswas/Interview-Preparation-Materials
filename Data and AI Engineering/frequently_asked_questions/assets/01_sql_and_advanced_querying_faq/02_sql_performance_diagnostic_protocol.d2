direction: right
classes: {
  box: { style: { fill: "#111827"; stroke-width: 1.5; rx: 10 } }
}

s1: "Step 1: Inspect Execution Plan\nEXPLAIN (ANALYZE, BUFFERS) / SET STATISTICS IO" { class: box; style.stroke: "#3B82F6" }
s2: "Step 2: Check System Concurrency\nLock wait analysis, blocking sessions & disk spill" { class: box; style.stroke: "#3B82F6" }
s3: "Step 3: Analyze Cardinality & Stats\nOutdated histogram stats, Cartesian explosions" { class: box; style.stroke: "#F59E0B" }
s4: "Step 4: Join Operator Review\nNested Loop vs Hash Join vs Merge Join" { class: box; style.stroke: "#8B5CF6" }
s5: "Step 5: Apply Remediation\nCovering indexes, partition pruning, query rewrites" { class: box; style.stroke: "#10B981" }

s1 -> s2: "Plan Baseline"
s2 -> s3: "Locking Cleared"
s3 -> s4: "Cardinality Verified"
s4 -> s5: "Operator Tuned"
