direction: right
classes: {
  pillar: { style: { fill: "#111827"; stroke-width: 2; border-radius: 10 } }
  stage: { style: { fill: "#1E293B"; stroke-width: 2; border-radius: 8 } }
}

pipeline: "1. Analysis Pipeline" {
  class: pillar
  style.stroke: "#3B82F6"
  explain: "EXPLAIN (ANALYZE, BUFFERS)\nInspect actual execution time & scan nodes" { class: stage; style.stroke: "#3B82F6" }
  metrics: "Buffer & I/O Profiling\nCheck cache hit ratio vs disk block reads" { class: stage; style.stroke: "#3B82F6" }
  explain -> metrics { style.stroke: "#3B82F6" }
}

decision: "2. Diagnostic Decision Tree" {
  class: pillar
  style.stroke: "#F59E0B"
  check_scan: "Decision 1: Seq Scan on Large Table?\nMissing index causing full table scan" { class: stage; style.stroke: "#F59E0B" }
  check_stats: "Decision 2: Stale Statistics?\nActual rows >> Planner estimated rows" { class: stage; style.stroke: "#F59E0B" }
  check_scan -> check_stats: "No" { style.stroke: "#F59E0B" }
}

remediation: "3. Remediation Strategies" {
  class: pillar
  style.stroke: "#10B981"
  fix_index: "Fix 1: CREATE INDEX CONCURRENTLY\nAdd B-tree / BRIN index on filter cols" { class: stage; style.stroke: "#10B981" }
  fix_stats: "Fix 2: Run ANALYZE (Refresh Stats)\nRecalculate histograms & MCV lists" { class: stage; style.stroke: "#10B981" }
  fix_mem: "Fix 3: Query Rewrite & work_mem\nIncrease work_mem to eliminate spill" { class: stage; style.stroke: "#F59E0B" }
}

pipeline.explain -> decision.check_scan { style.stroke: "#3B82F6" }
decision.check_scan -> remediation.fix_index: "Yes (Missing Index)" { style.stroke: "#10B981" }
decision.check_stats -> remediation.fix_stats: "Yes (Stale Stats)" { style.stroke: "#10B981" }
decision.check_stats -> remediation.fix_mem: "No (Spill to Disk)" { style.stroke: "#F59E0B" }
