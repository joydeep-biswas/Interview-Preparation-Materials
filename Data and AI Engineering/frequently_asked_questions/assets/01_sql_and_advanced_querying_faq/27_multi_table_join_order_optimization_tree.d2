direction: right
classes: {
  box: { style: { fill: "#111827"; stroke-width: 1.5; rx: 10 } }
}

inputs: "Multi-Table Sources" {
  orders: "orders\n(order_id, customer_id, order_date)" { class: box; style.stroke: "#3B82F6" }
  items: "order_items\n(order_id, product_id, line_total)" { class: box; style.stroke: "#3B82F6" }
  prods: "products\n(product_id, category_id)" { class: box; style.stroke: "#3B82F6" }
}

join_node: "Multi-Table Relational Join\nGROUP BY customer_id, order_month" {
  class: box
  style.stroke: "#F59E0B"
}

diversity: "Diversity Filter Gate\nCOUNT(DISTINCT category_id) &gt;= 3" {
  class: box
  style.stroke: "#8B5CF6"
}

win_rank: "DENSE_RANK() OVER\n(PARTITION BY month ORDER BY revenue DESC)" {
  class: box
  style.stroke: "#10B981"
}

top3: "Top 3 Diversified Customers per Month" {
  class: box
  style.stroke: "#10B981"
}

inputs.orders -> join_node
inputs.items -> join_node
inputs.prods -> join_node

join_node -> diversity -> win_rank -> top3
