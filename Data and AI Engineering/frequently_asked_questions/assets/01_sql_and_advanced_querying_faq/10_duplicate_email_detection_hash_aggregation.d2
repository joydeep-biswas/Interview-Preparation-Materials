direction: right
classes: {
  box: { style: { fill: "#111827"; stroke-width: 1.5; rx: 10 } }
}

raw: "Person Records\n(id, email tuples)" { class: box; style.stroke: "#3B82F6" }
hash_group: "Hash Aggregate on Email\nBucket by HASH(email) -> COUNT(*)" { class: box; style.stroke: "#F59E0B" }

dupes: "Duplicate Emails (FLAGGED!)\nCOUNT(id) &gt; 1" { class: box; style.stroke: "#EF4444" }
unique: "Unique Emails (Discarded)\nCOUNT(id) = 1" { class: box; style.stroke: "#10B981" }

raw -> hash_group: "Stream Records"
hash_group -> dupes: "HAVING COUNT &gt; 1"
hash_group -> unique: "HAVING COUNT = 1"
