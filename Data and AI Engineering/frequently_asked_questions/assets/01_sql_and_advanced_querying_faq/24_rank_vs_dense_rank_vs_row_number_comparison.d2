direction: right
classes: {
  box: { style: { fill: "#111827"; stroke-width: 2; border-radius: 10 } }
}

salaries: "Engineering Salaries\nAlice: \$150k\nBob: \$120k\nCharlie: \$120k (Tie)\nDavid: \$100k" {
  class: box
  style.stroke: "#3B82F6"
}

row_num: "ROW_NUMBER()\nAlice -> 1\nBob -> 2\nCharlie -> 3 (Arbitrary)\nDavid -> 4" {
  style.stroke: "#8B5CF6"
}

rank_func: "RANK()\nAlice -> 1\nBob -> 2\nCharlie -> 2 (Tie)\nDavid -> 4 (Gap at 3!)" {
  style.stroke: "#F59E0B"
}

dense_rank: "DENSE_RANK()\nAlice -> 1\nBob -> 2\nCharlie -> 2 (Tie)\nDavid -> 3 (NO GAP!)" {
  style.stroke: "#10B981"
}

salaries -> row_num
salaries -> rank_func
salaries -> dense_rank