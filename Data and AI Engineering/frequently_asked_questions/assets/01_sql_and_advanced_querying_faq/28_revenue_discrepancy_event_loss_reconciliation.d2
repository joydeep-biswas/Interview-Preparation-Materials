direction: right
classes: {
  pillar: { style: { fill: "#111827"; stroke-width: 2; border-radius: 10 } }
  stage: { style: { fill: "#1E293B"; stroke-width: 2; border-radius: 8 } }
}

alert: "Production Anomaly Detected\nDashboard Revenue: \$1,180,000\nLedger Revenue: \$1,000,000 (+18% Discrepancy!)" {
  class: pillar
  style.stroke: "#EF4444"
}

runbook: "4-Step SQL Diagnostic Runbook" {
  class: pillar
  style.stroke: "#3B82F6"
  s1: "Step 1: Record Count Reconciliation\nCOUNT(*) vs COUNT(DISTINCT order_id)" { class: stage; style.stroke: "#3B82F6" }
  s2: "Step 2: Join Fan-Out Detection\nCheck for duplicate PKs in joined dimension tables" { class: stage; style.stroke: "#EF4444" }
  s3: "Step 3: Temporal Alignment Audit\nReconcile UTC vs local business timezone boundaries" { class: stage; style.stroke: "#3B82F6" }
  s4: "Step 4: Status Mutation Lag\nAudit updated_at &gt; created_at transaction status shifts" { class: stage; style.stroke: "#3B82F6" }
}

root_cause: "Root Cause Isolated &amp; Fixed\ndim_merchant had duplicate active rows for 18% of sellers\ncausing a 1.18x Cartesian fan-out multiplication!" {
  class: pillar
  style.stroke: "#10B981"
}

alert -> runbook.s1
runbook.s2 -> root_cause: "Fan-Out Isolated"