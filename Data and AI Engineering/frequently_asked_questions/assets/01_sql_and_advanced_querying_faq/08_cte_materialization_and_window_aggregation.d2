direction: right
classes: {
  pillar: { style: { fill: "#111827"; stroke-width: 2; border-radius: 10 } }
  stage: { style: { fill: "#1E293B"; stroke-width: 2; border-radius: 8 } }
}

cte: "1. CTE: RunningTotalsByDept" {
  class: pillar
  style.stroke: "#3B82F6"
  e1: "Alice | Dept: 10 | Sal: \$5,000" { class: stage; style.stroke: "#3B82F6" }
  e2: "Bob   | Dept: 10 | Sal: \$6,000" { class: stage; style.stroke: "#3B82F6" }
  e3: "Carol | Dept: 20 | Sal: \$7,000" { class: stage; style.stroke: "#3B82F6" }
}

window_calc: "2. Window Frame Execution" {
  class: pillar
  style.stroke: "#8B5CF6"
  w1: "Alice: Dept 10 | Running: \$5,000" { class: stage; style.stroke: "#8B5CF6" }
  w2: "Bob:   Dept 10 | Running: \$11,000" { class: stage; style.stroke: "#8B5CF6" }
  w3: "Carol: Dept 20 | Running: \$7,000" { class: stage; style.stroke: "#8B5CF6" }
}

final_filter: "3. Outer Query Filter" {
  class: pillar
  style.stroke: "#10B981"
  f1: "Alice: Dept 10 | Keep (Pass)" { class: stage; style.stroke: "#10B981" }
  f2: "Bob:   Dept 10 | DISCARD (> \$10k)" { class: stage; style.stroke: "#EF4444" }
  f3: "Carol: Dept 20 | Keep (Pass)" { class: stage; style.stroke: "#10B981" }
}

cte.e1 -> window_calc.w1
cte.e2 -> window_calc.w2
cte.e3 -> window_calc.w3

window_calc.w1 -> final_filter.f1
window_calc.w2 -> final_filter.f2
window_calc.w3 -> final_filter.f3