direction: right
classes: {
  card: { style: { fill: "#111827"; stroke-width: 2; border-radius: 8 } }
}

app: "Ingestion App\nHikariCP / HTTP Pool" { class: card; style.stroke: "#3B82F6" }
nat: "Cloud NAT / Firewall\nIdle Timeout: 350s" { class: card; style.stroke: "#F59E0B" }
db: "Downstream DB / API\nPostgreSQL / Spanner" { class: card; style.stroke: "#10B981" }

app -> nat: "1. Handshake & Query 1"
nat -> db: "Forward Query 1"
db -> app: "Query 1 OK"
nat -> nat: "400s Idle -> Drop TCP state!"
app -> nat: "2. Reuses idle socket -> Query 2"
nat -> app: "TCP RST: Drop connection!"