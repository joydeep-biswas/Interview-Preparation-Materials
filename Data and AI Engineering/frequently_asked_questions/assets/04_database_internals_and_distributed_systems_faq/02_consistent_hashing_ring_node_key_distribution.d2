direction: right
classes: {
  node: { style: { fill: "#111827"; stroke: "#3B82F6"; stroke-width: 2; border-radius: 8 } }
  key: { style: { fill: "#1E293B"; stroke: "#10B981"; stroke-width: 2; border-radius: 6 } }
}

node_a: "Node A\nAngle: 0°" { class: node }
key_1: "Key 1\nAngle: 45° -> Node B" { class: key }
node_b: "Node B\nAngle: 90°" { class: node }
key_2: "Key 2\nAngle: 150° -> Node C" { class: key }
node_c: "Node C\nAngle: 210°" { class: node }
key_3: "Key 3\nAngle: 320° -> Node A" { class: key }

node_a -> key_1 -> node_b -> key_2 -> node_c -> key_3 -> node_a: "Clockwise Range Walk"