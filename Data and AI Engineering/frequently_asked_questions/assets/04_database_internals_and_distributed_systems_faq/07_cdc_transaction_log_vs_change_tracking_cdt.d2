direction: right
classes: {
  box: { style: { fill: "#111827"; stroke-width: 2; border-radius: 10 } }
}

txns: "Source Database DML Operations\nRow 101 INSERT: \$100\nRow 101 UPDATE: \$150\nRow 101 UPDATE: \$200" {
  class: box
  style.stroke: "#64748B"
}

cdc: "Log-Based CDC (Debezium / Oracle GoldenGate)\nReads Database WAL\nPublishes Full Historical Audit Stream\nEvent 1: INSERT \$100\nEvent 2: UPDATE \$100 -> \$150\nEvent 3: UPDATE \$150 -> \$200" {
  style.stroke: "#3B82F6"
}

cdt: "Change Tracking / CDT (Lightweight Sync)\nsys.change_tracking_tables\nRow 101: Op='U', Version=42\n(No intermediate values recorded)\nETL fetches latest base row: \$200" {
  class: box
  style.stroke: "#10B981"
}

txns -> cdc: "Async Log Capture"
txns -> cdt: "Internal Version Counter"