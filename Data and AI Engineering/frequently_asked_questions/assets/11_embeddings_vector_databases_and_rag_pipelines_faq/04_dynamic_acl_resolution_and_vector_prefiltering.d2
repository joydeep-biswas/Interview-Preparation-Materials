direction: right
classes: {
  blue_box: { style: { fill: "#111827", stroke: "#3B82F6", stroke-width: 2 } }
  amber_box: { style: { fill: "#111827", stroke: "#F59E0B", stroke-width: 2 } }
  purple_box: { style: { fill: "#0D1526", stroke: "#8B5CF6", stroke-width: 2 } }
  green_box: { style: { fill: "#064E3B", stroke: "#10B981", stroke-width: 2 } }
}

UserQuery: "Incoming Request\nBearer JWT: Alice" { class: blue_box }
IAM: "IAM Token Context\nUser: alice, Groups: ENG" { class: amber_box }
VectorDB: "Vector Pre-Filter (Qdrant)\nEvaluated before HNSW walk" { class: purple_box }
CleanCandidates: "Authorized Chunks\nZero data leakage" { class: green_box }

UserQuery -> IAM -> VectorDB -> CleanCandidates
