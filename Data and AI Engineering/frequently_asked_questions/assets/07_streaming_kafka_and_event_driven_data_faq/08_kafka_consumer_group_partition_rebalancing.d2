direction: right
classes: {
  part: { style: { fill: "#111827"; stroke: "#3B82F6"; stroke-width: 1.5; rx: 6 } }
  active: { style: { fill: "#064E3B"; stroke: "#10B981"; stroke-width: 1.5; rx: 6 } }
  idle: { style: { fill: "#7F1D1D"; stroke: "#EF4444"; stroke-width: 1.5; rx: 6 } }
}

partitions: "Kafka Topic (12 Partitions)" {
  p0: "Partition 0" { class: part }
  p1: "Partition 1" { class: part }
  p11: "Partition 11" { class: part }
}

consumers: "Consumer Group (15 Consumers)" {
  c0: "Consumer 1 (Active)" { class: active }
  c1: "Consumer 2 (Active)" { class: active }
  c11: "Consumer 12 (Active)" { class: active }
  c12: "Consumer 13 (IDLE STANDBY)" { class: idle }
  c13: "Consumer 14 (IDLE STANDBY)" { class: idle }
  c14: "Consumer 15 (IDLE STANDBY)" { class: idle }
}

partitions.p0 -> consumers.c0: "1:1 Mapping"
partitions.p1 -> consumers.c1: "1:1 Mapping"
partitions.p11 -> consumers.c11: "1:1 Mapping"
