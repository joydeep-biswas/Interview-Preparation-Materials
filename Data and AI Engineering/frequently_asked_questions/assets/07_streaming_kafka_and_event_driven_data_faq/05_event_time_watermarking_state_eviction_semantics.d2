direction: right
classes: {
  box: { style: { fill: "#111827"; stroke-width: 2; rx: 10 } }
}

events: "Incoming Stream of Events" { class: box; style.stroke: "#3B82F6" }
w_check: "Watermark Evaluation:\nEvent Time >= MaxTime - 2 hours?" { class: box; style.stroke: "#F59E0B" }

state: "State Store Update (RocksDB)\nWindow aggregate updated & preserved" { class: box; style.stroke: "#10B981" }
dropped: "Dropped as Too Late\nDiscarded to prevent unbounded state memory bloat" { class: box; style.stroke: "#EF4444" }

events -> w_check
w_check -> state: "YES: Within Watermark"
w_check -> dropped: "NO: Older than Watermark"
