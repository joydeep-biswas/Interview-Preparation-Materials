direction: right
classes: {
  box: { style: { fill: "#111827"; stroke-width: 2; border-radius: 10 } }
}

raw: "Raw Incoming Micro-Batch" { class: box; style.stroke: "#3B82F6" }
val: "Parse & Validate Schema\n(from_json with permissive schema)" { class: box; style.stroke: "#8B5CF6" }
decide: "Is Valid Record?" { class: box; style.stroke: "#F59E0B" }

silver: "Silver Production Table\nClean validated Lakehouse data" { class: box; style.stroke: "#10B981" }
quar: "bronze_quarantine Table (DLQ)\nRaw payload + stack trace for manual triage" { class: box; style.stroke: "#EF4444" }

raw -> val -> decide
decide -> silver: "Valid Record"
decide -> quar: "Corrupt / Poison Pill"