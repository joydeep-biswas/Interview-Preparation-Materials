direction: right
classes: {
  card: { style: { fill: "#111827"; stroke-width: 2; border-radius: 10 } }
}

s1: "1. Standard Imports\nfrom pyspark.sql import functions as F, Window as W" { class: card; style.stroke: "#3B82F6" }
s2: "2. Logical Stage Decomposition\nFilter -> Join -> Aggregate -> Rank" { class: card; style.stroke: "#F59E0B" }
s3: "3. Fluent Method Chaining\nWrapped in parentheses (df.filter().join())" { class: card; style.stroke: "#10B981" }
s4: "4. Deterministic Types & Aliases\n.cast('decimal(10,2)'), .alias()" { class: card; style.stroke: "#8B5CF6" }

s1 -> s2 -> s3 -> s4