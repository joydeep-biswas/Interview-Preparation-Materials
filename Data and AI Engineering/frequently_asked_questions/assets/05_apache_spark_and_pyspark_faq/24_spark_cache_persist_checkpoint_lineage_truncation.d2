direction: right
classes: {
  raw_node: { style: { fill: "#111827"; stroke: "#3B82F6"; stroke-width: 2; border-radius: 8 } }
  stage_node: { style: { fill: "#1E293B"; stroke: "#64748B"; stroke-width: 1.5; border-radius: 6 } }
  cache_node: { style: { fill: "#1E1B4B"; stroke: "#8B5CF6"; stroke-width: 2; border-radius: 8 } }
  recompute_node: { style: { fill: "#7F1D1D"; stroke: "#EF4444"; stroke-width: 1.5; border-radius: 6 } }
  chk_call: { style: { fill: "#1E293B"; stroke: "#F59E0B"; stroke-width: 2; border-radius: 8 } }
  storage_node: { style: { fill: "#064E3B"; stroke: "#10B981"; stroke-width: 2; border-radius: 8 } }
  cut_node: { style: { fill: "#022C22"; stroke: "#34D399"; stroke-width: 2; border-radius: 8 } }
}

CachePersistMechanics: "Mechanism A: cache() / persist()" {
  style: { fill: "#0D1526"; stroke: "#8B5CF6"; stroke-width: 1.5; border-radius: 8 }
  Source1: "Raw Storage Source" { class: raw_node }
  Stage1: "Stage 1: Filter & Map" { class: stage_node }
  Stage2: "Stage 2: Wide Shuffle" { class: stage_node }
  CachedRAM: "Executor RAM Partition\nFull Lineage DAG RETAINED" { class: cache_node }
  EvictedRecompute: "If Evicted / Crash:\nReplay full DAG from source!" { class: recompute_node }

  Source1 -> Stage1 -> Stage2 -> CachedRAM
  CachedRAM -> EvictedRecompute: "LRU Eviction Hazard"
  EvictedRecompute -> Stage1: "Recompute Stage 1..N"
}

CheckpointMechanics: "Mechanism B: checkpoint()" {
  style: { fill: "#0D1526"; stroke: "#10B981"; stroke-width: 1.5; border-radius: 8 }
  Source2: "Raw Storage Source" { class: raw_node }
  IterStages: "Stages 1..100 (Iterative ML)\nGrowing DAG causes StackOverflow" { class: stage_node }
  ChkCall: "df.checkpoint() Trigger\nForces Physical Materialization" { class: chk_call }
  ReliableDisk: "Write Parquet to ADLS/S3\n/checkpoints/iter_50/" { class: storage_node }
  TruncatedLineage: "Lineage Cleanly CUT (None)\nInstant failure recovery" { class: cut_node }

  Source2 -> IterStages -> ChkCall -> ReliableDisk -> TruncatedLineage
}
