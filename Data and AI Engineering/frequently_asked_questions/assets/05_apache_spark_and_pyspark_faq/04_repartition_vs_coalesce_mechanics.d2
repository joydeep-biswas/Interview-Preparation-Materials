direction: right
title: "Repartition vs Coalesce Mechanics"
classes: {
  container: { style: { fill: "#111827"; stroke-width: 2; border-radius: 10 } }
  box: { style: { fill: "#1E293B"; stroke-width: 2; border-radius: 8 } }
  table_box: { style: { fill: "#1E293B"; stroke: "#38bdf8"; stroke-width: 2 } }
  blue_box: { style: { fill: "#1e293b"; stroke: "#38bdf8"; stroke-width: 2; border-radius: 8 } }
  green_box: { style: { fill: "#0f291e"; stroke: "#4ade80"; stroke-width: 2; border-radius: 8 } }
  amber_box: { style: { fill: "#231e12"; stroke: "#fbbf24"; stroke-width: 2; border-radius: 8 } }
  purple_box: { style: { fill: "#1e1b2e"; stroke: "#c084fc"; stroke-width: 2; border-radius: 8 } }
  red_box: { style: { fill: "#2b1111"; stroke: "#f87171"; stroke-width: 2; border-radius: 8 } }
}

Coalesce: "coalesce(2) (Zero Network Shuffle)" {
  class: container
  style.stroke: "#34D399"
  P1: "Node 1 Part 1"
  P2: "Node 1 Part 2"
  P3: "Node 2 Part 3"
  P4: "Node 2 Part 4"
  MergedA: "Merged Part A (Local)"
  MergedB: "Merged Part B (Local)"

  P1 -> MergedA
  P2 -> MergedA
  P3 -> MergedB
  P4 -> MergedB
}

Repartition: "repartition(2) (Full Network Shuffle)" {
  class: container
  style.stroke: "#FBBF24"
  RP1: "Part 1"
  RP2: "Part 2"
  RP3: "Part 3"
  RP4: "Part 4"
  Shuffle: "Cluster Network Shuffle (Round-Robin / Hash)"
  EvenA: "Even Part A"
  EvenB: "Even Part B"

  RP1 -> Shuffle
  RP2 -> Shuffle
  RP3 -> Shuffle
  RP4 -> Shuffle
  Shuffle -> EvenA
  Shuffle -> EvenB
}