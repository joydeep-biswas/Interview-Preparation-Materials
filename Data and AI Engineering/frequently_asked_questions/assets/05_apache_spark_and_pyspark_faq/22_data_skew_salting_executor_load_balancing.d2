direction: right
classes: {
  box_red: { style: { fill: "#111827"; stroke: "#EF4444"; stroke-width: 2; border-radius: 10 } }
  box_green: { style: { fill: "#111827"; stroke: "#10B981"; stroke-width: 2; border-radius: 10 } }
}

problem: "Standard Join: All Skewed Rows Hit Executor 4" {
  class: box_red
  m1: "Hot Merchant M1 (10M Rows)"
  h1: "Hash(M1) % 4 = Partition 3"
  m1 -> h1
  tail: "Tail Merchants (1M Rows)"
  h2: "Partitions 0, 1, 2"
  tail -> h2
  h1 -> e4: "⛔ Core 4: 10M Rows (OOM / 45 Min Straggler)"
  h2 -> e_idle: "Executors 1-3: Idle in 2 Min"
}

solution: "Salting Pipeline: Hot Key Split Across K=4" {
  class: box_green
  s_m1: "Orders M1 + Salt 0..3"
  p0: "Core 0: 2.5M Rows (Done in 3 Min)"
  p1: "Core 1: 2.5M Rows (Done in 3 Min)"
  p2: "Core 2: 2.5M Rows (Done in 3 Min)"
  p3: "Core 3: 2.5M Rows (Done in 3 Min)"
  s_m1 -> p0
  s_m1 -> p1
  s_m1 -> p2
  s_m1 -> p3
}