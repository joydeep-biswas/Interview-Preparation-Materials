direction: right
title: "Apache Spark Distributed Architecture"
classes: {
  container: { style: { fill: "#111827"; stroke-width: 2; border-radius: 10 } }
  box: { style: { fill: "#1E293B"; stroke-width: 2; border-radius: 8 } }
  table_box: { style: { fill: "#1E293B"; stroke: "#38bdf8"; stroke-width: 2 } }
  blue_box: { style: { fill: "#1e293b"; stroke: "#38bdf8"; stroke-width: 2; border-radius: 8 } }
  green_box: { style: { fill: "#0f291e"; stroke: "#4ade80"; stroke-width: 2; border-radius: 8 } }
  amber_box: { style: { fill: "#231e12"; stroke: "#fbbf24"; stroke-width: 2; border-radius: 8 } }
  purple_box: { style: { fill: "#1e1b2e"; stroke: "#c084fc"; stroke-width: 2; border-radius: 8 } }
  red_box: { style: { fill: "#2b1111"; stroke: "#f87171"; stroke-width: 2; border-radius: 8 } }
}

Driver: "Spark Driver Node" {
  class: container
  style.stroke: "#38BDF8"
  Session: "SparkSession & User Code"
  Catalyst: "Catalyst Optimizer (Plan Generation)"
  DAGSched: "DAG Scheduler (Stage Boundaries)"
  TaskSched: "Task Scheduler (Task Dispatcher)"

  Session -> Catalyst -> DAGSched -> TaskSched
}

ClusterMgr: "Cluster Manager (K8s / YARN / Standalone)" {
  class: container
  style.stroke: "#C084FC"
  Alloc: "Container Resource Allocator"
}

Executors: "Distributed Executors" {
  class: container
  style.stroke: "#34D399"
  E1: "Executor 1 (JVM Container, Task Slots, BlockManager)"
  E2: "Executor 2 (JVM Container, Task Slots, BlockManager)"
}

Driver.Session -> ClusterMgr.Alloc: "Container Allocation Request" { style.stroke: "#C084FC" }
ClusterMgr.Alloc -> Executors.E1: "Launches Pod / Container" { style.stroke: "#C084FC" }
ClusterMgr.Alloc -> Executors.E2: "Launches Pod / Container" { style.stroke: "#C084FC" }
Driver.TaskSched -> Executors.E1: "Dispatches TaskSet" { style.stroke: "#34D399" }
Driver.TaskSched -> Executors.E2: "Dispatches TaskSet" { style.stroke: "#34D399" }