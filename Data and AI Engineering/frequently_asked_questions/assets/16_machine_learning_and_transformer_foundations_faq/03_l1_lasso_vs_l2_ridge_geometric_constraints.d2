direction: down
classes: {
  diamond_box: { shape: diamond, style: { fill: "#111827", stroke: "#F59E0B" } }
  l1_box: { style: { fill: "#0D1526", stroke: "#3B82F6" } }
  l2_box: { style: { fill: "#0D1526", stroke: "#10B981" } }
}

Check: "Feature Space Characteristic?" { class: diamond_box }
L1: "L1 (Lasso) Constraint\nDiamond corner geometry\nExact zeros (Sparse)" { class: l1_box }
L2: "L2 (Ridge) Constraint\nCircular tangent geometry\nSmooth shrinkage (Dense)" { class: l2_box }

Check -> L1: "High Dim & Sparse"
Check -> L2: "Collinear & Dense"
