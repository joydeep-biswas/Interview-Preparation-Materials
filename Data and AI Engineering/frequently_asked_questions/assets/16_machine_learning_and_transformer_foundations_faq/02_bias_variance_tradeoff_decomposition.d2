direction: right
classes: {
  under_box: { style: { fill: "#7F1D1D", stroke: "#EF4444" } }
  opt_box: { style: { fill: "#0D1F1C", stroke: "#10B981" } }
  over_box: { style: { fill: "#7F1D1D", stroke: "#EF4444" } }
}

Underfit: "High Bias (Underfitting)\n• High Train Error\n• High Val Error" { class: under_box }
Optimal: "Optimal Balance\n• Low Train Error\n• Low Val Error" { class: opt_box }
Overfit: "High Variance (Overfitting)\n• Near-Zero Train Error\n• High Val Error" { class: over_box }

Underfit -> Optimal: "Add Capacity"
Optimal -> Overfit: "Excessive Capacity"
