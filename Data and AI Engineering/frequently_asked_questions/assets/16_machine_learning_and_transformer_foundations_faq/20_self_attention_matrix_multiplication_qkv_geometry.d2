direction: right
classes: {
  qkv_box: { style: { fill: "#0D1526"; stroke: "#3B82F6" } }
  dot_box: { style: { fill: "#0D1526"; stroke: "#8B5CF6" } }
  soft_box: { style: { fill: "#0D1526"; stroke: "#F59E0B" } }
  val_box: { style: { fill: "#0D1F1C"; stroke: "#10B981" } }
}

Projections: "1. Linear Projections\nQ = X*W_q, K = X*W_k, V = X*W_v" { class: qkv_box }
Scores: "2. Compatibility Scores\nRaw Matrix S = Q*K^T / sqrt(d)" { class: dot_box }
Weights: "3. Softmax Weights\nA = softmax(S) (Rows sum to 1)" { class: soft_box }
Synthesis: "4. Value Synthesis\nOutput = A * V [N, d_v]" { class: val_box }

Projections -> Scores -> Weights -> Synthesis