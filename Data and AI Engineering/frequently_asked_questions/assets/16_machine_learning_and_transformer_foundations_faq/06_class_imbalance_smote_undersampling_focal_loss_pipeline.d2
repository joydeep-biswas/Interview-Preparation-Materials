direction: right
classes: {
  bad_box: { style: { fill: "#7F1D1D", stroke: "#EF4444" } }
  c_blue: { style: { fill: "#0D1526", stroke: "#3B82F6" } }
  c_purple: { style: { fill: "#0D1526", stroke: "#8B5CF6" } }
  c_green: { style: { fill: "#064E3B", stroke: "#10B981" } }
}

Imbalance: "Imbalanced Dataset\n99.8% : 0.2% Ratio" { class: bad_box }
Resample: "1. Data Resampling\nSMOTE & Tomek Links" { class: c_blue }
Loss: "2. Cost & Focal Loss\nDownweights easy negatives" { class: c_purple }
Eval: "3. PR-AUC Metric\nThreshold calibration" { class: c_green }

Imbalance -> Resample -> Loss -> Eval
