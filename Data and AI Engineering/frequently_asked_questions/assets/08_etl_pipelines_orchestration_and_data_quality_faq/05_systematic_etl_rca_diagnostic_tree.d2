direction: down
classes: {
  blue_box: { style: { fill: "#111827", stroke: "#3B82F6", stroke-width: 2 } }
  diamond_box: { shape: diamond, style: { fill: "#111827", stroke: "#F59E0B", stroke-width: 2 } }
  red_box: { style: { fill: "#111827", stroke: "#EF4444", stroke-width: 2 } }
  purple_box: { style: { fill: "#111827", stroke: "#8B5CF6", stroke-width: 2 } }
  green_box: { style: { fill: "#111827", stroke: "#10B981", stroke-width: 2 } }
}

S1: "Step 1: Orchestrator Gantt Chart (Airflow / ADF)\nWhich exact task consumed the extra 2.5 hours?" { class: blue_box }
S2: "Task Category?\nIngest vs Transform vs Load" { class: diamond_box }

C1: "Source & Network Bottleneck\n• Source DB connection throttle\n• Table lock / blocking SPIDs\n• WAN/VPN saturating" { class: red_box }
C2: "Compute Engine Health\n• Spark data skew (stragglers)\n• OOM spills to disk\n• Executor node preemption" { class: purple_box }
C3: "Target Sink Contention\n• Delta transaction conflict\n• Small file compaction backlog\n• COPY INTO throttled" { class: green_box }

S1 -> S2
S2 -> C1: "Ingestion / Source"
S2 -> C2: "Transformation"
S2 -> C3: "Target Load"
