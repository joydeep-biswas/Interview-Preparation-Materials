direction: right
classes: {
  source_node: { style: { fill: "#111827"; stroke: "#3B82F6"; stroke-width: 2; border-radius: 8 } }
  meta_node: { style: { fill: "#1E293B"; stroke: "#F59E0B"; stroke-width: 2; border-radius: 8 } }
  data_node: { style: { fill: "#1E1B4B"; stroke: "#8B5CF6"; stroke-width: 2; border-radius: 8 } }
  sink_node: { style: { fill: "#064E3B"; stroke: "#10B981"; stroke-width: 2; border-radius: 8 } }
}

S3Raw: "Amazon S3 Raw Ingestion\nFiles with mutated/new columns\nDaily partition drops" { class: source_node }

GlueCrawler: "AWS Glue Crawler\nPolicy: Add new columns only\nNever alter existing data types" { class: meta_node }
GlueCatalog: "AWS Glue Data Catalog\nMetadata table schema updated\nNew columns added as NULLABLE" { class: meta_node }

GlueJob: "AWS Glue PySpark ETL Job\nDynamicFrame Ingestion\nresolveChoice(cast: string)" { class: data_node }
CleanS3: "Clean Lakehouse (S3 Parquet)\nConsistent typed Parquet storage\nPartition projected" { class: sink_node }

Athena: "Amazon Athena / BI Layer\nZero query failure on new columns\nInstant schema synchronization" { class: sink_node }

S3Raw -> GlueCrawler: "Scheduled Crawl"
GlueCrawler -> GlueCatalog: "Schema Evolution Update"
S3Raw -> GlueJob: "Batch Processing"
GlueJob -> CleanS3: "resolveChoice() Cast"
GlueCatalog -> Athena: "Table DDL Metadata"
CleanS3 -> Athena: "Serverless SQL Query"
