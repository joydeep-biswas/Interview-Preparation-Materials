direction: right
classes: {
  blue_box: { style: { fill: "#111827"; stroke: "#3B82F6" } }
  diamond_box: { shape: diamond; style: { fill: "#111827"; stroke: "#F59E0B" } }
  lock_box: { style: { fill: "#111827"; stroke: "#8B5CF6" } }
  green_box: { style: { fill: "#064E3B"; stroke: "#10B981" } }
  red_box: { style: { fill: "#7F1D1D"; stroke: "#EF4444" } }
}

T1: "Schedule Trigger (2 AM)" { class: blue_box }
T2: "Tumbling Window" { class: blue_box }
T3: "Storage Event" { class: blue_box }
Gate: "Concurrency = 1?\nPrior Run Active?" { class: diamond_box }
Queue: "Queued in ADF" { class: blue_box }
LockAct: "Acquire Blob Lease\nDistributed Lock" { class: lock_box }
Execute: "Execute Ingestion & Merge\nDelta MERGE INTO" { class: green_box }
Abort: "Graceful Abort\nLease Conflict (412)" { class: red_box }

T1 -> Gate
T2 -> Gate
T3 -> Gate
Gate -> Queue: "ACTIVE"
Gate -> LockAct: "IDLE"
LockAct -> Execute: "201 Acquired"
LockAct -> Abort: "412 Conflict"