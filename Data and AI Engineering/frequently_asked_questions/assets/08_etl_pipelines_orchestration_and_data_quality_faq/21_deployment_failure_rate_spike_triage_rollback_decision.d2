direction: down
classes: {
  alert_box: { style: { fill: "#7F1D1D"; stroke: "#EF4444" } }
  diamond_box: { shape: diamond; style: { fill: "#111827"; stroke: "#F59E0B" } }
  red_box: { style: { fill: "#111827"; stroke: "#EF4444" } }
  green_box: { style: { fill: "#064E3B"; stroke: "#10B981" } }
}

Alert: "🚨 Failure Rate Spike\n0.1% -> 4.0% Post-Deploy" { class: alert_box }
CheckData: "Corrupted /\nDuplicate Data?" { class: diamond_box }
CheckTime: "Can Fix in < 30m?\n(Known minor fix)" { class: diamond_box }

EmergencyRestore: "Emergency Rollback & Restore\n• RESTORE TO VERSION_AS_OF\n• Revert git commit" { class: red_box }
Rollback: "Safe Code Rollback\n• Revert to prior container tag\n• Replay from safe watermark" { class: red_box }
FixForward: "Hotfix Forward\n• Patch config parameter\n• Fast-track hotfix CI/CD PR" { class: green_box }

Alert -> CheckData
CheckData -> EmergencyRestore: "YES: Data Toxic"
CheckData -> CheckTime: "NO: Pure Connection/Read Error"
CheckTime -> Rollback: "NO: Unclear Root Cause"
CheckTime -> FixForward: "YES: Known Minor Fix"