direction: right
classes: {
  container_blue: { style: { fill: "#0D1526"; stroke: "#3B82F6" } }
  container_purple: { style: { fill: "#0D1526"; stroke: "#8B5CF6" } }
  container_green: { style: { fill: "#0D1526"; stroke: "#10B981" } }
  box_dark: { style: { fill: "#111827"; stroke: "#1E293B" } }
}

SourceWAL: "Source Transaction Log" {
  class: container_blue
  OLTP: "OLTP Database\nPostgreSQL / MySQL" { class: box_dark }
  WAL: "Transaction Log\nWAL / Binlog stream" { class: box_dark }
  OLTP -> WAL
}

CDCStreaming: "Log-Based CDC & Streaming" {
  class: container_purple
  Debezium: "Debezium Connector\nReal-time log scraping" { class: box_dark }
  Kafka: "Kafka Topic: orders_cdc\nPartitioned by order_id" { class: box_dark }
  Debezium -> Kafka
}

StreamLakehouse: "Stream Engine & Lakehouse" {
  class: container_green
  Stream: "Spark / Flink Engine\nExactly-once micro-batch" { class: box_dark }
  Delta: "Delta Lake Silver\nMERGE / Deletion vectors" { class: box_dark }
  Stream -> Delta
}

SourceWAL.WAL -> CDCStreaming.Debezium
CDCStreaming.Kafka -> StreamLakehouse.Stream