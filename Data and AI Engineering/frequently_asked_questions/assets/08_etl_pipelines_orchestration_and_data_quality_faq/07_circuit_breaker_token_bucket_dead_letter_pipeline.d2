direction: right
classes: {
  blue_box: { style: { fill: "#111827", stroke: "#3B82F6", stroke-width: 2 } }
  cyan_box: { style: { fill: "#111827", stroke: "#06B6D4", stroke-width: 2 } }
  amber_box: { style: { fill: "#111827", stroke: "#F59E0B", stroke-width: 2 } }
  green_box: { style: { fill: "#111827", stroke: "#10B981", stroke-width: 2 } }
  red_box: { style: { fill: "#111827", stroke: "#EF4444", stroke-width: 2 } }
}

Batch: "ETL Ingestion Tasks\n• 10,000 req / sec" { class: blue_box }
RL: "1. Token-Bucket Limiter\n• Caps rate to 50 req/sec\n• Prevents HTTP 429" { class: cyan_box }
CB: "2. Circuit Breaker\n• CLOSED: Normal\n• OPEN: Trips if error > 20%\n• HALF-OPEN: Canary probe" { class: amber_box }
Downstream: "External REST API\n• Target 3rd party" { class: green_box }
DLQ: "3. Dead-Letter Queue\n• Jittered exponential backoff" { class: red_box }

Batch -> RL -> CB
CB -> Downstream: "Normal (CLOSED)" { style: { stroke: "#10B981" } }
CB -> DLQ: "Tripped (OPEN)" { style: { stroke: "#EF4444" } }
