direction: right
classes: {
  container: { style: { fill: "#0D1526"; stroke: "#1E293B" } }
  blue_box: { style: { fill: "#111827"; stroke: "#3B82F6"; stroke-width: 2 } }
  purple_box: { style: { fill: "#111827"; stroke: "#8B5CF6"; stroke-width: 2 } }
  amber_box: { shape: diamond; style: { fill: "#111827"; stroke: "#F59E0B"; stroke-width: 2 } }
  red_box: { style: { fill: "#111827"; stroke: "#EF4444"; stroke-width: 2 } }
  green_box: { style: { fill: "#111827"; stroke: "#10B981"; stroke-width: 2 } }
}

IdempotentFileDedup: "Idempotent File Ingestion & Checksum Deduplication Flow" {
  class: container
  File: "Incoming Source File\n• Landed in S3 / ADLS\n• orders_20261025.csv" { class: blue_box }
  Hash: "Compute SHA-256\n• Cryptographic hash" { class: purple_box }
  Check: "Checksum In\netl_file_audit?" { class: amber_box }
  Skip: "Skip Idempotently\n• Duplicate file ignored\n• Log audit warning metric" { class: red_box }
  Process: "Ingest & Commit\n• Ingest rows to Bronze/Silver\n• Insert checksum to audit log" { class: green_box }

  File -> Hash -> Check
  Check -> Skip: "YES" { style: { stroke: "#EF4444" } }
  Check -> Process: "NO" { style: { stroke: "#10B981" } }
}