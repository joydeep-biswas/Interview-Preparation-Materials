direction: right
classes: {
  source_node: { style: { fill: "#111827"; stroke: "#3B82F6"; stroke-width: 2; border-radius: 8 } }
  engine_node: { style: { fill: "#1E293B"; stroke: "#F59E0B"; stroke-width: 2; border-radius: 8 } }
  thread_node: { style: { fill: "#1E1B4B"; stroke: "#8B5CF6"; stroke-width: 2; border-radius: 8 } }
  sink_node: { style: { fill: "#064E3B"; stroke: "#10B981"; stroke-width: 2; border-radius: 8 } }
}

SourceDB: "Source SQL Database\n1 Billion Rows (500 GB)\ntransaction_id PK Index" { class: source_node }
PartitionEngine: "ADF Dynamic Range Engine\nPhysical Partitions: 32\nUpper/Lower Bounds Query" { class: engine_node }

ADFCompute: "ADF Serverless Azure-IR (64 DIUs, Concurrency = 32)" {
  style: { fill: "#0B0F19"; stroke: "#475569"; stroke-width: 1.5; border-radius: 8 }
  T1: "Thread 1: IDs 1 – 250M\nDirect Parallel Reader" { class: thread_node }
  T2: "Thread 2: IDs 250M – 500M\nDirect Parallel Reader" { class: thread_node }
  T3: "Thread 3: IDs 500M – 750M\nDirect Parallel Reader" { class: thread_node }
  T4: "Thread 4: IDs 750M – 1B\nDirect Parallel Reader" { class: thread_node }
}

ADLSSink: "ADLS Gen2 Bronze Lakehouse\nSnappy-Compressed Parquet\nParallel Ingestion Streams" { class: sink_node }

SourceDB -> PartitionEngine: "Metadata Discovery"
PartitionEngine -> ADFCompute.T1: "Partition Chunk 1"
PartitionEngine -> ADFCompute.T2: "Partition Chunk 2"
PartitionEngine -> ADFCompute.T3: "Partition Chunk 3"
PartitionEngine -> ADFCompute.T4: "Partition Chunk 4"
ADFCompute.T1 -> ADLSSink: "Direct Binary Stream"
ADFCompute.T2 -> ADLSSink: "Direct Binary Stream"
ADFCompute.T3 -> ADLSSink: "Direct Binary Stream"
ADFCompute.T4 -> ADLSSink: "Direct Binary Stream"
