direction: down
classes: {
  meta_box: { style: { fill: "#111827", stroke: "#8B5CF6", stroke-width: 2 } }
  cat_box: { style: { fill: "#111827", stroke: "#3B82F6", stroke-width: 2 } }
  schema_box: { style: { fill: "#111827", stroke: "#06B6D4", stroke-width: 2 } }
  gold_box: { style: { fill: "#111827", stroke: "#10B981", stroke-width: 2 } }
  obj_box: { style: { fill: "#064E3B", stroke: "#10B981", stroke-width: 2 } }
}

Account: "Databricks Account Metastore\nCentral cross-workspace root" { class: meta_box }

DevCat: "dev_catalog (Sandbox)" { class: cat_box }
TestCat: "test_catalog (Integration)" { class: cat_box }
ProdCat: "prod_catalog (Production)" { class: cat_box }

Bronze: "bronze (Raw)" { class: schema_box }
Silver: "silver (Curated)" { class: schema_box }
Gold: "gold (Data Marts)" { class: gold_box }

T1: "fact_daily_revenue (Table)" { class: obj_box }
V1: "v_masked_customer (View)" { class: gold_box }

Account -> DevCat
Account -> TestCat
Account -> ProdCat

ProdCat -> Bronze
ProdCat -> Silver
ProdCat -> Gold

Gold -> T1
Gold -> V1
