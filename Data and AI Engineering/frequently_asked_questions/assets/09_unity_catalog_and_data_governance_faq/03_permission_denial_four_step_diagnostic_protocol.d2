direction: right
classes: {
  alert_box: { style: { fill: "#7F1D1D"; stroke: "#EF4444"; stroke-width: 2 } }
  amber_box: { style: { fill: "#111827"; stroke: "#F59E0B"; stroke-width: 2 } }
  blue_box: { style: { fill: "#111827"; stroke: "#3B82F6"; stroke-width: 2 } }
  purple_box: { style: { fill: "#111827"; stroke: "#8B5CF6"; stroke-width: 2 } }
  green_box: { style: { fill: "#111827"; stroke: "#10B981"; stroke-width: 2 } }
}

Err: "Permission Denied\nHTTP 403 Forbidden" { class: alert_box }
S1: "Step 1: USE Chain\nUSE CATALOG & SCHEMA?" { class: amber_box }
S2: "Step 2: Cluster Mode\nShared vs Single-User?" { class: blue_box }
S3: "Step 3: Check Grants\nSHOW GRANTS ON TABLE" { class: purple_box }
S4: "Step 4: Row Filter\nFilter evaluates to FALSE?" { class: green_box }

Err -> S1 -> S2 -> S3 -> S4