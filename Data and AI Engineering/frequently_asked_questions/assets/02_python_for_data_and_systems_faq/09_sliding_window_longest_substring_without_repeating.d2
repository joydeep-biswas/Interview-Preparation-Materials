direction: right
classes: {
  box: { style: { fill: "#111827"; stroke-width: 2; border-radius: 10 } }
}

w1: "Window [0..0]: 'p'\nMax = 1 | Map: {'p': 0}" { class: box; style.stroke: "#64748B" }
w2: "Window [0..1]: 'p w'\nMax = 2 | Map: {'p': 0, 'w': 1}" { class: box; style.stroke: "#64748B" }
w3: "Window [2..2]: Duplicate 'w' at 1 &gt;= left(0)\nJump left to 1+1=2. Window: 'w' (Max = 2)" { class: box; style.stroke: "#F59E0B" }
w4: "Window [2..3]: 'w k'\nMax = 2 | Map: {'w': 2, 'k': 3}" { class: box; style.stroke: "#64748B" }
w5: "Window [2..4]: 'w k e'\nMax = 3 | Map: {'w': 2, 'k': 3, 'e': 4}" { class: box; style.stroke: "#10B981" }
w6: "Window [3..5]: Duplicate 'w' at 2 &gt;= left(2)\nJump left to 2+1=3. Window: 'k e w' (Max = 3)" { class: box; style.stroke: "#10B981" }

w1 -> w2 -> w3 -> w4 -> w5 -> w6