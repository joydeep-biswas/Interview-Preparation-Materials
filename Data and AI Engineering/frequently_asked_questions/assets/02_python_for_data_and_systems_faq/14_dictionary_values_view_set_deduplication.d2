direction: right
classes: {
  box: { style: { fill: "#111827"; stroke-width: 1.5; rx: 10 } }
}

dict_node: "Source Dictionary\n{'u1': 'US', 'u2': 'IN', 'u3': 'US', 'u4': 'UK'}" {
  class: box
  style.stroke: "#3B82F6"
}

view: "1. dict.values() View\nO(1) memory dynamic generator view\nZero list copy allocated in RAM" {
  class: box
  style.stroke: "#64748B"
}

set_build: "2. set() Deduplication\nHash table insertion O(N)\nEliminates duplicate 'US' value" {
  class: box
  style.stroke: "#F59E0B"
}

output: "3. Unique Values Result\n{'US', 'IN', 'UK'} or list(set)\nExact unique value cardinality" {
  class: box
  style.stroke: "#10B981"
}

dict_node -> view -> set_build -> output
