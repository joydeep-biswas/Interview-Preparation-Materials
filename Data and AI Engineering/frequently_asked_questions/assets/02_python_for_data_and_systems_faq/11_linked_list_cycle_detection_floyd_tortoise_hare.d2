direction: right
classes: {
  box: { style: { fill: "#111827"; stroke-width: 1.5; rx: 10 } }
}

topology: "Linked List Topology\n(3) -> (2) -> (0) -> (-4) -> back to (2)" {
  class: box
  style.stroke: "#3B82F6"
}

p0: "Step 0\nslow = 3, fast = 3" { class: box; style.stroke: "#64748B" }
p1: "Step 1\nslow = 2, fast = 0" { class: box; style.stroke: "#64748B" }
p2: "Step 2\nslow = 0, fast = 2" { class: box; style.stroke: "#64748B" }
p3: "Step 3 (COLLISION!)\nslow = -4, fast = -4\nCycle Confirmed! O(1) Memory" { class: box; style.stroke: "#10B981" }

topology -> p0 -> p1 -> p2 -> p3
