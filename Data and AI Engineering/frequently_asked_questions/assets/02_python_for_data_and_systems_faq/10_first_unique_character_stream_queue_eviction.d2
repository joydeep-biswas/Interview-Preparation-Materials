direction: right
classes: {
  box: { style: { fill: "#111827"; stroke-width: 1.5; rx: 10 } }
}

stream: "Incoming Event Stream\n'a' -> 'b' -> 'a' -> 'c'" { class: box; style.stroke: "#3B82F6" }
ingest: "Counter & Queue Engine\nIncrement char frequency map" { class: box; style.stroke: "#F59E0B" }

q1: "Event 'a': count=1\nQueue: ['a'] (Head: 'a')" { class: box; style.stroke: "#64748B" }
q2: "Event 'b': count=1\nQueue: ['a', 'b'] (Head: 'a')" { class: box; style.stroke: "#64748B" }
evict: "Event 'a': count=2\nQueue Head 'a' count &gt; 1 -> Pop Left!\nQueue: ['b'] (Head: 'b')" { class: box; style.stroke: "#EF4444" }
q3: "Event 'c': count=1\nQueue: ['b', 'c']\nFirst Unique Character: 'b'" { class: box; style.stroke: "#10B981" }

stream -> ingest
ingest -> q1 -> q2 -> evict -> q3
