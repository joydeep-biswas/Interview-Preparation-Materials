direction: right
classes: {
  box: { style: { fill: "#111827"; stroke-width: 1.5; rx: 10 } }
}

ingress: "Ingress Order Tuples\n(101, 'm_1', 'DELIVERED', 1700000100)\n(102, 'm_2', 'CANCELLED', 1700000150)\n(103, 'm_1', 'DELIVERED', 1700000050)" {
  class: box
  style.stroke: "#3B82F6"
}

filter_node: "Generator Stream Filter (Zero RAM)\nstatus == 'DELIVERED'" {
  class: box
  style.stroke: "#8B5CF6"
}

hash_agg: "Single-Pass Dictionary Aggregation\nSpace: O(M) Unique Merchants\n'm_1': count = 2, min_ts = 1700000050" {
  class: box
  style.stroke: "#10B981"
}

output: "Aggregated Summary Output\n[('m_1', 2, 1700000050)]\nStreaming single pass completed" {
  class: box
  style.stroke: "#10B981"
}

ingress -> filter_node
filter_node -> hash_agg: "Pass Only DELIVERED"
hash_agg -> output
