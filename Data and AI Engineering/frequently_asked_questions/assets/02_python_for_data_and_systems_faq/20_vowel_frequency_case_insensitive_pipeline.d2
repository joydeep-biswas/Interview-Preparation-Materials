# Vowel Frequency: Case-Insensitive String Frequency Analysis Pipeline
direction: right
classes: {
  box: { style: { fill: "#111827"; stroke-width: 2; border-radius: 10 } }
  node: { style: { fill: "#1E293B"; stroke-width: 1.5; border-radius: 8 } }
}

vowel_pipeline: "Case-Insensitive Vowel Frequency Architecture" {
  class: box
  style.stroke: "#3B82F6"

  input_str: "Raw Input String\n'Data Engineering'\nLength: 16 chars" {
    class: node
    style.stroke: "#3B82F6"
  }

  normalize: "Normalization Stage\n• Case folding: s.lower()\n• Filter predicate: char in 'aeiou'" {
    class: node
    style.stroke: "#F59E0B"
  }

  agg: "Aggregation Stage\n• collections.Counter(vowels)\n• Or dictionary single-pass loop\n• O(N) time, O(1) space" {
    class: node
    style.stroke: "#10B981"
  }

  output: "Final Structured Output\n{'a': 2, 'e': 3, 'i': 2}\nKeys sorted or vowel-order preserved" {
    class: node
    style.stroke: "#8B5CF6"
  }

  input_str -> normalize -> agg -> output
}

