direction: right
classes: {
  box: { style: { fill: "#111827"; stroke-width: 1.5; rx: 10 } }
}

stream: "Input Array: nums = [1, 1, 1, 2, 2, 3], k = 2\nFrequency Map: {1: 3, 2: 2, 3: 1}" {
  class: box
  style.stroke: "#3B82F6"
}

heap_method: "Method A: Min-Heap of Size K = 2 O(N log K)\nPush (count, val) into heap\nPop smallest when size &gt; K\nFinal Heap holds top 2 items: [2, 1]" {
  class: box
  style.stroke: "#F59E0B"
}

bucket_method: "Method B: Bucket Sort O(N) Linear Time\nBuckets indexed by frequency: 0..N\nBucket 3: [1], Bucket 2: [2], Bucket 1: [3]\nTraverse backwards: Take [1], then [2] -> [1, 2]" {
  class: box
  style.stroke: "#10B981"
}

stream -> heap_method
stream -> bucket_method
