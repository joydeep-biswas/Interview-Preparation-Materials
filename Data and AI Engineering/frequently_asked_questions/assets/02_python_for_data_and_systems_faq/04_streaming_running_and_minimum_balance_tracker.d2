direction: right
classes: {
  box: { style: { fill: "#111827"; stroke-width: 2; border-radius: 10 } }
}

stream: "Incoming Number Stream\n[-10, 20, 5, -30, 40, ...]" { class: box; style.stroke: "#3B82F6" }
tracker: "Streaming Balance Tracker\nrunning_sum += val\nmin_balance = min(min_balance, running_sum)" { class: box; style.stroke: "#F59E0B" }

q1: "Query 1: Running Balance\nInstant O(1) Lookup: +25" { class: box; style.stroke: "#10B981" }
q2: "Query 2: Minimum Balance\nInstant O(1) Lookup: -15" { class: box; style.stroke: "#10B981" }

stream -> tracker
tracker -> q1
tracker -> q2