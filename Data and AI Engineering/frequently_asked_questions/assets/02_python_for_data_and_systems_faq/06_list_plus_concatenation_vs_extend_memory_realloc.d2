direction: right
classes: {
  pillar: { style: { fill: "#111827"; stroke-width: 2; border-radius: 10 } }
  stage: { style: { fill: "#1E293B"; stroke-width: 2; border-radius: 8 } }
}

list_plus: "1. Concatenation: list_c = list_a + list_b (Out-of-Place)" {
  class: pillar
  style.stroke: "#EF4444"
  alloc: "Allocate New PyListObject\nCapacity = Exactly (N + K)" { class: stage; style.stroke: "#EF4444" }
  copya: "Memcpy Pointers from list_a (N Items)" { class: stage; style.stroke: "#EF4444" }
  copyb: "Memcpy Pointers from list_b (K Items)" { class: stage; style.stroke: "#EF4444" }
  alloc -> copya -> copyb
}

list_extend: "2. In-Place Extension: list_a.extend(list_b)" {
  class: pillar
  style.stroke: "#10B981"
  check: "Check Buffer Capacity\nallocated &gt;= (N + K)?" { class: stage; style.stroke: "#F59E0B" }
  resize: "Geometric Over-Allocation\nCapacity ~ (N+K) + ((N+K) &gt;&gt; 3) + 6" { class: stage; style.stroke: "#F59E0B" }
  memmove: "Memmove Pointers from list_b\nDirectly into list_a contiguous array" { class: stage; style.stroke: "#10B981" }
  check -> resize: "No (Buffer Full)"
  resize -> memmove
  check -> memmove: "Yes (Spare Capacity)"
}