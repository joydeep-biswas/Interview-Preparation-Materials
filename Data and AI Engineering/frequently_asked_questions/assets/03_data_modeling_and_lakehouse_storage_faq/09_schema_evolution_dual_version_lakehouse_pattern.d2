direction: right
classes: {
  box: { style: { fill: "#111827"; stroke-width: 2; border-radius: 10 } }
}

producer: "Producer Schema Change\nPushes breaking structural mutation" { class: box; style.stroke: "#3B82F6" }
gate: "Schema Registry Gate" { class: box; style.stroke: "#F59E0B" }

block: "Reject Incompatible Mutation\nBlocks non-compliant deployment" { class: box; style.stroke: "#EF4444" }
dual: "Dual-Version Lakehouse Pattern\nApproved evolution without breaking consumers" { class: box; style.stroke: "#10B981" }

base: "Base Physical Table\nContains unioned superset of all versioned columns" { class: box; style.stroke: "#3B82F6" }
v1: "view_events_v1\nServes legacy consumer contract" { class: box; style.stroke: "#10B981" }
v2: "view_events_v2\nServes modern extended contract" { class: box; style.stroke: "#10B981" }

producer -> gate
gate -> block: "Incompatible"
gate -> dual: "Approved Evolution"
dual -> base
base -> v1
base -> v2