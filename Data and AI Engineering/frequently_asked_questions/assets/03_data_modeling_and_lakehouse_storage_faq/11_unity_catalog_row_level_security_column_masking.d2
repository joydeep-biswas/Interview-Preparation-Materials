direction: right
classes: {
  box: { style: { fill: "#111827"; stroke-width: 1.5; rx: 10 } }
}

user: "Analyst / ML Query\nSELECT * FROM customers" { class: box; style.stroke: "#3B82F6" }
gov: "Unity Catalog Policy Engine\nEvaluates user roles & attributes" { class: box; style.stroke: "#8B5CF6" }

rls: "Row-Level Security (RLS)\nWHERE market = session_user_market()\nFilters unauthorized tenant rows" { class: box; style.stroke: "#10B981" }
ddm: "Dynamic Column Masking (DDM)\nIF IS_MEMBER('pii_admin') THEN email\nELSE sha256(email) (Masked)" { class: box; style.stroke: "#10B981" }

storage: "Encrypted Storage (ADLS / S3)\nEncrypted Parquet Files" { class: box; style.stroke: "#3B82F6" }

user -> gov
gov -> rls -> storage
gov -> ddm -> storage
