direction: right
classes: {
  box: { style: { fill: "#111827"; stroke-width: 2; border-radius: 10 } }
}

ingest: "Log Stream (100k events/sec)\nKafka buffer" { class: box; style.stroke: "#3B82F6" }
mem: "In-Memory Micro-Batch\nBuffers 10 seconds of writes" { class: box; style.stroke: "#3B82F6" }
append: "Append-Only Parquet Chunk\nUnindexed, instant O(1) write" { class: box; style.stroke: "#F59E0B" }

compact: "Nightly OPTIMIZE Compaction\nMerge small files into 512MB chunks\nGenerate Bloom filters & Z-Order" {
  class: box
  style.stroke: "#10B981"
}

read_perf: "Analytical Query Reads\nFast columnar pruning & vector scans" {
  class: box
  style.stroke: "#10B981"
}

ingest -> mem -> append -> compact -> read_perf