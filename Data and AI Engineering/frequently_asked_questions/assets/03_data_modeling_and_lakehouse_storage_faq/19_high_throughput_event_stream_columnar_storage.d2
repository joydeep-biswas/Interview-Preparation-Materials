direction: right
classes: {
  card: { style: { fill: "#111827"; stroke-width: 2; border-radius: 10 } }
  col: { style: { fill: "#1E293B"; stroke-width: 2; border-radius: 6 } }
}

clients: "Web & Mobile Clients\n50,000 Events / Sec" { class: card; style.stroke: "#3B82F6" }
broker: "1. Ingestion Broker\nKafka / AWS Kinesis / Event Hubs" { class: card; style.stroke: "#F59E0B" }
stream: "2. Stream Processing\nSpark Streaming / Auto Loader" { class: card; style.stroke: "#10B981" }
lake: "3. Partitioned Lakehouse\nDelta Lake / Apache Iceberg" { class: card; style.stroke: "#8B5CF6" }

clients -> broker -> stream -> lake