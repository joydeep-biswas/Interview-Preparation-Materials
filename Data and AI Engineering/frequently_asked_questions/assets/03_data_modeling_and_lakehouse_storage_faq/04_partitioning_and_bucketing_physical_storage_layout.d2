direction: right
classes: {
  box: { style: { fill: "#111827"; stroke-width: 1.5; rx: 10 } }
}

stream: "Enterprise Event Stream" { class: box; style.stroke: "#3B82F6" }
part: "1. Partition by Low-Cardinality Key\nevent_date=2024-06-01/\nFilesystem folder hierarchy" { class: box; style.stroke: "#3B82F6" }
buck: "2. Bucket by High-Cardinality Key\nuser_id into 32 Buckets\nHash: murmur3(user_id) % 32" { class: box; style.stroke: "#F59E0B" }

f0: "File: bucket_0000.parquet" { class: box; style.stroke: "#10B981" }
f1: "File: bucket_0001.parquet" { class: box; style.stroke: "#10B981" }
fn: "File: bucket_0031.parquet" { class: box; style.stroke: "#10B981" }

stream -> part -> buck
buck -> f0
buck -> f1
buck -> fn
