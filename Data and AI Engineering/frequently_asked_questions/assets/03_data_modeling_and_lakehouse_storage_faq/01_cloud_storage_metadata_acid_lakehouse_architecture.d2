direction: right
classes: {
  pillar: { style: { fill: "#111827"; stroke-width: 2; border-radius: 10 } }
  stage: { style: { fill: "#1E293B"; stroke-width: 2; border-radius: 8 } }
}

storage: "1. Cloud Storage Substrate" {
  class: pillar
  style.stroke: "#3B82F6"
  files: "Parquet Data Files\nImmutable columnar files + blobs" { class: stage; style.stroke: "#3B82F6" }
}

metadata: "2. ACID Metadata Layer (Delta / Iceberg)" {
  class: pillar
  style.stroke: "#F59E0B"
  log: "Transaction Commit Log\n_delta_log/*.json / metadata.json\nSerializes ACID transactions" { class: stage; style.stroke: "#F59E0B" }
  stats: "Min/Max Stats & Data Skipping\nTracks min, max & null counts per column" { class: stage; style.stroke: "#F59E0B" }
  log -> stats
}

engines: "3. Compute Engine Federation" {
  class: pillar
  style.stroke: "#10B981"
  spark: "Apache Spark / Databricks" { class: stage; style.stroke: "#10B981" }
  trino: "Trino / Starburst Presto" { class: stage; style.stroke: "#10B981" }
  snowflake: "Snowflake Iceberg Tables" { class: stage; style.stroke: "#10B981" }
}

metadata.log -> storage.files: "Pointers to Active Parquet Files"
engines.spark -> metadata.log: "Atomic Commit Protocol"