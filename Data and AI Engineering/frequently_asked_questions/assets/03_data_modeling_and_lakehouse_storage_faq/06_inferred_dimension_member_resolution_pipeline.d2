direction: right
classes: {
  box: { style: { fill: "#111827"; stroke-width: 2; border-radius: 10 } }
}

order: "Order Event Ingested\ncustomer_id = 999" { class: box; style.stroke: "#3B82F6" }
lookup: "Dimension Lookup\nLook up customer_id in dim_customer" { class: box; style.stroke: "#F59E0B" }

found: "Assign Existing Key\nAttach customer_sk to fact row" { class: box; style.stroke: "#10B981" }
inferred: "Create Inferred Placeholder\ncustomer_sk = Hash(999)\nis_inferred = TRUE, name = 'UNKNOWN'\nZero pipeline blockage" { class: box; style.stroke: "#EF4444" }

late_crm: "Late Customer Record (CRM)\ncustomer_id = 999, name = 'Alice'" { class: box; style.stroke: "#3B82F6" }
reconcile: "SCD Reconcile & Overwrite\nUpdates inferred record: name='Alice', is_inferred=FALSE\nFact foreign keys remain intact" { class: box; style.stroke: "#10B981" }

order -> lookup
lookup -> found: "Found"
lookup -> inferred: "Not Found"
late_crm -> reconcile
inferred -> reconcile: "Reconcile"