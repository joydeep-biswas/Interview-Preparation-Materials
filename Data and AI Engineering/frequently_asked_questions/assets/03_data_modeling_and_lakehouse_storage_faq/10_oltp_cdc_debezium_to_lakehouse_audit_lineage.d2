direction: right
classes: {
  box: { style: { fill: "#111827"; stroke-width: 2; border-radius: 10 } }
}

oltp: "PostgreSQL Master (OLTP)\nWrites Write-Ahead Log (WAL)" { class: box; style.stroke: "#3B82F6" }
debezium: "Debezium CDC Engine\nDecodes transaction log stream" { class: box; style.stroke: "#F59E0B" }
kafka: "Kafka: cdc.orders.events\nTransactional event stream" { class: box; style.stroke: "#F59E0B" }

spark: "Spark Structured Streaming\nMicro-batch processing engine" { class: box; style.stroke: "#10B981" }
audit: "Audit Lineage Table\n(batch_id, count, hash, status)" { class: box; style.stroke: "#10B981" }
delta: "Production Delta Table\nACID MERGE INTO with deduplication" { class: box; style.stroke: "#10B981" }

oltp -> debezium -> kafka -> spark
spark -> audit
spark -> delta