direction: right
classes: {
  box: { style: { fill: "#111827"; stroke-width: 2; border-radius: 10 } }
}

dims: "Conformed Dimensions" {
  vendor: "dim_vendor (Vendor SK, Bank, Tax ID)" { class: box; style.stroke: "#10B981" }
  dt: "dim_date (Date SK, Quarter, Fiscal Year)" { class: box; style.stroke: "#10B981" }
  acc: "dim_chart_of_accounts (GL Account)" { class: box; style.stroke: "#10B981" }
}

facts: "Dual Fact Architecture" {
  f_inv: "fact_vendor_invoice_line\nGrain: 1 Invoice Line Item\n(invoice_num, po_num, amount)" { class: box; style.stroke: "#3B82F6" }
  f_pay: "fact_vendor_payment_batch\nGrain: 1 Payment Disbursement\n(batch_id, disbursement_amt)" { class: box; style.stroke: "#3B82F6" }
}

dims.vendor -> facts.f_inv
dims.vendor -> facts.f_pay
dims.dt -> facts.f_inv
dims.dt -> facts.f_pay