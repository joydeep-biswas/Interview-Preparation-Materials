direction: right
classes: {
  card: { style: { fill: "#111827"; stroke-width: 1.5; rx: 8 } }
}

client: "Customer / POS\nSends idempotent swipe request" { class: card; style.stroke: "#3B82F6" }
gw: "Payment Gateway API\nValidates idempotency_key" { class: card; style.stroke: "#8B5CF6" }
db: "Relational DB (Postgres/Spanner)\npayment_intents table" { class: card; style.stroke: "#F59E0B" }
ledger: "Double-Entry Ledger\njournal_entries & ledger_lines" { class: card; style.stroke: "#10B981" }

client -> gw: "POST /v1/payments (key)"
gw -> db: "Check key status"
gw -> ledger: "Atomic debit/credit"
