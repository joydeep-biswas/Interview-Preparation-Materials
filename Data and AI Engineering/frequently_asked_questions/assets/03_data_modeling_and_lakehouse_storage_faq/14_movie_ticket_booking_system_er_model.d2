direction: right
classes: {
  entity: { style: { fill: "#111827"; stroke-width: 2; border-radius: 8 } }
  central: { style: { fill: "#1F2937"; stroke-width: 2; border-radius: 10 } }
}

theater: "THEATER\ntheater_id (PK)\nname, city" { class: entity; style.stroke: "#3B82F6" }
auditorium: "AUDITORIUM\nauditorium_id (PK)\ntheater_id (FK), screen_num" { class: entity; style.stroke: "#3B82F6" }
seat: "SEAT\nseat_id (PK)\nauditorium_id (FK), row, col" { class: entity; style.stroke: "#3B82F6" }

movie: "MOVIE\nmovie_id (PK)\ntitle, runtime" { class: entity; style.stroke: "#8B5CF6" }
showtime: "SHOWTIME\nshowtime_id (PK)\nmovie_id (FK), start_time" { class: entity; style.stroke: "#8B5CF6" }

show_seat: "SHOW_SEAT (Locking Granularity)\nshow_seat_id (PK)\nshowtime_id (FK), seat_id (FK)\nstatus (AVAILABLE, LOCKED, BOOKED)\nhold_expiry (Timestamp)\nbooking_id (FK), version (Optimistic Lock)" {
  class: central
  style.stroke: "#F59E0B"
}

booking: "BOOKING\nbooking_id (PK)\nuser_id (FK), total_amt, status" { class: entity; style.stroke: "#10B981" }
user: "USER\nuser_id (PK)\nname, email" { class: entity; style.stroke: "#10B981" }

theater -> auditorium: "1:N houses"
auditorium -> seat: "1:N contains"
movie -> showtime: "1:N schedules"
auditorium -> showtime: "1:N hosts"
showtime -> show_seat: "1:N creates"
seat -> show_seat: "1:N maps"
booking -> show_seat: "1:N claims"
user -> booking: "1:N places"