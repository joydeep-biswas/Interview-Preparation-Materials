direction: right
classes: {
  container_blue: { style: { fill: "#0D1526", stroke: "#3B82F6" } }
  sched_box: { style: { fill: "#111827", stroke: "#3B82F6" } }
  batched_box: { style: { fill: "#111827", stroke: "#8B5CF6" } }
  good_box: { style: { fill: "#064E3B", stroke: "#10B981", stroke-width: 2 } }
  bad_box: { style: { fill: "#7F1D1D", stroke: "#EF4444", stroke-width: 2 } }
}

ServingEngine: "vLLM Continuous Batching" {
  class: container_blue
  Sched: "Iteration Scheduler (Token Budget = 4096)" { class: sched_box }
  Batched: "Batched Tokens:\n• Prefill: 2048 tokens (Compute-Bound)\n• Decode: 64 streams (Bandwidth-Bound)" { class: batched_box }

  Sched -> Batched
}

ChunkedPrefill: "✓ Chunked Prefill Enabled\n• Slices prompt into 512 chunks\n• Stable ITL & high throughput" { class: good_box }
NaivePrefill: "❌ Non-Chunked Prefill\n• Long prompt monopolizes iteration\n• Catastrophic ITL latency spike!" { class: bad_box }

ServingEngine.Batched -> ChunkedPrefill: "Chunked"
ServingEngine.Batched -> NaivePrefill: "Non-Chunked"
