direction: right
classes: {
  start_node: { style: { fill: "#111827"; stroke: "#3B82F6"; stroke-width: 2; border-radius: 8 } }
  dec_node: { style: { fill: "#1E293B"; stroke: "#F59E0B"; stroke-width: 2; border-radius: 8 } }
  selfhost_node: { style: { fill: "#064E3B"; stroke: "#10B981"; stroke-width: 2; border-radius: 8 } }
  api_node: { style: { fill: "#1E1B4B"; stroke: "#8B5CF6"; stroke-width: 2; border-radius: 8 } }
}

ProjectStart: "Enterprise LLM Initiation\nEvaluate hosting strategy" { class: start_node }

ZeroEgressCheck: "Zero-Egress Regulatory Mandate?\nHIPAA / Defense / Sovereign Banking" { class: dec_node }
SelfHostPrivate: "Self-Host Open-Weight Models\nvLLM / Triton on Private VPC\nZero vendor network egress" { class: selfhost_node }

VolumeCheck: "Daily Token Volume > 50M Tokens?\nHigh sustained concurrency" { class: dec_node }
MLOpsCheck: "Dedicated MLOps / K8s Team?\nCapacity to manage GPU drivers & CUDA" { class: dec_node }

CommercialAPI: "Commercial Frontier API\nAzure OpenAI / Anthropic / Vertex AI\nZero infra overhead | Lowest TCO" { class: api_node }

ProjectStart -> ZeroEgressCheck: "Architecture Review"
ZeroEgressCheck -> SelfHostPrivate: "YES: Strict VPC Mandate"
ZeroEgressCheck -> VolumeCheck: "NO: Cloud Egress Allowed"
VolumeCheck -> MLOpsCheck: "YES: High Scale"
VolumeCheck -> CommercialAPI: "NO: Low-to-Medium Scale"
MLOpsCheck -> SelfHostPrivate: "YES: Team Capable"
MLOpsCheck -> CommercialAPI: "NO: Lack K8s / GPU Team"
