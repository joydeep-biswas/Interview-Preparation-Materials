}

leaky_bucket: "Leaky Bucket (Fixed Smoothing)" {
  style.fill: "#111827"
  style.stroke: "#F59E0B"
  queue: "FIFO buffer holds incoming requests"
  leak: "Leaks at strictly fixed rate r"
  use: "Traffic shaping, protecting fragile databases"
}

token_bucket -> leaky_bucket: "Burst tolerance vs Output smoothing"