direction: right
classes: {
  container: { style: { fill: "#111827"; stroke-width: 2; border-radius: 10 } }
  box: { style: { fill: "#1E293B"; stroke-width: 2; border-radius: 8 } }
  table_box: { style: { fill: "#1E293B"; stroke: "#38bdf8"; stroke-width: 2 } }
  blue_box: { style: { fill: "#1e293b"; stroke: "#38bdf8"; stroke-width: 2; border-radius: 8 } }
  green_box: { style: { fill: "#0f291e"; stroke: "#4ade80"; stroke-width: 2; border-radius: 8 } }
  amber_box: { style: { fill: "#231e12"; stroke: "#fbbf24"; stroke-width: 2; border-radius: 8 } }
  purple_box: { style: { fill: "#1e1b2e"; stroke: "#c084fc"; stroke-width: 2; border-radius: 8 } }
  red_box: { style: { fill: "#2b1111"; stroke: "#f87171"; stroke-width: 2; border-radius: 8 } }
}

dist_monolith: "Distributed Monolith" {
  class: container
  style.fill: "#111827"
  style.stroke: "#EF4444"
  db: "Shared DB across all services (SPOF)"
  coupling: "Synchronous HTTP chains (A->B->C->D)"
  deploys: "Co-dependent lock-step weekend releases"
  verdict: "Worst of both worlds"
}

autonomous: "Autonomous Microservices" {
  class: container
  style.fill: "#111827"
  style.stroke: "#10B981"
  db: "Strict Database-per-Service isolation"
  async: "Event-driven via Kafka / Choreography"
  deploys: "Independent CI/CD deployments 50x/day"
  verdict: "Resilient & agile architecture"
}

dist_monolith -> autonomous: "Evolution to decoupled domain architecture"