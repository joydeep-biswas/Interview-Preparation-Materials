direction: right
classes: {
  container: { style: { fill: "#111827"; stroke-width: 2; border-radius: 10 } }
  box: { style: { fill: "#1E293B"; stroke-width: 2; border-radius: 8 } }
  table_box: { style: { fill: "#1E293B"; stroke: "#38bdf8"; stroke-width: 2 } }
  blue_box: { style: { fill: "#1e293b"; stroke: "#38bdf8"; stroke-width: 2; border-radius: 8 } }
  green_box: { style: { fill: "#0f291e"; stroke: "#4ade80"; stroke-width: 2; border-radius: 8 } }
  amber_box: { style: { fill: "#231e12"; stroke: "#fbbf24"; stroke-width: 2; border-radius: 8 } }
  purple_box: { style: { fill: "#1e1b2e"; stroke: "#c084fc"; stroke-width: 2; border-radius: 8 } }
  red_box: { style: { fill: "#2b1111"; stroke: "#f87171"; stroke-width: 2; border-radius: 8 } }
}

client: "1. Client Request" {
  class: container
  style.fill: "#111827"
  style.stroke: "#3B82F6"
  post: "POST /v1/payments"
  key: "Idempotency-Key: UUIDv4"
}

redis: "2. Redis Guard Layer" {
  class: container
  style.fill: "#111827"
  style.stroke: "#F59E0B"
  cache_lookup: "Check if result already cached"
  lock: "SET lock:{uuid} NX PX 15000" { class: box }
}

acquirer_db: "3. Acquirer & DB" {
  class: container
  style.fill: "#111827"
  style.stroke: "#10B981"
  stripe: "Stripe deduplicates with key"
  db: "UNIQUE constraint + Outbox table"
}

events: "4. Cache & Event Bus" {
  class: container
  style.fill: "#111827"
  style.stroke: "#8B5CF6"
  cache: "SETEX idem:{uuid} 24h" { class: box }
  kafka: "Debezium publishes PaymentSuccess"
  response: "Return HTTP 201 receipt"
}

client -> redis: "Validate & acquire lock"
redis -> acquirer_db: "Process payment"
acquirer_db -> events: "Save & notify"