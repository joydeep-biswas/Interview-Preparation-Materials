direction: right
classes: {
  container: { style: { fill: "#111827"; stroke-width: 2; border-radius: 10 } }
  box: { style: { fill: "#1E293B"; stroke-width: 2; border-radius: 8 } }
  table_box: { style: { fill: "#1E293B"; stroke: "#38bdf8"; stroke-width: 2 } }
  blue_box: { style: { fill: "#1e293b"; stroke: "#38bdf8"; stroke-width: 2; border-radius: 8 } }
  green_box: { style: { fill: "#0f291e"; stroke: "#4ade80"; stroke-width: 2; border-radius: 8 } }
  amber_box: { style: { fill: "#231e12"; stroke: "#fbbf24"; stroke-width: 2; border-radius: 8 } }
  purple_box: { style: { fill: "#1e1b2e"; stroke: "#c084fc"; stroke-width: 2; border-radius: 8 } }
  red_box: { style: { fill: "#2b1111"; stroke: "#f87171"; stroke-width: 2; border-radius: 8 } }
}

gateway: "1. Edge API Gateway" {
  class: container
  style.fill: "#111827"
  style.stroke: "#3B82F6"
  features: "TLS termination, JWT Auth, Token Bucket Rate Limiting"
}

mesh: "2. Service Mesh" {
  class: container
  style.fill: "#111827"
  style.stroke: "#F59E0B"
  discovery: "K8s CoreDNS / Consul"
  security: "SPIFFE mTLS Zero-Trust"
}

services: "3. Domain Microservices" {
  class: container
  style.fill: "#111827"
  style.stroke: "#10B981"
  order: "Order Service -> PostgreSQL"
  payment: "Payment Service -> PostgreSQL"
  catalog: "Catalog Service -> MongoDB"
  db_rule: "Strict Database-per-Service isolation"
}

event_bus: "4. Event Backbone" {
  class: container
  style.fill: "#111827"
  style.stroke: "#8B5CF6"
  kafka: "Kafka Choreography Saga"
  cdc: "Transactional Outbox with Debezium CDC"
}

gateway -> mesh: "Forward authenticated traffic"
mesh -> services: "mTLS load balancing"
services -> event_bus: "Publish domain events"