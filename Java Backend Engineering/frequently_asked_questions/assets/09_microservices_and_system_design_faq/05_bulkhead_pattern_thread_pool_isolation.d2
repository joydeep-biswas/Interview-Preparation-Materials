direction: right
classes: {
  container: { style: { fill: "#111827"; stroke-width: 2; border-radius: 10 } }
  box: { style: { fill: "#1E293B"; stroke-width: 2; border-radius: 8 } }
  table_box: { style: { fill: "#1E293B"; stroke: "#38bdf8"; stroke-width: 2 } }
  blue_box: { style: { fill: "#1e293b"; stroke: "#38bdf8"; stroke-width: 2; border-radius: 8 } }
  green_box: { style: { fill: "#0f291e"; stroke: "#4ade80"; stroke-width: 2; border-radius: 8 } }
  amber_box: { style: { fill: "#231e12"; stroke: "#fbbf24"; stroke-width: 2; border-radius: 8 } }
  purple_box: { style: { fill: "#1e1b2e"; stroke: "#c084fc"; stroke-width: 2; border-radius: 8 } }
  red_box: { style: { fill: "#2b1111"; stroke: "#f87171"; stroke-width: 2; border-radius: 8 } }
}

shared: "Anti-Pattern: Shared Thread Pool" {
  class: container
  style.fill: "#111827"
  style.stroke: "#EF4444"
  pool: "200 shared Tomcat threads"
  slow_dep: "Slow 3rd-party API blocks all 200 threads"
  collapse: "Checkout & Login fail (Whole system down!)"
}

bulkhead: "Bulkhead Pattern Solution" {
  class: container
  style.fill: "#111827"
  style.stroke: "#10B981"
  order_pool: "Core Orders: 150 threads (Protected)"
  rec_pool: "Recommendations: Capped at 20 threads"
  water_tight: "Slow dependency only floods its own compartment"
  survival: "Checkout stays 100% healthy!"
}

shared -> bulkhead: "Compartmentalized fault isolation"