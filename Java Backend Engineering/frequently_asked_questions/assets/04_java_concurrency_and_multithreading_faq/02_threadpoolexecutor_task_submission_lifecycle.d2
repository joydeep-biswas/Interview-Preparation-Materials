direction: right
classes: {
  container: { style: { fill: "#111827"; stroke-width: 2; border-radius: 10 } }
  box: { style: { fill: "#1E293B"; stroke-width: 2; border-radius: 8 } }
  table_box: { style: { fill: "#1E293B"; stroke: "#38bdf8"; stroke-width: 2 } }
  blue_box: { style: { fill: "#1e293b"; stroke: "#38bdf8"; stroke-width: 2; border-radius: 8 } }
  green_box: { style: { fill: "#0f291e"; stroke: "#4ade80"; stroke-width: 2; border-radius: 8 } }
  amber_box: { style: { fill: "#231e12"; stroke: "#fbbf24"; stroke-width: 2; border-radius: 8 } }
  purple_box: { style: { fill: "#1e1b2e"; stroke: "#c084fc"; stroke-width: 2; border-radius: 8 } }
  red_box: { style: { fill: "#2b1111"; stroke: "#f87171"; stroke-width: 2; border-radius: 8 } }
}

core_pool: "1. Core Pool Check" {
  class: container
  style.fill: "#111827"
  style.stroke: "#3B82F6"
  rule: "If count < corePoolSize -> Spawn worker thread"
  full: "If full -> Route to workQueue"
}

work_queue: "2. Queue Capacity" {
  class: container
  style.fill: "#111827"
  style.stroke: "#F59E0B"
  rule: "If queue not full -> workQueue.offer(task)"
  full: "If queue full -> Route to maximumPoolSize"
}

max_pool: "3. Max Pool Check" {
  class: container
  style.fill: "#111827"
  style.stroke: "#8B5CF6"
  rule: "If count < maxPoolSize -> Spawn burst worker"
  full: "If max pool reached -> Trigger Rejection"
}

rejection: "4. RejectedExecutionHandler" {
  class: container
  style.fill: "#111827"
  style.stroke: "#EF4444"
  caller_runs: "CallerRunsPolicy: Calling thread executes (backpressure)"
  abort: "AbortPolicy: Throws RejectedExecutionException"
  discard: "DiscardOldestPolicy / DiscardPolicy"
}

core_pool -> work_queue: "Core full"
work_queue -> max_pool: "Queue full"
max_pool -> rejection: "Pool exhausted"