direction: right

optimistic: "1. Optimistic Locking (@Version)" {
  style.fill: "#111827"
  style.stroke: "#10B981"
  read: "Non-blocking read without lock"
  update: "UPDATE WHERE id=1 AND version=1"
  conflict: "If count==0: OptimisticLockException & retry"
  workload: "High read / low contention (Scalable)"
}

pessimistic: "2. Pessimistic Locking (FOR UPDATE)" {
  style.fill: "#111827"
  style.stroke: "#EF4444"
  lock: "SELECT FOR UPDATE acquires DB row lock"
  block: "Other transactions blocked in DB"
  release: "Lock released on COMMIT"
  workload: "Heavy contention (Flash sales / Inventory)"
}

optimistic -> pessimistic: "Trade-offs in concurrency control"