direction: right
classes: {
  container: { style: { fill: "#111827"; stroke-width: 2; border-radius: 10 } }
  box: { style: { fill: "#1E293B"; stroke-width: 2; border-radius: 8 } }
  table_box: { style: { fill: "#1E293B"; stroke: "#38bdf8"; stroke-width: 2 } }
  blue_box: { style: { fill: "#1e293b"; stroke: "#38bdf8"; stroke-width: 2; border-radius: 8 } }
  green_box: { style: { fill: "#0f291e"; stroke: "#4ade80"; stroke-width: 2; border-radius: 8 } }
  amber_box: { style: { fill: "#231e12"; stroke: "#fbbf24"; stroke-width: 2; border-radius: 8 } }
  purple_box: { style: { fill: "#1e1b2e"; stroke: "#c084fc"; stroke-width: 2; border-radius: 8 } }
  red_box: { style: { fill: "#2b1111"; stroke: "#f87171"; stroke-width: 2; border-radius: 8 } }
}

new_state: "NEW" {
  class: container
  style.fill: "#111827"
  style.stroke: "#3B82F6"
  created: "Thread instantiated, not started"
}

runnable: "RUNNABLE" {
  class: container
  style.fill: "#111827"
  style.stroke: "#10B981"
  running: "Executing bytecode or in OS I/O"
}

blocked: "BLOCKED" {
  class: container
  style.fill: "#111827"
  style.stroke: "#EF4444"
  lock: "Waiting on synchronized object monitor"
}

waiting: "WAITING" {
  class: container
  style.fill: "#111827"
  style.stroke: "#F59E0B"
  park: "wait(), join(), LockSupport.park()"
}

timed_waiting: "TIMED_WAITING" {
  class: container
  style.fill: "#111827"
  style.stroke: "#8B5CF6"
  sleep: "sleep(ms), wait(timeout), parkNanos()"
}

terminated: "TERMINATED" {
  class: container
  style.fill: "#111827"
  style.stroke: "#6B7280"
  dead: "run() completed or unhandled exception"
}

new_state -> runnable: "thread.start()"
runnable -> blocked: "synchronized lock contention"
runnable -> waiting: "wait() / park()"
runnable -> timed_waiting: "sleep() / timeout"
runnable -> terminated: "run() finished"