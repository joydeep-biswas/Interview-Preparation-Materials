direction: right
classes: {
  container: { style: { fill: "#111827"; stroke-width: 2; border-radius: 10 } }
  box: { style: { fill: "#1E293B"; stroke-width: 2; border-radius: 8 } }
  table_box: { style: { fill: "#1E293B"; stroke: "#38bdf8"; stroke-width: 2 } }
  blue_box: { style: { fill: "#1e293b"; stroke: "#38bdf8"; stroke-width: 2; border-radius: 8 } }
  green_box: { style: { fill: "#0f291e"; stroke: "#4ade80"; stroke-width: 2; border-radius: 8 } }
  amber_box: { style: { fill: "#231e12"; stroke: "#fbbf24"; stroke-width: 2; border-radius: 8 } }
  purple_box: { style: { fill: "#1e1b2e"; stroke: "#c084fc"; stroke-width: 2; border-radius: 8 } }
  red_box: { style: { fill: "#2b1111"; stroke: "#f87171"; stroke-width: 2; border-radius: 8 } }
}

core1: "CPU Core 1 (Thread 1)" {
  class: container
  style.fill: "#111827"
  style.stroke: "#3B82F6"
  reg: "flag = true (Local write)"
  barrier: "Volatile write (StoreLoad barrier)"
}

bus: "MESI Bus & Shared L3 Cache" {
  class: container
  style.fill: "#111827"
  style.stroke: "#10B981"
  mesi: "Invalidates Core 2 cache line"
  l3: "Shared L3 cache holds synchronized data"
}

core2: "CPU Core 2 (Thread 2)" {
  class: container
  style.fill: "#111827"
  style.stroke: "#EF4444"
  stale: "Cannot use stale L1 cache"
  read: "Volatile read reloads from shared memory"
}

core1 -> bus: "Flush on volatile write"
bus -> core2: "Invalidate cache line"