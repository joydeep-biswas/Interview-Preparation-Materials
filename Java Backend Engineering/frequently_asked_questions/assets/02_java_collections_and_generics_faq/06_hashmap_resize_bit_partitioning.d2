direction: right
classes: {
  container: { style: { fill: "#111827"; stroke-width: 2; border-radius: 10 } }
  box: { style: { fill: "#1E293B"; stroke-width: 2; border-radius: 8 } }
  table_box: { style: { fill: "#1E293B"; stroke: "#38bdf8"; stroke-width: 2 } }
  blue_box: { style: { fill: "#1e293b"; stroke: "#38bdf8"; stroke-width: 2; border-radius: 8 } }
  green_box: { style: { fill: "#0f291e"; stroke: "#4ade80"; stroke-width: 2; border-radius: 8 } }
  amber_box: { style: { fill: "#231e12"; stroke: "#fbbf24"; stroke-width: 2; border-radius: 8 } }
  purple_box: { style: { fill: "#1e1b2e"; stroke: "#c084fc"; stroke-width: 2; border-radius: 8 } }
  red_box: { style: { fill: "#2b1111"; stroke: "#f87171"; stroke-width: 2; border-radius: 8 } }
}

old_table: "Old Table (Cap = 16)" {
  class: container
  style.fill: "#111827"
  style.stroke: "#3B82F6"
  mask: "Mask: 0000 1111"
  collision: "Key A and Key B both at index 5"
}

rehash: "resize() Doubling (Cap = 32)" {
  class: container
  style.fill: "#111827"
  style.stroke: "#F59E0B"
  bit_test: "Check bit: (hash & 16)"
  bit_0: "Bit == 0 -> Remains at index 5"
  bit_1: "Bit == 1 -> Moves to index 5 + 16 = 21"
}

new_table: "New Table (Cap = 32)" {
  class: container
  style.fill: "#111827"
  style.stroke: "#10B981"
  low: "Bucket 5: Key A (loHead)"
  high: "Bucket 21: Key B (hiHead)"
  order: "Order preserved, zero hashCode() recalculation"
}

old_table -> rehash: "Threshold reached"
rehash -> new_table: "Bit-partitioned split"