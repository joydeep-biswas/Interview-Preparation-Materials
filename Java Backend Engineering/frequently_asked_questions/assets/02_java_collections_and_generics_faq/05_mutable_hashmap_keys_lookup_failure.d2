direction: right
classes: {
  container: { style: { fill: "#111827"; stroke-width: 2; border-radius: 10 } }
  box: { style: { fill: "#1E293B"; stroke-width: 2; border-radius: 8 } }
  table_box: { style: { fill: "#1E293B"; stroke: "#38bdf8"; stroke-width: 2 } }
  blue_box: { style: { fill: "#1e293b"; stroke: "#38bdf8"; stroke-width: 2; border-radius: 8 } }
  green_box: { style: { fill: "#0f291e"; stroke: "#4ade80"; stroke-width: 2; border-radius: 8 } }
  amber_box: { style: { fill: "#231e12"; stroke: "#fbbf24"; stroke-width: 2; border-radius: 8 } }
  purple_box: { style: { fill: "#1e1b2e"; stroke: "#c084fc"; stroke-width: 2; border-radius: 8 } }
  red_box: { style: { fill: "#2b1111"; stroke: "#f87171"; stroke-width: 2; border-radius: 8 } }
}

insert: "1. map.put(userKey, data)" {
  class: container
  style.fill: "#111827"
  style.stroke: "#3B82F6"
  hash: "hashCode = 100 -> Bucket 4"
}

mutate: "2. userKey.setName('Bob')" {
  class: container
  style.fill: "#111827"
  style.stroke: "#F59E0B"
  hash: "hashCode changes to 520!"
}

lookup: "3. map.get(userKey)" {
  class: container
  style.fill: "#111827"
  style.stroke: "#EF4444"
  hash: "Looks in Bucket 8 -> Returns NULL!"
}

leak: "4. Permanent Memory Leak" {
  class: container
  style.fill: "#111827"
  style.stroke: "#8B5CF6"
  zombie: "Entry remains pinned in Bucket 4 forever"
  remedy: "Use Immutable Keys (Records, Strings)"
}

insert -> mutate: "Key mutated"
mutate -> lookup: "Lookup fails"
lookup -> leak: "Memory leak"