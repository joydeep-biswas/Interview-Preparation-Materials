direction: down
classes: {
  container: { style: { fill: "#111827"; stroke-width: 2; border-radius: 10 } }
  box: { style: { fill: "#1E293B"; stroke-width: 2; border-radius: 8 } }
  table_box: { style: { fill: "#1E293B"; stroke: "#38bdf8"; stroke-width: 2 } }
  blue_box: { style: { fill: "#1e293b"; stroke: "#38bdf8"; stroke-width: 2; border-radius: 8 } }
  green_box: { style: { fill: "#0f291e"; stroke: "#4ade80"; stroke-width: 2; border-radius: 8 } }
  amber_box: { style: { fill: "#231e12"; stroke: "#fbbf24"; stroke-width: 2; border-radius: 8 } }
  purple_box: { style: { fill: "#1e1b2e"; stroke: "#c084fc"; stroke-width: 2; border-radius: 8 } }
  red_box: { style: { fill: "#2b1111"; stroke: "#f87171"; stroke-width: 2; border-radius: 8 } }
}

iterable: "Iterable<E> (Root Cursor Contract)" {
  class: container
  style.fill: "#111827"
  style.stroke: "#3B82F6"
  methods: "iterator(), forEach(), spliterator()"
}

collection: "Collection<E> (Core Container Contract)" {
  class: container
  style.fill: "#111827"
  style.stroke: "#10B981"
  methods: "add(), remove(), contains(), stream()"
}

iterable -> collection: "extends"

list: "List<E> (Ordered, Indexed)" {
  class: container
  style.fill: "#111827"
  style.stroke: "#3B82F6"
  impls: "ArrayList | LinkedList"
}

set: "Set<E> (Distinct Elements)" {
  class: container
  style.fill: "#111827"
  style.stroke: "#10B981"
  impls: "HashSet | TreeSet"
}

queue: "Queue<E> & Deque<E>" {
  class: container
  style.fill: "#111827"
  style.stroke: "#F59E0B"
  impls: "ArrayDeque | PriorityQueue"
}

map: "Map<K, V> (Key-Value Associative)" {
  class: container
  style.fill: "#111827"
  style.stroke: "#8B5CF6"
  impls: "HashMap | LinkedHashMap | TreeMap | ConcurrentHashMap"
}

collection -> list: "extends"
collection -> set: "extends"
collection -> queue: "extends"