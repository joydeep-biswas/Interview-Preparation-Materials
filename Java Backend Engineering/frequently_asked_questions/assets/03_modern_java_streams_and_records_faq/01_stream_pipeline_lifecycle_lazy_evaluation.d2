direction: right
classes: {
  container: { style: { fill: "#111827"; stroke-width: 2; border-radius: 10 } }
  box: { style: { fill: "#1E293B"; stroke-width: 2; border-radius: 8 } }
  table_box: { style: { fill: "#1E293B"; stroke: "#38bdf8"; stroke-width: 2 } }
  blue_box: { style: { fill: "#1e293b"; stroke: "#38bdf8"; stroke-width: 2; border-radius: 8 } }
  green_box: { style: { fill: "#0f291e"; stroke: "#4ade80"; stroke-width: 2; border-radius: 8 } }
  amber_box: { style: { fill: "#231e12"; stroke: "#fbbf24"; stroke-width: 2; border-radius: 8 } }
  purple_box: { style: { fill: "#1e1b2e"; stroke: "#c084fc"; stroke-width: 2; border-radius: 8 } }
  red_box: { style: { fill: "#2b1111"; stroke: "#f87171"; stroke-width: 2; border-radius: 8 } }
}

source: "1. Data Source" {
  class: container
  style.fill: "#111827"
  style.stroke: "#3B82F6"
  origin: "Collection, Array, Spliterator"
  invariant: "Non-storing, traversable once"
}

intermediate: "2. Intermediate Ops (Lazy)" {
  class: container
  style.fill: "#111827"
  style.stroke: "#F59E0B"
  stateless: "filter(), map() -> Fused Sinks"
  stateful: "sorted(), distinct() -> Buffering barrier"
  eval: "ZERO execution until terminal call"
}

terminal: "3. Terminal Op (Execution)" {
  class: container
  style.fill: "#111827"
  style.stroke: "#10B981"
  pull: "Pulls elements through fused pipeline"
  short_circuit: "findFirst(), limit() halt early"
  result: "collect(), reduce(), forEach()"
}

source -> intermediate: "Creates pipeline stages"
intermediate -> terminal: "Terminal op pulls execution"