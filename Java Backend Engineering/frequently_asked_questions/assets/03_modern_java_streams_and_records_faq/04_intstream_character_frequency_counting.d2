direction: right
classes: {
  container: { style: { fill: "#111827"; stroke-width: 2; border-radius: 10 } }
  box: { style: { fill: "#1E293B"; stroke-width: 2; border-radius: 8 } }
  table_box: { style: { fill: "#1E293B"; stroke: "#38bdf8"; stroke-width: 2 } }
  blue_box: { style: { fill: "#1e293b"; stroke: "#38bdf8"; stroke-width: 2; border-radius: 8 } }
  green_box: { style: { fill: "#0f291e"; stroke: "#4ade80"; stroke-width: 2; border-radius: 8 } }
  amber_box: { style: { fill: "#231e12"; stroke: "#fbbf24"; stroke-width: 2; border-radius: 8 } }
  purple_box: { style: { fill: "#1e1b2e"; stroke: "#c084fc"; stroke-width: 2; border-radius: 8 } }
  red_box: { style: { fill: "#2b1111"; stroke: "#f87171"; stroke-width: 2; border-radius: 8 } }
}

source: "1. IntStream Source" {
  class: container
  style.fill: "#111827"
  style.stroke: "#3B82F6"
  str: "'swiss'.chars() -> IntStream"
  box: "mapToObj(c -> (char)c)"
}

freq_map: "2. LinkedHashMap Counts" {
  class: container
  style.fill: "#111827"
  style.stroke: "#F59E0B"
  collect: "groupingBy(c; LinkedHashMap::new, counting())"
  table: "'s': 3 | 'w': 1 | 'i': 1"
  order: "LinkedHashMap preserves insertion order"
}

find: "3. findFirst() Non-Repeating" {
  class: container
  style.fill: "#111827"
  style.stroke: "#10B981"
  filter: "filter(entry -> entry.getValue() == 1)"
  result: "Optional.of('w') short-circuits"
  complexity: "O(N) Time | O(Sigma) Space"
}

source -> freq_map: "Stream chars"
freq_map -> find: "Scan ordered entries"