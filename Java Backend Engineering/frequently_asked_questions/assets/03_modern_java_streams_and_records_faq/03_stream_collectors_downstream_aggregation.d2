direction: right
classes: {
  container: { style: { fill: "#111827"; stroke-width: 2; border-radius: 10 } }
  box: { style: { fill: "#1E293B"; stroke-width: 2; border-radius: 8 } }
  table_box: { style: { fill: "#1E293B"; stroke: "#38bdf8"; stroke-width: 2 } }
  blue_box: { style: { fill: "#1e293b"; stroke: "#38bdf8"; stroke-width: 2; border-radius: 8 } }
  green_box: { style: { fill: "#0f291e"; stroke: "#4ade80"; stroke-width: 2; border-radius: 8 } }
  amber_box: { style: { fill: "#231e12"; stroke: "#fbbf24"; stroke-width: 2; border-radius: 8 } }
  purple_box: { style: { fill: "#1e1b2e"; stroke: "#c084fc"; stroke-width: 2; border-radius: 8 } }
  red_box: { style: { fill: "#2b1111"; stroke: "#f87171"; stroke-width: 2; border-radius: 8 } }
}

source: "1. Stream<Employee>" {
  class: container
  style.fill: "#111827"
  style.stroke: "#3B82F6"
  emps: "Alice (\$140k, Eng) | Bob (\$160k, Eng) | Charlie (\$120k, Fin)"
}

group: "2. groupingBy(department)" {
  class: container
  style.fill: "#111827"
  style.stroke: "#F59E0B"
  eng: "Engineering partition"
  fin: "Finance partition"
}

map: "3. mapping(salary)" {
  class: container
  style.fill: "#111827"
  style.stroke: "#8B5CF6"
  salary_stream: "Extracts Double salary, discards Emp object"
}

avg: "4. averagingDouble()" {
  class: container
  style.fill: "#111827"
  style.stroke: "#10B981"
  result: "Map<String, Double>: Eng: \$150k; Fin: \$120k"
  space: "O(1) accumulator per bucket"
}

source -> group: "Feed employees"
group -> map: "Department stream"
map -> avg: "Aggregate average"