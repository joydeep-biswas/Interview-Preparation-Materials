direction: right
classes: {
  pillar: { style: { fill: "#111827"; stroke-width: 2; rx: 10 } }
  card: { style: { fill: "#1E293B"; stroke-width: 1.5; rx: 8 } }
}

trigger: "Crash Event" {
  class: pillar
  style.stroke: "#EF4444"
  oom: "JVM throws OutOfMemoryError\nHeap exhausted, mutator threads freeze" { class: card; style.stroke: "#EF4444" }
  dump: "Automatic HPROF Dump\n-XX:+HeapDumpOnOutOfMemoryError" { class: card; style.stroke: "#EF4444" }

  oom -> dump
}

triage: "Offline Triage in Eclipse MAT" {
  class: pillar
  style.stroke: "#3B82F6"
  mat: "Open .hprof in Eclipse MAT\nIndex references and dominator hierarchy" { class: card; style.stroke: "#3B82F6" }
  dom_tree: "Inspect Dominator Tree\nSort objects by retained heap size" { class: card; style.stroke: "#3B82F6" }
  suspects: "Leak Suspects Report\nPinpoint single class holding >20% heap" { class: card; style.stroke: "#3B82F6" }
  gc_roots: "Path to GC Roots\nExclude soft/weak/phantom references" { class: card; style.stroke: "#3B82F6" }

  mat -> dom_tree -> gc_roots
  mat -> suspects -> gc_roots
}

root_cause: "Root Cause Remediation" {
  class: pillar
  style.stroke: "#10B981"
  static_cache: "Static Map / Unbounded Cache\nReplace with Caffeine maxWeight + expireAfterWrite" { class: card; style.stroke: "#10B981" }
  thread_local: "ThreadLocal Leak in Pooled Thread\nAlways wrap in try { ... } finally { tl.remove(); }" { class: card; style.stroke: "#10B981" }
  metaspace: "Metaspace Classloader Leak\nPrevent CGLIB / dynamic proxy class explosion" { class: card; style.stroke: "#10B981" }

  gc_roots -> static_cache
  gc_roots -> thread_local
  gc_roots -> metaspace
}

trigger.dump -> triage.mat
