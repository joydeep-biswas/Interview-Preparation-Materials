}

kafka: "Apache Kafka (Distributed Log)" {
  style.fill: "#111827"
  style.stroke: "#10B981"
  storage: "Append-only partitioned commit log"
  lifecycle: "Persistent: Retained by time/size, fully replayable"
  use: "High-throughput event streaming (1M+ msgs/s)"
}

rabbitmq -> kafka: "Queuing vs Event Streaming trade-off"