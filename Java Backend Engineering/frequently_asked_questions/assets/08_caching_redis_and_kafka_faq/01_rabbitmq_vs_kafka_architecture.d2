direction: right

rabbitmq: "RabbitMQ (Smart Broker)" {
  style.fill: "#111827"
  style.stroke: "#F59E0B"
  routing: "Exchange with complex routing keys"
  lifecycle: "Ephemeral: Deleted immediately after ACK"
