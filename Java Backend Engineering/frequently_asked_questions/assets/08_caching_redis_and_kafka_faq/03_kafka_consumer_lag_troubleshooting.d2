direction: right
classes: {
  container: { style: { fill: "#111827"; stroke-width: 2; border-radius: 10 } }
  box: { style: { fill: "#1E293B"; stroke-width: 2; border-radius: 8 } }
  table_box: { style: { fill: "#1E293B"; stroke: "#38bdf8"; stroke-width: 2 } }
  blue_box: { style: { fill: "#1e293b"; stroke: "#38bdf8"; stroke-width: 2; border-radius: 8 } }
  green_box: { style: { fill: "#0f291e"; stroke: "#4ade80"; stroke-width: 2; border-radius: 8 } }
  amber_box: { style: { fill: "#231e12"; stroke: "#fbbf24"; stroke-width: 2; border-radius: 8 } }
  purple_box: { style: { fill: "#1e1b2e"; stroke: "#c084fc"; stroke-width: 2; border-radius: 8 } }
  red_box: { style: { fill: "#2b1111"; stroke: "#f87171"; stroke-width: 2; border-radius: 8 } }
}

symptom: "1. Lag Monotonic Increase" {
  class: container
  style.fill: "#111827"
  style.stroke: "#EF4444"
  lag: "Lag = LogEndOffset - CurrentOffset"
  alert: "Lag > 50,000 records & latency spikes"
}

diagnostics: "2. Diagnostic Triage" {
  class: container
  style.fill: "#111827"
  style.stroke: "#F59E0B"
  skew: "Single partition lag: Hot key or poison pill"
  timeout: "max.poll.interval.ms: Rebalance storm"
  db: "Downstream DB bottleneck"
}

remedies: "3. Remedies" {
  class: container
  style.fill: "#111827"
  style.stroke: "#10B981"
  scale: "Scale consumers (up to partition count)"
  partitions: "Increase partition count for parallel scale"
  sticky: "CooperativeStickyAssignor (no stop-the-world)"
}

symptom -> diagnostics: "Triage root cause"
diagnostics -> remedies: "Apply mitigation"