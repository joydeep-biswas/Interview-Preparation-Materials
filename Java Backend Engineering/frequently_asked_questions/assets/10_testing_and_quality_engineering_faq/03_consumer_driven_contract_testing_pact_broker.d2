direction: right
classes: {
  box: { style: { fill: "#111827"; stroke-width: 1.5; rx: 10 } }
}

consumer: "Frontend / Client Microservice\n(Consumer Service)" {
  class: box
  style.stroke: "#3B82F6"
}

broker: "Pact Broker\n(Contract Storage & Matrix Engine)" {
  class: box
  style.stroke: "#8B5CF6"
}

provider: "Backend Producer Microservice\n(Order / Payment API)" {
  class: box
  style.stroke: "#10B981"
}

deploy_tool: "can-i-deploy CLI\n(Pre-release verification gate)" {
  class: box
  style.stroke: "#F59E0B"
}

consumer -> broker: "1. Publish Contract JSON (Pact file)"
broker -> provider: "2. Fetch Consumer Expectations in CI"
provider -> broker: "3. Publish Verification Result (Pass/Fail)"
deploy_tool -> broker: "4. Query Verification Matrix"
deploy_tool -> consumer: "5. Safe to deploy to Production"
