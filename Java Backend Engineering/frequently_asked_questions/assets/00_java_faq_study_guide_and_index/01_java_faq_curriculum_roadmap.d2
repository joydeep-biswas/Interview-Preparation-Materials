direction: right
classes: {
  container: { style: { fill: "#111827"; stroke-width: 2; border-radius: 10 } }
  box: { style: { fill: "#1E293B"; stroke-width: 2; border-radius: 8 } }
  table_box: { style: { fill: "#1E293B"; stroke: "#38bdf8"; stroke-width: 2 } }
  blue_box: { style: { fill: "#1e293b"; stroke: "#38bdf8"; stroke-width: 2; border-radius: 8 } }
  green_box: { style: { fill: "#0f291e"; stroke: "#4ade80"; stroke-width: 2; border-radius: 8 } }
  amber_box: { style: { fill: "#231e12"; stroke: "#fbbf24"; stroke-width: 2; border-radius: 8 } }
  purple_box: { style: { fill: "#1e1b2e"; stroke: "#c084fc"; stroke-width: 2; border-radius: 8 } }
  red_box: { style: { fill: "#2b1111"; stroke: "#f87171"; stroke-width: 2; border-radius: 8 } }
}

tier1: "Tier 1: Language & Memory" {
  class: container
  style.fill: "#111827"
  style.stroke: "#3B82F6"
  style.stroke-width: 2
  m1: "01. Core Java & Algorithms"
  m2: "02. Collections & Generics"
  m3: "03. Modern Java & Streams"
  m4: "04. Concurrency & Async"
}

tier2: "Tier 2: Frameworks & Sec" {
  class: container
  style.fill: "#111827"
  style.stroke: "#10B981"
  style.stroke-width: 2
  m5: "05. Spring Boot & REST"
  m6: "06. Security & Cryptography"
}

tier3: "Tier 3: Distributed Data" {
  class: container
  style.fill: "#111827"
  style.stroke: "#F59E0B"
  style.stroke-width: 2
  m7: "07. Databases & Hibernate"
  m8: "08. Caching & Messaging"
  m9: "09. Microservices & Design"
}

tier4: "Tier 4: Production & Ops" {
  class: container
  style.fill: "#111827"
  style.stroke: "#8B5CF6"
  style.stroke-width: 2
  m10: "10. Testing & Quality"
  m11: "11. Cloud & Containers"
  m12: "12. JVM Performance"
  m13: "13. Linux & Networking"
}

tier1 -> tier2: "Language to Enterprise" {
  style.stroke: "#10B981"
  style.stroke-width: 2
}
tier2 -> tier3: "Services to Distributed Systems" {
  style.stroke: "#F59E0B"
  style.stroke-width: 2
}
tier3 -> tier4: "Architecture to Production Ops" {
  style.stroke: "#8B5CF6"
  style.stroke-width: 2
}