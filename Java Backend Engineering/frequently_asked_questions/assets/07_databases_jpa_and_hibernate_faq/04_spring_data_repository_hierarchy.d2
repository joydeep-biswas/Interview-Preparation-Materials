direction: down
classes: {
  container: { style: { fill: "#111827"; stroke-width: 2; border-radius: 10 } }
  box: { style: { fill: "#1E293B"; stroke-width: 2; border-radius: 8 } }
  table_box: { style: { fill: "#1E293B"; stroke: "#38bdf8"; stroke-width: 2 } }
  blue_box: { style: { fill: "#1e293b"; stroke: "#38bdf8"; stroke-width: 2; border-radius: 8 } }
  green_box: { style: { fill: "#0f291e"; stroke: "#4ade80"; stroke-width: 2; border-radius: 8 } }
  amber_box: { style: { fill: "#231e12"; stroke: "#fbbf24"; stroke-width: 2; border-radius: 8 } }
  purple_box: { style: { fill: "#1e1b2e"; stroke: "#c084fc"; stroke-width: 2; border-radius: 8 } }
  red_box: { style: { fill: "#2b1111"; stroke: "#f87171"; stroke-width: 2; border-radius: 8 } }
}

repo: "Repository<T, ID> (Root Marker)" {
  class: container
  style.fill: "#111827"
  style.stroke: "#3B82F6"
}

crud: "CrudRepository<T, ID>" {
  class: container
  style.fill: "#111827"
  style.stroke: "#F59E0B"
  methods: "save(), findById(), delete()"
}

list_crud: "ListCrudRepository<T, ID>" {
  class: container
  style.fill: "#111827"
  style.stroke: "#3B82F6"
  methods: "findAll(): List<T>"
}

paging: "PagingAndSortingRepository<T, ID>" {
  class: container
  style.fill: "#111827"
  style.stroke: "#10B981"
  methods: "findAll(Pageable): Page<T>"
}

jpa: "JpaRepository<T, ID>" {
  class: container
  style.fill: "#111827"
  style.stroke: "#8B5CF6"
  methods: "flush(), saveAndFlush(), deleteInBatch()"
}

repo -> crud: "extends"
crud -> list_crud: "extends"
crud -> paging: "extends"
list_crud -> jpa: "extends"
paging -> jpa: "extends"