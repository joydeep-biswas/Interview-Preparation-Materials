direction: right
classes: {
  container: { style: { fill: "#111827"; stroke-width: 2; border-radius: 10 } }
  box: { style: { fill: "#1E293B"; stroke-width: 2; border-radius: 8 } }
  table_box: { style: { fill: "#1E293B"; stroke: "#38bdf8"; stroke-width: 2 } }
  blue_box: { style: { fill: "#1e293b"; stroke: "#38bdf8"; stroke-width: 2; border-radius: 8 } }
  green_box: { style: { fill: "#0f291e"; stroke: "#4ade80"; stroke-width: 2; border-radius: 8 } }
  amber_box: { style: { fill: "#231e12"; stroke: "#fbbf24"; stroke-width: 2; border-radius: 8 } }
  purple_box: { style: { fill: "#1e1b2e"; stroke: "#c084fc"; stroke-width: 2; border-radius: 8 } }
  red_box: { style: { fill: "#2b1111"; stroke: "#f87171"; stroke-width: 2; border-radius: 8 } }
}

proxy: "1. AOP Proxy Intercept" {
  class: container
  style.fill: "#111827"
  style.stroke: "#3B82F6"
  interceptor: "TransactionInterceptor.invokeWithinTransaction()"
  config: "Inspects propagation (REQUIRED) and isolation"
}

tm: "2. PlatformTxManager" {
  class: container
  style.fill: "#111827"
  style.stroke: "#F59E0B"
  conn: "con.setAutoCommit(false)"
  thread_local: "TransactionSynchronizationManager binds connection"
}

target: "3. Target Method" {
  class: container
  style.fill: "#111827"
  style.stroke: "#10B981"
  service: "OrderServiceImpl.create() executes"
  sql: "repo.save() uses ThreadLocal connection"
}

finish: "4. Commit / Rollback" {
  class: container
  style.fill: "#111827"
  style.stroke: "#8B5CF6"
  commit: "con.commit() on normal return"
  rollback: "con.rollback() on RuntimeException"
  pool: "HikariCP reclaims connection"
}

proxy -> tm: "Begin transaction"
tm -> target: "Execute business logic"
target -> finish: "Commit or rollback"