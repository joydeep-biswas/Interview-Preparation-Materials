direction: right
classes: {
  container: { style: { fill: "#111827"; stroke-width: 2; border-radius: 10 } }
  box: { style: { fill: "#1E293B"; stroke-width: 2; border-radius: 8 } }
  table_box: { style: { fill: "#1E293B"; stroke: "#38bdf8"; stroke-width: 2 } }
  blue_box: { style: { fill: "#1e293b"; stroke: "#38bdf8"; stroke-width: 2; border-radius: 8 } }
  green_box: { style: { fill: "#0f291e"; stroke: "#4ade80"; stroke-width: 2; border-radius: 8 } }
  amber_box: { style: { fill: "#231e12"; stroke: "#fbbf24"; stroke-width: 2; border-radius: 8 } }
  purple_box: { style: { fill: "#1e1b2e"; stroke: "#c084fc"; stroke-width: 2; border-radius: 8 } }
  red_box: { style: { fill: "#2b1111"; stroke: "#f87171"; stroke-width: 2; border-radius: 8 } }
}

client: "1. External Client" {
  class: container
  style.fill: "#111827"
  style.stroke: "#3B82F6"
  jwt: "Bearer JWT (RS256 signed by IdP)"
}

gateway: "2. API Gateway (Edge AuthN)" {
  class: container
  style.fill: "#111827"
  style.stroke: "#10B981"
  verify: "Validates signature with JWKS public keys"
  blacklist: "Checks Redis token blacklist"
}

propagation: "3. Identity Propagation" {
  class: container
  style.fill: "#111827"
  style.stroke: "#F59E0B"
  headers: "Mints trusted internal X-User-Id headers"
  mtls: "Transports across internal mTLS mesh"
}

services: "4. Internal Services" {
  class: container
  style.fill: "#111827"
  style.stroke: "#8B5CF6"
  order: "Order Service & Payment Service"
  authz: "Fast local role authorization (No RSA re-verify)"
}

client -> gateway: "HTTPS Request with JWT"
gateway -> propagation: "Authenticated identity"
propagation -> services: "mTLS internal propagation"