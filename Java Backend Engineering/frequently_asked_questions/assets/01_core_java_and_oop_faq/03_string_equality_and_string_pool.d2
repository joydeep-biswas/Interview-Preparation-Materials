direction: right
classes: {
  container: { style: { fill: "#111827"; stroke-width: 2; border-radius: 10 } }
  box: { style: { fill: "#1E293B"; stroke-width: 2; border-radius: 8 } }
  table_box: { style: { fill: "#1E293B"; stroke: "#38bdf8"; stroke-width: 2 } }
  blue_box: { style: { fill: "#1e293b"; stroke: "#38bdf8"; stroke-width: 2; border-radius: 8 } }
  green_box: { style: { fill: "#0f291e"; stroke: "#4ade80"; stroke-width: 2; border-radius: 8 } }
  amber_box: { style: { fill: "#231e12"; stroke: "#fbbf24"; stroke-width: 2; border-radius: 8 } }
  purple_box: { style: { fill: "#1e1b2e"; stroke: "#c084fc"; stroke-width: 2; border-radius: 8 } }
  red_box: { style: { fill: "#2b1111"; stroke: "#f87171"; stroke-width: 2; border-radius: 8 } }
}

stack: "Stack Frame Variables" {
  class: container
  style.fill: "#111827"
  style.stroke: "#3B82F6"
  style.stroke-width: 2
  s1: "s1 = 'Java' (Literal)"
  s2: "s2 = 'Java' (Literal)"
  s3: "s3 = new String('Java')"
}

pool: "String Intern Pool (Inside Heap)" {
  class: container
  style.fill: "#111827"
  style.stroke: "#10B981"
  style.stroke-width: 2
  canonical: "Canonical Pooled String: 'Java'"
}

heap_obj: "Regular Heap Object" {
  class: container
  style.fill: "#111827"
  style.stroke: "#F59E0B"
  style.stroke-width: 2
  fresh: "Distinct String Instance: 'Java'"
}

assertions: "Comparison Assertions" {
  class: container
  style.fill: "#111827"
  style.stroke: "#8B5CF6"
  style.stroke-width: 2
  c1: "s1 == s2 : TRUE (Same Address)"
  c2: "s1 == s3 : FALSE (Different Address)"
  c3: "s1.equals(s3) : TRUE (Same Value)"
}

stack.s1 -> pool.canonical
stack.s2 -> pool.canonical
stack.s3 -> heap_obj.fresh
pool -> assertions
heap_obj -> assertions