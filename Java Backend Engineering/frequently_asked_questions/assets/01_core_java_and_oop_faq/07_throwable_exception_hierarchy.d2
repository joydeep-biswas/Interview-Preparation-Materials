direction: down
title: "Java Throwable & Exception Class Hierarchy"
classes: {
  container: { style: { fill: "#111827"; stroke-width: 2; border-radius: 10 } }
  box: { style: { fill: "#1E293B"; stroke-width: 2; border-radius: 8 } }
  table_box: { style: { fill: "#1E293B"; stroke: "#38bdf8"; stroke-width: 2 } }
  blue_box: { style: { fill: "#1e293b"; stroke: "#38bdf8"; stroke-width: 2; border-radius: 8 } }
  green_box: { style: { fill: "#0f291e"; stroke: "#4ade80"; stroke-width: 2; border-radius: 8 } }
  amber_box: { style: { fill: "#231e12"; stroke: "#fbbf24"; stroke-width: 2; border-radius: 8 } }
  purple_box: { style: { fill: "#1e1b2e"; stroke: "#c084fc"; stroke-width: 2; border-radius: 8 } }
  red_box: { style: { fill: "#2b1111"; stroke: "#f87171"; stroke-width: 2; border-radius: 8 } }
}

Root: "java.lang.Throwable" {
  class: container
  style.fill: "#1E293B"
  style.stroke: "#3B82F6"
}

FatalErrors: "java.lang.Error (Fatal JVM Failures)" {
  class: container
  style.fill: "#1C1917"
  style.stroke: "#EF4444"
  types: "OutOfMemoryError, StackOverflowError, VirtualMachineError"
  rule: "Unrecoverable; NEVER catch in application code"
}

Checked: "java.lang.Exception (Checked Exceptions)" {
  class: container
  style.fill: "#1C1917"
  style.stroke: "#F59E0B"
  types: "IOException, SQLException, TimeoutException"
  rule: "Enforced by javac compiler (mandatory try-catch or throws)"
}

Unchecked: "java.lang.RuntimeException (Unchecked)" {
  class: container
  style.fill: "#06201B"
  style.stroke: "#047857"
  types: "NullPointerException, IllegalArgumentException"
  rule: "Software bugs; fix root cause rather than catching"
}

Root -> FatalErrors: "Unrecoverable" { style.stroke: "#EF4444" }
Root -> Checked: "Recoverable External" { style.stroke: "#F59E0B" }
Checked -> Unchecked: "Programming Bugs" { style.stroke: "#10B981" }