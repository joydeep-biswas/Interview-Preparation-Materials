direction: right
classes: {
  container: { style: { fill: "#111827"; stroke-width: 2; border-radius: 10 } }
  box: { style: { fill: "#1E293B"; stroke-width: 2; border-radius: 8 } }
  table_box: { style: { fill: "#1E293B"; stroke: "#38bdf8"; stroke-width: 2 } }
  blue_box: { style: { fill: "#1e293b"; stroke: "#38bdf8"; stroke-width: 2; border-radius: 8 } }
  green_box: { style: { fill: "#0f291e"; stroke: "#4ade80"; stroke-width: 2; border-radius: 8 } }
  amber_box: { style: { fill: "#231e12"; stroke: "#fbbf24"; stroke-width: 2; border-radius: 8 } }
  purple_box: { style: { fill: "#1e1b2e"; stroke: "#c084fc"; stroke-width: 2; border-radius: 8 } }
  red_box: { style: { fill: "#2b1111"; stroke: "#f87171"; stroke-width: 2; border-radius: 8 } }
}

window: "1. Window Pointers" {
  class: container
  style.fill: "#111827"
  style.stroke: "#3B82F6"
  style.stroke-width: 2
  pointers: "L = 0, R = 0"
}

seen_map: "2. Map<Char, Index>" {
  class: container
  style.fill: "#111827"
  style.stroke: "#10B981"
  style.stroke-width: 2
  check: "map.containsKey(c) & lastSeen >= L"
}

dup: "Duplicate Found: Shift L to lastSeen + 1" {
  class: container
  style.fill: "#111827"
  style.stroke: "#EF4444"
  style.stroke-width: 2
}

no_dup: "No Duplicate: Expand R & Update maxLen" {
  class: container
  style.fill: "#111827"
  style.stroke: "#10B981"
  style.stroke-width: 2
}

max_len: "3. Max Length" {
  class: container
  style.fill: "#111827"
  style.stroke: "#8B5CF6"
  style.stroke-width: 2
  result: "O(N) Time, O(min(N,M)) Space"
}

window -> seen_map: "Scan Character at R" {
  style.stroke: "#10B981"
  style.stroke-width: 2
}
seen_map -> dup: "lastSeen >= L" {
  style.stroke: "#EF4444"
  style.stroke-width: 2
}
seen_map -> no_dup: "no collision" {
  style.stroke: "#10B981"
  style.stroke-width: 2
}
dup -> max_len: "Recalculate Window" {
  style.stroke: "#8B5CF6"
  style.stroke-width: 2
}
no_dup -> max_len: "Update Global Max" {
  style.stroke: "#8B5CF6"
  style.stroke-width: 2
}