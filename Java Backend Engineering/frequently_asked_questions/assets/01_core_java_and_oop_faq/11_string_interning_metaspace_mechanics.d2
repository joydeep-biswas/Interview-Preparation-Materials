direction: right
classes: {
  container: { style: { fill: "#111827"; stroke-width: 2; border-radius: 10 } }
  box: { style: { fill: "#1E293B"; stroke-width: 2; border-radius: 8 } }
  table_box: { style: { fill: "#1E293B"; stroke: "#38bdf8"; stroke-width: 2 } }
  blue_box: { style: { fill: "#1e293b"; stroke: "#38bdf8"; stroke-width: 2; border-radius: 8 } }
  green_box: { style: { fill: "#0f291e"; stroke: "#4ade80"; stroke-width: 2; border-radius: 8 } }
  amber_box: { style: { fill: "#231e12"; stroke: "#fbbf24"; stroke-width: 2; border-radius: 8 } }
  purple_box: { style: { fill: "#1e1b2e"; stroke: "#c084fc"; stroke-width: 2; border-radius: 8 } }
  red_box: { style: { fill: "#2b1111"; stroke: "#f87171"; stroke-width: 2; border-radius: 8 } }
}

cp: "1. Class Constant Pool" {
  class: container
  style.fill: "#111827"
  style.stroke: "#3B82F6"
  style.stroke-width: 2
  ldc: "ldc #7 (Symbolic 'hello' String)"
}

table: "2. StringTable (Native Hash)" {
  class: container
  style.fill: "#111827"
  style.stroke: "#10B981"
  style.stroke-width: 2
  hashtable: "Native C++ StringTable in Heap"
  intern: "intern() returns pooled canonical ref"
}

equality: "3. Runtime Equality" {
  class: container
  style.fill: "#111827"
  style.stroke: "#8B5CF6"
  style.stroke-width: 2
  identity: "str.intern() == 'hello' is TRUE"
  caution: "Avoid interning dynamic high-cardinality keys"
}

cp -> table: "JVM StringTable Lookup" {
  style.stroke: "#10B981"
  style.stroke-width: 2
}
table -> equality: "Canonical Pointer Return" {
  style.stroke: "#8B5CF6"
  style.stroke-width: 2
}