direction: down
classes: {
  container: { style: { fill: "#111827"; stroke-width: 2; border-radius: 10 } }
  box: { style: { fill: "#1E293B"; stroke-width: 2; border-radius: 8 } }
  table_box: { style: { fill: "#1E293B"; stroke: "#38bdf8"; stroke-width: 2 } }
  blue_box: { style: { fill: "#1e293b"; stroke: "#38bdf8"; stroke-width: 2; border-radius: 8 } }
  green_box: { style: { fill: "#0f291e"; stroke: "#4ade80"; stroke-width: 2; border-radius: 8 } }
  amber_box: { style: { fill: "#231e12"; stroke: "#fbbf24"; stroke-width: 2; border-radius: 8 } }
  purple_box: { style: { fill: "#1e1b2e"; stroke: "#c084fc"; stroke-width: 2; border-radius: 8 } }
  red_box: { style: { fill: "#2b1111"; stroke: "#f87171"; stroke-width: 2; border-radius: 8 } }
}

ref: "Parent p = new Child();" {
  class: container
  style.fill: "#111827"
  style.stroke: "#3B82F6"
  style.stroke-width: 2
  desc: "Reference: Parent | Heap Object: Child"
}

static_call: "Static Binding: p.staticPrint()" {
  class: container
  style.fill: "#111827"
  style.stroke: "#F59E0B"
  style.stroke-width: 2
  bytecode: "invokestatic Parent.staticPrint()"
  result: "Prints Parent staticPrint (Method Hiding)"
}

virtual_call: "Dynamic Dispatch: p.instancePrint()" {
  class: container
  style.fill: "#111827"
  style.stroke: "#10B981"
  style.stroke-width: 2
  bytecode: "invokevirtual Parent.instancePrint()"
  result: "Prints Child instancePrint (vtable Polymorphism)"
}

ref -> static_call: "Compile-Time Type Bound" {
  style.stroke: "#F59E0B"
  style.stroke-width: 2
}
ref -> virtual_call: "Runtime Instance Bound" {
  style.stroke: "#10B981"
  style.stroke-width: 2
}