direction: right
classes: {
  container: { style: { fill: "#111827"; stroke-width: 2; border-radius: 10 } }
  box: { style: { fill: "#1E293B"; stroke-width: 2; border-radius: 8 } }
  table_box: { style: { fill: "#1E293B"; stroke: "#38bdf8"; stroke-width: 2 } }
  blue_box: { style: { fill: "#1e293b"; stroke: "#38bdf8"; stroke-width: 2; border-radius: 8 } }
  green_box: { style: { fill: "#0f291e"; stroke: "#4ade80"; stroke-width: 2; border-radius: 8 } }
  amber_box: { style: { fill: "#231e12"; stroke: "#fbbf24"; stroke-width: 2; border-radius: 8 } }
  purple_box: { style: { fill: "#1e1b2e"; stroke: "#c084fc"; stroke-width: 2; border-radius: 8 } }
  red_box: { style: { fill: "#2b1111"; stroke: "#f87171"; stroke-width: 2; border-radius: 8 } }
}

stack: "Thread Stack Frame" {
  class: container
  style.fill: "#111827"
  style.stroke: "#3B82F6"
  style.stroke-width: 2
  ref: "Parent p (Compressed OOP 4 bytes)"
  invoke: "invokevirtual #4"
}

heap: "Heap Object: Child Instance" {
  class: container
  style.fill: "#111827"
  style.stroke: "#10B981"
  style.stroke-width: 2
  mark_word: "Mark Word (8 bytes): Hash/GC/Locks"
  klass_word: "Klass Word (4 bytes): Pointer to Klass"
  fields: "Instance Fields"
}

metaspace: "Metaspace: InstanceKlass" {
  class: container
  style.fill: "#111827"
  style.stroke: "#8B5CF6"
  style.stroke-width: 2
  vtable: "vtable: Index 2 -> Child.print()"
  jit: "JIT Monomorphic Call Inlining"
}

stack -> heap: "Reference Pointer" {
  style.stroke: "#10B981"
  style.stroke-width: 2
}
heap -> metaspace: "Klass Pointer" {
  style.stroke: "#8B5CF6"
  style.stroke-width: 2
}