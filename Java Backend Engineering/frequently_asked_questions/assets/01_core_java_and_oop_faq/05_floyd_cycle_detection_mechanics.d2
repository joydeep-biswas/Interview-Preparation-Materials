direction: right

phase1: "Phase 1: Detecting Cycle Presence" {
  style.fill: "#111827"
  style.stroke: "#3B82F6"
  style.stroke-width: 2
  slow: "slow = slow.next (1 step)"
  fast: "fast = fast.next.next (2 steps)"
  meet: "slow == fast at meeting point M"
}

phase2: "Phase 2: Locating Cycle Entrance Node" {
  style.fill: "#111827"
  style.stroke: "#10B981"
  style.stroke-width: 2
  math: "Proof: Distance to entrance F = nC - a"
  reset: "Reset slow to head; keep fast at M"
  converge: "Both step by 1 -> Meet at Cycle Start"
}

phase1 -> phase2: "Cycle Confirmed" {
  style.stroke: "#10B981"
  style.stroke-width: 2
}