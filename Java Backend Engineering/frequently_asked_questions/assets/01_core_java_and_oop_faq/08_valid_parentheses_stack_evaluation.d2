direction: right

input: "Input Stream: '{ [ ] ( ) }'" {
  style.fill: "#111827"
  style.stroke: "#3B82F6"
  style.stroke-width: 2
  scan: "Character-by-character scan O(N)"
}

stack: "Deque Stack Invariants (ArrayDeque)" {
  style.fill: "#111827"
  style.stroke: "#10B981"
  style.stroke-width: 2
  push: "Open Bracket -> Push to Stack"
  pop: "Close Bracket -> Pop & Verify Match"
  empty: "Return stack.isEmpty() at EOF"
}

verdict: "Validation Verdict" {
  style.fill: "#111827"
  style.stroke: "#8B5CF6"
  style.stroke-width: 2
  valid: "Match Confirmed: TRUE"
  edge: "Detects mismatched or unclosed brackets"
}

input -> stack: "Feed Stream" {
  style.stroke: "#10B981"
  style.stroke-width: 2
}
stack -> verdict: "Evaluate Completion" {
  style.stroke: "#8B5CF6"
  style.stroke-width: 2
}