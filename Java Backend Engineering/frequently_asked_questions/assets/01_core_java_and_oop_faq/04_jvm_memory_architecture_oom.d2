direction: right
classes: {
  container: { style: { fill: "#111827"; stroke-width: 2; border-radius: 10 } }
  box: { style: { fill: "#1E293B"; stroke-width: 2; border-radius: 8 } }
  table_box: { style: { fill: "#1E293B"; stroke: "#38bdf8"; stroke-width: 2 } }
  blue_box: { style: { fill: "#1e293b"; stroke: "#38bdf8"; stroke-width: 2; border-radius: 8 } }
  green_box: { style: { fill: "#0f291e"; stroke: "#4ade80"; stroke-width: 2; border-radius: 8 } }
  amber_box: { style: { fill: "#231e12"; stroke: "#fbbf24"; stroke-width: 2; border-radius: 8 } }
  purple_box: { style: { fill: "#1e1b2e"; stroke: "#c084fc"; stroke-width: 2; border-radius: 8 } }
  red_box: { style: { fill: "#2b1111"; stroke: "#f87171"; stroke-width: 2; border-radius: 8 } }
}

young: "Young Gen (-Xmn)" {
  class: container
  style.fill: "#111827"
  style.stroke: "#3B82F6"
  style.stroke-width: 2
  eden: "Eden Space (Bump Pointer)"
  survivor: "Survivor Spaces (S0/S1)"
}

old: "Old Gen (Tenured)" {
  class: container
  style.fill: "#111827"
  style.stroke: "#EF4444"
  style.stroke-width: 2
  oom_heap: "OOM: Java heap space"
  leaks: "Static Caches & ThreadLocals"
}

meta: "Metaspace & Stacks" {
  class: container
  style.fill: "#111827"
  style.stroke: "#F59E0B"
  style.stroke-width: 2
  oom_meta: "OOM: Metaspace"
  so_err: "StackOverflowError (Recursion)"
}

direct: "Direct Memory (Off-Heap)" {
  class: container
  style.fill: "#111827"
  style.stroke: "#8B5CF6"
  style.stroke-width: 2
  oom_direct: "OOM: Direct buffer memory"
  netty: "Netty Zero-Copy NIO Buffers"
}

young -> old: "Promote Survivors" {
  style.stroke: "#EF4444"
  style.stroke-width: 2
}
old -> meta: "Non-Heap Allocation" {
  style.stroke: "#F59E0B"
  style.stroke-width: 2
}
meta -> direct: "Native Buffer Allocation" {
  style.stroke: "#8B5CF6"
  style.stroke-width: 2
}