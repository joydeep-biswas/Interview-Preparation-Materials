direction: right
classes: {
  pillar: { style: { fill: "#111827"; stroke-width: 2; rx: 10 } }
  stage: { style: { fill: "#1E293B"; stroke-width: 1.5; rx: 8 } }
}

kernel: "1. Linux OS & Socket Subsystem" {
  class: pillar
  style.stroke: "#3B82F6"
  nic: "Physical NIC\nRing buffer DMA transfers" { class: stage; style.stroke: "#3B82F6" }
  syn_q: "SYN Backlog Queue\ntcp_max_syn_backlog" { class: stage; style.stroke: "#3B82F6" }
  accept_q: "Accept Listen Queue\nsomaxconn (socket backlog)" { class: stage; style.stroke: "#3B82F6" }
  epoll: "Epoll Wait System Call\nNetty non-blocking event loop" { class: stage; style.stroke: "#3B82F6" }

  nic -> syn_q -> accept_q -> epoll
}

runtime: "2. Enterprise Service Runtime" {
  class: pillar
  style.stroke: "#10B981"
  workers: "Worker Threads / Virtual Threads\nExecutes business logic" { class: stage; style.stroke: "#10B981" }
  mdc: "Logback MDC Context\nTraceId, SpanId & TenantId" { class: stage; style.stroke: "#10B981" }
  metrics: "Micrometer Metrics\nPrometheus MeterRegistry counters" { class: stage; style.stroke: "#10B981" }

  workers -> mdc
  workers -> metrics
}

telemetry: "3. Telemetry & Alerting Plane" {
  class: pillar
  style.stroke: "#8B5CF6"
  fluent: "FluentBit DaemonSet\nJSON log shipping to OpenSearch" { class: stage; style.stroke: "#8B5CF6" }
  prom: "Prometheus Server\nTSDB alerts & Grafana dashboards" { class: stage; style.stroke: "#8B5CF6" }
  flame: "Async Profiler Flamegraphs\nNon-safepoint CPU & alloc profiling" { class: stage; style.stroke: "#8B5CF6" }
}

kernel.epoll -> runtime.workers: "Dispatch Socket"
runtime.mdc -> telemetry.fluent
runtime.metrics -> telemetry.prom
runtime.workers -> telemetry.flame: "Async Profiler"
