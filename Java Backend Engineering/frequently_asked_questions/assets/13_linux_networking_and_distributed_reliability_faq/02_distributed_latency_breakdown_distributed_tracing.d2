direction: right
classes: {
  box: { style: { fill: "#111827"; stroke-width: 2; border-radius: 10 } }
}

client: "Mobile / Web Client\n(Total Roundtrip: 5,439ms)" {
  class: box
  style.stroke: "#3B82F6"
}

gateway: "API Gateway (Envoy)\nIngress network hop: 12ms" {
  class: box
  style.stroke: "#8B5CF6"
}

tomcat: "Tomcat Queue Starvation\nRequest stalled in Accept Queue: 2,100ms" {
  class: box
  style.stroke: "#EF4444"
}

service: "OrderService Business Logic\nPure Java CPU execution: 4ms" {
  class: box
  style.stroke: "#10B981"
}

hikari: "HikariCP Pool Starvation\nBlocked waiting for JDBC handle: 1,800ms" {
  class: box
  style.stroke: "#EF4444"
}

db: "PostgreSQL Database\nRow read + insert + commit: 23ms" {
  class: box
  style.stroke: "#10B981"
}

ext: "Downstream Payment API\nUnbounded HTTP call: 1,500ms" {
  class: box
  style.stroke: "#EF4444"
}

client -> gateway: "1. POST /orders (12ms)"
gateway -> tomcat: "2. Proxy Port 8080"
tomcat -> service: "3. Delayed Dispatch (2,100ms wait)"
service -> hikari: "4. getConnection() (1,800ms block)"
hikari -> db: "5. Query Inventory (15ms)"
service -> ext: "6. External Charge (1,500ms)"
service -> db: "7. Insert Order (8ms)"
service -> client: "8. 201 Created (5,439ms Total)"