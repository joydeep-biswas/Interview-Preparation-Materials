direction: right
classes: {
  container: { style: { fill: "#111827"; stroke-width: 2; border-radius: 10 } }
  box: { style: { fill: "#1E293B"; stroke-width: 2; border-radius: 8 } }
  table_box: { style: { fill: "#1E293B"; stroke: "#38bdf8"; stroke-width: 2 } }
  blue_box: { style: { fill: "#1e293b"; stroke: "#38bdf8"; stroke-width: 2; border-radius: 8 } }
  green_box: { style: { fill: "#0f291e"; stroke: "#4ade80"; stroke-width: 2; border-radius: 8 } }
  amber_box: { style: { fill: "#231e12"; stroke: "#fbbf24"; stroke-width: 2; border-radius: 8 } }
  purple_box: { style: { fill: "#1e1b2e"; stroke: "#c084fc"; stroke-width: 2; border-radius: 8 } }
  red_box: { style: { fill: "#2b1111"; stroke: "#f87171"; stroke-width: 2; border-radius: 8 } }
}

closed: "CLOSED (Normal Traffic)" {
  class: container
  style.fill: "#111827"
  style.stroke: "#10B981"
  requests: "100% permitted"
  window: "Evaluates sliding window failure rate"
}

open: "OPEN (Tripped)" {
  class: container
  style.fill: "#111827"
  style.stroke: "#EF4444"
  fail_fast: "Throws CallNotPermittedException"
  timer: "Waits e.g. 60s in open state"
}

half_open: "HALF_OPEN (Probing)" {
  class: container
  style.fill: "#111827"
  style.stroke: "#F59E0B"
  probes: "Permits 10 trial requests"
}

closed -> open: "Failure rate > threshold"
open -> half_open: "Wait timer expires"
half_open -> closed: "Trial probes succeed"
half_open -> open: "Trial probes fail"