direction: right
classes: {
  container: { style: { fill: "#111827"; stroke-width: 2; border-radius: 10 } }
  box: { style: { fill: "#1E293B"; stroke-width: 2; border-radius: 8 } }
  table_box: { style: { fill: "#1E293B"; stroke: "#38bdf8"; stroke-width: 2 } }
  blue_box: { style: { fill: "#1e293b"; stroke: "#38bdf8"; stroke-width: 2; border-radius: 8 } }
  green_box: { style: { fill: "#0f291e"; stroke: "#4ade80"; stroke-width: 2; border-radius: 8 } }
  amber_box: { style: { fill: "#231e12"; stroke: "#fbbf24"; stroke-width: 2; border-radius: 8 } }
  purple_box: { style: { fill: "#1e1b2e"; stroke: "#c084fc"; stroke-width: 2; border-radius: 8 } }
  red_box: { style: { fill: "#2b1111"; stroke: "#f87171"; stroke-width: 2; border-radius: 8 } }
}

env: "1. Environment Prep" {
  class: container
  style.fill: "#111827"
  style.stroke: "#3B82F6"
  run: "SpringApplication.run()"
  props: "Load application.yml & profiles"
}

context: "2. Context Creation" {
  class: container
  style.fill: "#111827"
  style.stroke: "#F59E0B"
  instantiate: "AnnotationConfigServletWebServerContext"
  post_processor: "ConfigurationClassPostProcessor scans beans"
}

refresh: "3. refresh() & Beans" {
  class: container
  style.fill: "#111827"
  style.stroke: "#10B981"
  tomcat: "onRefresh() starts Tomcat / Web Server"
  singletons: "Instantiate & proxy all singleton beans"
}

ready: "4. Application Ready" {
  class: container
  style.fill: "#111827"
  style.stroke: "#8B5CF6"
  runners: "Execute ApplicationRunner / CommandLineRunner"
  event: "ApplicationReadyEvent -> Readiness UP"
}

env -> context: "Environment ready"
context -> refresh: "Bean definitions registered"
refresh -> ready: "Context active"