direction: right
classes: {
  container: { style: { fill: "#111827"; stroke-width: 2; border-radius: 10 } }
  box: { style: { fill: "#1E293B"; stroke-width: 2; border-radius: 8 } }
  table_box: { style: { fill: "#1E293B"; stroke: "#38bdf8"; stroke-width: 2 } }
  blue_box: { style: { fill: "#1e293b"; stroke: "#38bdf8"; stroke-width: 2; border-radius: 8 } }
  green_box: { style: { fill: "#0f291e"; stroke: "#4ade80"; stroke-width: 2; border-radius: 8 } }
  amber_box: { style: { fill: "#231e12"; stroke: "#fbbf24"; stroke-width: 2; border-radius: 8 } }
  purple_box: { style: { fill: "#1e1b2e"; stroke: "#c084fc"; stroke-width: 2; border-radius: 8 } }
  red_box: { style: { fill: "#2b1111"; stroke: "#f87171"; stroke-width: 2; border-radius: 8 } }
}

request: "1. Client Request" {
  class: container
  style.fill: "#111827"
  style.stroke: "#3B82F6"
  post: "POST /v1/payments"
  header: "Idempotency-Key: uuid-123"
}

redis: "2. Redis SETNX Lock" {
  class: container
  style.fill: "#111827"
  style.stroke: "#F59E0B"
  cache_check: "GET idempotency:key -> return if cached"
  setnx: "SET lock:key NX PX 10000"
}

execution: "3. Payment & DB" {
  class: container
  style.fill: "#111827"
  style.stroke: "#10B981"
  stripe: "Call Payment Gateway"
  db_unique: "INSERT with UNIQUE(idempotency_key)"
}

response: "4. Cache & Return" {
  class: container
  style.fill: "#111827"
  style.stroke: "#8B5CF6"
  cache_save: "SETEX idempotency:key 86400 json"
  del_lock: "DEL lock:key"
  receipt: "HTTP 201 Payment Confirmed"
}

request -> redis: "Validate & acquire lock"
redis -> execution: "Execute payment"
execution -> response: "Save & reply"