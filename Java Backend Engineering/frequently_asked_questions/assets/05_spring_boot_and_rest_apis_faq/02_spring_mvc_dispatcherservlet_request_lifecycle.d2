direction: right
classes: {
  container: { style: { fill: "#111827"; stroke-width: 2; border-radius: 10 } }
  box: { style: { fill: "#1E293B"; stroke-width: 2; border-radius: 8 } }
  table_box: { style: { fill: "#1E293B"; stroke: "#38bdf8"; stroke-width: 2 } }
  blue_box: { style: { fill: "#1e293b"; stroke: "#38bdf8"; stroke-width: 2; border-radius: 8 } }
  green_box: { style: { fill: "#0f291e"; stroke: "#4ade80"; stroke-width: 2; border-radius: 8 } }
  amber_box: { style: { fill: "#231e12"; stroke: "#fbbf24"; stroke-width: 2; border-radius: 8 } }
  purple_box: { style: { fill: "#1e1b2e"; stroke: "#c084fc"; stroke-width: 2; border-radius: 8 } }
  red_box: { style: { fill: "#2b1111"; stroke: "#f87171"; stroke-width: 2; border-radius: 8 } }
}

front_ctrl: "1. DispatcherServlet" {
  class: container
  style.fill: "#111827"
  style.stroke: "#3B82F6"
  req: "Incoming HTTP Request"
  dispatch: "doDispatch() coordinates workflow"
}

mapping: "2. HandlerMapping" {
  class: container
  style.fill: "#111827"
  style.stroke: "#F59E0B"
  route: "Locates target Controller method"
  interceptor: "HandlerInterceptor.preHandle() executes"
}

controller: "3. Controller Execution" {
  class: container
  style.fill: "#111827"
  style.stroke: "#10B981"
  adapter: "HandlerAdapter binds parameters"
  service: "Business logic and database queries"
}

response: "4. Serialization" {
  class: container
  style.fill: "#111827"
  style.stroke: "#8B5CF6"
  jackson: "HttpMessageConverter serializes to JSON"
  cleanup: "afterCompletion() flushes MDC and ThreadLocals"
}

front_ctrl -> mapping: "Find handler"
mapping -> controller: "Invoke method"
controller -> response: "Return DTO"