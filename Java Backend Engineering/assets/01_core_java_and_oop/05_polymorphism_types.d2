direction: down
title: Java Polymorphism: Compile-Time vs Runtime Dynamic Binding

Root: Polymorphism in Java {
  style.fill: "#1E293B"
  style.stroke: "#3B82F6"
  desc: "Uniform call abstraction masking distinct implementations"
}

StaticP: Compile-Time / Static Polymorphism (Overloading) {
  style.fill: "#0B132B"
  style.stroke: "#0284C7"
  resolution: "Evaluated at compile-time by javac"
  bytecode: "invokestatic / invokevirtual (early binding)"
  example: "calc.add(int, int) vs calc.add(double, double)"
}

DynamicP: Runtime / Dynamic Polymorphism (Overriding) {
  style.fill: "#06201B"
  style.stroke: "#047857"
  resolution: "Evaluated at runtime by JVM via vtable"
  bytecode: "invokevirtual / invokeinterface (late binding)"
  example: "Payment p = new CryptoPayment(); p.process()"
}

Root -> StaticP: Compiler Static Resolution {
  style.stroke: "#0284C7"
}

Root -> DynamicP: JVM Dynamic Dispatch {
  style.stroke: "#10B981"
}
