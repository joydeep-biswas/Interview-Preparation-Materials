direction: down
title: "Constructor Overloading & Delegation Chaining (this())"
classes: {
  container: { style: { fill: "#111827"; stroke-width: 2; border-radius: 10 } }
  box: { style: { fill: "#1E293B"; stroke-width: 2; border-radius: 8 } }
  table_box: { style: { fill: "#1E293B"; stroke: "#38bdf8"; stroke-width: 2 } }
  blue_box: { style: { fill: "#1e293b"; stroke: "#38bdf8"; stroke-width: 2; border-radius: 8 } }
  green_box: { style: { fill: "#0f291e"; stroke: "#4ade80"; stroke-width: 2; border-radius: 8 } }
  amber_box: { style: { fill: "#231e12"; stroke: "#fbbf24"; stroke-width: 2; border-radius: 8 } }
  purple_box: { style: { fill: "#1e1b2e"; stroke: "#c084fc"; stroke-width: 2; border-radius: 8 } }
  red_box: { style: { fill: "#2b1111"; stroke: "#f87171"; stroke-width: 2; border-radius: 8 } }
}

C1: "UserProfile(username)" {
  class: container
  style.fill: "#1E293B"
  style.stroke: "#3B82F6"
  desc: "1-Arg constructor; defaults tier='STANDARD', zone=UTC"
  code: "this(username, 'STANDARD', ZoneOffset.UTC)"
}

C2: "UserProfile(username, tier)" {
  class: container
  style.fill: "#1E293B"
  style.stroke: "#3B82F6"
  desc: "2-Arg constructor; defaults zone=UTC"
  code: "this(username, tier, ZoneOffset.UTC)"
}

Master: "Master Canonical Constructor UserProfile(u, t, z)" {
  class: container
  style.fill: "#0B132B"
  style.stroke: "#10B981"
  step1: "1. Fail-fast validation (Objects.requireNonNull)"
  step2: "2. Final field assignment (this.username = ...)"
}

HeapObj: "Guaranteed Consistent Immutable Object in Heap" {
  class: container
  style.fill: "#0F172A"
  style.stroke: "#06B6D4"
}

C1 -> Master: "this(...) delegation" {
  style.stroke: "#06B6D4"
}

C2 -> Master: "this(...) delegation" {
  style.stroke: "#06B6D4"
}

Master -> HeapObj: "Completes <init>" {
  style.stroke: "#10B981"
}