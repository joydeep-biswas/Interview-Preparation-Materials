direction: right
title: "Floyd's Cycle-Finding Algorithm (Tortoise and Hare)"
classes: {
  container: { style: { fill: "#111827"; stroke-width: 2; border-radius: 10 } }
  box: { style: { fill: "#1E293B"; stroke-width: 2; border-radius: 8 } }
  table_box: { style: { fill: "#1E293B"; stroke: "#38bdf8"; stroke-width: 2 } }
  blue_box: { style: { fill: "#1e293b"; stroke: "#38bdf8"; stroke-width: 2; border-radius: 8 } }
  green_box: { style: { fill: "#0f291e"; stroke: "#4ade80"; stroke-width: 2; border-radius: 8 } }
  amber_box: { style: { fill: "#231e12"; stroke: "#fbbf24"; stroke-width: 2; border-radius: 8 } }
  purple_box: { style: { fill: "#1e1b2e"; stroke: "#c084fc"; stroke-width: 2; border-radius: 8 } }
  red_box: { style: { fill: "#2b1111"; stroke: "#f87171"; stroke-width: 2; border-radius: 8 } }
}

Nodes: "Linked List Topology" {
  class: container
  style.fill: "#0B132B"
  style.stroke: "#1D4ED8"
  
  N1: "Node 1 (Head)"
  N2: "Node 2"
  N3: "Node 3 (Cycle Origin)" {
    class: box
    style.stroke: "#10B981"
  }
  N4: "Node 4"
  N5: "Node 5 (Collision Point)" {
    class: box
    style.stroke: "#F59E0B"
  }
  N6: "Node 6"
  
  N1 -> N2 -> N3 -> N4 -> N5 -> N6 -> N3
}

Pointers: "Velocities" {
  class: container
  slow: "Tortoise (Slow): 1 step / tick (v = 1)"
  fast: "Hare (Fast): 2 steps / tick (v = 2)"
}

Proof: "Phase 1 & 2 Math" {
  class: container
  formula: "2 * dist(Slow) = dist(Hare) => 2(F + a) = F + nC + a => F = nC - a"
  phase2: "Reset Slow to Head; advance Slow & Fast at v=1; collide at Cycle Origin"
  complexity: "Time: O(n) | Auxiliary Space: O(1)"
}