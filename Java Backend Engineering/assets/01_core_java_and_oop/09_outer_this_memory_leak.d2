direction: right
title: "Non-Static Inner Class Memory Leak: Hidden Outer.this Reference"
classes: {
  container: { style: { fill: "#111827"; stroke-width: 2; border-radius: 10 } }
  box: { style: { fill: "#1E293B"; stroke-width: 2; border-radius: 8 } }
  table_box: { style: { fill: "#1E293B"; stroke: "#38bdf8"; stroke-width: 2 } }
  blue_box: { style: { fill: "#1e293b"; stroke: "#38bdf8"; stroke-width: 2; border-radius: 8 } }
  green_box: { style: { fill: "#0f291e"; stroke: "#4ade80"; stroke-width: 2; border-radius: 8 } }
  amber_box: { style: { fill: "#231e12"; stroke: "#fbbf24"; stroke-width: 2; border-radius: 8 } }
  purple_box: { style: { fill: "#1e1b2e"; stroke: "#c084fc"; stroke-width: 2; border-radius: 8 } }
  red_box: { style: { fill: "#2b1111"; stroke: "#f87171"; stroke-width: 2; border-radius: 8 } }
}

ThreadPool: "Long-Lived ThreadPool Queue (GC Root)" {
  class: container
  style.fill: "#1C1917"
  style.stroke: "#EF4444"
  status: "Active GC Root (Never collected)"
  holds: "Queue retains submitted Runnable task references"
}

InnerTask: "Anonymous Runnable Instance" {
  class: container
  style.fill: "#1E1B4B"
  style.stroke: "#8B5CF6"
  task: "executor.submit(new Runnable() { ... })" { class: box }
  syntheticField: "final HeavyProcessingService this\$0 (Compiler injected)"
}

HeavyService: "HeavyProcessingService (100MB Retained)" {
  class: container
  style.fill: "#1C1917"
  style.stroke: "#EF4444"
  cache: "byte[] cache = 100MB"
  gc: "Uncollectible due to unbroken GC Root chain"
  error: "Triggers java.lang.OutOfMemoryError"
}

Solution: "Architectural Fix" {
  class: container
  style.fill: "#06201B"
  style.stroke: "#10B981"
  fix1: "Use static nested class: static classes do NOT capture this\$0"
  fix2: "Use standalone lambdas that capture only explicit parameters"
}

ThreadPool -> InnerTask: "Holds task reference" {
  style.stroke: "#EF4444"
}

InnerTask -> HeavyService: "Implicit Outer.this pointer (this\$0)" {
  style.stroke: "#EF4444"
}