direction: right
title: "Java Access Modifier Visibility & Encapsulation Boundaries"
classes: {
  container: { style: { fill: "#111827"; stroke-width: 2; border-radius: 10 } }
  box: { style: { fill: "#1E293B"; stroke-width: 2; border-radius: 8 } }
  table_box: { style: { fill: "#1E293B"; stroke: "#38bdf8"; stroke-width: 2 } }
  blue_box: { style: { fill: "#1e293b"; stroke: "#38bdf8"; stroke-width: 2; border-radius: 8 } }
  green_box: { style: { fill: "#0f291e"; stroke: "#4ade80"; stroke-width: 2; border-radius: 8 } }
  amber_box: { style: { fill: "#231e12"; stroke: "#fbbf24"; stroke-width: 2; border-radius: 8 } }
  purple_box: { style: { fill: "#1e1b2e"; stroke: "#c084fc"; stroke-width: 2; border-radius: 8 } }
  red_box: { style: { fill: "#2b1111"; stroke: "#f87171"; stroke-width: 2; border-radius: 8 } }
}

PackageA: "Package com.enterprise.order" {
  class: container
  style.fill: "#0B132B"
  style.stroke: "#1D4ED8"
  
  OrderClass: "public class Order" {
    class: box
    m1: "+ public checkout() [Everywhere]"
    m2: "# protected audit() [Package + Subclasses]"
    m3: "~ default calculateTax() [Package only]"
    m4: "- private orderId [Class body only]"
  }
  
  OrderService: "class OrderService" {
    class: box
    desc: "Same package peer; can access default, protected, public"
  }
}

PackageB: "Package com.enterprise.billing" {
  class: container
  style.fill: "#06201B"
  style.stroke: "#047857"
  
  BillingAudit: "public class BillingAudit extends Order" {
    class: box
    desc: "Subclass in external package; can access protected & public"
  }
  
  ExternalClient: "public class ExternalClient" {
    class: box
    desc: "Unrelated external class; can access ONLY public"
  }
}

PackageA.OrderService -> PackageA.OrderClass: "Same package access"
PackageB.BillingAudit -> PackageA.OrderClass: "extends Order (Protected + Public)" {
  style.stroke: "#10B981"
}
PackageB.ExternalClient -> PackageA.OrderClass: "Public API only" {
  style.stroke: "#EF4444"
}