  style.fill: "#0B132B"
  style.stroke: "#3B82F6"
}
Term2: "Invoke Widened: process(long)" {
  style.fill: "#0F172A"
  style.stroke: "#10B981"
}

Step3: "3. Autoboxing possible?" {
  style.fill: "#0B132B"
  style.stroke: "#3B82F6"
}
Term3: "Invoke Boxed: process(Integer)" {
  style.fill: "#0F172A"
  style.stroke: "#06B6D4"
}

Step4: "4. Varargs Fallback available?" {
  style.fill: "#0B132B"
  style.stroke: "#3B82F6"
}
Term4: "Invoke Varargs: process(int...)" {
  style.fill: "#0F172A"
  style.stroke: "#8B5CF6"
}

Term5: "COMPILER ERROR: No matching method" {
  style.fill: "#1C1917"
  style.stroke: "#EF4444"
}

