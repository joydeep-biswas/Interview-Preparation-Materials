direction: right
title: JVM Thread Lifecycle State Machine (java.lang.Thread.State)

NEW: NEW (Created) {
  style.fill: "#1E293B"
  style.stroke: "#3B82F6"
}

RUNNABLE: RUNNABLE (Ready & Running) {
  style.fill: "#06201B"
  style.stroke: "#10B981"
}

BLOCKED: BLOCKED (Monitor Lock Contention) {
  style.fill: "#1C1917"
  style.stroke: "#EF4444"
}

WAITING: WAITING (Indefinite Wait) {
  style.fill: "#1C1917"
  style.stroke: "#F59E0B"
}

TIMED_WAITING: TIMED_WAITING (Timeout Wait) {
  style.fill: "#1C1917"
  style.stroke: "#F59E0B"
}

TERMINATED: TERMINATED (Dead) {
  style.fill: "#1E1B4B"
  style.stroke: "#8B5CF6"
}

NEW -> RUNNABLE: thread.start()
RUNNABLE -> BLOCKED: synchronized lock contention
BLOCKED -> RUNNABLE: lock acquired
RUNNABLE -> WAITING: wait(), join(), park()
WAITING -> RUNNABLE: notify(), unpark()
RUNNABLE -> TIMED_WAITING: sleep(ms), wait(timeout)
TIMED_WAITING -> RUNNABLE: timeout expires
RUNNABLE -> TERMINATED: run() completes
