direction: right
title: "Atomic CAS (Compare-And-Swap) Optimistic Retry Loop"
classes: {
  container: { style: { fill: "#111827"; stroke-width: 2; border-radius: 10 } }
  box: { style: { fill: "#1E293B"; stroke-width: 2; border-radius: 8 } }
  table_box: { style: { fill: "#1E293B"; stroke: "#38bdf8"; stroke-width: 2 } }
  blue_box: { style: { fill: "#1e293b"; stroke: "#38bdf8"; stroke-width: 2; border-radius: 8 } }
  green_box: { style: { fill: "#0f291e"; stroke: "#4ade80"; stroke-width: 2; border-radius: 8 } }
  amber_box: { style: { fill: "#231e12"; stroke: "#fbbf24"; stroke-width: 2; border-radius: 8 } }
  purple_box: { style: { fill: "#1e1b2e"; stroke: "#c084fc"; stroke-width: 2; border-radius: 8 } }
  red_box: { style: { fill: "#2b1111"; stroke: "#f87171"; stroke-width: 2; border-radius: 8 } }
}

Step1: "1. Read Current Memory Value" {
  class: container
  style.fill: "#0B132B"
  style.stroke: "#3B82F6"
  read: "int current = get() [V = 10]"
}

Step2: "2. Compute Candidate Value" {
  class: container
  style.fill: "#06201B"
  style.stroke: "#10B981"
  calc: "int next = current + 1 [11]"
}

Step3: "3. Hardware CAS Instruction" {
  class: container
  style.fill: "#1C1917"
  style.stroke: "#F59E0B"
  opcode: "LOCK CMPXCHG(target, expected=10, new=11)"
}

Success: "CAS Success" {
  class: container
  style.fill: "#06201B"
  style.stroke: "#10B981"
  done: "Value updated to 11; returns"
}

Step1 -> Step2 -> Step3
Step3 -> Success: "Memory unchanged (== 10)" { style.stroke: "#10B981" }
Step3 -> Step1: "Memory modified by other thread (Loopback retry!)" { style.stroke: "#EF4444" }