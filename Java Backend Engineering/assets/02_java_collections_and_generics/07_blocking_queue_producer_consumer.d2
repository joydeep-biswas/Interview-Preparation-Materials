direction: right
title: "BlockingQueue Producer-Consumer Concurrency Architecture"
classes: {
  container: { style: { fill: "#111827"; stroke-width: 2; border-radius: 10 } }
  box: { style: { fill: "#1E293B"; stroke-width: 2; border-radius: 8 } }
  table_box: { style: { fill: "#1E293B"; stroke: "#38bdf8"; stroke-width: 2 } }
  blue_box: { style: { fill: "#1e293b"; stroke: "#38bdf8"; stroke-width: 2; border-radius: 8 } }
  green_box: { style: { fill: "#0f291e"; stroke: "#4ade80"; stroke-width: 2; border-radius: 8 } }
  amber_box: { style: { fill: "#231e12"; stroke: "#fbbf24"; stroke-width: 2; border-radius: 8 } }
  purple_box: { style: { fill: "#1e1b2e"; stroke: "#c084fc"; stroke-width: 2; border-radius: 8 } }
  red_box: { style: { fill: "#2b1111"; stroke: "#f87171"; stroke-width: 2; border-radius: 8 } }
}

Producers: "Producer Threads" {
  class: container
  style.fill: "#0B132B"
  style.stroke: "#0284C7"
  call: "queue.put(item)"
  flow: "while (count == items.length) notFull.await()"
  signal: "enqueue(item); notEmpty.signal()"
}

Buffer: "ArrayBlockingQueue (Capacity N)" {
  class: container
  style.fill: "#1C1917"
  style.stroke: "#F59E0B"
  lock: "ReentrantLock lock"
  cond1: "Condition notFull (Blocks producers when full)"
  cond2: "Condition notEmpty (Blocks consumers when empty)"
  backpressure: "Enforces backpressure; prevents OOM"
}

Consumers: "Consumer Threads" {
  class: container
  style.fill: "#06201B"
  style.stroke: "#047857"
  call: "queue.take()"
  flow: "while (count == 0) notEmpty.await()"
  signal: "dequeue(item); notFull.signal()"
}

Producers -> Buffer: "put() blocks if full" {
  style.stroke: "#3B82F6"
}

Buffer -> Consumers: "take() blocks if empty" {
  style.stroke: "#10B981"
}