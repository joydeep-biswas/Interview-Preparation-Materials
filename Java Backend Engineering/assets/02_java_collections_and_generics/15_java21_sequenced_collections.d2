direction: down
title: "Java 21 Sequenced Collections Architecture"
classes: {
  container: { style: { fill: "#111827"; stroke-width: 2; border-radius: 10 } }
  box: { style: { fill: "#1E293B"; stroke-width: 2; border-radius: 8 } }
  table_box: { style: { fill: "#1E293B"; stroke: "#38bdf8"; stroke-width: 2 } }
  blue_box: { style: { fill: "#1e293b"; stroke: "#38bdf8"; stroke-width: 2; border-radius: 8 } }
  green_box: { style: { fill: "#0f291e"; stroke: "#4ade80"; stroke-width: 2; border-radius: 8 } }
  amber_box: { style: { fill: "#231e12"; stroke: "#fbbf24"; stroke-width: 2; border-radius: 8 } }
  purple_box: { style: { fill: "#1e1b2e"; stroke: "#c084fc"; stroke-width: 2; border-radius: 8 } }
  red_box: { style: { fill: "#2b1111"; stroke: "#f87171"; stroke-width: 2; border-radius: 8 } }
}

SeqCol: "<<interface>> SequencedCollection<E>" {
  class: container
  style.fill: "#1E293B"
  style.stroke: "#3B82F6"
  methods: "addFirst(), addLast(), getFirst(), getLast(), removeFirst(), removeLast()"
  view: "SequencedCollection<E> reversed() [Live O(1) zero-copy view]"
}

SeqMap: "<<interface>> SequencedMap<K, V>" {
  class: container
  style.fill: "#1E293B"
  style.stroke: "#F59E0B"
  methods: "firstEntry(), lastEntry(), pollFirstEntry(), pollLastEntry(), putFirst(), putLast()"
  view: "SequencedMap<K,V> reversed()"
}

List: "List<E> (ArrayList, LinkedList)"
Deque: "Deque<E> (ArrayDeque)"
SeqSet: "SequencedSet<E> (LinkedHashSet, TreeSet)"

LinkedHashMap: "LinkedHashMap<K,V>"
TreeMap: "TreeMap<K,V>"

SeqCol -> List
SeqCol -> Deque
SeqCol -> SeqSet

SeqMap -> LinkedHashMap
SeqMap -> TreeMap