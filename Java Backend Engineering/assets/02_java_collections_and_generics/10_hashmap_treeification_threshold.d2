direction: right
title: "HashMap Bucket Collision & Treeification Threshold Mechanics"
classes: {
  container: { style: { fill: "#111827"; stroke-width: 2; border-radius: 10 } }
  box: { style: { fill: "#1E293B"; stroke-width: 2; border-radius: 8 } }
  table_box: { style: { fill: "#1E293B"; stroke: "#38bdf8"; stroke-width: 2 } }
  blue_box: { style: { fill: "#1e293b"; stroke: "#38bdf8"; stroke-width: 2; border-radius: 8 } }
  green_box: { style: { fill: "#0f291e"; stroke: "#4ade80"; stroke-width: 2; border-radius: 8 } }
  amber_box: { style: { fill: "#231e12"; stroke: "#fbbf24"; stroke-width: 2; border-radius: 8 } }
  purple_box: { style: { fill: "#1e1b2e"; stroke: "#c084fc"; stroke-width: 2; border-radius: 8 } }
  red_box: { style: { fill: "#2b1111"; stroke: "#f87171"; stroke-width: 2; border-radius: 8 } }
}

Stage1: "Stage 1 Chained Linked List (< 8 Nodes)" {
  class: container
  style.fill: "#0B132B"
  style.stroke: "#0284C7"
  chain: "table[i] -> Node 1 -> Node 2 -> ... -> Node 7"
  search: "Linear O(N) scan using equals()"
  poisson: "P(k=8 collisions) is 1 in 16 Million under random hashes"
}

Stage2: "Stage 2 Decision Rule" {
  class: container
  style.fill: "#1C1917"
  style.stroke: "#F59E0B"
  cond1: "Bin Count >= TREEIFY_THRESHOLD (8)"
  cond2: "Table Capacity >= MIN_TREEIFY_CAPACITY (64)"
  trap: "If bin >= 8 but capacity < 64, table RESIZES (2x) instead of treeifying!"
}

Stage3: "Stage 3 Red-Black Tree (TreeBin)" {
  class: container
  style.fill: "#06201B"
  style.stroke: "#047857"
  tree: "TreeNode<K,V>: O(log N) worst-case search"
  untreeify: "UNTREEIFY_THRESHOLD = 6: converts back to linked list"
  hysteresis: "Gap 8->6 prevents thrashing on rapid insert/delete"
}

Stage1 -> Stage2: "8th collision added" {
  style.stroke: "#F59E0B"
}

Stage2 -> Stage3: "cap >= 64 satisfied" {
  style.stroke: "#10B981"
}