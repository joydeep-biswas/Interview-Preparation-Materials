direction: right
title: "Enterprise Spring Core & Spring Boot Runtime Architecture"
classes: {
  container: { style: { fill: "#111827"; stroke-width: 2; border-radius: 10 } }
  box: { style: { fill: "#1E293B"; stroke-width: 2; border-radius: 8 } }
  table_box: { style: { fill: "#1E293B"; stroke: "#38bdf8"; stroke-width: 2 } }
  blue_box: { style: { fill: "#1e293b"; stroke: "#38bdf8"; stroke-width: 2; border-radius: 8 } }
  green_box: { style: { fill: "#0f291e"; stroke: "#4ade80"; stroke-width: 2; border-radius: 8 } }
  amber_box: { style: { fill: "#231e12"; stroke: "#fbbf24"; stroke-width: 2; border-radius: 8 } }
  purple_box: { style: { fill: "#1e1b2e"; stroke: "#c084fc"; stroke-width: 2; border-radius: 8 } }
  red_box: { style: { fill: "#2b1111"; stroke: "#f87171"; stroke-width: 2; border-radius: 8 } }
}

stage1: "1. Startup & Config" {
  class: container
  style.fill: "#0b1329"
  style.stroke: "#3b82f6"

  main: "SpringApplication.run()"
  env: "Environment Preparation\n(application.yml, profiles)"
  ctx: "Create ApplicationContext"
  auto: "Auto-Configuration Engine\n(@Conditional evaluations)"

  main -> env -> ctx -> auto
}

stage2: "2. Definitions & Factory" {
  class: container
  style.fill: "#1a1c12"
  style.stroke: "#f59e0b"

  defs: "Scan Bean Definitions\n(@Component, @Bean)"
  bfpp: "BeanFactoryPostProcessors\n(Modify definitions early)"
  inst: "Instantiate Raw Beans\n(Reflection constructor)"

  defs -> bfpp -> inst
}

stage3: "3. Injection & AOP" {
  class: container
  style.fill: "#16122b"
  style.stroke: "#8b5cf6"

  pop: "Populate Properties (DI)"
  init: "Bean Initialization\n(@PostConstruct, InitializingBean)"
  aop: "BeanPostProcessor (AOP)\n(Wrap in CGLIB/JDK proxy)"

  pop -> init -> aop
}

stage4: "4. Web Server & Ready" {
  class: container
  style.fill: "#062e22"
  style.stroke: "#10b981"

  tomcat: "Start Embedded Server (Tomcat :8080)"
  act: "Expose Actuator (/health, /metrics)"
  ready: "ApplicationReadyEvent\n(Live traffic serving)"

  tomcat -> act -> ready
}

stage1.auto -> stage2.defs
stage2.inst -> stage3.pop
stage3.aop -> stage4.tomcat