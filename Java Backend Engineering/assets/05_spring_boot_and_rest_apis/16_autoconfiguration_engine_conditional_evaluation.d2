direction: right
title: "The Auto-Configuration Engine: Conditional Evaluation Pipeline"
classes: {
  container: { style: { fill: "#111827"; stroke-width: 2; border-radius: 10 } }
  box: { style: { fill: "#1E293B"; stroke-width: 2; border-radius: 8 } }
  table_box: { style: { fill: "#1E293B"; stroke: "#38bdf8"; stroke-width: 2 } }
  blue_box: { style: { fill: "#1e293b"; stroke: "#38bdf8"; stroke-width: 2; border-radius: 8 } }
  green_box: { style: { fill: "#0f291e"; stroke: "#4ade80"; stroke-width: 2; border-radius: 8 } }
  amber_box: { style: { fill: "#231e12"; stroke: "#fbbf24"; stroke-width: 2; border-radius: 8 } }
  purple_box: { style: { fill: "#1e1b2e"; stroke: "#c084fc"; stroke-width: 2; border-radius: 8 } }
  red_box: { style: { fill: "#2b1111"; stroke: "#f87171"; stroke-width: 2; border-radius: 8 } }
}

discovery: "1. Discovery & Import" {
  class: container
  style.fill: "#0b1329"
  style.stroke: "#3b82f6"

  run: "SpringApplication.run()"
  imports: "Read AutoConfiguration.imports\n(META-INF/spring/)"
  sort: "Topological Sort (@AutoConfigureAfter)"

  run -> imports -> sort
}

eval: "2. Conditional Filter Evaluation" {
  class: container
  style.fill: "#1a1c12"
  style.stroke: "#f59e0b"

  c_class: "@ConditionalOnClass(DataSource)"
  c_missing: "@ConditionalOnMissingBean(DataSource)"
  c_prop: "@ConditionalOnProperty(spring.datasource)"

  c_class -> c_missing -> c_prop
}

outcomes: "3. Configuration Outcomes" {
  class: container
  style.fill: "#0f172a"
  style.stroke: "#334155"

  load: "All Match: Register in BeanFactory\n(HikariDataSource Bean Loaded!)" {
    class: box
    style.stroke: "#10b981"
  }
  skip: "Any Fail: Pruned from Context Graph\n(Zero memory overhead)" {
    class: box
    style.stroke: "#ef4444"
  }
}

discovery.sort -> eval.c_class
eval.c_prop -> outcomes.load: "Conditions Satisfied"
eval.c_class -> outcomes.skip: "Missing Dependency"