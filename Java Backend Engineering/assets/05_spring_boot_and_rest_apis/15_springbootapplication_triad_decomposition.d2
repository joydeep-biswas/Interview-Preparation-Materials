direction: down
title: Deconstructing @SpringBootApplication: The Meta-Annotation Triad

root: "@SpringBootApplication (Bootstrap Master Switch)" {
  style.fill: "#064e3b"
  style.stroke: "#10b981"
  description: "Meta-annotation placed on Application.java main class"
}

p1: "1. @SpringBootConfiguration" {
  style.fill: "#0b1329"
  style.stroke: "#3b82f6"
  description: "Specialized @Configuration; primary Java config provider"
}

p2: "2. @EnableAutoConfiguration" {
  style.fill: "#1a1c12"
  style.stroke: "#f59e0b"
  description: "Activates AutoConfigurationImportSelector & @Conditional pipeline"
}

p3: "3. @ComponentScan" {
  style.fill: "#16122b"
  style.stroke: "#8b5cf6"
  description: "Scans base package & sub-packages for @Component stereotype beans"
}

root -> p1
root -> p2
root -> p3
