direction: right
title: "Production Circular Dependency Remediation Patterns"
classes: {
  container: { style: { fill: "#111827"; stroke-width: 2; border-radius: 10 } }
  box: { style: { fill: "#1E293B"; stroke-width: 2; border-radius: 8 } }
  table_box: { style: { fill: "#1E293B"; stroke: "#38bdf8"; stroke-width: 2 } }
  blue_box: { style: { fill: "#1e293b"; stroke: "#38bdf8"; stroke-width: 2; border-radius: 8 } }
  green_box: { style: { fill: "#0f291e"; stroke: "#4ade80"; stroke-width: 2; border-radius: 8 } }
  amber_box: { style: { fill: "#231e12"; stroke: "#fbbf24"; stroke-width: 2; border-radius: 8 } }
  purple_box: { style: { fill: "#1e1b2e"; stroke: "#c084fc"; stroke-width: 2; border-radius: 8 } }
  red_box: { style: { fill: "#2b1111"; stroke: "#f87171"; stroke-width: 2; border-radius: 8 } }
}

p1: "Pattern 1: Extract Shared Service (Recommended)" {
  class: container
  style.fill: "#0c1d1a"
  style.stroke: "#10b981"

  order: "OrderService"
  billing: "BillingService"
  shared: "InvoiceGenerationService (Shared)"

  order -> shared
  billing -> shared
}

p2: "Pattern 2: Event-Driven Decoupling" {
  class: container
  style.fill: "#16122b"
  style.stroke: "#8b5cf6"

  pub: "OrderService\n(publishes OrderCreatedEvent)"
  bus: "ApplicationEventPublisher"
  sub: "BillingService\n(@EventListener)"

  pub -> bus -> sub
}

p3: "Pattern 3: @Lazy Proxy Deferral (Quick Fix)" {
  class: container
  style.fill: "#1a1c12"
  style.stroke: "#f59e0b"

  lazy: "@Lazy BillingService proxy"
  warn: "Masks architectural smell; prohibited in Boot 2.6+"
}