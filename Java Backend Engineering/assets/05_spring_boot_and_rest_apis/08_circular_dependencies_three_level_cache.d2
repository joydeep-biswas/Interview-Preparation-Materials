direction: right
title: "Circular Dependencies: The Three-Level Cache Resolution Architecture"
classes: {
  container: { style: { fill: "#111827"; stroke-width: 2; border-radius: 10 } }
  box: { style: { fill: "#1E293B"; stroke-width: 2; border-radius: 8 } }
  table_box: { style: { fill: "#1E293B"; stroke: "#38bdf8"; stroke-width: 2 } }
  blue_box: { style: { fill: "#1e293b"; stroke: "#38bdf8"; stroke-width: 2; border-radius: 8 } }
  green_box: { style: { fill: "#0f291e"; stroke: "#4ade80"; stroke-width: 2; border-radius: 8 } }
  amber_box: { style: { fill: "#231e12"; stroke: "#fbbf24"; stroke-width: 2; border-radius: 8 } }
  purple_box: { style: { fill: "#1e1b2e"; stroke: "#c084fc"; stroke-width: 2; border-radius: 8 } }
  red_box: { style: { fill: "#2b1111"; stroke: "#f87171"; stroke-width: 2; border-radius: 8 } }
}

cycle: "Circular Dependency Cycle" {
  class: container
  style.fill: "#1a1116"
  style.stroke: "#ef4444"

  order: "OrderService"
  billing: "BillingService"
  deadlock: "Constructor Injection = DEADLOCK\n(BeanCurrentlyInCreationException)"

  order -> billing: "Autowired"
  billing -> order: "Autowired"
}

caches: "DefaultSingletonBeanRegistry" {
  class: container
  style.fill: "#0c1d1a"
  style.stroke: "#10b981"

  l1: "1st Level: singletonObjects\n(Fully initialized production beans)"
  l2: "2nd Level: earlySingletonObjects\n(Exposed early references / proxies)"
  l3: "3rd Level: singletonFactories\n(ObjectFactory lambdas: getEarlyBeanReference)"
}

cycle.order -> caches.l3: "1. Raw instance registered in L3"
caches.l3 -> caches.l2: "2. Evaluated when Billing requires Order"
caches.l2 -> caches.l1: "3. Promoted to L1 on complete init"