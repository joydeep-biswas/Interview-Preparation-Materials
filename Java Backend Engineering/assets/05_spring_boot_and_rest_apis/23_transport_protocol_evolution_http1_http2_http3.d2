direction: right
title: "Transport Protocol Evolution: HTTP/1.1 vs. HTTP/2 vs. HTTP/3 (QUIC)"
classes: {
  container: { style: { fill: "#111827"; stroke-width: 2; border-radius: 10 } }
  box: { style: { fill: "#1E293B"; stroke-width: 2; border-radius: 8 } }
  table_box: { style: { fill: "#1E293B"; stroke: "#38bdf8"; stroke-width: 2 } }
  blue_box: { style: { fill: "#1e293b"; stroke: "#38bdf8"; stroke-width: 2; border-radius: 8 } }
  green_box: { style: { fill: "#0f291e"; stroke: "#4ade80"; stroke-width: 2; border-radius: 8 } }
  amber_box: { style: { fill: "#231e12"; stroke: "#fbbf24"; stroke-width: 2; border-radius: 8 } }
  purple_box: { style: { fill: "#1e1b2e"; stroke: "#c084fc"; stroke-width: 2; border-radius: 8 } }
  red_box: { style: { fill: "#2b1111"; stroke: "#f87171"; stroke-width: 2; border-radius: 8 } }
}

h1: "HTTP/1.1 (1997)" {
  class: container
  style.fill: "#1a1116"
  style.stroke: "#ef4444"

  text: "Text-based framing"
  hol: "Head-of-Line blocking (1 req/socket)"
  headers: "Uncompressed redundant headers"
}

h2: "HTTP/2 (2015)" {
  class: container
  style.fill: "#0b1329"
  style.stroke: "#3b82f6"

  bin: "Binary framing (HEADERS & DATA)"
  mux: "Multiplexing over 1 TCP connection"
  hpack: "HPACK header compression"
  tcp_hol: "Still suffers TCP packet drop stall"
}

h3: "HTTP/3 (2022+)" {
  class: container
  style.fill: "#0c1d1a"
  style.stroke: "#10b981"

  quic: "QUIC transport over UDP"
  zero_hol: "ZERO Head-of-Line blocking!"
  rtt: "0-RTT connection resumption"
  roam: "Seamless mobile Wi-Fi <-> 5G roaming"
}

h1 -> h2: "Binary Multiplexing"
h2 -> h3: "QUIC / UDP Transport"