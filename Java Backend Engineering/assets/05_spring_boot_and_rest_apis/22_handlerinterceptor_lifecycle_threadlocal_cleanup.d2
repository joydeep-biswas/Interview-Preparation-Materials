direction: right
title: "HandlerInterceptor Lifecycle & ThreadLocal Context Cleanup"
classes: {
  container: { style: { fill: "#111827"; stroke-width: 2; border-radius: 10 } }
  box: { style: { fill: "#1E293B"; stroke-width: 2; border-radius: 8 } }
  table_box: { style: { fill: "#1E293B"; stroke: "#38bdf8"; stroke-width: 2 } }
  blue_box: { style: { fill: "#1e293b"; stroke: "#38bdf8"; stroke-width: 2; border-radius: 8 } }
  green_box: { style: { fill: "#0f291e"; stroke: "#4ade80"; stroke-width: 2; border-radius: 8 } }
  amber_box: { style: { fill: "#231e12"; stroke: "#fbbf24"; stroke-width: 2; border-radius: 8 } }
  purple_box: { style: { fill: "#1e1b2e"; stroke: "#c084fc"; stroke-width: 2; border-radius: 8 } }
  red_box: { style: { fill: "#2b1111"; stroke: "#f87171"; stroke-width: 2; border-radius: 8 } }
}

s1: "1. preHandle() (Gatekeeper)" {
  class: container
  style.fill: "#0b1329"
  style.stroke: "#3b82f6"

  eval: "Returns boolean (false = abort)"
  tl: "Sets ThreadLocal / MDC.put('traceId')"
}

s2: "2. Controller Execution" {
  class: container
  style.fill: "#0c1d1a"
  style.stroke: "#10b981"

  logic: "Executes @Service & DB transactions"
  reads: "Reads ThreadLocal context"
}

s3: "3. postHandle() (Before View)" {
  class: container
  style.fill: "#1a1c12"
  style.stroke: "#f59e0b"

  warn: "SKIPPED on exception! Never clean ThreadLocal here!"
}

s4: "4. afterCompletion() (Finally Block)" {
  class: container
  style.fill: "#1a1116"
  style.stroke: "#ef4444"

  always: "ALWAYS executes in finally block"
  clean: "MANDATORY CLEANUP: MDC.clear() & UserContext.clear()"
}

s1 -> s2 -> s3 -> s4