direction: down
title: "The Self-Invocation Proxy Bypass Trap & Production Fixes"
classes: {
  container: { style: { fill: "#111827"; stroke-width: 2; border-radius: 10 } }
  box: { style: { fill: "#1E293B"; stroke-width: 2; border-radius: 8 } }
  table_box: { style: { fill: "#1E293B"; stroke: "#38bdf8"; stroke-width: 2 } }
  blue_box: { style: { fill: "#1e293b"; stroke: "#38bdf8"; stroke-width: 2; border-radius: 8 } }
  green_box: { style: { fill: "#0f291e"; stroke: "#4ade80"; stroke-width: 2; border-radius: 8 } }
  amber_box: { style: { fill: "#231e12"; stroke: "#fbbf24"; stroke-width: 2; border-radius: 8 } }
  purple_box: { style: { fill: "#1e1b2e"; stroke: "#c084fc"; stroke-width: 2; border-radius: 8 } }
  red_box: { style: { fill: "#2b1111"; stroke: "#f87171"; stroke-width: 2; border-radius: 8 } }
}

trap: "The Trap: Self-Invocation Bypasses Proxy" {
  class: container
  style.fill: "#1a1116"
  style.stroke: "#ef4444"

  ext: "External Call: Controller -> Proxy -> Target (WORKS!)"
  internal: "Self-Invocation: this.sendEmail() -> Bypasses Proxy! (FAILS SILENTLY!)"

  ext -> internal
}

remedies: "3 Production Remedies" {
  class: container
  r1: "Remedy 1: Extract Separate Service (Recommended)\n(Move method to EmailService, inject into UserService)" {
    class: box
    style.stroke: "#10b981"
  }
  r2: "Remedy 2: Self-Injection\n(@Autowired @Lazy UserService self -> self.sendEmail())" {
    style.stroke: "#38bdf8"
  }
  r3: "Remedy 3: AspectJ Bytecode Weaving\n(Weaves bytecode directly, eliminating proxy reliance)" {
    class: box
    style.stroke: "#8b5cf6"
  }
}

trap -> remedies