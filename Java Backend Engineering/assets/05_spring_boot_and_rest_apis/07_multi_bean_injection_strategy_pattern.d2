direction: right
title: "Multi-Bean Injection & The Dynamic Strategy Pattern"
classes: {
  container: { style: { fill: "#111827"; stroke-width: 2; border-radius: 10 } }
  box: { style: { fill: "#1E293B"; stroke-width: 2; border-radius: 8 } }
  table_box: { style: { fill: "#1E293B"; stroke: "#38bdf8"; stroke-width: 2 } }
  blue_box: { style: { fill: "#1e293b"; stroke: "#38bdf8"; stroke-width: 2; border-radius: 8 } }
  green_box: { style: { fill: "#0f291e"; stroke: "#4ade80"; stroke-width: 2; border-radius: 8 } }
  amber_box: { style: { fill: "#231e12"; stroke: "#fbbf24"; stroke-width: 2; border-radius: 8 } }
  purple_box: { style: { fill: "#1e1b2e"; stroke: "#c084fc"; stroke-width: 2; border-radius: 8 } }
  red_box: { style: { fill: "#2b1111"; stroke: "#f87171"; stroke-width: 2; border-radius: 8 } }
}

container: "Spring ApplicationContext" {
  class: container
  style.fill: "#0b1329"
  style.stroke: "#3b82f6"

  scan: "Discovers all PaymentProcessor beans"
  ocp: "Open-Closed Principle: New processors added without modifying service"
}

registry: "Injected Strategy Map" {
  class: container
  style.fill: "#1a1c12"
  style.stroke: "#f59e0b"

  map: "Map<PaymentMethod, PaymentProcessor>"
  dispatch: "O(1) map.get(method).execute(req)\n(Zero switch statements!)"
}

strategies: "Concrete Strategy Implementations" {
  class: container
  style.fill: "#0c1d1a"
  style.stroke: "#10b981"

  cc: "CreditCardProcessor (CREDIT_CARD)"
  apple: "ApplePayProcessor (APPLE_PAY)"
  paypal: "PayPalProcessor (PAYPAL)"
  crypto: "CryptoProcessor (CRYPTO)"
}

container.scan -> registry.map: "Auto-inject collection"
registry.dispatch -> strategies.cc
registry.dispatch -> strategies.apple
registry.dispatch -> strategies.paypal
registry.dispatch -> strategies.crypto