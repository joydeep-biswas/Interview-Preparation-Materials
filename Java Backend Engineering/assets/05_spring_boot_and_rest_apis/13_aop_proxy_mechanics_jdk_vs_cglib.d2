direction: right
title: "Spring AOP Proxy Mechanics: JDK Dynamic Proxies vs. CGLIB"
classes: {
  container: { style: { fill: "#111827"; stroke-width: 2; border-radius: 10 } }
  box: { style: { fill: "#1E293B"; stroke-width: 2; border-radius: 8 } }
  table_box: { style: { fill: "#1E293B"; stroke: "#38bdf8"; stroke-width: 2 } }
  blue_box: { style: { fill: "#1e293b"; stroke: "#38bdf8"; stroke-width: 2; border-radius: 8 } }
  green_box: { style: { fill: "#0f291e"; stroke: "#4ade80"; stroke-width: 2; border-radius: 8 } }
  amber_box: { style: { fill: "#231e12"; stroke: "#fbbf24"; stroke-width: 2; border-radius: 8 } }
  purple_box: { style: { fill: "#1e1b2e"; stroke: "#c084fc"; stroke-width: 2; border-radius: 8 } }
  red_box: { style: { fill: "#2b1111"; stroke: "#f87171"; stroke-width: 2; border-radius: 8 } }
}

client: "Client Caller (e.g. Controller)" {
  class: container
  style.fill: "#0b1329"
  style.stroke: "#3b82f6"
  invoke: "orderService.create()"
}

proxy: "Spring Dynamic Proxy" {
  class: container
  style.fill: "#0c1d1a"
  style.stroke: "#10b981"

  jdk: "JDK Dynamic Proxy (implements interface)"
  cglib: "CGLIB Proxy (Subclasses target concrete class)"
}

chain: "MethodInterceptor Chain" {
  class: container
  style.fill: "#1a1c12"
  style.stroke: "#f59e0b"

  sec: "SecurityInterceptor (@PreAuthorize)"
  tx: "TransactionInterceptor (@Transactional)"
  audit: "Audit Aspect (@Around)"

  sec -> tx -> audit
}

target: "Target Bean Instance (OrderServiceImpl)" {
  class: container
  style.fill: "#062e3d"
  style.stroke: "#06b6d4"
  logic: "Pure business & database logic"
}

client.invoke -> proxy.cglib
proxy.cglib -> chain.sec
chain.audit -> target.logic: "MethodInvocation.proceed()"