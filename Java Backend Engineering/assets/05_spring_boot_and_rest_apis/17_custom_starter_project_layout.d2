direction: down
title: "Production Custom Spring Boot Starter: File & Directory Layout"
classes: {
  container: { style: { fill: "#111827"; stroke-width: 2; border-radius: 10 } }
  box: { style: { fill: "#1E293B"; stroke-width: 2; border-radius: 8 } }
  table_box: { style: { fill: "#1E293B"; stroke: "#38bdf8"; stroke-width: 2 } }
  blue_box: { style: { fill: "#1e293b"; stroke: "#38bdf8"; stroke-width: 2; border-radius: 8 } }
  green_box: { style: { fill: "#0f291e"; stroke: "#4ade80"; stroke-width: 2; border-radius: 8 } }
  amber_box: { style: { fill: "#231e12"; stroke: "#fbbf24"; stroke-width: 2; border-radius: 8 } }
  purple_box: { style: { fill: "#1e1b2e"; stroke: "#c084fc"; stroke-width: 2; border-radius: 8 } }
  red_box: { style: { fill: "#2b1111"; stroke: "#f87171"; stroke-width: 2; border-radius: 8 } }
}

root: "📁 enterprise-audit-spring-boot-starter/" {
  class: container
  style.fill: "#0b1329"
  style.stroke: "#3b82f6"

  src: "📁 src/main/java/com/enterprise/starter/audit/" {
    class: box
    style.stroke: "#10b981"
    f1: "📄 AuditAutoConfiguration.java (@AutoConfiguration)"
    f2: "📄 AuditProperties.java (@ConfigurationProperties)"
    f3: "📄 AuditService.java (Core Domain Engine)"
    f4: "📄 AuditFilter.java (OncePerRequestFilter)"
  }

  meta: "📁 src/main/resources/META-INF/spring/" {
    class: box
    style.stroke: "#f59e0b"
    f5: "📄 AutoConfiguration.imports (Class registration)"
    f6: "📄 additional-spring-configuration-metadata.json (IDE autocomplete)"
  }

  pom: "📄 pom.xml (spring-boot-autoconfigure dependency)"
}