direction: right
title: The Complete 12-Phase Spring Bean Lifecycle

s1: "Stage 1: Definition & Creation" {
  style.fill: "#0b1329"
  style.stroke: "#3b82f6"

  p1: "1. BeanDefinition Parsing"
  p2: "2. BeanFactoryPostProcessors"
  p3: "3. Constructor Instantiation"
  p4: "4. Populate Properties (DI)"

  p1 -> p2 -> p3 -> p4
}

s2: "Stage 2: Aware & Initialization" {
  style.fill: "#0c1d1a"
  style.stroke: "#10b981"

  p5: "5. Aware Callbacks"
  p6: "6. BPP Before-Init"
  p7: "7. @PostConstruct"
  p8: "8. InitializingBean / initMethod"

  p5 -> p6 -> p7 -> p8
}

s3: "Stage 3: AOP, Traffic & Teardown" {
  style.fill: "#16122b"
  style.stroke: "#8b5cf6"

  p9: "9. BPP After-Init (AOP Proxy Wrapping)"
  p10: "10. Ready / Serves Traffic"
  p11: "11. @PreDestroy"
  p12: "12. DisposableBean / destroyMethod"

  p9 -> p10 -> p11 -> p12
}

s1.p4 -> s2.p5
s2.p8 -> s3.p9
