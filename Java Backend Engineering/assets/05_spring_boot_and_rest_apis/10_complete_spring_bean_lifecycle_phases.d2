direction: right
title: "The Complete 12-Phase Spring Bean Lifecycle"
classes: {
  container: { style: { fill: "#111827"; stroke-width: 2; border-radius: 10 } }
  box: { style: { fill: "#1E293B"; stroke-width: 2; border-radius: 8 } }
  table_box: { style: { fill: "#1E293B"; stroke: "#38bdf8"; stroke-width: 2 } }
  blue_box: { style: { fill: "#1e293b"; stroke: "#38bdf8"; stroke-width: 2; border-radius: 8 } }
  green_box: { style: { fill: "#0f291e"; stroke: "#4ade80"; stroke-width: 2; border-radius: 8 } }
  amber_box: { style: { fill: "#231e12"; stroke: "#fbbf24"; stroke-width: 2; border-radius: 8 } }
  purple_box: { style: { fill: "#1e1b2e"; stroke: "#c084fc"; stroke-width: 2; border-radius: 8 } }
  red_box: { style: { fill: "#2b1111"; stroke: "#f87171"; stroke-width: 2; border-radius: 8 } }
}

s1: "Stage 1: Definition & Creation" {
  class: container
  style.fill: "#0b1329"
  style.stroke: "#3b82f6"

  p1: "1. BeanDefinition Parsing"
  p2: "2. BeanFactoryPostProcessors"
  p3: "3. Constructor Instantiation"
  p4: "4. Populate Properties (DI)"

  p1 -> p2 -> p3 -> p4
}

s2: "Stage 2: Aware & Initialization" {
  class: container
  style.fill: "#0c1d1a"
  style.stroke: "#10b981"

  p5: "5. Aware Callbacks"
  p6: "6. BPP Before-Init"
  p7: "7. @PostConstruct"
  p8: "8. InitializingBean / initMethod"

  p5 -> p6 -> p7 -> p8
}

s3: "Stage 3: AOP, Traffic & Teardown" {
  class: container
  style.fill: "#16122b"
  style.stroke: "#8b5cf6"

  p9: "9. BPP After-Init (AOP Proxy Wrapping)"
  p10: "10. Ready / Serves Traffic"
  p11: "11. @PreDestroy"
  p12: "12. DisposableBean / destroyMethod"

  p9 -> p10 -> p11 -> p12
}

s1.p4 -> s2.p5
s2.p8 -> s3.p9