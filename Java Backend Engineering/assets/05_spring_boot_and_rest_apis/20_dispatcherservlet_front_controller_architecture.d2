direction: right
title: "DispatcherServlet Front Controller: 3-Phase Internal Architecture"
classes: {
  container: { style: { fill: "#111827"; stroke-width: 2; border-radius: 10 } }
  box: { style: { fill: "#1E293B"; stroke-width: 2; border-radius: 8 } }
  table_box: { style: { fill: "#1E293B"; stroke: "#38bdf8"; stroke-width: 2 } }
  blue_box: { style: { fill: "#1e293b"; stroke: "#38bdf8"; stroke-width: 2; border-radius: 8 } }
  green_box: { style: { fill: "#0f291e"; stroke: "#4ade80"; stroke-width: 2; border-radius: 8 } }
  amber_box: { style: { fill: "#231e12"; stroke: "#fbbf24"; stroke-width: 2; border-radius: 8 } }
  purple_box: { style: { fill: "#1e1b2e"; stroke: "#c084fc"; stroke-width: 2; border-radius: 8 } }
  red_box: { style: { fill: "#2b1111"; stroke: "#f87171"; stroke-width: 2; border-radius: 8 } }
}

ds: "DispatcherServlet (Front Controller)" {
  class: container
  style.fill: "#0b1329"
  style.stroke: "#3b82f6"
  req: "POST /api/orders"
  dispatch: "doDispatch() loop"
}

p1: "Phase 1: Handler Mapping" {
  class: container
  style.fill: "#1a1c12"
  style.stroke: "#f59e0b"

  map: "RequestMappingHandlerMapping"
  chain: "HandlerExecutionChain\n(HandlerMethod + Interceptors)"

  map -> chain
}

p2: "Phase 2: Interceptors & Adapter" {
  class: container
  style.fill: "#0c1d1a"
  style.stroke: "#10b981"

  pre: "preHandle() checks"
  adapt: "HandlerAdapter (invoke controller)"
  post: "postHandle()"

  pre -> adapt -> post
}

p3: "Phase 3: Serialization & Response" {
  class: container
  style.fill: "#16122b"
  style.stroke: "#8b5cf6"

  conv: "Jackson HttpMessageConverter"
  res: "HTTP Response (201 Created + JSON)"

  conv -> res
}

ds.req -> ds.dispatch -> p1.map
p1.chain -> p2.pre
p2.adapt -> p3.conv