direction: right
title: "gRPC Communication Modes: Unary, Server, Client & Bidirectional"
classes: {
  container: { style: { fill: "#111827"; stroke-width: 2; border-radius: 10 } }
  box: { style: { fill: "#1E293B"; stroke-width: 2; border-radius: 8 } }
  table_box: { style: { fill: "#1E293B"; stroke: "#38bdf8"; stroke-width: 2 } }
  blue_box: { style: { fill: "#1e293b"; stroke: "#38bdf8"; stroke-width: 2; border-radius: 8 } }
  green_box: { style: { fill: "#0f291e"; stroke: "#4ade80"; stroke-width: 2; border-radius: 8 } }
  amber_box: { style: { fill: "#231e12"; stroke: "#fbbf24"; stroke-width: 2; border-radius: 8 } }
  purple_box: { style: { fill: "#1e1b2e"; stroke: "#c084fc"; stroke-width: 2; border-radius: 8 } }
  red_box: { style: { fill: "#2b1111"; stroke: "#f87171"; stroke-width: 2; border-radius: 8 } }
}

m1: "1. Unary RPC (1-to-1)" {
  class: container
  style.fill: "#0b1329"
  style.stroke: "#3b82f6"
  flow: "Single Request -> Single Response"
}

m2: "2. Server Streaming (1-to-Many)" {
  class: container
  style.fill: "#1a1c12"
  style.stroke: "#f59e0b"
  flow: "Single Request -> Stream of Responses"
}

m3: "3. Client Streaming (Many-to-1)" {
  class: container
  style.fill: "#16122b"
  style.stroke: "#8b5cf6"
  flow: "Stream of Requests -> Single Response"
}

m4: "4. Bidirectional Streaming (Full-Duplex)" {
  class: container
  style.fill: "#0c1d1a"
  style.stroke: "#10b981"
  flow: "Full-Duplex Concurrent Streams (Chat, Gaming)"
}