direction: right
title: "Bean Disambiguation: @Autowired, @Primary, and @Qualifier"
classes: {
  container: { style: { fill: "#111827"; stroke-width: 2; border-radius: 10 } }
  box: { style: { fill: "#1E293B"; stroke-width: 2; border-radius: 8 } }
  table_box: { style: { fill: "#1E293B"; stroke: "#38bdf8"; stroke-width: 2 } }
  blue_box: { style: { fill: "#1e293b"; stroke: "#38bdf8"; stroke-width: 2; border-radius: 8 } }
  green_box: { style: { fill: "#0f291e"; stroke: "#4ade80"; stroke-width: 2; border-radius: 8 } }
  amber_box: { style: { fill: "#231e12"; stroke: "#fbbf24"; stroke-width: 2; border-radius: 8 } }
  purple_box: { style: { fill: "#1e1b2e"; stroke: "#c084fc"; stroke-width: 2; border-radius: 8 } }
  red_box: { style: { fill: "#2b1111"; stroke: "#f87171"; stroke-width: 2; border-radius: 8 } }
}

consumer: "CheckoutService requires PaymentGateway" {
  class: container
  style.fill: "#0b1329"
  style.stroke: "#3b82f6"

  amb: "Two Candidates Found:\nStripeGateway vs PayPalGateway\n(NoUniqueBeanDefinitionException!)"
}

s1: "Strategy 1: @Primary" {
  class: container
  style.fill: "#0c1d1a"
  style.stroke: "#10b981"

  stripe: "@Primary on StripeGateway"
  res1: "Injected by default without qualifier"
}

s2: "Strategy 2: @Qualifier" {
  class: container
  style.fill: "#062e3d"
  style.stroke: "#06b6d4"

  paypal: "@Qualifier('payPalGateway')"
  res2: "Explicit override at injection site (Beats @Primary)"
}

consumer.amb -> s1.stripe: "Default resolution"
consumer.amb -> s2.paypal: "Explicit resolution"