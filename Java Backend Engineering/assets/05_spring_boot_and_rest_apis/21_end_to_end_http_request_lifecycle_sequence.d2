direction: down
title: "End-to-End Spring Boot HTTP Request Lifecycle Sequence"
classes: {
  container: { style: { fill: "#111827"; stroke-width: 2; border-radius: 10 } }
  box: { style: { fill: "#1E293B"; stroke-width: 2; border-radius: 8 } }
  table_box: { style: { fill: "#1E293B"; stroke: "#38bdf8"; stroke-width: 2 } }
  blue_box: { style: { fill: "#1e293b"; stroke: "#38bdf8"; stroke-width: 2; border-radius: 8 } }
  green_box: { style: { fill: "#0f291e"; stroke: "#4ade80"; stroke-width: 2; border-radius: 8 } }
  amber_box: { style: { fill: "#231e12"; stroke: "#fbbf24"; stroke-width: 2; border-radius: 8 } }
  purple_box: { style: { fill: "#1e1b2e"; stroke: "#c084fc"; stroke-width: 2; border-radius: 8 } }
  red_box: { style: { fill: "#2b1111"; stroke: "#f87171"; stroke-width: 2; border-radius: 8 } }
}

client: "HTTP Client"
filter: "FilterChain (CORS, Trace)"
ds: "DispatcherServlet"
adapter: "HandlerAdapter"
controller: "OrderController"
jackson: "Jackson Converter"

client -> filter: "1. POST /api/orders (JSON)"
filter -> ds: "2. doFilter()"
ds -> adapter: "3. handle(request)"
adapter -> jackson: "4. read(JSON -> DTO)"
jackson -> adapter: "5. Validated DTO"
adapter -> controller: "6. createOrder(dto)"
controller -> adapter: "7. ResponseEntity.created(dto)"
adapter -> jackson: "8. write(JSON bytes)"
adapter -> ds: "9. afterCompletion()"
ds -> client: "10. HTTP 201 Created + JSON"