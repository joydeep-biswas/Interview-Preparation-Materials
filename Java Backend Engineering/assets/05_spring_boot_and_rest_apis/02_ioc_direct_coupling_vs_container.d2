direction: right
title: "Direct Coupling vs. Inversion of Control (IoC)"
classes: {
  container: { style: { fill: "#111827"; stroke-width: 2; border-radius: 10 } }
  box: { style: { fill: "#1E293B"; stroke-width: 2; border-radius: 8 } }
  table_box: { style: { fill: "#1E293B"; stroke: "#38bdf8"; stroke-width: 2 } }
  blue_box: { style: { fill: "#1e293b"; stroke: "#38bdf8"; stroke-width: 2; border-radius: 8 } }
  green_box: { style: { fill: "#0f291e"; stroke: "#4ade80"; stroke-width: 2; border-radius: 8 } }
  amber_box: { style: { fill: "#231e12"; stroke: "#fbbf24"; stroke-width: 2; border-radius: 8 } }
  purple_box: { style: { fill: "#1e1b2e"; stroke: "#c084fc"; stroke-width: 2; border-radius: 8 } }
  red_box: { style: { fill: "#2b1111"; stroke: "#f87171"; stroke-width: 2; border-radius: 8 } }
}

trad: "Traditional Direct Coupling (No IoC)" {
  class: container
  style.fill: "#1a1116"
  style.stroke: "#ef4444"

  svc_t: "OrderService"
  repo_t: "PostgresOrderRepository"
  ds_t: "HikariDataSource"
  sock_t: "Low-level Network Socket"

  svc_t -> repo_t: "calls new()"
  repo_t -> ds_t: "calls new()"
  ds_t -> sock_t: "calls new Socket()"
}

ioc: "Inversion of Control (Spring IoC)" {
  class: container
  style.fill: "#0c1d1a"
  style.stroke: "#10b981"

  ctx: "Spring ApplicationContext (Container)"
  ds_i: "DataSource Bean"
  repo_i: "OrderRepository Bean"
  svc_i: "OrderService Bean"

  ctx -> ds_i: "1. Instantiates"
  ctx -> repo_i: "2. Injects DataSource"
  ctx -> svc_i: "3. Injects Repository"
}