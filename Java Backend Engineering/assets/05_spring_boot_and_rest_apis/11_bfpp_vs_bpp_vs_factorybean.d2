direction: right
title: "Core Extension Points: BeanFactoryPostProcessor vs. BeanPostProcessor vs. FactoryBean<T>"
classes: {
  container: { style: { fill: "#111827"; stroke-width: 2; border-radius: 10 } }
  box: { style: { fill: "#1E293B"; stroke-width: 2; border-radius: 8 } }
  table_box: { style: { fill: "#1E293B"; stroke: "#38bdf8"; stroke-width: 2 } }
  blue_box: { style: { fill: "#1e293b"; stroke: "#38bdf8"; stroke-width: 2; border-radius: 8 } }
  green_box: { style: { fill: "#0f291e"; stroke: "#4ade80"; stroke-width: 2; border-radius: 8 } }
  amber_box: { style: { fill: "#231e12"; stroke: "#fbbf24"; stroke-width: 2; border-radius: 8 } }
  purple_box: { style: { fill: "#1e1b2e"; stroke: "#c084fc"; stroke-width: 2; border-radius: 8 } }
  red_box: { style: { fill: "#2b1111"; stroke: "#f87171"; stroke-width: 2; border-radius: 8 } }
}

bfpp: "BeanFactoryPostProcessor" {
  class: container
  style.fill: "#0b1329"
  style.stroke: "#3b82f6"

  timing: "Runs FIRST, before beans exist"
  target: "Modifies BeanDefinition metadata"
  example: "PropertySourcesPlaceholderConfig (\${...})" { class: box }
}

bpp: "BeanPostProcessor" {
  class: container
  style.fill: "#0c1d1a"
  style.stroke: "#10b981"

  timing: "Runs DURING initialization"
  target: "Intercepts real bean instances"
  example: "AnnotationAwareAspectJAutoProxyCreator (AOP)"
}

fb: "FactoryBean<T>" {
  class: container
  style.fill: "#16122b"
  style.stroke: "#8b5cf6"

  timing: "Invoked on getBean()"
  target: "Encapsulates complex factory construction"
  example: "LocalContainerEntityManagerFactoryBean"
}

bfpp -> bpp: "Prepares definitions"
bpp -> fb: "Initializes factory"