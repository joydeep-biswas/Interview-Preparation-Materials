direction: down
title: "Spring Stereotype Annotations Hierarchy & Responsibilities"
classes: {
  container: { style: { fill: "#111827"; stroke-width: 2; border-radius: 10 } }
  box: { style: { fill: "#1E293B"; stroke-width: 2; border-radius: 8 } }
  table_box: { style: { fill: "#1E293B"; stroke: "#38bdf8"; stroke-width: 2 } }
  blue_box: { style: { fill: "#1e293b"; stroke: "#38bdf8"; stroke-width: 2; border-radius: 8 } }
  green_box: { style: { fill: "#0f291e"; stroke: "#4ade80"; stroke-width: 2; border-radius: 8 } }
  amber_box: { style: { fill: "#231e12"; stroke: "#fbbf24"; stroke-width: 2; border-radius: 8 } }
  purple_box: { style: { fill: "#1e1b2e"; stroke: "#c084fc"; stroke-width: 2; border-radius: 8 } }
  red_box: { style: { fill: "#2b1111"; stroke: "#f87171"; stroke-width: 2; border-radius: 8 } }
}

comp: "@Component (Meta-Annotation Root)" {
  class: container
  style.fill: "#0b1329"
  style.stroke: "#3b82f6"
  description: "General-purpose candidate for classpath scanning"
}

svc: "@Service (Domain Logic)" {
  class: container
  style.fill: "#0c1d1a"
  style.stroke: "#10b981"
  description: "Orchestration & @Transactional boundaries"
}

repo: "@Repository (Persistence)" {
  class: container
  style.fill: "#16122b"
  style.stroke: "#8b5cf6"
  description: "DAO & automatic DataAccessException translation"
}

ctrl: "@Controller / @RestController" {
  class: container
  style.fill: "#1a1c12"
  style.stroke: "#f59e0b"
  description: "HTTP web controllers & JSON @ResponseBody"
}

cfg: "@Configuration (Factory)" {
  class: container
  style.fill: "#0b1329"
  style.stroke: "#38bdf8"
  description: "@Bean factory with CGLIB proxyBeanMethods=true"
}

comp -> svc
comp -> repo
comp -> ctrl
comp -> cfg