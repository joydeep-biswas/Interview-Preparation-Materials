direction: right
title: "The Prototype-in-Singleton Injection Dilemma & Solutions"
classes: {
  container: { style: { fill: "#111827"; stroke-width: 2; border-radius: 10 } }
  box: { style: { fill: "#1E293B"; stroke-width: 2; border-radius: 8 } }
  table_box: { style: { fill: "#1E293B"; stroke: "#38bdf8"; stroke-width: 2 } }
  blue_box: { style: { fill: "#1e293b"; stroke: "#38bdf8"; stroke-width: 2; border-radius: 8 } }
  green_box: { style: { fill: "#0f291e"; stroke: "#4ade80"; stroke-width: 2; border-radius: 8 } }
  amber_box: { style: { fill: "#231e12"; stroke: "#fbbf24"; stroke-width: 2; border-radius: 8 } }
  purple_box: { style: { fill: "#1e1b2e"; stroke: "#c084fc"; stroke-width: 2; border-radius: 8 } }
  red_box: { style: { fill: "#2b1111"; stroke: "#f87171"; stroke-width: 2; border-radius: 8 } }
}

bug: "The Trap: Prototype-in-Singleton Frozen Instance" {
  class: container
  style.fill: "#1a1116"
  style.stroke: "#ef4444"

  svc1: "AuthenticationService (Singleton)"
  gen1: "TokenGenerator Instance #1 (FROZEN!)\nInjected once at startup"
  reqs: "All Requests 1, 2, 3 share Instance #1\n(State pollution bug!)"

  svc1 -> gen1: "Injected once"
  gen1 -> reqs
}

fix: "The Solution: ObjectProvider Resolution" {
  class: container
  style.fill: "#0c1d1a"
  style.stroke: "#10b981"

  svc2: "AuthenticationService (Singleton)"
  provider: "ObjectProvider<TokenGenerator>"
  t1: "TokenGen #1 (Req 1)"
  t2: "TokenGen #2 (Req 2)"
  t3: "TokenGen #3 (Req 3)"

  svc2 -> provider: "provider.getObject()"
  provider -> t1
  provider -> t2
  provider -> t3
}