direction: right
title: "Kubernetes Liveness & Readiness Probes (AvailabilityState Model)"
classes: {
  container: { style: { fill: "#111827"; stroke-width: 2; border-radius: 10 } }
  box: { style: { fill: "#1E293B"; stroke-width: 2; border-radius: 8 } }
  table_box: { style: { fill: "#1E293B"; stroke: "#38bdf8"; stroke-width: 2 } }
  blue_box: { style: { fill: "#1e293b"; stroke: "#38bdf8"; stroke-width: 2; border-radius: 8 } }
  green_box: { style: { fill: "#0f291e"; stroke: "#4ade80"; stroke-width: 2; border-radius: 8 } }
  amber_box: { style: { fill: "#231e12"; stroke: "#fbbf24"; stroke-width: 2; border-radius: 8 } }
  purple_box: { style: { fill: "#1e1b2e"; stroke: "#c084fc"; stroke-width: 2; border-radius: 8 } }
  red_box: { style: { fill: "#2b1111"; stroke: "#f87171"; stroke-width: 2; border-radius: 8 } }
}

k8s: "Kubernetes Kubelet Node Agent" {
  class: container
  style.fill: "#0b1329"
  style.stroke: "#3b82f6"
  poll: "Periodic health polling loop"
}

live: "Liveness Probe: /actuator/health/liveness" {
  class: container
  style.fill: "#1a1116"
  style.stroke: "#ef4444"

  state: "LivenessState (CORRECT / BROKEN)"
  cause: "Severe deadlock or fatal corruption"
  action: "Action: KILL & RESTART POD"
}

ready: "Readiness Probe: /actuator/health/readiness" {
  class: container
  style.fill: "#0c1d1a"
  style.stroke: "#10b981"

  r_state: "ReadinessState (ACCEPTING / REFUSING)"
  r_cause: "Warming caches or busy DB pool"
  r_action: "Action: STOP ROUTING TRAFFIC (DO NOT KILL!)"
}

k8s.poll -> live: "Liveness Check"
k8s.poll -> ready: "Readiness Check"