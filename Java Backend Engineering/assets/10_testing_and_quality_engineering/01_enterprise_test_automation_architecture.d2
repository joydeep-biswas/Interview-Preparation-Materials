direction: right
title: "Enterprise Test Automation & Continuous Quality Gates Architecture"
classes: {
  container: { style: { fill: "#111827"; stroke-width: 2; border-radius: 10 } }
  box: { style: { fill: "#1E293B"; stroke-width: 2; border-radius: 8 } }
  table_box: { style: { fill: "#1E293B"; stroke: "#38bdf8"; stroke-width: 2 } }
  blue_box: { style: { fill: "#1e293b"; stroke: "#38bdf8"; stroke-width: 2; border-radius: 8 } }
  green_box: { style: { fill: "#0f291e"; stroke: "#4ade80"; stroke-width: 2; border-radius: 8 } }
  amber_box: { style: { fill: "#231e12"; stroke: "#fbbf24"; stroke-width: 2; border-radius: 8 } }
  purple_box: { style: { fill: "#1e1b2e"; stroke: "#c084fc"; stroke-width: 2; border-radius: 8 } }
  red_box: { style: { fill: "#2b1111"; stroke: "#f87171"; stroke-width: 2; border-radius: 8 } }
}

pyramid: "The Enterprise Testing Pyramid" {
  class: container
  style.fill: "#0f172a"
  style.stroke: "#3b82f6"

  e2e: "E2E & Contract Tests (5-10%)\nPact / Selenium / RestAssured" {
    style.fill: "#78350f"
    style.stroke: "#f59e0b"
  }
  integ: "Integration Tests (20-30%)\nTestcontainers (Postgres, Kafka)" {
    style.fill: "#083344"
    style.stroke: "#06b6d4"
  }
  unit: "Unit Tests (60-70%)\nJUnit 5, AssertJ, Mockito\nFast & Deterministic" {
    style.fill: "#064e3b"
    style.stroke: "#10b981"
  }

  e2e -> integ -> unit
}

ci: "CI Quality Gates" {
  class: container
  style.fill: "#0f172a"
  style.stroke: "#10b981"

  git: "Git Push"
  u_run: "Run Unit Tests (~30s)"
  i_run: "Testcontainers Integration (~3m)"
  gate: "SonarQube Gate (>=80% Coverage)"

  git -> u_run -> i_run -> gate
}

pyramid -> ci: "Enforces testing standards"