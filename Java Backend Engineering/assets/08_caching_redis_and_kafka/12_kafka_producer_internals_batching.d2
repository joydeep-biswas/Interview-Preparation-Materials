direction: right
title: "Kafka Producer Internals: Ingestion, Batching & Transmission"
classes: {
  container: { style: { fill: "#111827"; stroke-width: 2; border-radius: 10 } }
  box: { style: { fill: "#1E293B"; stroke-width: 2; border-radius: 8 } }
  table_box: { style: { fill: "#1E293B"; stroke: "#38bdf8"; stroke-width: 2 } }
  blue_box: { style: { fill: "#1e293b"; stroke: "#38bdf8"; stroke-width: 2; border-radius: 8 } }
  green_box: { style: { fill: "#0f291e"; stroke: "#4ade80"; stroke-width: 2; border-radius: 8 } }
  amber_box: { style: { fill: "#231e12"; stroke: "#fbbf24"; stroke-width: 2; border-radius: 8 } }
  purple_box: { style: { fill: "#1e1b2e"; stroke: "#c084fc"; stroke-width: 2; border-radius: 8 } }
  red_box: { style: { fill: "#2b1111"; stroke: "#f87171"; stroke-width: 2; border-radius: 8 } }
}

Phase1: "Phase 1: Ingestion & Serialization" {
  class: container
  style.fill: "#0B132B"
  style.stroke: "#0284C7"
  record: "ProducerRecord (topic, key, value)"
  serializer: "Serializers (byte[])"
  partitioner: "Partitioner (Murmur2 hash)"
  record -> serializer -> partitioner
}

Phase2: "Phase 2: RecordAccumulator" {
  class: container
  style.fill: "#1E1B4B"
  style.stroke: "#8B5CF6"
  pool: "32MB Buffer Pool"
  p0: "Partition 0 Batch (16KB)"
  p1: "Partition 1 Batch (16KB)"
  p2: "Partition 2 Batch (16KB)"
}

Phase3: "Phase 3: Sender Thread" {
  class: container
  style.fill: "#06201B"
  style.stroke: "#10B981"
  sender: "Sender Thread (linger.ms & batch.size)"
  network: "NetworkClient Socket (acks=all, idempotence=true)"
  sender -> network
}

Phase1.partitioner -> Phase2.pool: "Appends record" { style.stroke: "#38BDF8" }
Phase2.pool -> Phase3.sender: "Batches dispatched" { style.stroke: "#10B981" }