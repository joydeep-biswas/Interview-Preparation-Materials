direction: right
title: "Four Enterprise Caching Patterns"
classes: {
  container: { style: { fill: "#111827"; stroke-width: 2; border-radius: 10 } }
  box: { style: { fill: "#1E293B"; stroke-width: 2; border-radius: 8 } }
  table_box: { style: { fill: "#1E293B"; stroke: "#38bdf8"; stroke-width: 2 } }
  blue_box: { style: { fill: "#1e293b"; stroke: "#38bdf8"; stroke-width: 2; border-radius: 8 } }
  green_box: { style: { fill: "#0f291e"; stroke: "#4ade80"; stroke-width: 2; border-radius: 8 } }
  amber_box: { style: { fill: "#231e12"; stroke: "#fbbf24"; stroke-width: 2; border-radius: 8 } }
  purple_box: { style: { fill: "#1e1b2e"; stroke: "#c084fc"; stroke-width: 2; border-radius: 8 } }
  red_box: { style: { fill: "#2b1111"; stroke: "#f87171"; stroke-width: 2; border-radius: 8 } }
}

P1: "1. Cache-Aside (Lazy)" {
  class: container
  style.fill: "#0B132B"
  style.stroke: "#0284C7"
  desc: "App checks cache -> reads DB on miss -> updates cache"
}

P2: "2. Read-Through" {
  class: container
  style.fill: "#06201B"
  style.stroke: "#10B981"
  desc: "App reads from cache -> cache library fetches DB transparently"
}

P3: "3. Write-Through" {
  class: container
  style.fill: "#1C1917"
  style.stroke: "#F59E0B"
  desc: "App writes cache -> cache synchronously writes DB"
}

P4: "4. Write-Behind (Write-Back)" {
  class: container
  style.fill: "#1E1B4B"
  style.stroke: "#8B5CF6"
  desc: "App writes cache (fast) -> async background queue drains batch to DB"
}