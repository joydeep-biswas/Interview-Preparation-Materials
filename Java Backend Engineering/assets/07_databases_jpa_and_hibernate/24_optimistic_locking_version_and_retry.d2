direction: right
title: "Optimistic Locking (@Version) & Automated Spring Retry Pattern"
classes: {
  container: { style: { fill: "#111827"; stroke-width: 2; border-radius: 10 } }
  box: { style: { fill: "#1E293B"; stroke-width: 2; border-radius: 8 } }
  table_box: { style: { fill: "#1E293B"; stroke: "#38bdf8"; stroke-width: 2 } }
  blue_box: { style: { fill: "#1e293b"; stroke: "#38bdf8"; stroke-width: 2; border-radius: 8 } }
  green_box: { style: { fill: "#0f291e"; stroke: "#4ade80"; stroke-width: 2; border-radius: 8 } }
  amber_box: { style: { fill: "#231e12"; stroke: "#fbbf24"; stroke-width: 2; border-radius: 8 } }
  purple_box: { style: { fill: "#1e1b2e"; stroke: "#c084fc"; stroke-width: 2; border-radius: 8 } }
  red_box: { style: { fill: "#2b1111"; stroke: "#f87171"; stroke-width: 2; border-radius: 8 } }
}

t1: "Thread 1 (User A)" {
  class: container
  style.fill: "#1e293b"
  style.stroke: "#3b82f6"
  read: "1. Read Account (v1)"
  upd: "3. UPDATE ... WHERE id=1 AND version=1"
}

db: "PostgreSQL Database\naccounts table" {
  style.fill: "#0f172a"
  style.stroke: "#10b981"
  state1: "id=1, balance=150, version=2"
  state2: "0 rows matched for version=1!"
}

t2: "Thread 2 (User B)\n@Retryable" {
  style.fill: "#111827"
  style.stroke: "#f59e0b"
  read: "2. Read Account (v1)"
  upd: "4. UPDATE ... WHERE id=1 AND version=1"
  retry: "5. Catches OptimisticLockException\nRe-reads v2 & succeeds on retry!"
}

t1.read -> db
t2.read -> db
t1.upd -> db.state1: "Success (1 row updated)"
t2.upd -> db.state2: "Conflict (0 rows updated)"
db.state2 -> t2.retry: "OptimisticLockException"