direction: right
title: "Hibernate Automatic Dirty Checking & Flush Synchronization"
classes: {
  container: { style: { fill: "#111827"; stroke-width: 2; border-radius: 10 } }
  box: { style: { fill: "#1E293B"; stroke-width: 2; border-radius: 8 } }
  table_box: { style: { fill: "#1E293B"; stroke: "#38bdf8"; stroke-width: 2 } }
  blue_box: { style: { fill: "#1e293b"; stroke: "#38bdf8"; stroke-width: 2; border-radius: 8 } }
  green_box: { style: { fill: "#0f291e"; stroke: "#4ade80"; stroke-width: 2; border-radius: 8 } }
  amber_box: { style: { fill: "#231e12"; stroke: "#fbbf24"; stroke-width: 2; border-radius: 8 } }
  purple_box: { style: { fill: "#1e1b2e"; stroke: "#c084fc"; stroke-width: 2; border-radius: 8 } }
  red_box: { style: { fill: "#2b1111"; stroke: "#f87171"; stroke-width: 2; border-radius: 8 } }
}

app: "Application Service" {
  class: container
  style.fill: "#1e293b"
  style.stroke: "#3b82f6"
  find: "em.find(101L)"
  mutate: "order.setStatus(CONFIRMED)"
  commit: "commit() / flush()"
}

pc: "Persistence Context (L1)" {
  class: container
  style.fill: "#064e3b"
  style.stroke: "#10b981"
  snap: "LoadedState: ['PENDING', 100]"
  diff: "Diff: 'CONFIRMED' != 'PENDING' -> DIRTY!"
}

aq: "ActionQueue" {
  class: container
  style.fill: "#1e293b"
  style.stroke: "#f59e0b"
  sched: "Schedules EntityUpdateAction"
}

db: "PostgreSQL Database" {
  class: container
  style.fill: "#0f172a"
  style.stroke: "#06b6d4"
  sql: "UPDATE orders SET status='CONFIRMED' WHERE id=101"
}

app.find -> pc: "Lookup"
pc -> db: "SELECT"
db -> pc: "Row loaded"
pc.snap -> app.mutate: "Managed instance"
app.commit -> pc.diff: "Trigger flush"
pc.diff -> aq.sched: "Enqueue"
aq.sched -> db.sql: "Execute SQL"