direction: right
title: "Zero-Downtime Database Refactoring: The Expand-Contract Pattern"
classes: {
  container: { style: { fill: "#111827"; stroke-width: 2; border-radius: 10 } }
  box: { style: { fill: "#1E293B"; stroke-width: 2; border-radius: 8 } }
  table_box: { style: { fill: "#1E293B"; stroke: "#38bdf8"; stroke-width: 2 } }
  blue_box: { style: { fill: "#1e293b"; stroke: "#38bdf8"; stroke-width: 2; border-radius: 8 } }
  green_box: { style: { fill: "#0f291e"; stroke: "#4ade80"; stroke-width: 2; border-radius: 8 } }
  amber_box: { style: { fill: "#231e12"; stroke: "#fbbf24"; stroke-width: 2; border-radius: 8 } }
  purple_box: { style: { fill: "#1e1b2e"; stroke: "#c084fc"; stroke-width: 2; border-radius: 8 } }
  red_box: { style: { fill: "#2b1111"; stroke: "#f87171"; stroke-width: 2; border-radius: 8 } }
}

p1: "Phase 1: Expand\nAdd nullable 'full_name'\nDual-write trigger/app logic" {
  style.fill: "#1e293b"
  style.stroke: "#3b82f6"
}

p2: "Phase 2: Backfill\nAsync throttled batch worker\nCopies legacy data in chunks" {
  style.fill: "#1e293b"
  style.stroke: "#06b6d4"
}

p3: "Phase 3: Switch Reads\nDeploy app reading 'full_name'\nWrites still dual-write" {
  style.fill: "#1e293b"
  style.stroke: "#10b981"
}

p4: "Phase 4: Contract\nRemove dual-write logic\nDrop legacy 'name' column" {
  style.fill: "#1e293b"
  style.stroke: "#8b5cf6"
}

p1 -> p2: "Schema Expanded"
p2 -> p3: "100% Backfilled"
p3 -> p4: "Verified in Prod"