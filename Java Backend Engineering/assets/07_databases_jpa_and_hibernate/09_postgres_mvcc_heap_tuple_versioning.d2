direction: right
title: "PostgreSQL MVCC: Physical Heap Tuple Versioning & HOT Chain"
classes: {
  container: { style: { fill: "#111827"; stroke-width: 2; border-radius: 10 } }
  box: { style: { fill: "#1E293B"; stroke-width: 2; border-radius: 8 } }
  table_box: { style: { fill: "#1E293B"; stroke: "#38bdf8"; stroke-width: 2 } }
  blue_box: { style: { fill: "#1e293b"; stroke: "#38bdf8"; stroke-width: 2; border-radius: 8 } }
  green_box: { style: { fill: "#0f291e"; stroke: "#4ade80"; stroke-width: 2; border-radius: 8 } }
  amber_box: { style: { fill: "#231e12"; stroke: "#fbbf24"; stroke-width: 2; border-radius: 8 } }
  purple_box: { style: { fill: "#1e1b2e"; stroke: "#c084fc"; stroke-width: 2; border-radius: 8 } }
  red_box: { style: { fill: "#2b1111"; stroke: "#f87171"; stroke-width: 2; border-radius: 8 } }
}

page: "PostgreSQL 8KB Heap Page (Block 0)" {
  class: container
  style.fill: "#0f172a"
  style.stroke: "#3b82f6"

  t1: "Tuple 1 (Dead Row Version)\nxmin=100 | xmax=105\nt_ctid=(0, 2)\nbalance=100.00" {
    style.fill: "#7f1d1d"
    style.stroke: "#ef4444"
  }

  t2: "Tuple 2 (Live Row Version)\nxmin=105 | xmax=0\nt_ctid=(0, 2)\nbalance=150.00" {
    style.fill: "#064e3b"
    style.stroke: "#10b981"
  }

  t1 -> t2: "t_ctid HOT chain pointer"
}

index: "B+Tree Index on id=1" {
  class: container
  style.fill: "#1e293b"
  style.stroke: "#06b6d4"
}

index -> page.t1: "Points to Tuple 1 ItemId"