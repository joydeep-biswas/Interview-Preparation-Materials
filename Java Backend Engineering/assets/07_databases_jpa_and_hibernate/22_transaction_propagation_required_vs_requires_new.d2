direction: right
title: "Spring Transaction Propagation: REQUIRED vs REQUIRES_NEW"
classes: {
  container: { style: { fill: "#111827"; stroke-width: 2; border-radius: 10 } }
  box: { style: { fill: "#1E293B"; stroke-width: 2; border-radius: 8 } }
  table_box: { style: { fill: "#1E293B"; stroke: "#38bdf8"; stroke-width: 2 } }
  blue_box: { style: { fill: "#1e293b"; stroke: "#38bdf8"; stroke-width: 2; border-radius: 8 } }
  green_box: { style: { fill: "#0f291e"; stroke: "#4ade80"; stroke-width: 2; border-radius: 8 } }
  amber_box: { style: { fill: "#231e12"; stroke: "#fbbf24"; stroke-width: 2; border-radius: 8 } }
  purple_box: { style: { fill: "#1e1b2e"; stroke: "#c084fc"; stroke-width: 2; border-radius: 8 } }
  red_box: { style: { fill: "#2b1111"; stroke: "#f87171"; stroke-width: 2; border-radius: 8 } }
}

svcA: "ServiceA (REQUIRED)\nTx 1 Scope" {
  style.fill: "#1e293b"
  style.stroke: "#3b82f6"
}

pool: "HikariCP Pool" {
  class: container
  style.fill: "#083344"
  style.stroke: "#06b6d4"
}

audit: "AuditService (REQUIRES_NEW)\nTx 2 Scope" {
  style.fill: "#111827"
  style.stroke: "#f59e0b"
}

db: "PostgreSQL Database" {
  class: container
  style.fill: "#0f172a"
  style.stroke: "#10b981"
}

svcA -> pool: "1. Borrows Conn 1 (Tx 1)"
svcA -> db: "2. INSERT orders (Tx 1)"
svcA -> audit: "3. Invokes log() [Suspends Tx 1]"
audit -> pool: "4. Borrows Conn 2 (Tx 2) [DEADLOCK RISK!]"
audit -> db: "5. INSERT audit_log"
audit -> pool: "6. Commit Tx 2 & release Conn 2"
svcA -> pool: "7. Rollback Tx 1 on Exception & release Conn 1"