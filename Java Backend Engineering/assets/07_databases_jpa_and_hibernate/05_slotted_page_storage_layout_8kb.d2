direction: down
title: "Internal 8KB Database Page Anatomy: Slotted Page Architecture"
classes: {
  container: { style: { fill: "#111827"; stroke-width: 2; border-radius: 10 } }
  box: { style: { fill: "#1E293B"; stroke-width: 2; border-radius: 8 } }
  table_box: { style: { fill: "#1E293B"; stroke: "#38bdf8"; stroke-width: 2 } }
  blue_box: { style: { fill: "#1e293b"; stroke: "#38bdf8"; stroke-width: 2; border-radius: 8 } }
  green_box: { style: { fill: "#0f291e"; stroke: "#4ade80"; stroke-width: 2; border-radius: 8 } }
  amber_box: { style: { fill: "#231e12"; stroke: "#fbbf24"; stroke-width: 2; border-radius: 8 } }
  purple_box: { style: { fill: "#1e1b2e"; stroke: "#c084fc"; stroke-width: 2; border-radius: 8 } }
  red_box: { style: { fill: "#2b1111"; stroke: "#f87171"; stroke-width: 2; border-radius: 8 } }
}

page: "Internal 8KB Database Page (8192 Bytes)" {
  class: container
  style.fill: "#0b1329"
  style.stroke: "#3b82f6"

  header: "Page Header (24 bytes: LSN, checksum, free space offsets)"
  ptrs: "Line Pointers / ItemIds (Grows Downwards from offset 24)"
  free: "Free Space Gap (Hole for future row allocations)"
  tuples: "Tuple Storage (Grows Upwards from 8192 byte boundary)"

  header -> ptrs -> free -> tuples
}

immutable_tid: "Tuples can move inside page without breaking external ItemPointer!" {
  class: container
  style.fill: "#064e3b"
  style.stroke: "#10b981"
}

page.tuples -> immutable_tid