direction: right
title: "Spring Transaction Propagation: REQUIRED vs NESTED (Savepoints)"
classes: {
  container: { style: { fill: "#111827"; stroke-width: 2; border-radius: 10 } }
  box: { style: { fill: "#1E293B"; stroke-width: 2; border-radius: 8 } }
  table_box: { style: { fill: "#1E293B"; stroke: "#38bdf8"; stroke-width: 2 } }
  blue_box: { style: { fill: "#1e293b"; stroke: "#38bdf8"; stroke-width: 2; border-radius: 8 } }
  green_box: { style: { fill: "#0f291e"; stroke: "#4ade80"; stroke-width: 2; border-radius: 8 } }
  amber_box: { style: { fill: "#231e12"; stroke: "#fbbf24"; stroke-width: 2; border-radius: 8 } }
  purple_box: { style: { fill: "#1e1b2e"; stroke: "#c084fc"; stroke-width: 2; border-radius: 8 } }
  red_box: { style: { fill: "#2b1111"; stroke: "#f87171"; stroke-width: 2; border-radius: 8 } }
}

runner: "Batch Job Runner" {
  class: container
  style.fill: "#1e293b"
  style.stroke: "#3b82f6"
}

svc: "BatchOrderService (REQUIRED)\nUses 1 Physical Connection" {
  style.fill: "#0f172a"
  style.stroke: "#10b981"
}

pool: "HikariCP Pool" {
  class: container
  style.fill: "#083344"
  style.stroke: "#06b6d4"
}

db: "Database Engine\nJDBC Savepoints" {
  style.fill: "#111827"
  style.stroke: "#f59e0b"
}

runner -> svc: "1. processBatch()"
svc -> pool: "2. Borrows Conn 1"
svc -> db: "3. SAVEPOINT item_1"
svc -> db: "4. INSERT item 1 (Success)"
svc -> db: "5. SAVEPOINT item_2"
svc -> db: "6. ROLLBACK TO SAVEPOINT item_2 (Failed)"
svc -> db: "7. COMMIT Tx 1"
svc -> pool: "8. Return Conn 1"