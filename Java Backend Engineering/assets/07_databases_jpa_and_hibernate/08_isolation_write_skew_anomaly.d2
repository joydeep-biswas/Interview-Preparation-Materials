direction: right
title: "Isolation Anomaly: Write Skew Under Repeatable Read"
classes: {
  container: { style: { fill: "#111827"; stroke-width: 2; border-radius: 10 } }
  box: { style: { fill: "#1E293B"; stroke-width: 2; border-radius: 8 } }
  table_box: { style: { fill: "#1E293B"; stroke: "#38bdf8"; stroke-width: 2 } }
  blue_box: { style: { fill: "#1e293b"; stroke: "#38bdf8"; stroke-width: 2; border-radius: 8 } }
  green_box: { style: { fill: "#0f291e"; stroke: "#4ade80"; stroke-width: 2; border-radius: 8 } }
  amber_box: { style: { fill: "#231e12"; stroke: "#fbbf24"; stroke-width: 2; border-radius: 8 } }
  purple_box: { style: { fill: "#1e1b2e"; stroke: "#c084fc"; stroke-width: 2; border-radius: 8 } }
  red_box: { style: { fill: "#2b1111"; stroke: "#f87171"; stroke-width: 2; border-radius: 8 } }
}

alice: "Dr. Alice (Tx 1: Repeatable Read)" {
  class: container
  style.fill: "#1e293b"
  style.stroke: "#3b82f6"
  read: "1. Read Count=2 (Safe)"
  write: "3. Set Alice=off & Commit"
}

db: "Hospital Database Engine" {
  class: container
  style.fill: "#0f172a"
  style.stroke: "#ef4444"
  inv: "Invariant: Count >= 1"
  violation: "CRITICAL: Count = 0 (Write Skew Anomaly!)"
}

bob: "Dr. Bob (Tx 2: Repeatable Read)" {
  class: container
  style.fill: "#1e293b"
  style.stroke: "#f59e0b"
  read: "2. Read Count=2 (Safe)"
  write: "4. Set Bob=off & Commit"
}

alice.read -> db.inv: "Sees 2 on call"
bob.read -> db.inv: "Sees 2 on call"
alice.write -> db.violation: "Commits (No row conflict)"
bob.write -> db.violation: "Commits (No row conflict)"