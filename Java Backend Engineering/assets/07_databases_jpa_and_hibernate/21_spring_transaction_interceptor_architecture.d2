direction: right
title: "Spring AOP Transaction Interceptor Architecture"
classes: {
  container: { style: { fill: "#111827"; stroke-width: 2; border-radius: 10 } }
  box: { style: { fill: "#1E293B"; stroke-width: 2; border-radius: 8 } }
  table_box: { style: { fill: "#1E293B"; stroke: "#38bdf8"; stroke-width: 2 } }
  blue_box: { style: { fill: "#1e293b"; stroke: "#38bdf8"; stroke-width: 2; border-radius: 8 } }
  green_box: { style: { fill: "#0f291e"; stroke: "#4ade80"; stroke-width: 2; border-radius: 8 } }
  amber_box: { style: { fill: "#231e12"; stroke: "#fbbf24"; stroke-width: 2; border-radius: 8 } }
  purple_box: { style: { fill: "#1e1b2e"; stroke: "#c084fc"; stroke-width: 2; border-radius: 8 } }
  red_box: { style: { fill: "#2b1111"; stroke: "#f87171"; stroke-width: 2; border-radius: 8 } }
}

caller: "External Caller\nController / Listener" {
  style.fill: "#1e293b"
  style.stroke: "#3b82f6"
}

proxy: "CGLIB Proxy\nOrderService\$\$SpringCGLIB\nInspects @Transactional" {
  style.fill: "#0f172a"
  style.stroke: "#10b981"
}

interceptor: "TransactionInterceptor\ninvokeWithinTransaction()\nManages advice chain" {
  style.fill: "#111827"
  style.stroke: "#f59e0b"
}

txmgr: "PlatformTransactionManager\nAcquires DB Connection\nBinds to ThreadLocal" {
  style.fill: "#083344"
  style.stroke: "#06b6d4"
}

target: "Target Service Method\nOrderService.placeOrder()\nExecutes Business Logic" {
  style.fill: "#1e293b"
  style.stroke: "#8b5cf6"
}

caller -> proxy: "1. Calls placeOrder()"
proxy -> interceptor: "2. Delegates to AOP Advice"
interceptor -> txmgr: "3. Begin Tx / Get Conn"
txmgr -> target: "4. Execute Target Method"
target -> interceptor: "5. Return / Throw"
interceptor -> txmgr: "6. Commit or Rollback"