direction: right
title: "Parallel Stream Execution: Fork-Join Spliterator & Work-Stealing"
classes: {
  container: { style: { fill: "#111827"; stroke-width: 2; border-radius: 10 } }
  box: { style: { fill: "#1E293B"; stroke-width: 2; border-radius: 8 } }
  table_box: { style: { fill: "#1E293B"; stroke: "#38bdf8"; stroke-width: 2 } }
  blue_box: { style: { fill: "#1e293b"; stroke: "#38bdf8"; stroke-width: 2; border-radius: 8 } }
  green_box: { style: { fill: "#0f291e"; stroke: "#4ade80"; stroke-width: 2; border-radius: 8 } }
  amber_box: { style: { fill: "#231e12"; stroke: "#fbbf24"; stroke-width: 2; border-radius: 8 } }
  purple_box: { style: { fill: "#1e1b2e"; stroke: "#c084fc"; stroke-width: 2; border-radius: 8 } }
  red_box: { style: { fill: "#2b1111"; stroke: "#f87171"; stroke-width: 2; border-radius: 8 } }
}

Dataset: "Parallel Stream (10,000,000 Records)"

ForkPhase: "1. Fork Phase (Spliterator)" {
  class: container
  style.fill: "#0B132B"
  style.stroke: "#0284C7"
  split: "Spliterator.trySplit() recursively divides data in O(1)"
  chunks: "Generates balanced sub-chunks down to threshold"
}

Execution: "2. ForkJoinPool Workers" {
  class: container
  style.fill: "#1C1917"
  style.stroke: "#F59E0B"
  workers: "Worker-1..4 process chunks concurrently"
  stealing: "Work-Stealing: idle threads steal from tails of busy deques"
}

JoinPhase: "3. Join Phase (Reduction)" {
  class: container
  style.fill: "#06201B"
  style.stroke: "#047857"
  merge: "Binary associative reduction combines partial results"
  rule: "NQ Model: N*Q > 10,000; strictly CPU-bound only (no blocking I/O)"
}

Dataset -> ForkPhase
ForkPhase -> Execution
Execution -> JoinPhase