direction: right
title: "Java Stream Pipeline Lazy Evaluation & Sink Chaining Architecture"
classes: {
  container: { style: { fill: "#111827"; stroke-width: 2; border-radius: 10 } }
  box: { style: { fill: "#1E293B"; stroke-width: 2; border-radius: 8 } }
  table_box: { style: { fill: "#1E293B"; stroke: "#38bdf8"; stroke-width: 2 } }
  blue_box: { style: { fill: "#1e293b"; stroke: "#38bdf8"; stroke-width: 2; border-radius: 8 } }
  green_box: { style: { fill: "#0f291e"; stroke: "#4ade80"; stroke-width: 2; border-radius: 8 } }
  amber_box: { style: { fill: "#231e12"; stroke: "#fbbf24"; stroke-width: 2; border-radius: 8 } }
  purple_box: { style: { fill: "#1e1b2e"; stroke: "#c084fc"; stroke-width: 2; border-radius: 8 } }
  red_box: { style: { fill: "#2b1111"; stroke: "#f87171"; stroke-width: 2; border-radius: 8 } }
}

Stage1: "Stage 1 Pipeline Declaration (Lazy)" {
  class: container
  style.fill: "#0B132B"
  style.stroke: "#0284C7"
  source: "orders.stream() [Spliterator]"
  f1: ".filter(Order::isPaid) [Stateless Sink]"
  m1: ".map(Order::getTotal) [Stateless Sink]"
  lazy: "Zero computation occurs until terminal operation!"
}

Stage2: "Stage 2 Terminal Evaluation (Eager)" {
  class: container
  style.fill: "#06201B"
  style.stroke: "#047857"
  terminal: ".collect(Collectors.toList()) triggers pipeline"
  fusion: "Loop Fusion: Each item passes horizontally through filter -> map -> collect"
  efficiency: "No intermediate collections allocated; single pass over data"
}

Stage1 -> Stage2: "Terminal op triggers execution"