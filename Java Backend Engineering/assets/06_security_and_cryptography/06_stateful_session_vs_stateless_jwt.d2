direction: right
title: "Stateful Session vs Stateless JWT Architecture"
classes: {
  container: { style: { fill: "#111827"; stroke-width: 2; border-radius: 10 } }
  box: { style: { fill: "#1E293B"; stroke-width: 2; border-radius: 8 } }
  table_box: { style: { fill: "#1E293B"; stroke: "#38bdf8"; stroke-width: 2 } }
  blue_box: { style: { fill: "#1e293b"; stroke: "#38bdf8"; stroke-width: 2; border-radius: 8 } }
  green_box: { style: { fill: "#0f291e"; stroke: "#4ade80"; stroke-width: 2; border-radius: 8 } }
  amber_box: { style: { fill: "#231e12"; stroke: "#fbbf24"; stroke-width: 2; border-radius: 8 } }
  purple_box: { style: { fill: "#1e1b2e"; stroke: "#c084fc"; stroke-width: 2; border-radius: 8 } }
  red_box: { style: { fill: "#2b1111"; stroke: "#f87171"; stroke-width: 2; border-radius: 8 } }
}

Stateful: "Stateful Session (Legacy Monolith)" {
  class: container
  style.fill: "#1C1917"
  style.stroke: "#EF4444"
  client: "Browser sends JSESSIONID cookie"
  server: "Tomcat heap table lookup"
  issue: "Requires sticky sessions; breaks horizontal scaling"
}

Stateless: "Stateless JWT (Cloud Microservices)" {
  class: container
  style.fill: "#06201B"
  style.stroke: "#10B981"
  client: "Client sends Authorization: Bearer JWT"
  server: "Cryptographic signature check via cached JWKS"
  advantage: "Zero DB lookups; unlimited horizontal K8s scaling"
}