direction: right
title: "PKI Certificate Chain & TrustStore Architecture"
classes: {
  container: { style: { fill: "#111827"; stroke-width: 2; border-radius: 10 } }
  box: { style: { fill: "#1E293B"; stroke-width: 2; border-radius: 8 } }
  table_box: { style: { fill: "#1E293B"; stroke: "#38bdf8"; stroke-width: 2 } }
  blue_box: { style: { fill: "#1e293b"; stroke: "#38bdf8"; stroke-width: 2; border-radius: 8 } }
  green_box: { style: { fill: "#0f291e"; stroke: "#4ade80"; stroke-width: 2; border-radius: 8 } }
  amber_box: { style: { fill: "#231e12"; stroke: "#fbbf24"; stroke-width: 2; border-radius: 8 } }
  purple_box: { style: { fill: "#1e1b2e"; stroke: "#c084fc"; stroke-width: 2; border-radius: 8 } }
  red_box: { style: { fill: "#2b1111"; stroke: "#f87171"; stroke-width: 2; border-radius: 8 } }
}

RootCA: "1. Root CA (DigiCert / Let's Encrypt)" {
  class: container
  style.fill: "#0B132B"
  style.stroke: "#0284C7"
  cert: "Self-Signed Root Certificate"
  store: "Java TrustStore (\$JAVA_HOME/lib/security/cacerts)"
}

InterCA: "2. Intermediate CA (R3)" {
  class: container
  style.fill: "#06201B"
  style.stroke: "#10B981"
  cert: "Signed by Root CA"
  role: "Isolates Root CA; handles routine signing"
}

LeafCert: "3. Server Leaf Certificate (*.company.com)" {
  class: container
  style.fill: "#1C1917"
  style.stroke: "#F59E0B"
  cert: "Signed by Intermediate CA"
  store: "Spring Boot KeyStore (keystore.p12)"
}

RootCA -> InterCA: "Signs with Root Private Key" { style.stroke: "#38BDF8" }
InterCA -> LeafCert: "Signs with Intermediate Private Key" { style.stroke: "#10B981" }
LeafCert -> RootCA: "Client validates signature path back to TrustStore" { style.stroke: "#F59E0B" }