direction: right
title: "Spring Security Authentication Flow: Manager & Provider Architecture"
classes: {
  container: { style: { fill: "#111827"; stroke-width: 2; border-radius: 10 } }
  box: { style: { fill: "#1E293B"; stroke-width: 2; border-radius: 8 } }
  table_box: { style: { fill: "#1E293B"; stroke: "#38bdf8"; stroke-width: 2 } }
  blue_box: { style: { fill: "#1e293b"; stroke: "#38bdf8"; stroke-width: 2; border-radius: 8 } }
  green_box: { style: { fill: "#0f291e"; stroke: "#4ade80"; stroke-width: 2; border-radius: 8 } }
  amber_box: { style: { fill: "#231e12"; stroke: "#fbbf24"; stroke-width: 2; border-radius: 8 } }
  purple_box: { style: { fill: "#1e1b2e"; stroke: "#c084fc"; stroke-width: 2; border-radius: 8 } }
  red_box: { style: { fill: "#2b1111"; stroke: "#f87171"; stroke-width: 2; border-radius: 8 } }
}

Filter: "1. AuthenticationFilter" {
  class: container
  style.fill: "#0B132B"
  style.stroke: "#0284C7"
  token: "Creates unauthenticated UsernamePasswordAuthenticationToken"
}

Manager: "2. AuthenticationManager (ProviderManager)" {
  class: container
  style.fill: "#06201B"
  style.stroke: "#10B981"
  p1: "DaoAuthenticationProvider (DB + BCrypt)"
  p2: "JwtAuthenticationProvider (JWKS + RS256)"
  p3: "LdapAuthenticationProvider (Active Directory)"
}

Success: "Authentication Success" {
  class: container
  style.fill: "#06201B"
  style.stroke: "#10B981"
  result: "GrantedAuthorities populated -> SecurityContextHolder"
}

Failure: "Authentication Failure" {
  class: container
  style.fill: "#1C1917"
  style.stroke: "#EF4444"
  error: "BadCredentialsException -> HTTP 401 Unauthorized"
}

Filter -> Manager: "Delegates token authentication" { style.stroke: "#38BDF8" }
Manager.p2 -> Success: "Credentials valid" { style.stroke: "#10B981" }
Manager.p1 -> Failure: "Bad password" { style.stroke: "#EF4444" }