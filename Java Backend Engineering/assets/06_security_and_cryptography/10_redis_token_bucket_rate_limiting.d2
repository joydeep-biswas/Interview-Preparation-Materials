direction: right
title: "Distributed Token Bucket Rate Limiting Architecture via Redis"
classes: {
  container: { style: { fill: "#111827"; stroke-width: 2; border-radius: 10 } }
  box: { style: { fill: "#1E293B"; stroke-width: 2; border-radius: 8 } }
  table_box: { style: { fill: "#1E293B"; stroke: "#38bdf8"; stroke-width: 2 } }
  blue_box: { style: { fill: "#1e293b"; stroke: "#38bdf8"; stroke-width: 2; border-radius: 8 } }
  green_box: { style: { fill: "#0f291e"; stroke: "#4ade80"; stroke-width: 2; border-radius: 8 } }
  amber_box: { style: { fill: "#231e12"; stroke: "#fbbf24"; stroke-width: 2; border-radius: 8 } }
  purple_box: { style: { fill: "#1e1b2e"; stroke: "#c084fc"; stroke-width: 2; border-radius: 8 } }
  red_box: { style: { fill: "#2b1111"; stroke: "#f87171"; stroke-width: 2; border-radius: 8 } }
}

Client: "Client Ingress (POST /api/auth/login)"
Filter: "RateLimitingFilter (OncePerRequestFilter)"
Redis: "Redis Cluster (Token Bucket Lua Script)"
Decision: "Tokens Available?" { shape: diamond }
  class: container

Allow: "HTTP 200 / Forward Request (X-RateLimit headers)"
Deny: "HTTP 429 Too Many Requests (Retry-After header)"

Client -> Filter: "Ingress request" { style.stroke: "#38BDF8" }
Filter -> Redis: "Evaluates token bucket" { style.stroke: "#10B981" }
Redis -> Decision: "Returns available count" { style.stroke: "#8B5CF6" }
Decision -> Allow: "Yes (Consume 1 token)" { style.stroke: "#10B981" }
Decision -> Deny: "No (Bucket empty)" { style.stroke: "#EF4444" }