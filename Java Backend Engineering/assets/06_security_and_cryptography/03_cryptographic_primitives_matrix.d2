direction: right
title: "The Four Core Cryptographic Primitives"
classes: {
  container: { style: { fill: "#111827"; stroke-width: 2; border-radius: 10 } }
  box: { style: { fill: "#1E293B"; stroke-width: 2; border-radius: 8 } }
  table_box: { style: { fill: "#1E293B"; stroke: "#38bdf8"; stroke-width: 2 } }
  blue_box: { style: { fill: "#1e293b"; stroke: "#38bdf8"; stroke-width: 2; border-radius: 8 } }
  green_box: { style: { fill: "#0f291e"; stroke: "#4ade80"; stroke-width: 2; border-radius: 8 } }
  amber_box: { style: { fill: "#231e12"; stroke: "#fbbf24"; stroke-width: 2; border-radius: 8 } }
  purple_box: { style: { fill: "#1e1b2e"; stroke: "#c084fc"; stroke-width: 2; border-radius: 8 } }
  red_box: { style: { fill: "#2b1111"; stroke: "#f87171"; stroke-width: 2; border-radius: 8 } }
}

Sym: "1. Symmetric Encryption (AES-256-GCM)" {
  class: container
  style.fill: "#0B132B"
  style.stroke: "#0284C7"
  key: "Single shared secret key K"
  use: "Data at rest (DB), high-speed bulk TLS channel"
}

Asym: "2. Asymmetric Key Pairs (RSA / ECC)" {
  class: container
  style.fill: "#06201B"
  style.stroke: "#10B981"
  keys: "Public key (encrypt/verify) + Private key (decrypt/sign)"
  use: "TLS handshake, JWT RS256, X.509 digital certificates"
}

Hash: "3. Cryptographic Hash (SHA-256)" {
  class: container
  style.fill: "#1C1917"
  style.stroke: "#F59E0B"
  property: "One-way irreversible 256-bit fixed digest"
  use: "File checksums, Git commit SHA, content addressing"
}

Hmac: "4. HMAC Authentication (HMAC-SHA256)" {
  class: container
  style.fill: "#1E1B4B"
  style.stroke: "#8B5CF6"
  property: "Message + shared secret -> tamper-proof MAC tag"
  use: "Webhook verification (Stripe/GitHub), JWT HS256"
}