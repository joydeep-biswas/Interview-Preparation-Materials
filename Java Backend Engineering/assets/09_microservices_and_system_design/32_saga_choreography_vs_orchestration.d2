direction: down
title: "Saga Pattern: Choreography vs Orchestration Architecture"
classes: {
  container: { style: { fill: "#111827"; stroke-width: 2; border-radius: 10 } }
  box: { style: { fill: "#1E293B"; stroke-width: 2; border-radius: 8 } }
  table_box: { style: { fill: "#1E293B"; stroke: "#38bdf8"; stroke-width: 2 } }
  blue_box: { style: { fill: "#1e293b"; stroke: "#38bdf8"; stroke-width: 2; border-radius: 8 } }
  green_box: { style: { fill: "#0f291e"; stroke: "#4ade80"; stroke-width: 2; border-radius: 8 } }
  amber_box: { style: { fill: "#231e12"; stroke: "#fbbf24"; stroke-width: 2; border-radius: 8 } }
  purple_box: { style: { fill: "#1e1b2e"; stroke: "#c084fc"; stroke-width: 2; border-radius: 8 } }
  red_box: { style: { fill: "#2b1111"; stroke: "#f87171"; stroke-width: 2; border-radius: 8 } }
}

choreography: "1. Saga Choreography (Decentralized Events)" {
  class: container
  style.fill: "#0b1329"
  style.stroke: "#3b82f6"

  o1: "Order Service"
  p1: "Payment Service"
  i1: "Inventory Service"
  s1: "Shipping Service"

  o1 -> p1: "OrderCreated"
  p1 -> i1: "PaymentCharged"
  i1 -> s1: "StockReserved"
}

orchestration: "2. Saga Orchestration (Centralized State Machine)" {
  class: container
  style.fill: "#062e24"
  style.stroke: "#10b981"

  orch: "OrderSagaOrchestrator\nTracks state in SagaLog" {
    style.fill: "#111827"
    style.stroke: "#f59e0b"
  }
  p2: "Payment Service"
  i2: "Inventory Service"
  s2: "Shipping Service"

  orch -> p2: "Command: Charge"
  orch -> i2: "Command: Reserve"
  orch -> s2: "Command: Ship"
}