direction: down
title: "Single Responsibility Principle (SRP): Cohesive Decomposition"
classes: {
  container: { style: { fill: "#111827"; stroke-width: 2; border-radius: 10 } }
  box: { style: { fill: "#1E293B"; stroke-width: 2; border-radius: 8 } }
  table_box: { style: { fill: "#1E293B"; stroke: "#38bdf8"; stroke-width: 2 } }
  blue_box: { style: { fill: "#1e293b"; stroke: "#38bdf8"; stroke-width: 2; border-radius: 8 } }
  green_box: { style: { fill: "#0f291e"; stroke: "#4ade80"; stroke-width: 2; border-radius: 8 } }
  amber_box: { style: { fill: "#231e12"; stroke: "#fbbf24"; stroke-width: 2; border-radius: 8 } }
  purple_box: { style: { fill: "#1e1b2e"; stroke: "#c084fc"; stroke-width: 2; border-radius: 8 } }
  red_box: { style: { fill: "#2b1111"; stroke: "#f87171"; stroke-width: 2; border-radius: 8 } }
}

processor: "OrderProcessor\nSingle Responsibility: Orchestration\nprocessOrder(request)" {
  style.fill: "#1e1b4b"
  style.stroke: "#8b5cf6"
}

val: "OrderValidator\nValidation rules" {
  style.fill: "#1e293b"
  style.stroke: "#3b82f6"
}
repo: "OrderRepository\nPersistence rules" {
  style.fill: "#1e293b"
  style.stroke: "#10b981"
}
pay: "PaymentGatewayClient\nStripe API integration" {
  style.fill: "#1e293b"
  style.stroke: "#f59e0b"
}
notif: "NotificationService\nCustomer receipts" {
  style.fill: "#1e293b"
  style.stroke: "#06b6d4"
}

processor -> val: "1. validates"
processor -> repo: "2. saves"
processor -> pay: "3. charges"
processor -> notif: "4. notifies"