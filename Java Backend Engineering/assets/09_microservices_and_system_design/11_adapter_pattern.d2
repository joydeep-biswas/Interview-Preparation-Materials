direction: right
title: "Adapter Pattern: Bridging Incompatible Interfaces"
classes: {
  container: { style: { fill: "#111827"; stroke-width: 2; border-radius: 10 } }
  box: { style: { fill: "#1E293B"; stroke-width: 2; border-radius: 8 } }
  table_box: { style: { fill: "#1E293B"; stroke: "#38bdf8"; stroke-width: 2 } }
  blue_box: { style: { fill: "#1e293b"; stroke: "#38bdf8"; stroke-width: 2; border-radius: 8 } }
  green_box: { style: { fill: "#0f291e"; stroke: "#4ade80"; stroke-width: 2; border-radius: 8 } }
  amber_box: { style: { fill: "#231e12"; stroke: "#fbbf24"; stroke-width: 2; border-radius: 8 } }
  purple_box: { style: { fill: "#1e1b2e"; stroke: "#c084fc"; stroke-width: 2; border-radius: 8 } }
  red_box: { style: { fill: "#2b1111"; stroke: "#f87171"; stroke-width: 2; border-radius: 8 } }
}

client: "CheckoutService" {
  class: container
  style.fill: "#0f172a"
  style.stroke: "#3b82f6"
}

target: "PaymentGateway <<interface>>\n+charge(customerId, cents)" {
  style.fill: "#064e3b"
  style.stroke: "#10b981"
}

adapter: "LegacyBankingAdapter\nConverts cents -> dollars\nFormats SOAP XML" {
  style.fill: "#111827"
  style.stroke: "#f59e0b"
}

adaptee: "LegacySoapBankingClient\n+submitDebitTransaction(acc, dollars)" {
  style.fill: "#1a1118"
  style.stroke: "#ef4444"
}

client -> target: "1. Calls clean API"
adapter -> target: "implements"
adapter -> adaptee: "2. Translates to SOAP"