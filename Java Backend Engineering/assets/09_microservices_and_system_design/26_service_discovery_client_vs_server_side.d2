direction: right
title: "Service Discovery: Client-Side vs Server-Side Architecture"
classes: {
  container: { style: { fill: "#111827"; stroke-width: 2; border-radius: 10 } }
  box: { style: { fill: "#1E293B"; stroke-width: 2; border-radius: 8 } }
  table_box: { style: { fill: "#1E293B"; stroke: "#38bdf8"; stroke-width: 2 } }
  blue_box: { style: { fill: "#1e293b"; stroke: "#38bdf8"; stroke-width: 2; border-radius: 8 } }
  green_box: { style: { fill: "#0f291e"; stroke: "#4ade80"; stroke-width: 2; border-radius: 8 } }
  amber_box: { style: { fill: "#231e12"; stroke: "#fbbf24"; stroke-width: 2; border-radius: 8 } }
  purple_box: { style: { fill: "#1e1b2e"; stroke: "#c084fc"; stroke-width: 2; border-radius: 8 } }
  red_box: { style: { fill: "#2b1111"; stroke: "#f87171"; stroke-width: 2; border-radius: 8 } }
}

client_side: "Client-Side Discovery (Eureka)" {
  class: container
  style.fill: "#0f172a"
  style.stroke: "#3b82f6"

  c_client: "Client App"
  eureka: "Eureka Registry"
  targets: "Service Instances (Direct Hop)"

  c_client -> eureka: "1. Query registry"
  eureka -> c_client: "2. Return IPs"
  c_client -> targets: "3. Direct RPC"
}

server_side: "Server-Side Discovery (Kubernetes)" {
  class: container
  style.fill: "#062e24"
  style.stroke: "#10b981"

  s_client: "Client App"
  k8s_svc: "K8s Service / Virtual IP"
  pods: "Pods (Endpoints)"

  s_client -> k8s_svc: "1. Calls DNS hostname"
  k8s_svc -> pods: "2. Proxies to Pod"
}