direction: down
title: "Factory Method & Abstract Factory: Decoupled Object Creation"
classes: {
  container: { style: { fill: "#111827"; stroke-width: 2; border-radius: 10 } }
  box: { style: { fill: "#1E293B"; stroke-width: 2; border-radius: 8 } }
  table_box: { style: { fill: "#1E293B"; stroke: "#38bdf8"; stroke-width: 2 } }
  blue_box: { style: { fill: "#1e293b"; stroke: "#38bdf8"; stroke-width: 2; border-radius: 8 } }
  green_box: { style: { fill: "#0f291e"; stroke: "#4ade80"; stroke-width: 2; border-radius: 8 } }
  amber_box: { style: { fill: "#231e12"; stroke: "#fbbf24"; stroke-width: 2; border-radius: 8 } }
  purple_box: { style: { fill: "#1e1b2e"; stroke: "#c084fc"; stroke-width: 2; border-radius: 8 } }
  red_box: { style: { fill: "#2b1111"; stroke: "#f87171"; stroke-width: 2; border-radius: 8 } }
}

client: "NotificationService" {
  class: container
  style.fill: "#0f172a"
  style.stroke: "#3b82f6"
}

factory: "NotificationFactory\n+create(channel): Notification" {
  class: container
  style.fill: "#111827"
  style.stroke: "#f59e0b"
}

iface: "Notification <<interface>>\n+send(recipient, message)" {
  style.fill: "#064e3b"
  style.stroke: "#10b981"
}

email: "EmailNotification\nSendGrid SMTP" {
  style.fill: "#1e293b"
  style.stroke: "#f59e0b"
}
sms: "SmsNotification\nTwilio SMS API" {
  style.fill: "#1e293b"
  style.stroke: "#06b6d4"
}
push: "PushNotification\nFirebase Cloud Messaging" {
  style.fill: "#1e293b"
  style.stroke: "#10b981"
}

client -> factory: "1. Requests notification"
factory -> iface: "2. Produces instance"
iface <- email: "implements"
iface <- sms: "implements"
iface <- push: "implements"