direction: right
title: "API Idempotency & Distributed Deduplication via Redis Lease Locks"
classes: {
  container: { style: { fill: "#111827"; stroke-width: 2; border-radius: 10 } }
  box: { style: { fill: "#1E293B"; stroke-width: 2; border-radius: 8 } }
  table_box: { style: { fill: "#1E293B"; stroke: "#38bdf8"; stroke-width: 2 } }
  blue_box: { style: { fill: "#1e293b"; stroke: "#38bdf8"; stroke-width: 2; border-radius: 8 } }
  green_box: { style: { fill: "#0f291e"; stroke: "#4ade80"; stroke-width: 2; border-radius: 8 } }
  amber_box: { style: { fill: "#231e12"; stroke: "#fbbf24"; stroke-width: 2; border-radius: 8 } }
  purple_box: { style: { fill: "#1e1b2e"; stroke: "#c084fc"; stroke-width: 2; border-radius: 8 } }
  red_box: { style: { fill: "#2b1111"; stroke: "#f87171"; stroke-width: 2; border-radius: 8 } }
}

client: "Client App" {
  class: container
  style.fill: "#1e293b"
  style.stroke: "#3b82f6"
}
gw: "Idempotency Interceptor\nSpring HandlerInterceptor" {
  style.fill: "#083344"
  style.stroke: "#06b6d4"
}
redis: "Redis Cluster\nAtomic SETNX & Cache" {
  style.fill: "#111827"
  style.stroke: "#f59e0b"
}
db: "PostgreSQL Database\nACID Order Storage" {
  style.fill: "#064e3b"
  style.stroke: "#10b981"
}

client -> gw: "1. POST (Idempotency-Key: uuid-101)"
gw -> redis: "2. SETNX uuid-101 IN_PROGRESS"
redis -> gw: "Lock acquired"
gw -> db: "3. INSERT order (9042)"
gw -> redis: "4. Cache {orderId: 9042}"
gw -> client: "5. 201 Created"

client -> gw: "6. RETRY with same uuid-101"
gw -> redis: "7. GET uuid-101"
redis -> gw: "Cached {orderId: 9042}"
gw -> client: "8. 200 OK from Cache (No DB hit!)"