direction: right
title: "System Design: Real-Time Priority Notification & Dispatch Mesh"
classes: {
  container: { style: { fill: "#111827"; stroke-width: 2; border-radius: 10 } }
  box: { style: { fill: "#1E293B"; stroke-width: 2; border-radius: 8 } }
  table_box: { style: { fill: "#1E293B"; stroke: "#38bdf8"; stroke-width: 2 } }
  blue_box: { style: { fill: "#1e293b"; stroke: "#38bdf8"; stroke-width: 2; border-radius: 8 } }
  green_box: { style: { fill: "#0f291e"; stroke: "#4ade80"; stroke-width: 2; border-radius: 8 } }
  amber_box: { style: { fill: "#231e12"; stroke: "#fbbf24"; stroke-width: 2; border-radius: 8 } }
  purple_box: { style: { fill: "#1e1b2e"; stroke: "#c084fc"; stroke-width: 2; border-radius: 8 } }
  red_box: { style: { fill: "#2b1111"; stroke: "#f87171"; stroke-width: 2; border-radius: 8 } }
}

ingress: "1. Ingress & Deduplication\nNotification Gateway\nRedis Dedup (5m TTL)" {
  style.fill: "#0f172a"
  style.stroke: "#3b82f6"
}

kafka: "2. Priority Kafka Mesh" {
  class: container
  style.fill: "#111827"
  style.stroke: "#f59e0b"

  otp: "High: 'notif-otp-urgent'\nSLA < 1.5s" {
    style.fill: "#450a0a"
    style.stroke: "#ef4444"
  }
  order: "Medium: 'notif-order-status'\nSLA < 30s" {
    style.fill: "#083344"
    style.stroke: "#06b6d4"
  }
  bulk: "Bulk: 'notif-promotions'\nThrottled" {
    style.fill: "#1e1b4b"
    style.stroke: "#8b5cf6"
  }
}

dispatch: "3. Channel Vendor Dispatch\nAPNs / FCM (Push)\nTwilio / SNS (SMS)\nSendGrid (Email)" {
  style.fill: "#062e24"
  style.stroke: "#10b981"
}

ingress -> kafka: "Routes by Priority"
kafka -> dispatch: "Consumes & Dispatches"