direction: down
title: "Facade Pattern: Simplified Coordinated Subsystem Entry Point"
classes: {
  container: { style: { fill: "#111827"; stroke-width: 2; border-radius: 10 } }
  box: { style: { fill: "#1E293B"; stroke-width: 2; border-radius: 8 } }
  table_box: { style: { fill: "#1E293B"; stroke: "#38bdf8"; stroke-width: 2 } }
  blue_box: { style: { fill: "#1e293b"; stroke: "#38bdf8"; stroke-width: 2; border-radius: 8 } }
  green_box: { style: { fill: "#0f291e"; stroke: "#4ade80"; stroke-width: 2; border-radius: 8 } }
  amber_box: { style: { fill: "#231e12"; stroke: "#fbbf24"; stroke-width: 2; border-radius: 8 } }
  purple_box: { style: { fill: "#1e1b2e"; stroke: "#c084fc"; stroke-width: 2; border-radius: 8 } }
  red_box: { style: { fill: "#2b1111"; stroke: "#f87171"; stroke-width: 2; border-radius: 8 } }
}

client: "OrderController\nCalls fulfillOrder()" {
  style.fill: "#0f172a"
  style.stroke: "#3b82f6"
}

facade: "OrderFulfillmentFacade\nCoordinates 4 subsystems\nHandles errors & rollbacks" {
  style.fill: "#111827"
  style.stroke: "#f59e0b"
}

s1: "InventoryService\nreserveStock()" {
  style.fill: "#1e293b"
  style.stroke: "#3b82f6"
}
s2: "PaymentService\ncharge()" {
  style.fill: "#1e293b"
  style.stroke: "#10b981"
}
s3: "ShippingService\ncreateShipment()" {
  style.fill: "#1e293b"
  style.stroke: "#f59e0b"
}
s4: "NotificationService\nsendConfirmation()" {
  style.fill: "#1e293b"
  style.stroke: "#06b6d4"
}

client -> facade: "1. Fulfill Order"
facade -> s1: "2. Reserve stock"
facade -> s2: "3. Charge card"
facade -> s3: "4. Create shipment"
facade -> s4: "5. Send email"