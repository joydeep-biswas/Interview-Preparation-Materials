direction: right
title: "System Design: Stripe Payment Processing & Idempotent Webhook Architecture"
classes: {
  container: { style: { fill: "#111827"; stroke-width: 2; border-radius: 10 } }
  box: { style: { fill: "#1E293B"; stroke-width: 2; border-radius: 8 } }
  table_box: { style: { fill: "#1E293B"; stroke: "#38bdf8"; stroke-width: 2 } }
  blue_box: { style: { fill: "#1e293b"; stroke: "#38bdf8"; stroke-width: 2; border-radius: 8 } }
  green_box: { style: { fill: "#0f291e"; stroke: "#4ade80"; stroke-width: 2; border-radius: 8 } }
  amber_box: { style: { fill: "#231e12"; stroke: "#fbbf24"; stroke-width: 2; border-radius: 8 } }
  purple_box: { style: { fill: "#1e1b2e"; stroke: "#c084fc"; stroke-width: 2; border-radius: 8 } }
  red_box: { style: { fill: "#2b1111"; stroke: "#f87171"; stroke-width: 2; border-radius: 8 } }
}

client: "1. Client Submission\nIdempotency-Key: ord-8102" {
  class: container
  style.fill: "#0f172a"
  style.stroke: "#3b82f6"
}

svc: "2. Payment Service\nRedis Lock + Ledger Hold\nDebit: Receivable | Credit: Escrow" {
  class: container
  style.fill: "#111827"
  style.stroke: "#f59e0b"
}

stripe: "3. Stripe Cloud\nAuthorizes card\nEmits payment_intent.succeeded" {
  style.fill: "#083344"
  style.stroke: "#06b6d4"
}

webhook: "4. Webhook Receiver\nVerifies HMAC-SHA256 signature\nPosts Final Settlement Journal" {
  style.fill: "#062e24"
  style.stroke: "#10b981"
}

client -> svc: "1. Checkout"
svc -> stripe: "2. Create PaymentIntent"
stripe -> webhook: "3. Webhook (Signature verified)"
webhook -> svc: "4. Settles Ledger"