direction: down
title: "Strategy Pattern: Encapsulated Swappable Tax Calculation Algorithms"
classes: {
  container: { style: { fill: "#111827"; stroke-width: 2; border-radius: 10 } }
  box: { style: { fill: "#1E293B"; stroke-width: 2; border-radius: 8 } }
  table_box: { style: { fill: "#1E293B"; stroke: "#38bdf8"; stroke-width: 2 } }
  blue_box: { style: { fill: "#1e293b"; stroke: "#38bdf8"; stroke-width: 2; border-radius: 8 } }
  green_box: { style: { fill: "#0f291e"; stroke: "#4ade80"; stroke-width: 2; border-radius: 8 } }
  amber_box: { style: { fill: "#231e12"; stroke: "#fbbf24"; stroke-width: 2; border-radius: 8 } }
  purple_box: { style: { fill: "#1e1b2e"; stroke: "#c084fc"; stroke-width: 2; border-radius: 8 } }
  red_box: { style: { fill: "#2b1111"; stroke: "#f87171"; stroke-width: 2; border-radius: 8 } }
}

context: "TaxCalculationService\nMap<String, TaxStrategy>" {
  style.fill: "#0f172a"
  style.stroke: "#3b82f6"
}

strategy: "TaxStrategy <<interface>>\n+getCountryCode()\n+calculateTax(amt)" {
  style.fill: "#064e3b"
  style.stroke: "#10b981"
}

us: "UsSalesTaxStrategy\n@Component('US')" {
  style.fill: "#1e293b"
  style.stroke: "#f59e0b"
}
eu: "EuVatTaxStrategy\n@Component('EU')" {
  style.fill: "#1e293b"
  style.stroke: "#06b6d4"
}
in: "IndiaGstTaxStrategy\n@Component('IN')" {
  style.fill: "#1e293b"
  style.stroke: "#8b5cf6"
}

context -> strategy: "1. Delegates calculation"
strategy <- us: "implements"
strategy <- eu: "implements"
strategy <- in: "implements"