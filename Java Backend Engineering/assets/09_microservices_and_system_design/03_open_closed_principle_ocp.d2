direction: down
title: "Open/Closed Principle (OCP): Extensible Strategy Architecture"
classes: {
  container: { style: { fill: "#111827"; stroke-width: 2; border-radius: 10 } }
  box: { style: { fill: "#1E293B"; stroke-width: 2; border-radius: 8 } }
  table_box: { style: { fill: "#1E293B"; stroke: "#38bdf8"; stroke-width: 2 } }
  blue_box: { style: { fill: "#1e293b"; stroke: "#38bdf8"; stroke-width: 2; border-radius: 8 } }
  green_box: { style: { fill: "#0f291e"; stroke: "#4ade80"; stroke-width: 2; border-radius: 8 } }
  amber_box: { style: { fill: "#231e12"; stroke: "#fbbf24"; stroke-width: 2; border-radius: 8 } }
  purple_box: { style: { fill: "#1e1b2e"; stroke: "#c084fc"; stroke-width: 2; border-radius: 8 } }
  red_box: { style: { fill: "#2b1111"; stroke: "#f87171"; stroke-width: 2; border-radius: 8 } }
}

service: "PaymentExecutionService\nClosed for modification\nMap<String, PaymentStrategy>" {
  style.fill: "#0f172a"
  style.stroke: "#3b82f6"
}

strategy: "PaymentStrategy <<interface>>\n+pay(amount): PaymentReceipt" {
  class: container
  style.fill: "#064e3b"
  style.stroke: "#10b981"
}

cc: "CreditCardPaymentStrategy\n@Component('CREDIT_CARD')" {
  style.fill: "#1e293b"
  style.stroke: "#f59e0b"
}
upi: "UpiPaymentStrategy\n@Component('UPI')" {
  style.fill: "#1e293b"
  style.stroke: "#06b6d4"
}
crypto: "CryptoPaymentStrategy\nNEW EXTENSION: Zero code change!" {
  class: container
  style.fill: "#1e293b"
  style.stroke: "#8b5cf6"
}

service -> strategy: "Depends on abstraction"
strategy <- cc: "implements"
strategy <- upi: "implements"
strategy <- crypto: "implements"