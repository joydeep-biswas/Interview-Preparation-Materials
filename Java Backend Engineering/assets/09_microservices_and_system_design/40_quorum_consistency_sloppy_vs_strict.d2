direction: right
title: "The Quorum Consistency Guarantee: Strict Quorums & The Overlap Principle"
classes: {
  container: { style: { fill: "#111827"; stroke-width: 2; border-radius: 10 } }
  box: { style: { fill: "#1E293B"; stroke-width: 2; border-radius: 8 } }
  table_box: { style: { fill: "#1E293B"; stroke: "#38bdf8"; stroke-width: 2 } }
  blue_box: { style: { fill: "#1e293b"; stroke: "#38bdf8"; stroke-width: 2; border-radius: 8 } }
  green_box: { style: { fill: "#0f291e"; stroke: "#4ade80"; stroke-width: 2; border-radius: 8 } }
  amber_box: { style: { fill: "#231e12"; stroke: "#fbbf24"; stroke-width: 2; border-radius: 8 } }
  purple_box: { style: { fill: "#1e1b2e"; stroke: "#c084fc"; stroke-width: 2; border-radius: 8 } }
  red_box: { style: { fill: "#2b1111"; stroke: "#f87171"; stroke-width: 2; border-radius: 8 } }
}

writer: "Write Client (W = 3)\nWrites latest version v2" {
  style.fill: "#064e3b"
  style.stroke: "#10b981"
}

group: "Replication Group (N = 5)" {
  class: container
  style.fill: "#0f172a"
  style.stroke: "#334155"

  n1: "Node 1 (v2)"
  n2: "Node 2 (v2)"
  n3: "Node 3 (v2 - OVERLAP!)" {
    class: box
    style.fill: "#78350f"
    style.stroke: "#f59e0b"
  }
  n4: "Node 4 (v1)"
  n5: "Node 5 (v1)"
}

reader: "Read Client (R = 3)\nReads from Nodes 3, 4, 5" {
  style.fill: "#1e1b4b"
  style.stroke: "#8b5cf6"
}

writer -> group.n1
writer -> group.n2
writer -> group.n3

reader -> group.n3: "Reads v2"
reader -> group.n4: "Reads v1"
reader -> group.n5: "Reads v1"