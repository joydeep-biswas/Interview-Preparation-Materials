direction: right
title: "Decorator Pattern: Dynamic Transparent Behavior Augmentation"
classes: {
  container: { style: { fill: "#111827"; stroke-width: 2; border-radius: 10 } }
  box: { style: { fill: "#1E293B"; stroke-width: 2; border-radius: 8 } }
  table_box: { style: { fill: "#1E293B"; stroke: "#38bdf8"; stroke-width: 2 } }
  blue_box: { style: { fill: "#1e293b"; stroke: "#38bdf8"; stroke-width: 2; border-radius: 8 } }
  green_box: { style: { fill: "#0f291e"; stroke: "#4ade80"; stroke-width: 2; border-radius: 8 } }
  amber_box: { style: { fill: "#231e12"; stroke: "#fbbf24"; stroke-width: 2; border-radius: 8 } }
  purple_box: { style: { fill: "#1e1b2e"; stroke: "#c084fc"; stroke-width: 2; border-radius: 8 } }
  red_box: { style: { fill: "#2b1111"; stroke: "#f87171"; stroke-width: 2; border-radius: 8 } }
}

client: "MessageService" {
  class: container
  style.fill: "#0f172a"
  style.stroke: "#3b82f6"
}

iface: "MessagePublisher <<interface>>\n+publish(topic, payload)" {
  style.fill: "#064e3b"
  style.stroke: "#10b981"
}

dec: "EncryptedMessageDecorator\nAdds AES-256 GCM\nWraps delegate publisher" {
  style.fill: "#111827"
  style.stroke: "#f59e0b"
}

base: "KafkaMessagePublisher\nCore KafkaTemplate sender" {
  style.fill: "#083344"
  style.stroke: "#06b6d4"
}

client -> iface: "1. Publishes"
dec -> iface: "implements"
dec -> base: "2. Wraps & forwards encrypted payload"