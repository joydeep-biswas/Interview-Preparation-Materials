direction: right
title: "Interface Segregation Principle (ISP): Granular Single-Purpose Contracts"
classes: {
  container: { style: { fill: "#111827"; stroke-width: 2; border-radius: 10 } }
  box: { style: { fill: "#1E293B"; stroke-width: 2; border-radius: 8 } }
  table_box: { style: { fill: "#1E293B"; stroke: "#38bdf8"; stroke-width: 2 } }
  blue_box: { style: { fill: "#1e293b"; stroke: "#38bdf8"; stroke-width: 2; border-radius: 8 } }
  green_box: { style: { fill: "#0f291e"; stroke: "#4ade80"; stroke-width: 2; border-radius: 8 } }
  amber_box: { style: { fill: "#231e12"; stroke: "#fbbf24"; stroke-width: 2; border-radius: 8 } }
  purple_box: { style: { fill: "#1e1b2e"; stroke: "#c084fc"; stroke-width: 2; border-radius: 8 } }
  red_box: { style: { fill: "#2b1111"; stroke: "#f87171"; stroke-width: 2; border-radius: 8 } }
}

http: "HttpRequestHandler <<interface>>\n+handleRequest(req)" {
  style.fill: "#1e3a8a"
  style.stroke: "#3b82f6"
}
ctrl: "WebApiController" {
  class: container
  style.fill: "#1e293b"
  style.stroke: "#3b82f6"
}
ctrl -> http: "implements"

kafka: "KafkaMessageListener <<interface>>\n+onMessage(record)" {
  style.fill: "#064e3b"
  style.stroke: "#10b981"
}
consumer: "StreamEventConsumer" {
  class: container
  style.fill: "#1e293b"
  style.stroke: "#10b981"
}
consumer -> kafka: "implements"

batch: "BatchReportGenerator <<interface>>\n+generateReport()" {
  style.fill: "#78350f"
  style.stroke: "#f59e0b"
}
job: "NightlyReportingJob" {
  class: container
  style.fill: "#1e293b"
  style.stroke: "#f59e0b"
}
job -> batch: "implements"