direction: down
title: "Backend for Frontend (BFF) Pattern & Edge Routing Architecture"
classes: {
  container: { style: { fill: "#111827"; stroke-width: 2; border-radius: 10 } }
  box: { style: { fill: "#1E293B"; stroke-width: 2; border-radius: 8 } }
  table_box: { style: { fill: "#1E293B"; stroke: "#38bdf8"; stroke-width: 2 } }
  blue_box: { style: { fill: "#1e293b"; stroke: "#38bdf8"; stroke-width: 2; border-radius: 8 } }
  green_box: { style: { fill: "#0f291e"; stroke: "#4ade80"; stroke-width: 2; border-radius: 8 } }
  amber_box: { style: { fill: "#231e12"; stroke: "#fbbf24"; stroke-width: 2; border-radius: 8 } }
  purple_box: { style: { fill: "#1e1b2e"; stroke: "#c084fc"; stroke-width: 2; border-radius: 8 } }
  red_box: { style: { fill: "#2b1111"; stroke: "#f87171"; stroke-width: 2; border-radius: 8 } }
}

web_c: "Desktop Web (React)" {
  class: container
  style.fill: "#0f172a"
  style.stroke: "#3b82f6"
}
mob_c: "Mobile (iOS/Android)" {
  class: container
  style.fill: "#0f172a"
  style.stroke: "#10b981"
}
b2b_c: "B2B Partners" {
  class: container
  style.fill: "#0f172a"
  style.stroke: "#f59e0b"
}

web_bff: "Web BFF Service\nDense payloads & SSR" {
  style.fill: "#1e293b"
  style.stroke: "#3b82f6"
}
mob_bff: "Mobile BFF Service\nCompact payloads & batching" {
  style.fill: "#1e293b"
  style.stroke: "#10b981"
}
b2b_bff: "Partner BFF Service\nAPI keys & rate limiting" {
  style.fill: "#1e293b"
  style.stroke: "#f59e0b"
}

svcs: "Downstream Services\nCatalog, Order, User, Payment" {
  style.fill: "#0f172a"
  style.stroke: "#06b6d4"
}

web_c -> web_bff
mob_c -> mob_bff
b2b_c -> b2b_bff

web_bff -> svcs
mob_bff -> svcs
b2b_bff -> svcs