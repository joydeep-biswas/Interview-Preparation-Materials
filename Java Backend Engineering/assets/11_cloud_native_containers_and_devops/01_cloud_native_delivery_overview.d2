direction: right
title: "Cloud Native Enterprise Delivery Architecture"
classes: {
  container: { style: { fill: "#111827"; stroke-width: 2; border-radius: 10 } }
  box: { style: { fill: "#1E293B"; stroke-width: 2; border-radius: 8 } }
  table_box: { style: { fill: "#1E293B"; stroke: "#38bdf8"; stroke-width: 2 } }
  blue_box: { style: { fill: "#1e293b"; stroke: "#38bdf8"; stroke-width: 2; border-radius: 8 } }
  green_box: { style: { fill: "#0f291e"; stroke: "#4ade80"; stroke-width: 2; border-radius: 8 } }
  amber_box: { style: { fill: "#231e12"; stroke: "#fbbf24"; stroke-width: 2; border-radius: 8 } }
  purple_box: { style: { fill: "#1e1b2e"; stroke: "#c084fc"; stroke-width: 2; border-radius: 8 } }
  red_box: { style: { fill: "#2b1111"; stroke: "#f87171"; stroke-width: 2; border-radius: 8 } }
}

Container: "1. Containerization & Layering" {
  class: container
  style.fill: "#0B132B"
  style.stroke: "#0284C7"
  app: "Spring Boot Application"
  docker: "Multi-Stage Distroless Dockerfile"
  oci: "OCI Hardened Container Image"
  app -> docker -> oci
}

GitOps: "2. CI/CD & GitOps Automation" {
  class: container
  style.fill: "#06201B"
  style.stroke: "#10B981"
  git: "Git Repository (K8s Manifests)"
  argo: "ArgoCD Controller"
  rollouts: "Automated Canary Rollouts"
  git -> argo -> rollouts
}

K8s: "3. Kubernetes Orchestration" {
  class: container
  style.fill: "#1E1B4B"
  style.stroke: "#8B5CF6"
  ingress: "Ingress Controller (TLS)"
  pods: "Java Pods (HPA, Probes, Workload Identity)"
  telemetry: "OpenTelemetry & Prometheus"
  ingress -> pods -> telemetry
}

Container.oci -> GitOps.git: "Image tag updated" { style.stroke: "#38BDF8" }
GitOps.argo -> K8s.pods: "Reconciles live cluster state" { style.stroke: "#10B981" }