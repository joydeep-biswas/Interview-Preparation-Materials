direction: right
title: "Azure Service Bus vs Azure Event Hubs"
classes: {
  container: { style: { fill: "#111827"; stroke-width: 2; border-radius: 10 } }
  box: { style: { fill: "#1E293B"; stroke-width: 2; border-radius: 8 } }
  table_box: { style: { fill: "#1E293B"; stroke: "#38bdf8"; stroke-width: 2 } }
  blue_box: { style: { fill: "#1e293b"; stroke: "#38bdf8"; stroke-width: 2; border-radius: 8 } }
  green_box: { style: { fill: "#0f291e"; stroke: "#4ade80"; stroke-width: 2; border-radius: 8 } }
  amber_box: { style: { fill: "#231e12"; stroke: "#fbbf24"; stroke-width: 2; border-radius: 8 } }
  purple_box: { style: { fill: "#1e1b2e"; stroke: "#c084fc"; stroke-width: 2; border-radius: 8 } }
  red_box: { style: { fill: "#2b1111"; stroke: "#f87171"; stroke-width: 2; border-radius: 8 } }
}

ServiceBus: "Azure Service Bus (Enterprise Broker)" {
  class: container
  style.fill: "#0B132B"
  style.stroke: "#0284C7"
  app: "Producer App"
  queue: "Service Bus Queue"
  worker: "Consumer Pod"
  app -> queue -> worker: "Destructive read / Ack"
  features: "Sessions (FIFO), DLQ, Scheduled Delivery"
}

EventHubs: "Azure Event Hubs (Event Stream)" {
  class: container
  style.fill: "#06201B"
  style.stroke: "#10B981"
  iot: "IoT Telemetry"
  log: "Event Hub (Partitions)"
  consumer: "Analytics Group"
  iot -> log -> consumer: "Read offset (Non-destructive)"
  features: "Kafka API, Retention based, Millions msgs/sec"
}