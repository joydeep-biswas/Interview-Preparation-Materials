direction: right
title: "Automated TLS Certificate Management in Kubernetes"
classes: {
  container: { style: { fill: "#111827"; stroke-width: 2; border-radius: 10 } }
  box: { style: { fill: "#1E293B"; stroke-width: 2; border-radius: 8 } }
  table_box: { style: { fill: "#1E293B"; stroke: "#38bdf8"; stroke-width: 2 } }
  blue_box: { style: { fill: "#1e293b"; stroke: "#38bdf8"; stroke-width: 2; border-radius: 8 } }
  green_box: { style: { fill: "#0f291e"; stroke: "#4ade80"; stroke-width: 2; border-radius: 8 } }
  amber_box: { style: { fill: "#231e12"; stroke: "#fbbf24"; stroke-width: 2; border-radius: 8 } }
  purple_box: { style: { fill: "#1e1b2e"; stroke: "#c084fc"; stroke-width: 2; border-radius: 8 } }
  red_box: { style: { fill: "#2b1111"; stroke: "#f87171"; stroke-width: 2; border-radius: 8 } }
}

PatternA: "Pattern A: cert-manager (Let's Encrypt)" {
  class: container
  style.fill: "#0B132B"
  style.stroke: "#0284C7"
  ingress: "Ingress Resource (Annotation)"
  ctrl: "cert-manager Controller"
  acme: "Let's Encrypt Server"
  secret: "K8s Secret (tls.crt & tls.key)"
  ingress -> ctrl -> acme
  ctrl -> secret
}

PatternB: "Pattern B: Azure Key Vault CSI" {
  class: container
  style.fill: "#06201B"
  style.stroke: "#10B981"
  akv: "Azure Key Vault (Corporate Cert)"
  csi: "Secrets Store CSI Driver"
  mount: "Mounted in-memory volume (tmpfs)"
  pod: "Spring Boot SSL KeyStore"
  akv -> csi -> mount -> pod
}