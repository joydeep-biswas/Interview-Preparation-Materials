direction: right
title: "Linux Kernel Container Primitives"
classes: {
  container: { style: { fill: "#111827"; stroke-width: 2; border-radius: 10 } }
  box: { style: { fill: "#1E293B"; stroke-width: 2; border-radius: 8 } }
  table_box: { style: { fill: "#1E293B"; stroke: "#38bdf8"; stroke-width: 2 } }
  blue_box: { style: { fill: "#1e293b"; stroke: "#38bdf8"; stroke-width: 2; border-radius: 8 } }
  green_box: { style: { fill: "#0f291e"; stroke: "#4ade80"; stroke-width: 2; border-radius: 8 } }
  amber_box: { style: { fill: "#231e12"; stroke: "#fbbf24"; stroke-width: 2; border-radius: 8 } }
  purple_box: { style: { fill: "#1e1b2e"; stroke: "#c084fc"; stroke-width: 2; border-radius: 8 } }
  red_box: { style: { fill: "#2b1111"; stroke: "#f87171"; stroke-width: 2; border-radius: 8 } }
}

NS: "1. Namespaces (Visibility)" {
  class: container
  style.fill: "#0B132B"
  style.stroke: "#0284C7"
  pid: "PID (Process tree)"
  net: "NET (veth, loopback, port 8080)"
  mnt: "MNT (Private rootfs)"
  user: "USER (Map root to non-root UID)"
}

CG: "2. Control Groups (Quotas)" {
  class: container
  style.fill: "#1C1917"
  style.stroke: "#F59E0B"
  cpu: "CPU CFS Bandwidth (cpu.max)"
  mem: "Memory Limit (memory.max -> OOM 137)"
  blk: "BlkIO (Disk read/write IOPS)"
}

OFS: "3. OverlayFS (Layered Storage)" {
  class: container
  style.fill: "#06201B"
  style.stroke: "#10B981"
  upper: "UpperDir: Writable layer"
  lower3: "App Layer (app.jar)"
  lower2: "JRE Layer (binaries)"
  lower1: "Distroless RootFS"
  upper -> lower3 -> lower2 -> lower1
}