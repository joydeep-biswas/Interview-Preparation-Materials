direction: down
title: "Azure Workload Identity OIDC Federation"
classes: {
  container: { style: { fill: "#111827"; stroke-width: 2; border-radius: 10 } }
  box: { style: { fill: "#1E293B"; stroke-width: 2; border-radius: 8 } }
  table_box: { style: { fill: "#1E293B"; stroke: "#38bdf8"; stroke-width: 2 } }
  blue_box: { style: { fill: "#1e293b"; stroke: "#38bdf8"; stroke-width: 2; border-radius: 8 } }
  green_box: { style: { fill: "#0f291e"; stroke: "#4ade80"; stroke-width: 2; border-radius: 8 } }
  amber_box: { style: { fill: "#231e12"; stroke: "#fbbf24"; stroke-width: 2; border-radius: 8 } }
  purple_box: { style: { fill: "#1e1b2e"; stroke: "#c084fc"; stroke-width: 2; border-radius: 8 } }
  red_box: { style: { fill: "#2b1111"; stroke: "#f87171"; stroke-width: 2; border-radius: 8 } }
}

Pod: "Java Pod on AKS"
K8s: "K8s API Server (OIDC Issuer)"
Entra: "Microsoft Entra ID (Azure AD)"
AKV: "Azure Key Vault"

Pod -> K8s: "1. Request projected ServiceAccount token" { style.stroke: "#38BDF8" }
K8s -> Pod: "2. Return signed K8s JWT" { style.stroke: "#34D399" }
Pod -> Entra: "3. Exchange JWT for Azure AD OAuth token" { style.stroke: "#C084FC" }
Entra -> K8s: "4. Validates OIDC JWKS keys" { style.stroke: "#C084FC" }
Entra -> Pod: "5. Emits Azure AD access token" { style.stroke: "#34D399" }
Pod -> AKV: "6. GET /secrets/db-password (Bearer token)" { style.stroke: "#F59E0B" }
AKV -> Pod: "7. Returns secret value" { style.stroke: "#34D399" }