direction: right
title: "Zero-Downtime Deployment Strategies"
classes: {
  container: { style: { fill: "#111827"; stroke-width: 2; border-radius: 10 } }
  box: { style: { fill: "#1E293B"; stroke-width: 2; border-radius: 8 } }
  table_box: { style: { fill: "#1E293B"; stroke: "#38bdf8"; stroke-width: 2 } }
  blue_box: { style: { fill: "#1e293b"; stroke: "#38bdf8"; stroke-width: 2; border-radius: 8 } }
  green_box: { style: { fill: "#0f291e"; stroke: "#4ade80"; stroke-width: 2; border-radius: 8 } }
  amber_box: { style: { fill: "#231e12"; stroke: "#fbbf24"; stroke-width: 2; border-radius: 8 } }
  purple_box: { style: { fill: "#1e1b2e"; stroke: "#c084fc"; stroke-width: 2; border-radius: 8 } }
  red_box: { style: { fill: "#2b1111"; stroke: "#f87171"; stroke-width: 2; border-radius: 8 } }
}

Rolling: "1. Rolling Deployment" {
  class: container
  style.fill: "#0B132B"
  style.stroke: "#0284C7"
  desc: "Gradual pod-by-pod replacement; zero extra cost"
}

BlueGreen: "2. Blue-Green Deployment" {
  class: container
  style.fill: "#06201B"
  style.stroke: "#10B981"
  desc: "Instant router switchover; requires 2x infrastructure"
}

Canary: "3. Canary Deployment" {
  class: container
  style.fill: "#1C1917"
  style.stroke: "#F59E0B"
  desc: "5% -> 25% -> 100% traffic shift with automated metrics"
}

"Shadow": "4. Shadow Deployment" {
  class: container
  style.fill: "#1E1B4B"
  style.stroke: "#8B5CF6"
  desc: "Mirrored live traffic copy; zero user impact"
}