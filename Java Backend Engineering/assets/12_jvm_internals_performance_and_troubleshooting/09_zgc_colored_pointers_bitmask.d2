direction: right
title: "ZGC Colored Pointer & Load Barrier"
classes: {
  container: { style: { fill: "#111827"; stroke-width: 2; border-radius: 10 } }
  box: { style: { fill: "#1E293B"; stroke-width: 2; border-radius: 8 } }
  table_box: { style: { fill: "#1E293B"; stroke: "#38bdf8"; stroke-width: 2 } }
  blue_box: { style: { fill: "#1e293b"; stroke: "#38bdf8"; stroke-width: 2; border-radius: 8 } }
  green_box: { style: { fill: "#0f291e"; stroke: "#4ade80"; stroke-width: 2; border-radius: 8 } }
  amber_box: { style: { fill: "#231e12"; stroke: "#fbbf24"; stroke-width: 2; border-radius: 8 } }
  purple_box: { style: { fill: "#1e1b2e"; stroke: "#c084fc"; stroke-width: 2; border-radius: 8 } }
  red_box: { style: { fill: "#2b1111"; stroke: "#f87171"; stroke-width: 2; border-radius: 8 } }
}

ReferenceBits: "64-Bit Reference Layout" {
  class: container
  style.stroke: "#38BDF8"
  Unused: "Bits 48-63 (16 bits) OS Reserved"
  Final: "Bit 47 Finalizable"
  Remap: "Bit 46 Remapped Pointer"
  Mark1: "Bit 45 Marked1 (Alt Cycle)"
  Mark0: "Bit 44 Marked0 (Current Cycle)"
  Addr: "Bits 0-43 (44 bits = 16TB Heap Address Space)"
}

LoadBarrier: "Concurrent Load Barrier" {
  class: container
  style.stroke: "#34D399"
  Step1: "Mutator loads reference (o = p.target)"
  Step2: "Test color bit with BAD_MASK"
  FastPath: "Fast Path (Good Bit -> Immediate Return)"
  SlowPath: "Slow Path (Bad Bit -> Forwarding Table Lookup & Relocate)"
  SelfHeal: "Self-Healing Pointer (In-place update to Remapped bit)"

  Step1 -> Step2: "JIT injected check" { style.stroke: "#38BDF8" }
  Step2 -> FastPath: "Good bit" { style.stroke: "#34D399" }
  Step2 -> SlowPath: "Bad bit" { style.stroke: "#EF4444" }
  SlowPath -> SelfHeal: "Resolves new address" { style.stroke: "#C084FC" }
}