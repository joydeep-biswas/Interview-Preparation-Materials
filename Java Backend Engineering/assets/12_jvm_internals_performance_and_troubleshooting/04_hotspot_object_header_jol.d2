direction: right
title: "HotSpot 64-bit Java Object Layout (JOL)"
classes: {
  container: { style: { fill: "#111827"; stroke-width: 2; border-radius: 10 } }
  box: { style: { fill: "#1E293B"; stroke-width: 2; border-radius: 8 } }
  table_box: { style: { fill: "#1E293B"; stroke: "#38bdf8"; stroke-width: 2 } }
  blue_box: { style: { fill: "#1e293b"; stroke: "#38bdf8"; stroke-width: 2; border-radius: 8 } }
  green_box: { style: { fill: "#0f291e"; stroke: "#4ade80"; stroke-width: 2; border-radius: 8 } }
  amber_box: { style: { fill: "#231e12"; stroke: "#fbbf24"; stroke-width: 2; border-radius: 8 } }
  purple_box: { style: { fill: "#1e1b2e"; stroke: "#c084fc"; stroke-width: 2; border-radius: 8 } }
  red_box: { style: { fill: "#2b1111"; stroke: "#f87171"; stroke-width: 2; border-radius: 8 } }
}

MarkWord: "1. Mark Word (8 Bytes)" {
  class: container
  style.fill: "#0B132B"
  style.stroke: "#0284C7"
  data: "HashCode (31b) · GC Age (4b) · Biased (1b) · Lock Bits (2b)"
}

KlassWord: "2. Klass Word (4 Bytes)" {
  class: container
  style.fill: "#06201B"
  style.stroke: "#10B981"
  data: "Compressed pointer to InstanceKlass in Metaspace"
}

InstanceData: "3. Instance Fields (13 Bytes)" {
  class: container
  style.fill: "#1E1B4B"
  style.stroke: "#8B5CF6"
  data: "Primitive fields & compressed reference pointers"
}

Padding: "4. Alignment Padding (3 Bytes)" {
  class: container
  style.fill: "#1C1917"
  style.stroke: "#F59E0B"
  data: "Rounds total object allocation to 8-byte boundary (32B)"
}

MarkWord -> KlassWord -> InstanceData -> Padding