direction: right
title: "HotSpot Garbage Collector Comparison Matrix"
classes: {
  container: { style: { fill: "#111827"; stroke-width: 2; border-radius: 10 } }
  box: { style: { fill: "#1E293B"; stroke-width: 2; border-radius: 8 } }
  table_box: { style: { fill: "#1E293B"; stroke: "#38bdf8"; stroke-width: 2 } }
  blue_box: { style: { fill: "#1e293b"; stroke: "#38bdf8"; stroke-width: 2; border-radius: 8 } }
  green_box: { style: { fill: "#0f291e"; stroke: "#4ade80"; stroke-width: 2; border-radius: 8 } }
  amber_box: { style: { fill: "#231e12"; stroke: "#fbbf24"; stroke-width: 2; border-radius: 8 } }
  purple_box: { style: { fill: "#1e1b2e"; stroke: "#c084fc"; stroke-width: 2; border-radius: 8 } }
  red_box: { style: { fill: "#2b1111"; stroke: "#f87171"; stroke-width: 2; border-radius: 8 } }
}

Parallel: "Parallel GC (-XX:+UseParallelGC)" {
  class: container
  style.stroke: "#38BDF8"
  P_type: "Throughput-Optimized"
  P_arch: "Generational Young & Old STW Mark-Compact"
  P_pauses: "High (50ms - seconds)"
  P_target: "Batch Jobs, Machine Learning, Data Processing"
}

G1: "G1 GC (-XX:+UseG1GC)" {
  class: container
  style.stroke: "#34D399"
  G_type: "Low Latency & Predictable"
  G_arch: "2048 Homogeneous Regions + RSet Tracking"
  G_pauses: "Targetable (-XX:MaxGCPauseMillis=200)"
  G_target: "Standard Web APIs, Microservices (4GB-32GB)"
}

ZGC: "ZGC & Shenandoah (-XX:+UseZGC)" {
  class: container
  style.stroke: "#C084FC"
  Z_type: "Ultra-Low Latency Sub-millisecond"
  Z_arch: "Colored Pointers + Concurrent Load Barriers"
  Z_pauses: "Sub-millisecond (< 1ms, up to 16TB heap)"
  Z_target: "High Frequency Trading, Giant In-Memory Caches"
}