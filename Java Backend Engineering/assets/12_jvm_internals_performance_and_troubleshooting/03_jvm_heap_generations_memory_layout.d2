direction: right
title: HotSpot JVM Generational Heap Memory Layout

Young: Young Generation (Minor GCs) {
  style.fill: "#06201B"
  style.stroke: "#10B981"
  eden: "Eden Space (TLABs, ~80%)"
  s0: "Survivor 0 (From)"
  s1: "Survivor 1 (To)"
  eden -> s0: Survives Minor GC
  s0 -> s1: Survives next GC
}

Old: Old Generation (Tenured) {
  style.fill: "#1C1917"
  style.stroke: "#F59E0B"
  tenured: "Tenured Space (Singletons, Caches, DB Pools)"
  humongous: "Humongous Regions (>50% Region Size)"
}

Young.s1 -> Old.tenured: Tenuring threshold reached (Age 15) { style.stroke: "#F59E0B" }
