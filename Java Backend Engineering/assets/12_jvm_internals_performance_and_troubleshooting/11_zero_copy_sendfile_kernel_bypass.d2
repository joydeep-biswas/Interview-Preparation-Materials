direction: right
title: "High-Throughput I/O: Traditional vs Zero-Copy"
classes: {
  container: { style: { fill: "#111827"; stroke-width: 2; border-radius: 10 } }
  box: { style: { fill: "#1E293B"; stroke-width: 2; border-radius: 8 } }
  table_box: { style: { fill: "#1E293B"; stroke: "#38bdf8"; stroke-width: 2 } }
  blue_box: { style: { fill: "#1e293b"; stroke: "#38bdf8"; stroke-width: 2; border-radius: 8 } }
  green_box: { style: { fill: "#0f291e"; stroke: "#4ade80"; stroke-width: 2; border-radius: 8 } }
  amber_box: { style: { fill: "#231e12"; stroke: "#fbbf24"; stroke-width: 2; border-radius: 8 } }
  purple_box: { style: { fill: "#1e1b2e"; stroke: "#c084fc"; stroke-width: 2; border-radius: 8 } }
  red_box: { style: { fill: "#2b1111"; stroke: "#f87171"; stroke-width: 2; border-radius: 8 } }
}

Traditional: "Traditional 4-Copy I/O" {
  class: container
  style.stroke: "#EF4444"
  Disk: "Physical Disk"
  KernelPage: "OS Page Cache"
  JVM: "JVM User Space Heap Buffer (new byte[8192])"
  Socket: "OS Socket Buffer"
  NIC: "Network Card"

  Disk -> KernelPage: "DMA Copy" { style.stroke: "#38BDF8" }
  KernelPage -> JVM: "CPU Copy + Context Switch" { style.stroke: "#EF4444" }
  JVM -> Socket: "CPU Copy + Context Switch" { style.stroke: "#EF4444" }
  Socket -> NIC: "DMA Copy" { style.stroke: "#34D399" }
}

ZeroCopy: "Zero-Copy (transferTo / sendfile)" {
  class: container
  style.stroke: "#34D399"
  Z_Disk: "Physical Disk"
  Z_KernelPage: "OS Page Cache (Kernel)"
  Z_NIC: "Network Card (NIC Buffer)"

  Z_Disk -> Z_KernelPage: "1. DMA Copy" { style.stroke: "#34D399" }
  Z_KernelPage -> Z_NIC: "2. Gather DMA Copy (Zero CPU Copy!)" { style.stroke: "#34D399" }
}