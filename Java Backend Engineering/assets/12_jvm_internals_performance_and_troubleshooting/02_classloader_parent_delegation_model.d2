direction: down
title: "ClassLoader Subsystem: Parent Delegation Model"
classes: {
  container: { style: { fill: "#111827"; stroke-width: 2; border-radius: 10 } }
  box: { style: { fill: "#1E293B"; stroke-width: 2; border-radius: 8 } }
  table_box: { style: { fill: "#1E293B"; stroke: "#38bdf8"; stroke-width: 2 } }
  blue_box: { style: { fill: "#1e293b"; stroke: "#38bdf8"; stroke-width: 2; border-radius: 8 } }
  green_box: { style: { fill: "#0f291e"; stroke: "#4ade80"; stroke-width: 2; border-radius: 8 } }
  amber_box: { style: { fill: "#231e12"; stroke: "#fbbf24"; stroke-width: 2; border-radius: 8 } }
  purple_box: { style: { fill: "#1e1b2e"; stroke: "#c084fc"; stroke-width: 2; border-radius: 8 } }
  red_box: { style: { fill: "#2b1111"; stroke: "#f87171"; stroke-width: 2; border-radius: 8 } }
}

Boot: "1. Bootstrap ClassLoader (Native C++ / java.base)" {
  class: container
  style.fill: "#0B132B"
  style.stroke: "#0284C7"
}

Plat: "2. Platform ClassLoader (JDK Extensions)" {
  class: container
  style.fill: "#06201B"
  style.stroke: "#10B981"
}

App: "3. Application ClassLoader (App JARs & Classpath)" {
  class: container
  style.fill: "#1E1B4B"
  style.stroke: "#8B5CF6"
}

App -> Plat: "1. Delegates UP" { style.stroke: "#38BDF8" }
Plat -> Boot: "2. Delegates UP" { style.stroke: "#38BDF8" }
Boot -> Plat: "3. If absent, search down" { style.stroke: "#F59E0B" }
Plat -> App: "4. If absent, search down" { style.stroke: "#F59E0B" }