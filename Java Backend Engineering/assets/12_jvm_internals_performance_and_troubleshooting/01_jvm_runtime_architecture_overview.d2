direction: right
title: "JVM Runtime Subsystems Architecture"
classes: {
  container: { style: { fill: "#111827"; stroke-width: 2; border-radius: 10 } }
  box: { style: { fill: "#1E293B"; stroke-width: 2; border-radius: 8 } }
  table_box: { style: { fill: "#1E293B"; stroke: "#38bdf8"; stroke-width: 2 } }
  blue_box: { style: { fill: "#1e293b"; stroke: "#38bdf8"; stroke-width: 2; border-radius: 8 } }
  green_box: { style: { fill: "#0f291e"; stroke: "#4ade80"; stroke-width: 2; border-radius: 8 } }
  amber_box: { style: { fill: "#231e12"; stroke: "#fbbf24"; stroke-width: 2; border-radius: 8 } }
  purple_box: { style: { fill: "#1e1b2e"; stroke: "#c084fc"; stroke-width: 2; border-radius: 8 } }
  red_box: { style: { fill: "#2b1111"; stroke: "#f87171"; stroke-width: 2; border-radius: 8 } }
}

ClassLoader: "1. ClassLoader Subsystem" {
  class: container
  style.fill: "#0B132B"
  style.stroke: "#0284C7"
  boot: "Bootstrap ClassLoader (Native)"
  plat: "Platform ClassLoader"
  app: "Application ClassLoader"
  boot -> plat -> app
}

Memory: "2. Runtime Data Areas" {
  class: container
  style.fill: "#06201B"
  style.stroke: "#10B981"
  heap: "JVM Heap (Young, Old Gen)"
  meta: "Metaspace (Off-Heap Class Metadata)"
  stacks: "Thread Stacks (StackFrames)"
  pc: "PC Registers"
}

Engine: "3. Execution Engine & JNI" {
  class: container
  style.fill: "#1E1B4B"
  style.stroke: "#8B5CF6"
  interp: "Bytecode Interpreter"
  jit: "JIT Compiler (C1 / C2)"
  gc: "Garbage Collector (G1 / ZGC)"
  jni: "Java Native Interface"
}

ClassLoader -> Memory: "Loads classes & constants" { style.stroke: "#38BDF8" }
Memory -> Engine: "Bytecode execution & GC tracing" { style.stroke: "#10B981" }