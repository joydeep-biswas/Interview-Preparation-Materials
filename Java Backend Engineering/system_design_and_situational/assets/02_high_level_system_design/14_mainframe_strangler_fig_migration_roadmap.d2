direction: right
classes: {
  container: { style: { fill: "#111827"; stroke-width: 2; border-radius: 10 } }
  box: { style: { fill: "#1E293B"; stroke-width: 2; border-radius: 8 } }
  table_box: { style: { fill: "#1E293B"; stroke: "#38bdf8"; stroke-width: 2 } }
  blue_box: { style: { fill: "#1e293b"; stroke: "#38bdf8"; stroke-width: 2; border-radius: 8 } }
  green_box: { style: { fill: "#0f291e"; stroke: "#4ade80"; stroke-width: 2; border-radius: 8 } }
  amber_box: { style: { fill: "#231e12"; stroke: "#fbbf24"; stroke-width: 2; border-radius: 8 } }
  purple_box: { style: { fill: "#1e1b2e"; stroke: "#c084fc"; stroke-width: 2; border-radius: 8 } }
  red_box: { style: { fill: "#2b1111"; stroke: "#f87171"; stroke-width: 2; border-radius: 8 } }
}

phase1: "Phase 1: Shadow CDC" {
  class: container
  style.fill: "#111827"
  style.stroke: "#3B82F6"
  style.stroke-width: 2
  mainframe: "Mainframe DB2 (Primary)"
  cdc: "Debezium CDC to Kafka"
  cloud_db: "Passive Cloud Replica"
}

phase2: "Phase 2: Dual-Run Parity" {
  class: container
  style.fill: "#111827"
  style.stroke: "#F59E0B"
  style.stroke-width: 2
  gateway: "Smart Routing API Gateway"
  reconcile: "Flink Continuous Reconciliation"
}

phase3: "Phase 3: Read Cutover" {
  class: container
  style.fill: "#111827"
  style.stroke: "#10B981"
  style.stroke-width: 2
  reads: "100% Reads on Cloud DB"
  mips: "70% MIPS Cost Reduction"
}

phase4: "Phase 4: Full Cutover" {
  class: container
  style.fill: "#111827"
  style.stroke: "#8B5CF6"
  style.stroke-width: 2
  cloud_primary: "Cloud DB Source of Truth"
  decom: "Mainframe Decommissioned to Archive"
}

phase1 -> phase2: "CDC Pipeline Stable" {
  style.stroke: "#F59E0B"
  style.stroke-width: 2
}
phase2 -> phase3: "Parity Proven (30 Days)" {
  style.stroke: "#10B981"
  style.stroke-width: 2
}
phase3 -> phase4: "Zero Read Regressions" {
  style.stroke: "#8B5CF6"
  style.stroke-width: 2
}