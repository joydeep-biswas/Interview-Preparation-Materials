direction: right
classes: {
  container: { style: { fill: "#111827"; stroke-width: 2; border-radius: 10 } }
  box: { style: { fill: "#1E293B"; stroke-width: 2; border-radius: 8 } }
  table_box: { style: { fill: "#1E293B"; stroke: "#38bdf8"; stroke-width: 2 } }
  blue_box: { style: { fill: "#1e293b"; stroke: "#38bdf8"; stroke-width: 2; border-radius: 8 } }
  green_box: { style: { fill: "#0f291e"; stroke: "#4ade80"; stroke-width: 2; border-radius: 8 } }
  amber_box: { style: { fill: "#231e12"; stroke: "#fbbf24"; stroke-width: 2; border-radius: 8 } }
  purple_box: { style: { fill: "#1e1b2e"; stroke: "#c084fc"; stroke-width: 2; border-radius: 8 } }
  red_box: { style: { fill: "#2b1111"; stroke: "#f87171"; stroke-width: 2; border-radius: 8 } }
}

sender: "1. Sender & Gateway" {
  class: container
  style.fill: "#111827"
  style.stroke: "#3B82F6"
  style.stroke-width: 2
  client: "Sender Mobile Client"
  netty: "Netty WebSocket Gateway (Epoll)"
}

registry: "2. Session Registry" {
  class: container
  style.fill: "#111827"
  style.stroke: "#10B981"
  style.stroke-width: 2
  redis: "Redis Session Table (User -> Gateway Pod)"
  heartbeat: "30s Heartbeat & Presence"
}

router: "3. Message Router" {
  class: container
  style.fill: "#111827"
  style.stroke: "#F59E0B"
  style.stroke-width: 2
  online: "Online: Inter-Pod gRPC & WebSocket Push"
  offline: "Offline: Kafka Topic & APNs/FCM Push"
}

cassandra: "4. Cassandra History" {
  class: container
  style.fill: "#111827"
  style.stroke: "#8B5CF6"
  style.stroke-width: 2
  schema: "PRIMARY KEY ((chat_id), msg_id DESC)"
  sstable: "High-Throughput Append-Only SSTables"
}

sender -> registry: "Lookup Recipient Pod" {
  style.stroke: "#10B981"
  style.stroke-width: 2
}
registry -> router: "Route to Destination" {
  style.stroke: "#F59E0B"
  style.stroke-width: 2
}
router -> cassandra: "Persist Chat Message" {
  style.stroke: "#8B5CF6"
  style.stroke-width: 2
}