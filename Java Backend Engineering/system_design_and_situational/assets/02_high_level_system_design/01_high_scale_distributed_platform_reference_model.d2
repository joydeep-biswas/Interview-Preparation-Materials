direction: right
classes: {
  container: { style: { fill: "#111827"; stroke-width: 2; border-radius: 10 } }
  box: { style: { fill: "#1E293B"; stroke-width: 2; border-radius: 8 } }
  table_box: { style: { fill: "#1E293B"; stroke: "#38bdf8"; stroke-width: 2 } }
  blue_box: { style: { fill: "#1e293b"; stroke: "#38bdf8"; stroke-width: 2; border-radius: 8 } }
  green_box: { style: { fill: "#0f291e"; stroke: "#4ade80"; stroke-width: 2; border-radius: 8 } }
  amber_box: { style: { fill: "#231e12"; stroke: "#fbbf24"; stroke-width: 2; border-radius: 8 } }
  purple_box: { style: { fill: "#1e1b2e"; stroke: "#c084fc"; stroke-width: 2; border-radius: 8 } }
  red_box: { style: { fill: "#2b1111"; stroke: "#f87171"; stroke-width: 2; border-radius: 8 } }
}

edge: "1. Edge & Ingress" {
  class: container
  style.fill: "#111827"
  style.stroke: "#3B82F6"
  style.stroke-width: 2
  dns: "Route53 / Anycast Geo-DNS"
  gateway: "API Gateway (Envoy Rate Limiter & Auth)"
}

services: "2. Services & Event Mesh" {
  class: container
  style.fill: "#111827"
  style.stroke: "#10B981"
  style.stroke-width: 2
  apps: "Spring Boot 3 Stateless Microservices"
  kafka: "Apache Kafka Partitioned Event Mesh"
}

caching: "3. Caching & Fast Data" {
  class: container
  style.fill: "#111827"
  style.stroke: "#F59E0B"
  style.stroke-width: 2
  l1: "Caffeine In-Process JVM Cache (L1)"
  l2: "Redis Cluster Distributed Cache (L2)"
}

storage: "4. Polyglot Persistence" {
  class: container
  style.fill: "#111827"
  style.stroke: "#8B5CF6"
  style.stroke-width: 2
  aurora: "Aurora PostgreSQL OLTP Master/Replicas"
  nosql: "ScyllaDB & Elasticsearch Search Index"
  s3: "Amazon S3 Object Store"
}

edge -> services: "Route Verified Requests" {
  style.stroke: "#10B981"
  style.stroke-width: 2
}
services -> caching: "Cache-Aside Lookups" {
  style.stroke: "#F59E0B"
  style.stroke-width: 2
}
services -> storage: "ACID Commits & Index Sync" {
  style.stroke: "#8B5CF6"
  style.stroke-width: 2
}