direction: right
classes: {
  container: { style: { fill: "#111827"; stroke-width: 2; border-radius: 10 } }
  box: { style: { fill: "#1E293B"; stroke-width: 2; border-radius: 8 } }
  table_box: { style: { fill: "#1E293B"; stroke: "#38bdf8"; stroke-width: 2 } }
  blue_box: { style: { fill: "#1e293b"; stroke: "#38bdf8"; stroke-width: 2; border-radius: 8 } }
  green_box: { style: { fill: "#0f291e"; stroke: "#4ade80"; stroke-width: 2; border-radius: 8 } }
  amber_box: { style: { fill: "#231e12"; stroke: "#fbbf24"; stroke-width: 2; border-radius: 8 } }
  purple_box: { style: { fill: "#1e1b2e"; stroke: "#c084fc"; stroke-width: 2; border-radius: 8 } }
  red_box: { style: { fill: "#2b1111"; stroke: "#f87171"; stroke-width: 2; border-radius: 8 } }
}

tpp: "1. FinTech App (TPP)" {
  class: container
  style.fill: "#111827"
  style.stroke: "#3B82F6"
  style.stroke-width: 2
  req: "GET /accounts (Signed DPoP JWT + mTLS)"
}

edge_auth: "2. Edge Validation (< 2ms)" {
  class: container
  style.fill: "#111827"
  style.stroke: "#10B981"
  style.stroke-width: 2
  crypto: "RS256 Signature Verification"
  bloom: "In-Memory Bloom Filter Revocation Check"
}

registry: "3. Central Registry (Fallback)" {
  class: container
  style.fill: "#111827"
  style.stroke: "#F59E0B"
  style.stroke-width: 2
  redis: "Redis Token Blacklist"
  pubsub: "Pub/Sub Syncs Bloom Filter"
}

account_svc: "4. Account API Service" {
  class: container
  style.fill: "#111827"
  style.stroke: "#8B5CF6"
  style.stroke-width: 2
  core: "Fetch Balance with Masked PII"
  audit: "GDPR Access Audit Trail in Kafka"
}

tpp -> edge_auth: "Inbound Request" {
  style.stroke: "#10B981"
  style.stroke-width: 2
}
edge_auth -> registry: "Bloom False Positive Disambiguation" {
  style.stroke: "#F59E0B"
  style.stroke-width: 2
}
edge_auth -> account_svc: "Verified Consent Dispatch" {
  style.stroke: "#8B5CF6"
  style.stroke-width: 2
}