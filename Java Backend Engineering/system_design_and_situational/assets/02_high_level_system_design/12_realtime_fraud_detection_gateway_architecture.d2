direction: right
classes: {
  container: { style: { fill: "#111827"; stroke-width: 2; border-radius: 10 } }
  box: { style: { fill: "#1E293B"; stroke-width: 2; border-radius: 8 } }
  table_box: { style: { fill: "#1E293B"; stroke: "#38bdf8"; stroke-width: 2 } }
  blue_box: { style: { fill: "#1e293b"; stroke: "#38bdf8"; stroke-width: 2; border-radius: 8 } }
  green_box: { style: { fill: "#0f291e"; stroke: "#4ade80"; stroke-width: 2; border-radius: 8 } }
  amber_box: { style: { fill: "#231e12"; stroke: "#fbbf24"; stroke-width: 2; border-radius: 8 } }
  purple_box: { style: { fill: "#1e1b2e"; stroke: "#c084fc"; stroke-width: 2; border-radius: 8 } }
  red_box: { style: { fill: "#2b1111"; stroke: "#f87171"; stroke-width: 2; border-radius: 8 } }
}

ingress: "1. Ingress & Card Switch" {
  class: container
  style.fill: "#111827"
  style.stroke: "#3B82F6"
  style.stroke-width: 2
  pos: "POS Swipe Authorization Request"
  switch: "ISO 8583 Binary Message Switch"
  gateway: "Netty Low-Latency Ingress Gateway"
}

features: "2. Online Feature Store" {
  class: container
  style.fill: "#111827"
  style.stroke: "#10B981"
  style.stroke-width: 2
  redis: "Redis Low-Latency Velocity Features"
  metrics: "tx_count_10m & distinct_countries"
}

inference: "3. Inference & Rules" {
  class: container
  style.fill: "#111827"
  style.stroke: "#F59E0B"
  style.stroke-width: 2
  drools: "Drools Sanctions & Hard Block Rules"
  onnx: "ONNX Runtime Vectorized XGBoost Model"
}

decision: "4. Decision & Audit" {
  class: container
  style.fill: "#111827"
  style.stroke: "#8B5CF6"
  style.stroke-width: 2
  policy: "Approve / 3DS Challenge / Decline"
  audit: "Async Feature Snapshot to Kafka"
}

ingress -> features: "Fetch Real-Time Features" {
  style.stroke: "#10B981"
  style.stroke-width: 2
}
features -> inference: "Evaluate ML Model" {
  style.stroke: "#F59E0B"
  style.stroke-width: 2
}
inference -> decision: "Emit Live Scoring Result" {
  style.stroke: "#8B5CF6"
  style.stroke-width: 2
}