direction: right
classes: {
  container: { style: { fill: "#111827"; stroke-width: 2; border-radius: 10 } }
  box: { style: { fill: "#1E293B"; stroke-width: 2; border-radius: 8 } }
  table_box: { style: { fill: "#1E293B"; stroke: "#38bdf8"; stroke-width: 2 } }
  blue_box: { style: { fill: "#1e293b"; stroke: "#38bdf8"; stroke-width: 2; border-radius: 8 } }
  green_box: { style: { fill: "#0f291e"; stroke: "#4ade80"; stroke-width: 2; border-radius: 8 } }
  amber_box: { style: { fill: "#231e12"; stroke: "#fbbf24"; stroke-width: 2; border-radius: 8 } }
  purple_box: { style: { fill: "#1e1b2e"; stroke: "#c084fc"; stroke-width: 2; border-radius: 8 } }
  red_box: { style: { fill: "#2b1111"; stroke: "#f87171"; stroke-width: 2; border-radius: 8 } }
}

client: "1. Client Request" {
  class: container
  style.fill: "#111827"
  style.stroke: "#3B82F6"
  style.stroke-width: 2
  req: "GET /7aB9xQ"
  gw: "Edge API Gateway"
}

cache: "2. Redis Cache L1/L2" {
  class: container
  style.fill: "#111827"
  style.stroke: "#10B981"
  style.stroke-width: 2
  lookup: "O(1) Memory Lookup"
}

db: "3. Distributed DB" {
  class: container
  style.fill: "#111827"
  style.stroke: "#F59E0B"
  style.stroke-width: 2
  query: "CockroachDB / ScyllaDB Fallback"
  populate: "Populate Redis Cache"
}

response: "4. Response & Analytics" {
  class: container
  style.fill: "#111827"
  style.stroke: "#8B5CF6"
  style.stroke-width: 2
  redirect: "Return HTTP 302 Redirect"
  kafka: "Async Kafka Click Analytics"
}

client -> cache: "Lookup Short Key" {
  style.stroke: "#10B981"
  style.stroke-width: 2
}
cache -> response: "Cache Hit (95%)" {
  style.stroke: "#10B981"
  style.stroke-width: 2
}
cache -> db: "Cache Miss (5%)" {
  style.stroke: "#F59E0B"
  style.stroke-width: 2
}
db -> response: "Write Cache & Return 302" {
  style.stroke: "#8B5CF6"
  style.stroke-width: 2
}