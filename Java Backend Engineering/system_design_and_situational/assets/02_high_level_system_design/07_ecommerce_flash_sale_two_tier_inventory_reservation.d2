direction: down

checkout: "Checkout Request (User buys Item #42)" {
  style.fill: "#111827"
  style.stroke: "#3B82F6"
  style.stroke-width: 2
  lua: "Redis In-Memory Atomic DECR Script"
}

success: "Stock >= 0: Temporary Reservation Success" {
  style.fill: "#111827"
  style.stroke: "#10B981"
  style.stroke-width: 2
  reserve: "15-Minute Expiration TTL in Redis"
  commit: "Commit to PostgreSQL on Payment"
  revert: "Keyspace Notification Reverts on Expiry"
}

sold_out: "Stock < 0: Instant Sold Out Reversion" {
  style.fill: "#111827"
  style.stroke: "#EF4444"
  style.stroke-width: 2
  revert_counter: "Atomic INCR Counter Reversion"
  fail_fast: "Return 'Sold Out' (<3ms) Without DB Lock"
}

checkout -> success: "Stock Available" {
  style.stroke: "#10B981"
  style.stroke-width: 2
}
checkout -> sold_out: "Stock Depleted" {
  style.stroke: "#EF4444"
  style.stroke-width: 2
}