direction: right
classes: {
  container: { style: { fill: "#111827"; stroke-width: 2; border-radius: 10 } }
  box: { style: { fill: "#1E293B"; stroke-width: 2; border-radius: 8 } }
  table_box: { style: { fill: "#1E293B"; stroke: "#38bdf8"; stroke-width: 2 } }
  blue_box: { style: { fill: "#1e293b"; stroke: "#38bdf8"; stroke-width: 2; border-radius: 8 } }
  green_box: { style: { fill: "#0f291e"; stroke: "#4ade80"; stroke-width: 2; border-radius: 8 } }
  amber_box: { style: { fill: "#231e12"; stroke: "#fbbf24"; stroke-width: 2; border-radius: 8 } }
  purple_box: { style: { fill: "#1e1b2e"; stroke: "#c084fc"; stroke-width: 2; border-radius: 8 } }
  red_box: { style: { fill: "#2b1111"; stroke: "#f87171"; stroke-width: 2; border-radius: 8 } }
}

client: "Client Application" {
  class: container
  style.fill: "#111827"
  style.stroke: "#3B82F6"
  style.stroke-width: 2
  req: "1. POST /payments (\$100; Idempotency-Key: K1)"
  timeout: "4. HTTP 504 Timeout (Payment Pending)"
  verified: "7. Webhook Confirmed Receipt"
}

gateway: "Payment Gateway & Reconciler" {
  class: container
  style.fill: "#111827"
  style.stroke: "#F59E0B"
  style.stroke-width: 2
  forward: "2. Forward ISO 8583 Auth"
  dropped: "Drop: Socket Timeout (Never Blind Retry)"
  reconcile: "5. Active Inquiry: GET /charges?key=K1"
  success: "6. Mark Local DB 'SUCCESS'"
}

bank: "Acquiring Bank / PSP" {
  class: container
  style.fill: "#111827"
  style.stroke: "#10B981"
  style.stroke-width: 2
  charged: "Deducts Funds & Commits Charge"
  drop: "ACK Dropped on Network Boundary"
  inquiry: "Inquiry Returns 'SUCCESS'"
}

client -> gateway: "1. Charge Request" {
  style.stroke: "#3B82F6"
  style.stroke-width: 2
}
gateway -> bank: "2. Process Auth" {
  style.stroke: "#F59E0B"
  style.stroke-width: 2
}
gateway -> client: "4. HTTP 504 Timeout" {
  style.stroke: "#EF4444"
  style.stroke-width: 2
}
gateway -> bank: "5. Reconcile Status" {
  style.stroke: "#8B5CF6"
  style.stroke-width: 2
}
bank -> gateway: "6. Confirm Charge" {
  style.stroke: "#10B981"
  style.stroke-width: 2
}
gateway -> client: "7. Async Webhook Confirmed" {
  style.stroke: "#10B981"
  style.stroke-width: 2
}