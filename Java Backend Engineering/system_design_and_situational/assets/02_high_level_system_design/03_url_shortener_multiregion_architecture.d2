direction: right
classes: {
  container: { style: { fill: "#111827"; stroke-width: 2; border-radius: 10 } }
  box: { style: { fill: "#1E293B"; stroke-width: 2; border-radius: 8 } }
  table_box: { style: { fill: "#1E293B"; stroke: "#38bdf8"; stroke-width: 2 } }
  blue_box: { style: { fill: "#1e293b"; stroke: "#38bdf8"; stroke-width: 2; border-radius: 8 } }
  green_box: { style: { fill: "#0f291e"; stroke: "#4ade80"; stroke-width: 2; border-radius: 8 } }
  amber_box: { style: { fill: "#231e12"; stroke: "#fbbf24"; stroke-width: 2; border-radius: 8 } }
  purple_box: { style: { fill: "#1e1b2e"; stroke: "#c084fc"; stroke-width: 2; border-radius: 8 } }
  red_box: { style: { fill: "#2b1111"; stroke: "#f87171"; stroke-width: 2; border-radius: 8 } }
}

edge: "Global Edge Layer" {
  class: container
  style.fill: "#111827"
  style.stroke: "#3B82F6"
  style.stroke-width: 2
  dns: "Anycast Geo-DNS Routing"
}

us: "Region 1: US-East" {
  class: container
  style.fill: "#111827"
  style.stroke: "#10B981"
  style.stroke-width: 2
  kgs_us: "KGS Range: 00..31"
  redis_us: "Redis L1 Cache US"
  crdb_us: "CockroachDB Raft Leader"
}

eu: "Region 2: EU-Central" {
  class: container
  style.fill: "#111827"
  style.stroke: "#F59E0B"
  style.stroke-width: 2
  kgs_eu: "KGS Range: 32..63"
  redis_eu: "Redis L1 Cache EU"
  crdb_eu: "CockroachDB Raft Peer"
}

apac: "Region 3: APAC" {
  class: container
  style.fill: "#111827"
  style.stroke: "#8B5CF6"
  style.stroke-width: 2
  kgs_apac: "KGS Range: 64..95"
  redis_apac: "Redis L1 Cache APAC"
  crdb_apac: "CockroachDB Raft Peer"
}

edge -> us: "US Client Ingress" {
  style.stroke: "#10B981"
  style.stroke-width: 2
}
edge -> eu: "EU Client Ingress" {
  style.stroke: "#F59E0B"
  style.stroke-width: 2
}
edge -> apac: "APAC Client Ingress" {
  style.stroke: "#8B5CF6"
  style.stroke-width: 2
}
us.crdb_us -> eu.crdb_eu: "Cross-Region Raft Sync" {
  style.stroke: "#F59E0B"
  style.stroke-width: 2
}
eu.crdb_eu -> apac.crdb_apac: "Cross-Region Raft Sync" {
  style.stroke: "#8B5CF6"
  style.stroke-width: 2
}