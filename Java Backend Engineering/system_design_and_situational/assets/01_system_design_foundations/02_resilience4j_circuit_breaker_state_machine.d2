direction: right
classes: {
  container: { style: { fill: "#111827"; stroke-width: 2; border-radius: 10 } }
  box: { style: { fill: "#1E293B"; stroke-width: 2; border-radius: 8 } }
  table_box: { style: { fill: "#1E293B"; stroke: "#38bdf8"; stroke-width: 2 } }
  blue_box: { style: { fill: "#1e293b"; stroke: "#38bdf8"; stroke-width: 2; border-radius: 8 } }
  green_box: { style: { fill: "#0f291e"; stroke: "#4ade80"; stroke-width: 2; border-radius: 8 } }
  amber_box: { style: { fill: "#231e12"; stroke: "#fbbf24"; stroke-width: 2; border-radius: 8 } }
  purple_box: { style: { fill: "#1e1b2e"; stroke: "#c084fc"; stroke-width: 2; border-radius: 8 } }
  red_box: { style: { fill: "#2b1111"; stroke: "#f87171"; stroke-width: 2; border-radius: 8 } }
}

closed: "CLOSED (Normal)" {
  class: container
  style.fill: "#111827"
  style.stroke: "#10B981"
  style.stroke-width: 2
  desc: "Requests execute normally\nFailure rate tracked"
}

open: "OPEN (Tripped)" {
  class: container
  style.fill: "#111827"
  style.stroke: "#EF4444"
  style.stroke-width: 2
  desc: "Fails fast immediately\nExecutes Fallback method"
}

half_open: "HALF-OPEN (Probing)" {
  class: container
  style.fill: "#111827"
  style.stroke: "#F59E0B"
  style.stroke-width: 2
  desc: "Allows limited probe requests\nEvaluates downstream recovery"
}

closed -> open: "Failure Rate >= 50%" {
  style.stroke: "#EF4444"
  style.stroke-width: 2
}
open -> half_open: "Sleep Window (30s) Expired" {
  style.stroke: "#F59E0B"
  style.stroke-width: 2
}
half_open -> closed: "Consecutive Probes Succeed" {
  style.stroke: "#10B981"
  style.stroke-width: 2
}
half_open -> open: "Single Probe Fails" {
  style.stroke: "#EF4444"
  style.stroke-width: 2
}