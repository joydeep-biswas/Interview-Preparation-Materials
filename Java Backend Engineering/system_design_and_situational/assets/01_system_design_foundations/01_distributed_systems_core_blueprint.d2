direction: right
classes: {
  container: { style: { fill: "#111827"; stroke-width: 2; border-radius: 10 } }
  box: { style: { fill: "#1E293B"; stroke-width: 2; border-radius: 8 } }
  table_box: { style: { fill: "#1E293B"; stroke: "#38bdf8"; stroke-width: 2 } }
  blue_box: { style: { fill: "#1e293b"; stroke: "#38bdf8"; stroke-width: 2; border-radius: 8 } }
  green_box: { style: { fill: "#0f291e"; stroke: "#4ade80"; stroke-width: 2; border-radius: 8 } }
  amber_box: { style: { fill: "#231e12"; stroke: "#fbbf24"; stroke-width: 2; border-radius: 8 } }
  purple_box: { style: { fill: "#1e1b2e"; stroke: "#c084fc"; stroke-width: 2; border-radius: 8 } }
  red_box: { style: { fill: "#2b1111"; stroke: "#f87171"; stroke-width: 2; border-radius: 8 } }
}

ingress: "1. Ingress & Edge Layer" {
  class: container
  style.fill: "#111827"
  style.stroke: "#3B82F6"
  style.stroke-width: 2
  dns: "Geo-DNS & Anycast"
  cdn: "CDN Edge Caching"
  gateway: "API Gateway (Rate Limiter & Token Bucket)"
}

services: "2. Core Microservices" {
  class: container
  style.fill: "#111827"
  style.stroke: "#10B981"
  style.stroke-width: 2
  order: "Order Service"
  payment: "Payment Gateway Service"
  resilience: "Resilience4j Circuit Breakers"
}

cache: "3. Caching & Fast Data" {
  class: container
  style.fill: "#111827"
  style.stroke: "#F59E0B"
  style.stroke-width: 2
  redis: "Redis Cluster (Sub-millisecond L1/L2)"
  pattern: "Cache-Aside & Write-Through"
}

storage: "4. Polyglot Persistence" {
  class: container
  style.fill: "#111827"
  style.stroke: "#8B5CF6"
  style.stroke-width: 2
  sql: "Sharded PostgreSQL / Aurora OLTP"
  nosql: "Cassandra / ScyllaDB High-Write"
  consensus: "Raft / etcd Distributed State"
}

ingress -> services: "Authenticated Traffic" {
  style.stroke: "#10B981"
  style.stroke-width: 2
}
services -> cache: "O(1) Memory Lookups" {
  style.stroke: "#F59E0B"
  style.stroke-width: 2
}
services -> storage: "Durable Write-Ahead Log & Commits" {
  style.stroke: "#8B5CF6"
  style.stroke-width: 2
}