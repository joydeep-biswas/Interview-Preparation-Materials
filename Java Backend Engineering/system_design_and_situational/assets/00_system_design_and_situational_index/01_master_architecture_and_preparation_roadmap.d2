direction: right
classes: {
  container: { style: { fill: "#111827"; stroke-width: 2; border-radius: 10 } }
  box: { style: { fill: "#1E293B"; stroke-width: 2; border-radius: 8 } }
  table_box: { style: { fill: "#1E293B"; stroke: "#38bdf8"; stroke-width: 2 } }
  blue_box: { style: { fill: "#1e293b"; stroke: "#38bdf8"; stroke-width: 2; border-radius: 8 } }
  green_box: { style: { fill: "#0f291e"; stroke: "#4ade80"; stroke-width: 2; border-radius: 8 } }
  amber_box: { style: { fill: "#231e12"; stroke: "#fbbf24"; stroke-width: 2; border-radius: 8 } }
  purple_box: { style: { fill: "#1e1b2e"; stroke: "#c084fc"; stroke-width: 2; border-radius: 8 } }
  red_box: { style: { fill: "#2b1111"; stroke: "#f87171"; stroke-width: 2; border-radius: 8 } }
}

pillar1: "Phase 1: Foundations (01)" {
  class: container
  style.fill: "#111827"
  style.stroke: "#3B82F6"
  style.stroke-width: 2
  desc: "Scalability Primitives\nCAP & PACELC\nRaft Consensus & 2PC\nB+ vs LSM Trees\nConsistent Hashing\nResilience4j Circuit Breakers"
}

pillar2: "Phase 2: High-Level HLD (02)" {
  class: container
  style.fill: "#111827"
  style.stroke: "#10B981"
  style.stroke-width: 2
  desc: "URL Shortener & KGS\nTwitter Snowflake 64-bit ID\nNotification Engine\n50,000 TPS Idempotent Payments\nFlash Sale Inventory\nRate Limiter & Chat"
}

pillar3: "Phase 3: Low-Level LLD (03)" {
  class: container
  style.fill: "#111827"
  style.stroke: "#F59E0B"
  style.stroke-width: 2
  desc: "JMM & Happens-Before\nReentrantLock & CAS\nRing Buffers & Deduplication\nCustom Thread Pools\nSpotify State Design Pattern"
}

pillar4: "Phase 4: Situational (04)" {
  class: container
  style.fill: "#111827"
  style.stroke: "#8B5CF6"
  style.stroke-width: 2
  desc: "Sev-1 Incident Protocol\nThread Pool Exhaustion Triage\nJVM Memory Leak Triage\nDistributed Deadlocks\nZero-Downtime Expand-Contract"
}

pillar1 -> pillar2: "Distributed Primitives" {
  style.stroke: "#10B981"
  style.stroke-width: 2
}
pillar2 -> pillar3: "Component Internals" {
  style.stroke: "#F59E0B"
  style.stroke-width: 2
}
pillar3 -> pillar4: "Operational Leadership" {
  style.stroke: "#8B5CF6"
  style.stroke-width: 2
}