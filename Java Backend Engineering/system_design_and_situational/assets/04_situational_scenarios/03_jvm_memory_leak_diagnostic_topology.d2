direction: right
classes: {
  container: { style: { fill: "#111827"; stroke-width: 2; border-radius: 10 } }
  box: { style: { fill: "#1E293B"; stroke-width: 2; border-radius: 8 } }
  table_box: { style: { fill: "#1E293B"; stroke: "#38bdf8"; stroke-width: 2 } }
  blue_box: { style: { fill: "#1e293b"; stroke: "#38bdf8"; stroke-width: 2; border-radius: 8 } }
  green_box: { style: { fill: "#0f291e"; stroke: "#4ade80"; stroke-width: 2; border-radius: 8 } }
  amber_box: { style: { fill: "#231e12"; stroke: "#fbbf24"; stroke-width: 2; border-radius: 8 } }
  purple_box: { style: { fill: "#1e1b2e"; stroke: "#c084fc"; stroke-width: 2; border-radius: 8 } }
  red_box: { style: { fill: "#2b1111"; stroke: "#f87171"; stroke-width: 2; border-radius: 8 } }
}

heap: "1. JVM Heap Anatomy" {
  class: container
  style.fill: "#111827"
  style.stroke: "#3B82F6"
  style.stroke-width: 2
  eden: "Eden & Survivor (Young Gen)"
  tenured: "Tenured / Old Gen (ThreadLocal leaks)"
}

off_heap: "2. Off-Heap & Native" {
  class: container
  style.fill: "#111827"
  style.stroke: "#10B981"
  style.stroke-width: 2
  direct: "Direct ByteBuffers (Netty Channels)"
  metaspace: "Metaspace (CGLIB Proxies)"
}

diagnostics: "3. Triage & MAT Tool" {
  class: container
  style.fill: "#111827"
  style.stroke: "#F59E0B"
  style.stroke-width: 2
  dump: "jcmd PID GC.heap_dump"
  mat: "Eclipse MAT Dominator Tree"
}

remediation: "4. Preventative Fixes" {
  class: container
  style.fill: "#111827"
  style.stroke: "#8B5CF6"
  style.stroke-width: 2
  code: "ThreadLocal.remove() in finally block"
  flags: "-XX:MaxDirectMemorySize & MaxMetaspace"
}

heap -> off_heap: "Full GC Triggered" {
  style.stroke: "#10B981"
  style.stroke-width: 2
}
off_heap -> diagnostics: "Capture Heap Dump" {
  style.stroke: "#F59E0B"
  style.stroke-width: 2
}
diagnostics -> remediation: "Fix Leak Root Cause" {
  style.stroke: "#8B5CF6"
  style.stroke-width: 2
}