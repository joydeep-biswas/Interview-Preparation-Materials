direction: right
classes: {
  container: { style: { fill: "#111827"; stroke-width: 2; border-radius: 10 } }
  box: { style: { fill: "#1E293B"; stroke-width: 2; border-radius: 8 } }
  table_box: { style: { fill: "#1E293B"; stroke: "#38bdf8"; stroke-width: 2 } }
  blue_box: { style: { fill: "#1e293b"; stroke: "#38bdf8"; stroke-width: 2; border-radius: 8 } }
  green_box: { style: { fill: "#0f291e"; stroke: "#4ade80"; stroke-width: 2; border-radius: 8 } }
  amber_box: { style: { fill: "#231e12"; stroke: "#fbbf24"; stroke-width: 2; border-radius: 8 } }
  purple_box: { style: { fill: "#1e1b2e"; stroke: "#c084fc"; stroke-width: 2; border-radius: 8 } }
  red_box: { style: { fill: "#2b1111"; stroke: "#f87171"; stroke-width: 2; border-radius: 8 } }
}

phase1: "Phase 1: Detection & Triage" {
  class: container
  style.fill: "#111827"
  style.stroke: "#EF4444"
  style.stroke-width: 2
  alert: "Metric Breach (p99 > 500ms / 5xx Spike)"
  triage: "Incident Commander Trace Isolation"
  shed: "Traffic Shedding & Circuit Breaker Trip"
}

phase2: "Phase 2: Rectification & Bridge" {
  class: container
  style.fill: "#111827"
  style.stroke: "#F59E0B"
  style.stroke-width: 2
  bridge: "War Room & Statuspage Client Updates"
  hotfix: "Rollback or Hotfix Canary Deployment"
}

phase3: "Phase 3: Hardening & Post-Mortem" {
  class: container
  style.fill: "#111827"
  style.stroke: "#10B981"
  style.stroke-width: 2
  post_mortem: "Blameless 5 Whys Post-Mortem"
  action_items: "Socket Timeout Hardening & Chaos Testing"
}

phase1 -> phase2: "Active Blast Radius Contained" {
  style.stroke: "#F59E0B"
  style.stroke-width: 2
}
phase2 -> phase3: "Service Health Verified" {
  style.stroke: "#10B981"
  style.stroke-width: 2
}