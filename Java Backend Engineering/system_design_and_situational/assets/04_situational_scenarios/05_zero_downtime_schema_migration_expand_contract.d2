direction: right
classes: {
  container: { style: { fill: "#111827"; stroke-width: 2; border-radius: 10 } }
  box: { style: { fill: "#1E293B"; stroke-width: 2; border-radius: 8 } }
  table_box: { style: { fill: "#1E293B"; stroke: "#38bdf8"; stroke-width: 2 } }
  blue_box: { style: { fill: "#1e293b"; stroke: "#38bdf8"; stroke-width: 2; border-radius: 8 } }
  green_box: { style: { fill: "#0f291e"; stroke: "#4ade80"; stroke-width: 2; border-radius: 8 } }
  amber_box: { style: { fill: "#231e12"; stroke: "#fbbf24"; stroke-width: 2; border-radius: 8 } }
  purple_box: { style: { fill: "#1e1b2e"; stroke: "#c084fc"; stroke-width: 2; border-radius: 8 } }
  red_box: { style: { fill: "#2b1111"; stroke: "#f87171"; stroke-width: 2; border-radius: 8 } }
}

expand: "Phase 1: Expand (Dual-Write)" {
  class: container
  style.fill: "#111827"
  style.stroke: "#3B82F6"
  style.stroke-width: 2
  schema: "Add Nullable phone_v2 Column"
  dual_write: "App Dual-Writes to v1 & v2"
}

migrate: "Phase 2: Migrate (Backfill)" {
  class: container
  style.fill: "#111827"
  style.stroke: "#F59E0B"
  style.stroke-width: 2
  backfill: "Background Chunked Backfill (5,000 rows/batch)"
  cutover: "Clients Progressively Cut Over Reads to v2"
}

contract: "Phase 3: Contract (Prune)" {
  class: container
  style.fill: "#111827"
  style.stroke: "#10B981"
  style.stroke-width: 2
  stop_write: "100% Traffic on v2 (Stop writes to v1)"
  drop: "ALTER TABLE DROP COLUMN phone"
}

expand -> migrate: "Dual-Write Live" {
  style.stroke: "#F59E0B"
  style.stroke-width: 2
}
migrate -> contract: "Backfill 100% Complete" {
  style.stroke: "#10B981"
  style.stroke-width: 2
}