direction: right

expand: "Phase 1: Expand (Dual-Write)" {
  style.fill: "#111827"
  style.stroke: "#3B82F6"
  style.stroke-width: 2
  schema: "Add Nullable phone_v2 Column"
  dual_write: "App Dual-Writes to v1 & v2"
}

migrate: "Phase 2: Migrate (Backfill)" {
  style.fill: "#111827"
  style.stroke: "#F59E0B"
  style.stroke-width: 2
  backfill: "Background Chunked Backfill (5,000 rows/batch)"
  cutover: "Clients Progressively Cut Over Reads to v2"
}

contract: "Phase 3: Contract (Prune)" {
  style.fill: "#111827"
  style.stroke: "#10B981"
  style.stroke-width: 2
  stop_write: "100% Traffic on v2 (Stop writes to v1)"
  drop: "ALTER TABLE DROP COLUMN phone"
}

expand -> migrate: "Dual-Write Live" {
  style.stroke: "#F59E0B"
  style.stroke-width: 2
}
migrate -> contract: "Backfill 100% Complete" {
  style.stroke: "#10B981"
  style.stroke-width: 2
}