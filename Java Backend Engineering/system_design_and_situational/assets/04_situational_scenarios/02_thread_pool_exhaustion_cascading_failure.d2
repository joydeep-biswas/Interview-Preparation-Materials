direction: right
classes: {
  container: { style: { fill: "#111827"; stroke-width: 2; border-radius: 10 } }
  box: { style: { fill: "#1E293B"; stroke-width: 2; border-radius: 8 } }
  table_box: { style: { fill: "#1E293B"; stroke: "#38bdf8"; stroke-width: 2 } }
  blue_box: { style: { fill: "#1e293b"; stroke: "#38bdf8"; stroke-width: 2; border-radius: 8 } }
  green_box: { style: { fill: "#0f291e"; stroke: "#4ade80"; stroke-width: 2; border-radius: 8 } }
  amber_box: { style: { fill: "#231e12"; stroke: "#fbbf24"; stroke-width: 2; border-radius: 8 } }
  purple_box: { style: { fill: "#1e1b2e"; stroke: "#c084fc"; stroke-width: 2; border-radius: 8 } }
  red_box: { style: { fill: "#2b1111"; stroke: "#f87171"; stroke-width: 2; border-radius: 8 } }
}

client: "Client Application" {
  class: container
  style.fill: "#111827"
  style.stroke: "#3B82F6"
  style.stroke-width: 2
  req: "1. POST /orders"
  timeout: "5. HTTP 504 Gateway Timeout"
  fallback: "6. Fast Fallback Response (<5ms)"
}

gateway: "API Gateway (Envoy)" {
  class: container
  style.fill: "#111827"
  style.stroke: "#10B981"
  style.stroke-width: 2
  forward: "2. Forward Request to Order Svc"
}

order_svc: "Order Service (Tomcat Pool)" {
  class: container
  style.fill: "#111827"
  style.stroke: "#EF4444"
  style.stroke-width: 2
  thread: "Allocates Thread-1"
  starved: "3. 200/200 Threads Blocked Waiting"
  cb: "Resilience4j Trips OPEN -> Threads Restored"
}

fraud_svc: "Downstream Fraud Service" {
  class: container
  style.fill: "#111827"
  style.stroke: "#6B7280"
  style.stroke-width: 2
  hang: "4. HANGS INDEFINITELY (No Socket Timeout)"
}

client -> gateway: "Submit Order" {
  style.stroke: "#3B82F6"
  style.stroke-width: 2
}
gateway -> order_svc: "Route to Tomcat Pool" {
  style.stroke: "#10B981"
  style.stroke-width: 2
}
order_svc -> fraud_svc: "Call Fraud Check" {
  style.stroke: "#EF4444"
  style.stroke-width: 2
}
order_svc -> gateway: "Timeout Response" {
  style.stroke: "#EF4444"
  style.stroke-width: 2
}
gateway -> client: "504 Gateway Timeout" {
  style.stroke: "#EF4444"
  style.stroke-width: 2
}