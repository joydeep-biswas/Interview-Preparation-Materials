direction: right
classes: {
  container: { style: { fill: "#111827"; stroke-width: 2; border-radius: 10 } }
  box: { style: { fill: "#1E293B"; stroke-width: 2; border-radius: 8 } }
  table_box: { style: { fill: "#1E293B"; stroke: "#38bdf8"; stroke-width: 2 } }
  blue_box: { style: { fill: "#1e293b"; stroke: "#38bdf8"; stroke-width: 2; border-radius: 8 } }
  green_box: { style: { fill: "#0f291e"; stroke: "#4ade80"; stroke-width: 2; border-radius: 8 } }
  amber_box: { style: { fill: "#231e12"; stroke: "#fbbf24"; stroke-width: 2; border-radius: 8 } }
  purple_box: { style: { fill: "#1e1b2e"; stroke: "#c084fc"; stroke-width: 2; border-radius: 8 } }
  red_box: { style: { fill: "#2b1111"; stroke: "#f87171"; stroke-width: 2; border-radius: 8 } }
}

deadlock: "Circular Wait Deadlock Condition (Failure)" {
  class: container
  style.fill: "#111827"
  style.stroke: "#EF4444"
  style.stroke-width: 2
  thread_a: "Thread A: Holds User 1, Waits User 2"
  thread_b: "Thread B: Holds User 2, Waits User 1"
  err: "ERROR 40P01: Deadlock Detected"
}

solution: "Canonical Lock Ordering Solution (Success)" {
  class: container
  style.fill: "#111827"
  style.stroke: "#10B981"
  style.stroke-width: 2
  rule: "Deterministic Rule: min(id1, id2) then max(id1, id2)"
  linear: "Both Threads Acquire in Same Order -> Zero Deadlocks"
}

deadlock.thread_a -> deadlock.thread_b: "Contends with" {
  style.stroke: "#EF4444"
  style.stroke-dash: 4
}
deadlock.thread_b -> deadlock.thread_a: "Contends with" {
  style.stroke: "#EF4444"
  style.stroke-dash: 4
}

solution.rule -> solution.linear: "Guarantees Cycle-Free Graph" {
  style.stroke: "#10B981"
  style.stroke-width: 2
}