direction: right
classes: {
  container: { style: { fill: "#111827"; stroke-width: 2; border-radius: 10 } }
  box: { style: { fill: "#1E293B"; stroke-width: 2; border-radius: 8 } }
  table_box: { style: { fill: "#1E293B"; stroke: "#38bdf8"; stroke-width: 2 } }
  blue_box: { style: { fill: "#1e293b"; stroke: "#38bdf8"; stroke-width: 2; border-radius: 8 } }
  green_box: { style: { fill: "#0f291e"; stroke: "#4ade80"; stroke-width: 2; border-radius: 8 } }
  amber_box: { style: { fill: "#231e12"; stroke: "#fbbf24"; stroke-width: 2; border-radius: 8 } }
  purple_box: { style: { fill: "#1e1b2e"; stroke: "#c084fc"; stroke-width: 2; border-radius: 8 } }
  red_box: { style: { fill: "#2b1111"; stroke: "#f87171"; stroke-width: 2; border-radius: 8 } }
}

ingress: "1. Worker Ingress" {
  class: container
  style.fill: "#111827"
  style.stroke: "#3B82F6"
  style.stroke-width: 2
  threads: "Concurrent Worker Threads (Publishers/Readers)"
  jmm: "Java Memory Model Happens-Before Fences"
}

synchronization: "2. Synchronization Tier" {
  class: container
  style.fill: "#111827"
  style.stroke: "#10B981"
  style.stroke-width: 2
  locks: "ReentrantLock & Condition Variables"
  cas: "Atomic CAS & StampedLock Optimistic Reads"
}

structures: "3. Memory Structures" {
  class: container
  style.fill: "#111827"
  style.stroke: "#F59E0B"
  style.stroke-width: 2
  disruptor: "LMAX Disruptor Ring Buffer (Padded)"
  chm: "ConcurrentHashMap with Lock Striping"
}

executors: "4. Thread Pools & Stealing" {
  class: container
  style.fill: "#111827"
  style.stroke: "#8B5CF6"
  style.stroke-width: 2
  pool: "Custom ThreadPoolExecutor with CallerRunsPolicy"
  forkjoin: "ForkJoinPool Work-Stealing Deques"
}

ingress -> synchronization: "Acquire Guard" {
  style.stroke: "#10B981"
  style.stroke-width: 2
}
synchronization -> structures: "Safe Concurrent Mutation" {
  style.stroke: "#F59E0B"
  style.stroke-width: 2
}
structures -> executors: "Dispatch Tasks" {
  style.stroke: "#8B5CF6"
  style.stroke-width: 2
}