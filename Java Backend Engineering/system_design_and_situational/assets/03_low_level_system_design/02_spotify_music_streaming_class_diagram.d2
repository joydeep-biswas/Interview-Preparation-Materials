direction: right
classes: {
  container: { style: { fill: "#111827"; stroke-width: 2; border-radius: 10 } }
  box: { style: { fill: "#1E293B"; stroke-width: 2; border-radius: 8 } }
  table_box: { style: { fill: "#1E293B"; stroke: "#38bdf8"; stroke-width: 2 } }
  blue_box: { style: { fill: "#1e293b"; stroke: "#38bdf8"; stroke-width: 2; border-radius: 8 } }
  green_box: { style: { fill: "#0f291e"; stroke: "#4ade80"; stroke-width: 2; border-radius: 8 } }
  amber_box: { style: { fill: "#231e12"; stroke: "#fbbf24"; stroke-width: 2; border-radius: 8 } }
  purple_box: { style: { fill: "#1e1b2e"; stroke: "#c084fc"; stroke-width: 2; border-radius: 8 } }
  red_box: { style: { fill: "#2b1111"; stroke: "#f87171"; stroke-width: 2; border-radius: 8 } }
}

player: "MusicPlayer (Context)" {
  class: container
  style.fill: "#111827"
  style.stroke: "#3B82F6"
  style.stroke-width: 2
  state: "- currentState : PlaybackState"
  queue: "- currentQueue : Playlist"
  methods: "+ play()\n+ pause()\n+ next()\n+ setState(PlaybackState state)"
}

state_interface: "<<interface>> PlaybackState" {
  class: container
  style.fill: "#111827"
  style.stroke: "#10B981"
  style.stroke-width: 2
  methods: "+ play(MusicPlayer player)\n+ pause(MusicPlayer player)\n+ next(MusicPlayer player)"
}

playing: "PlayingState" {
  class: container
  style.fill: "#111827"
  style.stroke: "#10B981"
  style.stroke-width: 2
  desc: "+ play() (noop)\n+ pause() -> PausedState\n+ next() -> next track"
}

paused: "PausedState" {
  class: container
  style.fill: "#111827"
  style.stroke: "#F59E0B"
  style.stroke-width: 2
  desc: "+ play() -> PlayingState\n+ pause() (noop)\n+ next() -> next track"
}

stopped: "StoppedState" {
  class: container
  style.fill: "#111827"
  style.stroke: "#EF4444"
  style.stroke-width: 2
  desc: "+ play() -> PlayingState\n+ pause() (noop)\n+ next() (noop)"
}

domain: "Playlist & Track" {
  class: container
  style.fill: "#111827"
  style.stroke: "#8B5CF6"
  style.stroke-width: 2
  playlist: "Playlist: - tracks : List<Track>"
  track: "Track: - id, - title, - durationSec"
}

player -> state_interface: "delegates to" {
  style.stroke: "#10B981"
  style.stroke-width: 2
}
state_interface -> playing: "implements" {
  style.stroke: "#10B981"
  style.stroke-dash: 4
}
state_interface -> paused: "implements" {
  style.stroke: "#F59E0B"
  style.stroke-dash: 4
}
state_interface -> stopped: "implements" {
  style.stroke: "#EF4444"
  style.stroke-dash: 4
}
player -> domain: "maintains queue" {
  style.stroke: "#8B5CF6"
  style.stroke-width: 2
}